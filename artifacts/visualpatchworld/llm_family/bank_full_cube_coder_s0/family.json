      "name": "linear_effector_block_coupling",
      "mechanism": "Effector moves linearly with action; block follows when contacted via sticky constraint.",
      "code": "# HYPOTHESIS: linear_effector_block_coupling\n# MECHANISM: Effector moves linearly with action; block follows when contacted via sticky constraint.\nPARAMS = {\"effector_gain\": 0.1, \"contact_distance\": 0.05}\n\ndef step(state, action, p, meta):\n    import math\n    next_state = state.copy()\n    \n    # Effector moves directly with action\n    dx = action[0] * p[\"effector_gain\"]\n    dy = action[1] * p[\"effector_gain\"]\n    dz = action[2] * p[\"effector_gain\"]\n    \n    new_ex = state[\"effector.x\"] + dx\n    new_ey = state[\"effector.y\"] + dy\n    new_ez = state[\"effector.z\"] + dz\n    \n    # Check if effector is close enough to block to move it\n    bx = state[\"block.x\"]\n    by = state[\"block.y\"]\n    bz = state[\"block.z\"]\n    \n    dist = math.sqrt((new_ex - bx)**2 + (new_ey - by)**2 + (new_ez - bz)**2)\n    \n    if dist < p[\"contact_distance\"]:\n        # Move block with effector\n        next_state[\"block.x\"] = bx + dx\n        next_state[\"block.y\"] = by + dy\n        next_state[\"block.z\"] = bz + dz\n    \n    next_state[\"effector.x\"] = new_ex\n    next_state[\"effector.y\"] = new_ey\n    next_state[\"effector.z\"] = new_ez\n    \n    return next_state",
      "init_params": {
        "effector_gain": 0.1,
        "contact_distance": 0.05
      },
      "repaired": false
