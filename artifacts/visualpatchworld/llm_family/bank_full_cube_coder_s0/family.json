    {
      "name": "velocity_control_with_momentum_and_friction",
      "mechanism": "Both effector and block have momentum; they interact through contact with friction and damping.",
      "code": "# HYPOTHESIS: velocity_control_with_momentum_and_friction\n# MECHANISM: Both effector and block have momentum; they interact through contact with friction and damping.\nPARAMS = {\n    \"effector_accel\": 10.0,\n    \"block_mass\": 0.5,\n    \"friction_coeff\": 0.1,\n    \"air_resistance\": 0.2,\n    \"contact_spring\": 50.0,\n    \"dt\": 0.1\n}\n\ndef step(state, action, p, meta):\n    import math\n    next_state = state.copy()\n    \n    # Effector acceleration from action\n    ax_e = action[0] * p[\"effector_accel\"]\n    ay_e = action[1] * p[\"effector_accel\"]\n    az_e = action[2] * p[\"effector_accel\"]\n    \n    # Get current velocities\n    vx_e = state.get(\"effector.vx\", 0.0)\n    vy_e = state.get(\"effector.vy\", 0.0)\n    vz_e = state.get(\"effector.vz\", 0.0)\n    \n    vx_b = state.get(\"block.vx\", 0.0)\n    vy_b = state.get(\"block.vy\", 0.0)\n    vz_b = state.get(\"block.vz\", 0.0)\n    \n    # Update effector velocity\n    vx_e += ax_e * p[\"dt\"]\n    vy_e += ay_e * p[\"dt\"]\n    vz_e += az_e * p[\"dt\"]\n    \n    # Apply air resistance\n    vx_e *= (1 - p[\"air_resistance\"] * p[\"dt\"])\n    vy_e *= (1 - p[\"air_resistance\"] * p[\"dt\"])\n    vz_e *= (1 - p[\"air_resistance\"] * p[\"dt\"])\n    \n    # Calculate relative positions\n    ex = state[\"effector.x\"] + vx_e * p[\"dt\"]\n    ey = state[\"effector.y\"] + vy_e * p[\"dt\"]\n    ez = state[\"effector.z\"] + vz_e * p[\"dt\"]\n    \n    bx = state[\"block.x\"] + vx_b * p[\"dt\"]\n    by = state[\"block.y\"] + vy_b * p[\"dt\"]\n    bz = state[\"block.z\"] + vz_b * p[\"dt\"]\n    \n    # Contact interaction\n    dx = ex - bx\n    dy = ey - by\n    dz = ez - bz\n    dist = math.sqrt(dx*dx + dy*dy + dz*dz)\n    \n    if dist < 0.1:  # Interaction range\n        # Direction vectors\n        nx = dx / (dist + 1e-8)\n        ny = dy / (dist + 1e-8)\n        nz = dz / (dist + 1e-8)\n        \n        # Spring force\n        spring_force = (0.1 - dist) * p[\"contact_spring\"]\n        fx = nx * spring_force\n        fy = ny * spring_force\n        fz = nz * spring_force\n        \n        # Apply to block\n        ax_b = fx / p[\"block_mass\"]\n        ay_b = fy / p[\"block_mass\"]\n        az_b = fz / p[\"block_mass\"]\n        \n        vx_b += ax_b * p[\"dt\"]\n        vy_b += ay_b * p[\"dt\"]\n        vz_b += az_b * p[\"dt\"]\n        \n        # Friction opposing relative motion\n        rvx = vx_e - vx_b\n        rvy = vy_e - vy_b\n        rvz = vz_e - vz_b\n        \n        rv_norm = math.sqrt(rvx*rvx + rvy*rvy + rvz*rvz)\n        if rv_norm > 1e-8:\n            friction_mag = p[\"friction_coeff\"] * abs(spring_force)\n            fv_x = -rvx/rv_norm * friction_mag\n            fv_y = -rvy/rv_norm * friction_mag\n            fv_z = -rvz/rv_norm * friction_mag\n            \n            # Apply friction to both objects\n            vx_e += fv_x / p[\"block_mass\"] * p[\"dt\"]\n            vy_e += fv_y / p[\"block_mass\"] * p[\"dt\"]\n            vz_e += fv_z / p[\"block_mass\"] * p[\"dt\"]\n            \n            vx_b -= fv_x / p[\"block_mass\"] * p[\"dt\"]\n            vy_b -= fv_y / p[\"block_mass\"] * p[\"dt\"]\n            vz_b -= fv_z / p[\"block_mass\"] * p[\"dt\"]\n    \n    # Apply air resistance to block\n    vx_b *= (1 - p[\"air_resistance\"] * p[\"dt\"])\n    vy_b *= (1 - p[\"air_resistance\"] * p[\"dt\"])\n    vz_b *= (1 - p[\"air_resistance\"] * p[\"dt\"])\n    \n    # Update positions\n    next_state[\"effector.x\"] = state[\"effector.x\"] + vx_e * p[\"dt\"]\n    next_state[\"effector.y\"] = state[\"effector.y\"] + vy_e * p[\"dt\"]\n    next_state[\"effector.z\"] = state[\"effector.z\"] + vz_e * p[\"dt\"]\n    next_state[\"effector.vx\"] = vx_e\n    next_state[\"effector.vy\"] = vy_e\n    next_state[\"effector.vz\"] = vz_e\n    \n    next_state[\"block.x\"] = state[\"block.x\"] + vx_b * p[\"dt\"]\n    next_state[\"block.y\"] = state[\"block.y\"] + vy_b * p[\"dt\"]\n    next_state[\"block.z\"] = state[\"block.z\"] + vz_b * p[\"dt\"]\n    next_state[\"block.vx\"] = vx_b\n    next_state[\"block.vy\"] = vy_b\n    next_state[\"block.vz\"] = vz_b\n    \n    return next_state",
