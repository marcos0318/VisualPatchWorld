      "code": "# HYPOTHESIS: baseline_direct_mapping\n# MECHANISM: Direct mapping of actions to position changes without physical simulation or coupling.\nPARAMS = {\"gain_x\": 0.1, \"gain_y\": 0.1, \"gain_z\": 0.1}\n\ndef step(state, action, p, meta):\n    next_state = state.copy()\n    \n    # Direct position update from action\n    next_state[\"effector.x\"] = state[\"effector.x\"] + action[0] * p[\"gain_x\"]\n    next_state[\"effector.y\"] = state[\"effector.y\"] + action[1] * p[\"gain_y\"]\n    next_state[\"effector.z\"] = state[\"effector.z\"] + action[2] * p[\"gain_z\"]\n    \n    # Block position updated independently (no physics)\n    next_state[\"block.x\"] = state[\"block.x\"] + action[3] * p[\"gain_x\"]\n    next_state[\"block.y\"] = state[\"block.y\"] + action[4] * p[\"gain_y\"]\n    next_state[\"block.z\"] = state[\"block.z\"]  # Z unchanged in this baseline\n    \n    return next_state",
