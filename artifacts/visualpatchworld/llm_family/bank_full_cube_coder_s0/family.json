    {
      "name": "actuated_rigid_gripper_with_block_physics",
      "mechanism": "Effector is a rigid body with velocity control; block behaves as independent object with gravity and contact.",
      "code": "# HYPOTHESIS: actuated_rigid_gripper_with_block_physics\n# MECHANISM: Effector is a rigid body with velocity control; block behaves as independent object with gravity and contact.\nPARAMS = {\n    \"effector_speed\": 0.5,\n    \"block_mass\": 0.2,\n    \"gravity\": -9.8,\n    \"ground_level\": 0.02,\n    \"dt\": 0.1,\n    \"contact_stiffness\": 100.0\n}\n\ndef step(state, action, p, meta):\n    import math\n    next_state = state.copy()\n    \n    # Effector velocity clamped to maximum speed\n    ax = action[0]\n    ay = action[1]\n    az = action[2]\n    norm = math.sqrt(ax*ax + ay*ay + az*az)\n    if norm > 1e-8:\n        scale = min(norm, 1.0) / norm\n        vx_e = ax * scale * p[\"effector_speed\"]\n        vy_e = ay * scale * p[\"effector_speed\"]\n        vz_e = az * scale * p[\"effector_speed\"]\n    else:\n        vx_e, vy_e, vz_e = 0.0, 0.0, 0.0\n    \n    # Effector position update\n    new_ex = state[\"effector.x\"] + vx_e * p[\"dt\"]\n    new_ey = state[\"effector.y\"] + vy_e * p[\"dt\"]\n    new_ez = state[\"effector.z\"] + vz_e * p[\"dt\"]\n    \n    # Block physics simulation\n    bx = state[\"block.x\"]\n    by = state[\"block.y\"]\n    bz = state[\"block.z\"]\n    vx_b = state.get(\"block.vx\", 0.0)\n    vy_b = state.get(\"block.vy\", 0.0)\n    vz_b = state.get(\"block.vz\", 0.0)\n    \n    # Apply gravity\n    vz_b += p[\"gravity\"] * p[\"dt\"]\n    \n    # Contact force calculation (simplified)\n    dx = new_ex - bx\n    dy = new_ey - by\n    dz = new_ez - bz\n    dist = math.sqrt(dx*dx + dy*dy + dz*dz)\n    \n    if dist < 0.1:  # Interaction distance\n        # Normalized direction vector\n        nx = dx / (dist + 1e-8)\n        ny = dy / (dist + 1e-8)\n        nz = dz / (dist + 1e-8)\n        \n        # Spring-like repulsion/attraction\n        force_mag = (0.1 - dist) * p[\"contact_stiffness\"]\n        fx = nx * force_mag\n        fy = ny * force_mag\n        fz = nz * force_mag\n        \n        # Apply force to block\n        ax_b = fx / p[\"block_mass\"]\n        ay_b = fy / p[\"block_mass\"]\n        az_b = fz / p[\"block_mass\"]\n        \n        vx_b += ax_b * p[\"dt\"]\n        vy_b += ay_b * p[\"dt\"]\n        vz_b += az_b * p[\"dt\"]\n    \n    # Ground collision for block\n    new_bz = bz + vz_b * p[\"dt\"]\n    if new_bz < p[\"ground_level\"]:\n        new_bz = p[\"ground_level\"]\n        vz_b = 0.0  # Stop vertical motion\n    \n    new_bx = bx + vx_b * p[\"dt\"]\n    new_by = by + vy_b * p[\"dt\"]\n    \n    # Update states\n    next_state[\"effector.x\"] = new_ex\n    next_state[\"effector.y\"] = new_ey\n    next_state[\"effector.z\"] = new_ez\n    \n    next_state[\"block.x\"] = new_bx\n    next_state[\"block.y\"] = new_by\n    next_state[\"block.z\"] = new_bz\n    next_state[\"block.vx\"] = vx_b\n    next_state[\"block.vy\"] = vy_b\n    next_state[\"block.vz\"] = vz_b\n    \n    return next_state",
