    {
      "name": "second_order_dynamics_with_gravity",
      "mechanism": "Effector has mass and inertia; responds to forces with acceleration, under gravity and damping.",
      "code": "# HYPOTHESIS: second_order_dynamics_with_gravity\n# MECHANISM: Effector has mass and inertia; responds to forces with acceleration, under gravity and damping.\nPARAMS = {\n    \"mass\": 1.0,\n    \"force_gain\": 10.0,\n    \"damping\": 0.5,\n    \"gravity\": -9.8,\n    \"dt\": 0.1\n}\n\ndef step(state, action, p, meta):\n    import math\n    next_state = state.copy()\n    \n    # Compute forces from action\n    fx = action[0] * p[\"force_gain\"]\n    fy = action[1] * p[\"force_gain\"]\n    fz = action[2] * p[\"force_gain\"]\n    \n    # Add gravity\n    fz += p[\"mass\"] * p[\"gravity\"]\n    \n    # Update velocities using F = ma and damping\n    vx = state.get(\"effector.vx\", 0.0)\n    vy = state.get(\"effector.vy\", 0.0)\n    vz = state.get(\"effector.vz\", 0.0)\n    \n    ax = fx / p[\"mass\"] - p[\"damping\"] * vx\n    ay = fy / p[\"mass\"] - p[\"damping\"] * vy\n    az = fz / p[\"mass\"] - p[\"damping\"] * vz\n    \n    new_vx = vx + ax * p[\"dt\"]\n    new_vy = vy + ay * p[\"dt\"]\n    new_vz = vz + az * p[\"dt\"]\n    \n    # Update positions\n    new_ex = state[\"effector.x\"] + new_vx * p[\"dt\"]\n    new_ey = state[\"effector.y\"] + new_vy * p[\"dt\"]\n    new_ez = state[\"effector.z\"] + new_vz * p[\"dt\"]\n    \n    next_state[\"effector.x\"] = new_ex\n    next_state[\"effector.y\"] = new_ey\n    next_state[\"effector.z\"] = new_ez\n    next_state[\"effector.vx\"] = new_vx\n    next_state[\"effector.vy\"] = new_vy\n    next_state[\"effector.vz\"] = new_vz\n    \n    # Block remains stationary unless contacted\n    # Simple contact model: if effector touches block, move block too\n    dx = new_ex - state[\"block.x\"]\n    dy = new_ey - state[\"block.y\"]\n    dz = new_ez - state[\"block.z\"]\n    dist = math.sqrt(dx*dx + dy*dy + dz*dz)\n    \n    if dist < 0.05:  # Contact threshold\n        next_state[\"block.x\"] = state[\"block.x\"] + new_vx * p[\"dt\"]\n        next_state[\"block.y\"] = state[\"block.y\"] + new_vy * p[\"dt\"]\n        next_state[\"block.z\"] = state[\"block.z\"] + new_vz * p[\"dt\"]\n        next_state[\"block.vx\"] = new_vx\n        next_state[\"block.vy\"] = new_vy\n        next_state[\"block.vz\"] = new_vz\n    \n    return next_state",
      "init_params": {
