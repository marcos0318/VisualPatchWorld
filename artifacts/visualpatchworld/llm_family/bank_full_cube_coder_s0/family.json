    {
      "name": "proportional_position_control",
      "mechanism": "Effector moves towards commanded position based on error; block follows when grabbed.",
      "code": "# HYPOTHESIS: proportional_position_control\n# MECHANISM: Effector moves towards commanded position based on error; block follows when grabbed.\nPARAMS = {\n    \"kp\": 5.0,\n    \"grab_threshold\": 0.05,\n    \"release_threshold\": 0.1\n}\n\ndef step(state, action, p, meta):\n    import math\n    next_state = state.copy()\n    \n    # Desired position change based on action\n    cmd_dx = action[0]\n    cmd_dy = action[1]\n    cmd_dz = action[2]\n    \n    # Current and desired positions\n    curr_ex = state[\"effector.x\"]\n    curr_ey = state[\"effector.y\"]\n    curr_ez = state[\"effector.z\"]\n    \n    des_ex = curr_ex + cmd_dx\n    des_ey = curr_ey + cmd_dy\n    des_ez = curr_ez + cmd_dz\n    \n    # Proportional control response\n    out_dx = (des_ex - curr_ex) * p[\"kp\"]\n    out_dy = (des_ey - curr_ey) * p[\"kp\"]\n    out_dz = (des_ez - curr_ez) * p[\"kp\"]\n    \n    new_ex = curr_ex + out_dx\n    new_ey = curr_ey + out_dy\n    new_ez = curr_ez + out_dz\n    \n    # Determine if grabbing based on proximity\n    bx = state[\"block.x\"]\n    by = state[\"block.y\"]\n    bz = state[\"block.z\"]\n    \n    dist = math.sqrt((new_ex - bx)**2 + (new_ey - by)**2 + (new_ez - bz)**2)\n    \n    grabbed = state.get(\"__grabbed__\", False)\n    \n    if not grabbed and dist < p[\"grab_threshold\"]:\n        grabbed = True\n    elif grabbed and dist > p[\"release_threshold\"]:\n        grabbed = False\n    \n    # Move block if grabbed\n    if grabbed:\n        next_state[\"block.x\"] = bx + out_dx\n        next_state[\"block.y\"] = by + out_dy\n        next_state[\"block.z\"] = bz + out_dz\n    \n    next_state[\"effector.x\"] = new_ex\n    next_state[\"effector.y\"] = new_ey\n    next_state[\"effector.z\"] = new_ez\n    next_state[\"__grabbed__\"] = grabbed\n    \n    return next_state",
      "init_params": {
        "kp": 5.0,
        "grab_threshold": 0.05,
        "release_threshold": 0.1
      },
      "repaired": false
