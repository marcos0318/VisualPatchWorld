      "code": "# HYPOTHESIS: proximity_push\n# MECHANISM: Block moves only when effector is within proximity radius; motion is proportional to action magnitude and distance overlap.\nPARAMS = {\"effector_speed\": 0.1, \"push_radius\": 0.03, \"push_gain\": 0.5, \"z_contact_thresh\": 0.05}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = dict(state)\n    \n    eff_x = state[\"effector.x\"]\n    eff_y = state[\"effector.y\"]\n    eff_z = state[\"effector.z\"]\n    block_x = state[\"block.x\"]\n    block_y = state[\"block.y\"]\n    block_z = state[\"block.z\"]\n    goal_x = state[\"goal.x\"]\n    goal_y = state[\"goal.y\"]\n    goal_z = state[\"goal.z\"]\n    \n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    az = action[2] if len(action) > 2 else 0.0\n    agrasp = action[4] if len(action) > 4 else 0.0\n    \n    new_eff_x = eff_x + p[\"effector_speed\"] * ax\n    new_eff_y = eff_y + p[\"effector_speed\"] * ay\n    new_eff_z = eff_z + p[\"effector_speed\"] * az\n    \n    dx = abs(new_eff_x - block_x)\n    dy = abs(new_eff_y - block_y)\n    dz = abs(new_eff_z - block_z)\n    \n    in_xy_range = dx < p[\"push_radius\"] and dy < p[\"push_radius\"]\n    z_aligned = dz < p[\"z_contact_thresh\"]\n    can_push = in_xy_range and z_aligned and agrasp > 0.0\n    \n    if can_push:\n        overlap_x = max(0, p[\"push_radius\"] - dx)\n        overlap_y = max(0, p[\"push_radius\"] - dy)\n        push_factor = p[\"push_gain\"] * (overlap_x + overlap_y) / (2 * p[\"push_radius\"])\n        new_block_x = block_x + p[\"effector_speed\"] * push_factor * ax\n        new_block_y = block_y + p[\"effector_speed\"] * push_factor * ay\n        new_block_z = block_z + p[\"effector_speed\"] * push_factor * az\n    else:\n        new_block_x = block_x\n        new_block_y = block_y\n        new_block_z = block_z\n    \n    new_state[\"effector.x\"] = new_eff_x\n    new_state[\"effector.y\"] = new_eff_y\n    new_state[\"effector.z\"] = new_eff_z\n    new_state[\"block.x\"] = new_block_x\n    new_state[\"block.y\"] = new_block_y\n    new_state[\"block.z\"] = new_block_z\n    new_state[\"goal.x\"] = goal_x\n    new_state[\"goal.y\"] = goal_y\n    new_state[\"goal.z\"] = goal_z\n    \n    return new_state",
