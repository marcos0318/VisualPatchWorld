 = -p[\"damper_c\"] * rel_vy\n        damp_fz = -p[\"damper_c\"] * rel_vz\n        \n        total_fx = spring_fx + damp_fx\n        total_fy = spring_fy + damp_fy\n        total_fz = spring_fz + damp_fz\n        \n        block_vx = block_vx + total_fx - p[\"block_drag\"] * block_vx\n        block_vy = block_vy + total_fy - p[\"block_drag\"] * block_vy\n        block_vz = block_vz + total_fz - p[\"block_drag\"] * block_vz\n    else:\n        block_vx = block_vx - p[\"block_drag\"] * block_vx\n        block_vy = block_vy - p[\"block_drag\"] * block_vy\n        block_vz = block_vz - p[\"block_drag\"] * block_vz\n    \n    new_block_x = block_x + block_vx\n    new_block_y = block_y + block_vy\n    new_block_z = block_z + block_vz\n    \n    new_state[\"effector.x\"] = new_eff_x\n    new_state[\"effector.y\"] = new_eff_y\n    new_state[\"effector.z\"] = new_eff_z\n    new_state[\"block.x\"] = new_block_x\n    new_state[\"block.y\"] = new_block_y\n    new_state[\"block.z\"] = new_block_z\n    new_state[\"effector.vx\"] = new_eff_vx\n    new_state[\"effector.vy\"] = new_eff_vy\n    new_state[\"effector.vz\"] = new_eff_vz\n    new_state[\"block.vx\"] = block_vx\n    new_state[\"block.vy\"] = block_vy\n    new_state[\"block.vz\"] = block_vz\n    new_state[\"goal.x\"] = goal_x\n    new_state[\"goal.y\"] = goal_y\n    new_state[\"goal.z\"] = goal_z\n    \n    return new_state",
