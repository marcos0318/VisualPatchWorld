      "code": "# HYPOTHESIS: saturating_nonlinear_kinematic\n# MECHANISM: Action-to-velocity mapping uses tanh saturation; block follows effector with proportional coupling when grasping signal is active.\nPARAMS = {\"max_speed\": 0.15, \"steepness\": 4.0, \"grasp_gain\": 0.9, \"grasp_thresh\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = dict(state)\n    \n    eff_x = state[\"effector.x\"]\n    eff_y = state[\"effector.y\"]\n    eff_z = state[\"effector.z\"]\n    block_x = state[\"block.x\"]\n    block_y = state[\"block.y\"]\n    block_z = state[\"block.z\"]\n    goal_x = state[\"goal.x\"]\n    goal_y = state[\"goal.y\"]\n    goal_z = state[\"goal.z\"]\n    \n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    az = action[2] if len(action) > 2 else 0.0\n    agrasp = action[4] if len(action) > 4 else 0.0\n    \n    def saturate(a):\n        return p[\"max_speed\"] * math.tanh(p[\"steepness\"] * a)\n    \n    new_eff_x = eff_x + saturate(ax)\n    new_eff_y = eff_y + saturate(ay)\n    new_eff_z = eff_z + saturate(az)\n    \n    is_grasping = agrasp > p[\"grasp_thresh\"]\n    \n    if is_grasping:\n        new_block_x = block_x + p[\"grasp_gain\"] * (new_eff_x - block_x)\n        new_block_y = block_y + p[\"grasp_gain\"] * (new_eff_y - block_y)\n        new_block_z = block_z + p[\"grasp_gain\"] * (new_eff_z - block_z)\n    else:\n        new_block_x = block_x\n        new_block_y = block_y\n        new_block_z = block_z\n    \n    new_state[\"effector.x\"] = new_eff_x\n    new_state[\"effector.y\"] = new_eff_y\n    new_state[\"effector.z\"] = new_eff_z\n    new_state[\"block.x\"] = new_block_x\n    new_state[\"block.y\"] = new_block_y\n    new_state[\"block.z\"] = new_block_z\n    new_state[\"goal.x\"] = goal_x\n    new_state[\"goal.y\"] = goal_y\n    new_state[\"goal.z\"] = goal_z\n    \n    return new_state",
