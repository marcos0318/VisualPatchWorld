      "code": "# HYPOTHESIS: momentum_with_contact\n# MECHANISM: Both objects have velocity states; effector accelerates from action, block only accelerates when within contact distance and grasping.\nPARAMS = {\"effector_mass\": 1.0, \"block_mass\": 1.0, \"force_scale\": 0.05, \"friction\": 0.1, \"contact_dist\": 0.05, \"grasp_thresh\": 0.0}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = dict(state)\n    \n    eff_x = state[\"effector.x\"]\n    eff_y = state[\"effector.y\"]\n    eff_z = state[\"effector.z\"]\n    block_x = state[\"block.x\"]\n    block_y = state[\"block.y\"]\n    block_z = state[\"block.z\"]\n    goal_x = state[\"goal.x\"]\n    goal_y = state[\"goal.y\"]\n    goal_z = state[\"goal.z\"]\n    \n    eff_vx = state.get(\"effector.vx\", 0.0)\n    eff_vy = state.get(\"effector.vy\", 0.0)\n    eff_vz = state.get(\"effector.vz\", 0.0)\n    block_vx = state.get(\"block.vx\", 0.0)\n    block_vy = state.get(\"block.vy\", 0.0)\n    block_vz = state.get(\"block.vz\", 0.0)\n    \n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    az = action[2] if len(action) > 2 else 0.0\n    agrasp = action[4] if len(action) > 4 else 0.0\n    \n    fx = p[\"force_scale\"] * ax / p[\"effector_mass\"]\n    fy = p[\"force_scale\"] * ay / p[\"effector_mass\"]\n    fz = p[\"force_scale\"] * az / p[\"effector_mass\"]\n    \n    eff_vx = eff_vx + fx - p[\"friction\"] * eff_vx\n    eff_vy = eff_vy + fy - p[\"friction\"] * eff_vy\n    eff_vz = eff_vz + fz - p[\"friction\"] * eff_vz\n    \n    dist = math.sqrt((eff_x - block_x)**2 + (eff_y - block_y)**2 + (eff_z - block_z)**2)\n    in_contact = dist < p[\"contact_dist\"]\n    is_grasping = agrasp > p[\"grasp_thresh\"]\n    \n    if in_contact and is_grasping:\n        block_vx = block_vx + fx - p[\"friction\"] * block_vx\n        block_vy = block_vy + fy - p[\"friction\"] * block_vy\n        block_vz = block_vz + fz - p[\"friction\"] * block_vz\n    \n    new_eff_x = eff_x + eff_vx\n    new_eff_y = eff_y + eff_vy\n    new_eff_z = eff_z + eff_vz\n    new_block_x = block_x + block_vx\n    new_block_y = block_y + block_vy\n    new_block_z = block_z + block_vz\n    \n    new_state[\"effector.x\"] = new_eff_x\n    new_state[\"effector.y\"] = new_eff_y\n    new_state[\"effector.z\"] = new_eff_z\n    new_state[\"block.x\"] = new_block_x\n    new_state[\"block.y\"] = new_block_y\n    new_state[\"block.z\"] = new_block_z\n    new_state[\"effector.vx\"] = eff_vx\n    new_state[\"effector.vy\"] = eff_vy\n    new_state[\"effector.vz\"] = eff_vz\n    new_state[\"block.vx\"] = block_vx\n    new_state[\"block.vy\"] = block_vy\n    new_state[\"block.vz\"] = block_vz\n    new_state[\"goal.x\"] = goal_x\n    new_state[\"goal.y\"] = goal_y\n    new_state[\"goal.z\"] = goal_z\n    \n    return new_state",
