      "code": "# HYPOTHESIS: kinematic_grasp_coupling\n# MECHANISM: Effector moves kinematically from actions; block rigidly follows effector when 5th action component indicates grasp.\nPARAMS = {\"effector_gain\": 0.1, \"grasp_threshold\": 0.0, \"couple_x\": 1.0, \"couple_y\": 1.0, \"couple_z\": 1.0}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = dict(state)\n    \n    eff_x = state[\"effector.x\"]\n    eff_y = state[\"effector.y\"]\n    eff_z = state[\"effector.z\"]\n    block_x = state[\"block.x\"]\n    block_y = state[\"block.y\"]\n    block_z = state[\"block.z\"]\n    goal_x = state[\"goal.x\"]\n    goal_y = state[\"goal.y\"]\n    goal_z = state[\"goal.z\"]\n    \n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    az = action[2] if len(action) > 2 else 0.0\n    agrasp = action[4] if len(action) > 4 else 0.0\n    \n    new_eff_x = eff_x + p[\"effector_gain\"] * ax\n    new_eff_y = eff_y + p[\"effector_gain\"] * ay\n    new_eff_z = eff_z + p[\"effector_gain\"] * az\n    \n    is_grasping = agrasp > p[\"grasp_threshold\"]\n    \n    if is_grasping:\n        new_block_x = eff_x + p[\"couple_x\"] * (new_eff_x - eff_x)\n        new_block_y = eff_y + p[\"couple_y\"] * (new_eff_y - eff_y)\n        new_block_z = eff_z + p[\"couple_z\"] * (new_eff_z - eff_z)\n    else:\n        new_block_x = block_x\n        new_block_y = block_y\n        new_block_z = block_z\n    \n    new_state[\"effector.x\"] = new_eff_x\n    new_state[\"effector.y\"] = new_eff_y\n    new_state[\"effector.z\"] = new_eff_z\n    new_state[\"block.x\"] = new_block_x\n    new_state[\"block.y\"] = new_block_y\n    new_state[\"block.z\"] = new_block_z\n    new_state[\"goal.x\"] = goal_x\n    new_state[\"goal.y\"] = goal_y\n    new_state[\"goal.z\"] = goal_z\n    \n    return new_state",
