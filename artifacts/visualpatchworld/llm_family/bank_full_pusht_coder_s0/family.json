      "name": "linear_pusher_no_momentum",
      "mechanism": "Agent moves instantaneously to commanded position; block moves only when contacted, with no momentum or rotation.",
      "code": "# HYPOTHESIS: linear_pusher_no_momentum\n# MECHANISM: Agent moves instantaneously to commanded position; block moves only when contacted, with no momentum or rotation.\nPARAMS = {\"agent_gain\": 1.0, \"contact_threshold\": 10.0, \"friction_coeff\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    next_state = {}\n    # Agent moves directly based on action (no velocity integration)\n    next_state[\"agent.x\"] = state[\"agent.x\"] + action[0] * p[\"agent_gain\"]\n    next_state[\"agent.y\"] = state[\"agent.y\"] + action[1] * p[\"agent_gain\"]\n    next_state[\"agent.vx\"] = 0.0\n    next_state[\"agent.vy\"] = 0.0\n\n    # Block only moves if agent is close enough\n    dx_agent_block = state[\"agent.x\"] - state[\"block.x\"]\n    dy_agent_block = state[\"agent.y\"] - state[\"block.y\"]\n    dist = math.sqrt(dx_agent_block**2 + dy_agent_block**2)\n\n    if dist < p[\"contact_threshold\"]:\n        # Move block with agent\n        next_state[\"block.x\"] = state[\"block.x\"] + action[0] * p[\"agent_gain\"] * (1 - p[\"friction_coeff\"])\n        next_state[\"block.y\"] = state[\"block.y\"] + action[1] * p[\"agent_gain\"] * (1 - p[\"friction_coeff\"])\n    else:\n        next_state[\"block.x\"] = state[\"block.x\"]\n        next_state[\"block.y\"] = state[\"block.y\"]\n\n    # Angle does not change\n    next_state[\"block.angle\"] = state[\"block.angle\"]\n    return next_state",
      "init_params": {
        "agent_gain": 1.0,
        "contact_threshold": 10.0,
        "friction_coeff": 0.1
      },
      "repaired": false
    },
    {
      "name": "pusher_with_velocity_and_inertia",
      "mechanism": "Agent accelerates under action force, integrates velocity to get position; block responds via impulses upon contact with damping.",
      "code": "# HYPOTHESIS: pusher_with_velocity_and_inertia\n# MECHANISM: Agent accelerates under action force, integrates velocity to get position; block responds via impulses upon contact with damping.\nPARAMS = {\"agent_mass\": 1.0, \"block_mass\": 2.0, \"dt\": 0.1, \"damping\": 0.05, \"contact_distance\": 15.0}\n\ndef step(state, action, p, meta):\n    import math\n    next_state = {}\n\n    # Update agent: F = ma => v += a*dt; x += v*dt\n    ax_agent = action[0] / p[\"agent_mass\"]\n    ay_agent = action[1] / p[\"agent_mass\"]\n    vx_new = state[\"agent.vx\"] + ax_agent * p[\"dt\"]\n    vy_new = state[\"agent.vy\"] + ay_agent * p[\"dt\"]\n    x_new = state[\"agent.x\"] + vx_new * p[\"dt\"]\n    y_new = state[\"agent.y\"] + vy_new * p[\"dt\"]\n\n    next_state[\"agent.vx\"] = vx_new\n    next_state[\"agent.vy\"] = vy_new\n    next_state[\"agent.x\"] = x_new\n    next_state[\"agent.y\"] = y_new\n\n    # Compute distance between agent and block\n    dx = x_new - state[\"block.x\"]\n    dy = y_new - state[\"block.y\"]\n    dist = math.sqrt(dx*dx + dy*dy)\n\n    # If in contact, apply impulse\n    if dist < p[\"contact_distance\"]:\n        # Simple elastic impulse model: transfer some velocity\n        vbx = state[\"block.x\"] - state[\"block.x\"]  # Assume zero initial block velocity in x\n        vby = state[\"block.y\"] - state[\"block.y\"]  # Same for y\n        dvx = vx_new - vbx\n        dvy = vy_new - vby\n        impulse_scale = 0.5  # Fraction of relative velocity transferred\n        new_bx = state[\"block.x\"] + dvx * impulse_scale * p[\"dt\"]\n        new_by = state[\"block.y\"] + dvy * impulse_scale * p[\"dt\"]\n        next_state[\"block.x\"] = new_bx\n        next_state[\"block.y\"] = new_by\n        # Apply damping to block movement\n        next_state[\"block.x\"] -= (new_bx - state[\"block.x\"]) * p[\"damping\"]\n        next_state[\"block.y\"] -= (new_by - state[\"block.y\"]) * p[\"damping\"]\n    else:\n        next_state[\"block.x\"] = state[\"block.x\"]\n        next_state[\"block.y\"] = state[\"block.y\"]\n\n    # No rotation assumed\n    next_state[\"block.angle\"] = state[\"block.angle\"]\n    return next_state",
      "init_params": {
        "agent_mass": 1.0,
        "block_mass": 2.0,
        "dt": 0.1,
        "damping": 0.05,
        "contact_distance": 15.0
      },
      "repaired": false
