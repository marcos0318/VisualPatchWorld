    {
      "name": "sticky_push_with_coulomb_friction",
      "mechanism": "Agent sticks and drags block when in contact; both slide with Coulomb-type friction resisting motion.",
      "code": "# HYPOTHESIS: sticky_push_with_coulomb_friction\n# MECHANISM: Agent sticks and drags block when in contact; both slide with Coulomb-type friction resisting motion.\nPARAMS = {\"stick_threshold\": 10.0, \"friction_coefficient\": 0.2, \"drag_ratio\": 0.8, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    next_state = {}\n\n    # Agent moves according to action\n    ax = action[0]\n    ay = action[1]\n    vx_new = ax\n    vy_new = ay\n    x_new = state[\"agent.x\"] + vx_new * p[\"dt\"]\n    y_new = state[\"agent.y\"] + vy_new * p[\"dt\"]\n\n    next_state[\"agent.vx\"] = vx_new\n    next_state[\"agent.vy\"] = vy_new\n    next_state[\"agent.x\"] = x_new\n    next_state[\"agent.y\"] = y_new\n\n    # Distance check for sticking\n    dx = x_new - state[\"block.x\"]\n    dy = y_new - state[\"block.y\"]\n    dist = math.sqrt(dx*dx + dy*dy)\n\n    if dist < p[\"stick_threshold\"]:\n        # Move block proportionally\n        dbx = ax * p[\"drag_ratio\"] * p[\"dt\"]\n        dby = ay * p[\"drag_ratio\"] * p[\"dt\"]\n\n        # Friction reduces movement\n        speed = math.sqrt(dbx**2 + dby**2)\n        if speed > 1e-6:\n            friction_factor = max(0.0, 1.0 - p[\"friction_coefficient\"])\n            dbx *= friction_factor\n            dby *= friction_factor\n\n        next_state[\"block.x\"] = state[\"block.x\"] + dbx\n        next_state[\"block.y\"] = state[\"block.y\"] + dby\n        next_state[\"block.angle\"] = state[\"block.angle\"]  # No rotation\n    else:\n        next_state[\"block.x\"] = state[\"block.x\"]\n        next_state[\"block.y\"] = state[\"block.y\"]\n        next_state[\"block.angle\"] = state[\"block.angle\"]\n\n    return next_state",
      "init_params": {
        "stick_threshold": 10.0,
