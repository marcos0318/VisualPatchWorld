    {
      "name": "gated_push_with_angle_response",
      "mechanism": "Action affects agent velocity which integrates to position; block rotates when pushed at specific contact points.",
      "code": "# HYPOTHESIS: gated_push_with_angle_response\n# MECHANISM: Action affects agent velocity which integrates to position; block rotates when pushed at specific contact points.\nPARAMS = {\"agent_accel_gain\": 10.0, \"agent_damping\": 0.1, \"block_inertia\": 0.5, \"contact_radius\": 20.0, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    next_state = {}\n\n    # Agent dynamics: acceleration from action, damped velocity integration\n    ax = action[0] * p[\"agent_accel_gain\"]\n    ay = action[1] * p[\"agent_accel_gain\"]\n    vx_new = (state[\"agent.vx\"] + ax * p[\"dt\"]) * (1 - p[\"agent_damping\"])\n    vy_new = (state[\"agent.vy\"] + ay * p[\"dt\"]) * (1 - p[\"agent_damping\"])\n    x_new = state[\"agent.x\"] + vx_new * p[\"dt\"]\n    y_new = state[\"agent.y\"] + vy_new * p[\"dt\"]\n\n    next_state[\"agent.vx\"] = vx_new\n    next_state[\"agent.vy\"] = vy_new\n    next_state[\"agent.x\"] = x_new\n    next_state[\"agent.y\"] = y_new\n\n    # Check contact condition for block rotation\n    dx = x_new - state[\"block.x\"]\n    dy = y_new - state[\"block.y\"]\n    dist = math.sqrt(dx*dx + dy*dy)\n\n    if dist < p[\"contact_radius\"]:\n        # Torque ~ lever arm \u00d7 force\n        torque = (-dy)*vx_new + (dx)*vy_new  # 2D cross product equivalent\n        delta_angle = torque / p[\"block_inertia\"] * p[\"dt\"]\n        next_state[\"block.angle\"] = state[\"block.angle\"] + delta_angle\n        # Also translate block slightly\n        next_state[\"block.x\"] = state[\"block.x\"] + 0.1 * vx_new * p[\"dt\"]\n        next_state[\"block.y\"] = state[\"block.y\"] + 0.1 * vy_new * p[\"dt\"]\n    else:\n        next_state[\"block.angle\"] = state[\"block.angle\"]\n        next_state[\"block.x\"] = state[\"block.x\"]\n        next_state[\"block.y\"] = state[\"block.y\"]\n\n    return next_state",
      "init_params": {
        "agent_accel_gain": 10.0,
        "agent_damping": 0.1,
        "block_inertia": 0.5,
        "contact_radius": 20.0,
