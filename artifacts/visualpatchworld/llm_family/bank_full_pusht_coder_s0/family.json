    {
      "name": "passive_block_contact_push",
      "mechanism": "Agent has inertia and momentum; block behaves as a passive object that translates and rotates under contact forces.",
      "code": "# HYPOTHESIS: passive_block_contact_push\n# MECHANISM: Agent has inertia and momentum; block behaves as a passive object that translates and rotates under contact forces.\nPARAMS = {\"agent_mass\": 1.0, \"agent_damping\": 0.05, \"block_mass\": 5.0, \"block_inertia\": 2.0, \"dt\": 0.1, \"contact_stiffness\": 100.0}\n\ndef step(state, action, p, meta):\n    import math\n    next_state = {}\n\n    # Agent physics: second order with damping\n    ax = action[0] / p[\"agent_mass\"]\n    ay = action[1] / p[\"agent_mass\"]\n    vx_new = (state[\"agent.vx\"] + ax * p[\"dt\"]) * (1 - p[\"agent_damping\"])\n    vy_new = (state[\"agent.vy\"] + ay * p[\"dt\"]) * (1 - p[\"agent_damping\"])\n    x_new = state[\"agent.x\"] + vx_new * p[\"dt\"]\n    y_new = state[\"agent.y\"] + vy_new * p[\"dt\"]\n\n    next_state[\"agent.vx\"] = vx_new\n    next_state[\"agent.vy\"] = vy_new\n    next_state[\"agent.x\"] = x_new\n    next_state[\"agent.y\"] = y_new\n\n    # Contact force calculation\n    dx = x_new - state[\"block.x\"]\n    dy = y_new - state[\"block.y\"]\n    dist = math.sqrt(dx*dx + dy*dy)\n    if dist < 30.0:  # Assume approximate contact radius\n        # Normalized direction vector\n        nx = dx / (dist + 1e-8)\n        ny = dy / (dist + 1e-8)\n        # Spring-like repulsion/contact force\n        force_mag = p[\"contact_stiffness\"] * (30.0 - dist) / p[\"block_mass\"]\n        fx = nx * force_mag\n        fy = ny * force_mag\n\n        # Update block translation\n        bx_new = state[\"block.x\"] + fx * p[\"dt\"]**2\n        by_new = state[\"block.y\"] + fy * p[\"dt\"]**2\n        next_state[\"block.x\"] = bx_new\n        next_state[\"block.y\"] = by_new\n\n        # Torque = r x F -> rotation effect\n        torque = dx * fy - dy * fx\n        angular_acc = torque / p[\"block_inertia\"]\n        delta_angle = angular_acc * p[\"dt\"]**2\n        next_state[\"block.angle\"] = state[\"block.angle\"] + delta_angle\n    else:\n        next_state[\"block.x\"] = state[\"block.x\"]\n        next_state[\"block.y\"] = state[\"block.y\"]\n        next_state[\"block.angle\"] = state[\"block.angle\"]\n\n    return next_state",
