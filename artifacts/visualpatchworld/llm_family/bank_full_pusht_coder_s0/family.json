      "mechanism": "Baseline where agent performs noisy random walk independent of actions; block remains static.",
      "code": "# HYPOTHESIS: baseline_random_walk\n# MECHANISM: Baseline where agent performs noisy random walk independent of actions; block remains static.\nPARAMS = {\"noise_level\": 0.0}  # To be fitted to represent residual randomness\n\ndef step(state, action, p, meta):\n    import math\n    import random\n    next_state = {}\n\n    # Random walk regardless of action\n    noise_x = (random.random() - 0.5) * p[\"noise_level\"]\n    noise_y = (random.random() - 0.5) * p[\"noise_level\"]\n\n    next_state[\"agent.x\"] = state[\"agent.x\"] + noise_x\n    next_state[\"agent.y\"] = state[\"agent.y\"] + noise_y\n    next_state[\"agent.vx\"] = 0.0\n    next_state[\"agent.vy\"] = 0.0\n\n    # Block doesn't move\n    next_state[\"block.x\"] = state[\"block.x\"]\n    next_state[\"block.y\"] = state[\"block.y\"]\n    next_state[\"block.angle\"] = state[\"block.angle\"]\n\n    return next_state",
