    {
      "name": "kinematic_agent_static_block",
      "mechanism": "Agent velocity is directly set by action scaled by gain; position integrates velocity; block is static.",
      "code": "# HYPOTHESIS: kinematic_agent_static_block\n# MECHANISM: Agent velocity is directly set by action scaled by gain; position integrates velocity; block is static.\nPARAMS = {\"vel_gain\": 370.0, \"dt\": 0.11}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    \n    # Agent dynamics: Kinematic velocity control\n    new_vx = ax * p[\"vel_gain\"]\n    new_vy = ay * p[\"vel_gain\"]\n    new_x = s[\"agent.x\"] + new_vx * p[\"dt\"]\n    new_y = s[\"agent.y\"] + new_vy * p[\"dt\"]\n    \n    # Block dynamics: Static\n    new_bx = s[\"block.x\"]\n    new_by = s[\"block.y\"]\n    new_bangle = s[\"block.angle\"]\n    \n    return {\n        \"agent.vx\": new_vx, \"agent.vy\": new_vy, \"agent.x\": new_x, \"agent.y\": new_y,\n        \"block.x\": new_bx, \"block.y\": new_by, \"block.angle\": new_bangle\n    }",
      "init_params": {
        "vel_gain": 370.0,
        "dt": 0.11
      },
      "repaired": false
    },
    {
      "name": "kinematic_agent_geometric_push",
      "mechanism": "Agent moves kinematically; if overlapping block, block position is corrected to resolve penetration.",
      "code": "# HYPOTHESIS: kinematic_agent_geometric_push\n# MECHANISM: Agent moves kinematically; if overlapping block, block position is corrected to resolve penetration.\nPARAMS = {\"vel_gain\": 370.0, \"dt\": 0.11, \"agent_radius\": 15.0, \"block_radius\": 25.0}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    \n    # Agent dynamics\n    new_vx = ax * p[\"vel_gain\"]\n    new_vy = ay * p[\"vel_gain\"]\n    new_x = s[\"agent.x\"] + new_vx * p[\"dt\"]\n    new_y = s[\"agent.y\"] + new_vy * p[\"dt\"]\n    \n    # Block dynamics: Geometric collision resolution\n    dx = new_x - s[\"block.x\"]\n    dy = new_y - s[\"block.y\"]\n    dist = math.sqrt(dx*dx + dy*dy)\n    min_dist = p[\"agent_radius\"] + p[\"block_radius\"]\n    \n    new_bx = s[\"block.x\"]\n    new_by = s[\"block.y\"]\n    new_bangle = s[\"block.angle\"]\n    \n    if dist < min_dist and dist > 1e-6:\n        overlap = min_dist - dist\n        nx = dx / dist\n        ny = dy / dist\n        # Push block away from agent\n        new_bx += nx * overlap\n        new_by += ny * overlap\n        # Simple angle update based on push direction (heuristic)\n        new_bangle += overlap * 0.01\n        \n    return {\n        \"agent.vx\": new_vx, \"agent.vy\": new_vy, \"agent.x\": new_x, \"agent.y\": new_y,\n        \"block.x\": new_bx, \"block.y\": new_by, \"block.angle\": new_bangle\n    }",
      "init_params": {
        "vel_gain": 370.0,
        "dt": 0.11,
        "agent_radius": 15.0,
        "block_radius": 25.0
      },
      "repaired": false
    },
    {
      "name": "kinematic_agent_sticky_block",
      "mechanism": "Agent moves kinematically; if close, block velocity couples to agent velocity (sticky contact).",
      "code": "# HYPOTHESIS: kinematic_agent_sticky_block\n# MECHANISM: Agent moves kinematically; if close, block velocity couples to agent velocity (sticky contact).\nPARAMS = {\"vel_gain\": 370.0, \"dt\": 0.11, \"couple_dist\": 40.0, \"couple_gain\": 0.5}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    \n    # Agent dynamics\n    new_vx = ax * p[\"vel_gain\"]\n    new_vy = ay * p[\"vel_gain\"]\n    new_x = s[\"agent.x\"] + new_vx * p[\"dt\"]\n    new_y = s[\"agent.y\"] + new_vy * p[\"dt\"]\n    \n    # Block dynamics: Velocity coupling\n    dx = new_x - s[\"block.x\"]\n    dy = new_y - s[\"block.y\"]\n    dist = math.sqrt(dx*dx + dy*dy)\n    \n    new_bx = s[\"block.x\"]\n    new_by = s[\"block.y\"]\n    new_bangle = s[\"block.angle\"]\n    \n    if dist < p[\"couple_dist\"]:\n        # Block moves with agent\n        new_bx += new_vx * p[\"dt\"] * p[\"couple_gain\"]\n        new_by += new_vy * p[\"dt\"] * p[\"couple_gain\"]\n        # Rotate block slightly based on lateral motion\n        new_bangle += (new_vx * dy - new_vy * dx) * 0.0001\n        \n    return {\n        \"agent.vx\": new_vx, \"agent.vy\": new_vy, \"agent.x\": new_x, \"agent.y\": new_y,\n        \"block.x\": new_bx, \"block.y\": new_by, \"block.angle\": new_bangle\n    }",
      "init_params": {
        "vel_gain": 370.0,
        "dt": 0.11,
        "couple_dist": 40.0,
        "couple_gain": 0.5
      },
      "repaired": false
    },
    {
      "name": "dynamic_agent_force_control",
      "mechanism": "Action represents force; agent velocity updates via acceleration (Newtonian); block is static.",
      "code": "# HYPOTHESIS: dynamic_agent_force_control\n# MECHANISM: Action represents force; agent velocity updates via acceleration (Newtonian); block is static.\nPARAMS = {\"force_gain\": 40.0, \"mass\": 1.0, \"dt\": 0.11, \"drag\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    \n    # Agent dynamics: Newtonian with drag\n    force_x = ax * p[\"force_gain\"]\n    force_y = ay * p[\"force_gain\"]\n    \n    # Drag force\n    drag_x = -p[\"drag\"] * s[\"agent.vx\"]\n    drag_y = -p[\"drag\"] * s[\"agent.vy\"]\n    \n    acc_x = (force_x + drag_x) / p[\"mass\"]\n    acc_y = (force_y + drag_y) / p[\"mass\"]\n    \n    new_vx = s[\"agent.vx\"] + acc_x * p[\"dt\"]\n    new_vy = s[\"agent.vy\"] + acc_y * p[\"dt\"]\n    new_x = s[\"agent.x\"] + new_vx * p[\"dt\"]\n    new_y = s[\"agent.y\"] + new_vy * p[\"dt\"]\n    \n    # Block static\n    new_bx = s[\"block.x\"]\n    new_by = s[\"block.y\"]\n    new_bangle = s[\"block.angle\"]\n    \n    return {\n        \"agent.vx\": new_vx, \"agent.vy\": new_vy, \"agent.x\": new_x, \"agent.y\": new_y,\n        \"block.x\": new_bx, \"block.y\": new_by, \"block.angle\": new_bangle\n    }",
      "init_params": {
        "force_gain": 40.0,
        "mass": 1.0,
        "dt": 0.11,
        "drag": 0.1
      },
      "repaired": false
    },
    {
      "name": "velocity_lag_agent",
      "mechanism": "Agent velocity tracks action target with first-order lag (smoothing); block is static.",
      "code": "# HYPOTHESIS: velocity_lag_agent\n# MECHANISM: Agent velocity tracks action target with first-order lag (smoothing); block is static.\nPARAMS = {\"vel_gain\": 370.0, \"dt\": 0.11, \"lag\": 0.2}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    \n    # Agent dynamics: First order lag\n    target_vx = ax * p[\"vel_gain\"]\n    target_vy = ay * p[\"vel_gain\"]\n    \n    new_vx = s[\"agent.vx\"] + p[\"lag\"] * (target_vx - s[\"agent.vx\"])\n    new_vy = s[\"agent.vy\"] + p[\"lag\"] * (target_vy - s[\"agent.vy\"])\n    \n    new_x = s[\"agent.x\"] + new_vx * p[\"dt\"]\n    new_y = s[\"agent.y\"] + new_vy * p[\"dt\"]\n    \n    # Block static\n    new_bx = s[\"block.x\"]\n    new_by = s[\"block.y\"]\n    new_bangle = s[\"block.angle\"]\n    \n    return {\n        \"agent.vx\": new_vx, \"agent.vy\": new_vy, \"agent.x\": new_x, \"agent.y\": new_y,\n        \"block.x\": new_bx, \"block.y\": new_by, \"block.angle\": new_bangle\n    }",
      "init_params": {
        "vel_gain": 370.0,
        "dt": 0.11,
        "lag": 0.2
      },
      "repaired": false
    },
    {
      "name": "contact_gated_block_motion",
      "mechanism": "Block moves only if agent is close and moving towards it (directional gating); includes angular torque.",
      "code": "# HYPOTHESIS: contact_gated_block_motion\n# MECHANISM: Block moves only if agent is close and moving towards it (directional gating); includes angular torque.\nPARAMS = {\"vel_gain\": 370.0, \"dt\": 0.11, \"push_dist\": 50.0, \"push_gain\": 0.1, \"torque_gain\": 0.05}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    \n    # Agent dynamics: Kinematic\n    new_vx = ax * p[\"vel_gain\"]\n    new_vy = ay * p[\"vel_gain\"]\n    new_x = s[\"agent.x\"] + new_vx * p[\"dt\"]\n    new_y = s[\"agent.y\"] + new_vy * p[\"dt\"]\n    \n    # Block dynamics: Contact gated\n    dx = s[\"block.x\"] - s[\"agent.x\"]\n    dy = s[\"block.y\"] - s[\"agent.y\"]\n    dist = math.sqrt(dx*dx + dy*dy)\n    \n    new_bx = s[\"block.x\"]\n    new_by = s[\"block.y\"]\n    new_bangle = s[\"block.angle\"]\n    \n    if dist < p[\"push_dist\"] and dist > 1e-6:\n        # Normal vector from agent to block\n        nx = dx / dist\n        ny = dy / dist\n        \n        # Relative velocity along normal\n        rel_vel = new_vx * nx + new_vy * ny\n        \n        if rel_vel > 0:\n            # Push block\n            new_bx += nx * rel_vel * p[\"push_gain\"] * p[\"dt\"]\n            new_by += ny * rel_vel * p[\"push_gain\"] * p[\"dt\"]\n            # Torque based on tangential component\n            tan_vel = -new_vx * ny + new_vy * nx\n            new_bangle += tan_vel * p[\"torque_gain\"] * p[\"dt\"]\n            \n    return {\n        \"agent.vx\": new_vx, \"agent.vy\": new_vy, \"agent.x\": new_x, \"agent.y\": new_y,\n        \"block.x\": new_bx, \"block.y\": new_by, \"block.angle\": new_bangle\n    }",
      "init_params": {
        "vel_gain": 370.0,
        "dt": 0.11,
        "push_dist": 50.0,
        "push_gain": 0.1,
        "torque_gain": 0.05
      },
      "repaired": false
    }
