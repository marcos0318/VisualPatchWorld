    {
      "name": "linear_joint_control",
      "mechanism": "Actions directly control joint angles with linear mapping; finger position computed via forward kinematics.",
      "code": "# HYPOTHESIS: linear_joint_control\n# MECHANISM: Actions directly control joint angles with linear mapping; finger position computed via forward kinematics.\nPARAMS = {\"link1_length\": 1.0, \"link2_length\": 1.0, \"dt\": 0.01}\n\ndef step(state, action, p, meta):\n    import math\n    \n    # Update joint angles based on actions\n    new_arm_x = state[\"arm.x\"] + action[0] * p[\"dt\"]\n    new_arm_y = state[\"arm.y\"] + action[1] * p[\"dt\"]\n    \n    # Forward kinematics: compute finger position from joint angles\n    # Simplified 2-link planar arm\n    l1, l2 = p[\"link1_length\"], p[\"link2_length\"]\n    angle1, angle2 = new_arm_x, new_arm_y\n    \n    # Position of end effector\n    finger_x = l1 * math.cos(angle1) + l2 * math.cos(angle1 + angle2)\n    finger_y = l1 * math.sin(angle1) + l2 * math.sin(angle1 + angle2)\n    \n    return {\n        \"arm.x\": new_arm_x,\n        \"arm.y\": new_arm_y,\n        \"finger.x\": finger_x,\n        \"finger.y\": finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "link1_length": 1.0,
        "link2_length": 1.0,
        "dt": 0.01
      },
      "repaired": false
    },
    {
      "name": "momentum_arm_with_damping",
      "mechanism": "Arm has momentum and responds to actions as forces; includes velocity damping.",
      "code": "# HYPOTHESIS: momentum_arm_with_damping\n# MECHANISM: Arm has momentum and responds to actions as forces; includes velocity damping.\nPARAMS = {\"mass\": 1.0, \"damping\": 0.1, \"dt\": 0.01}\n\ndef step(state, action, p, meta):\n    import math\n    \n    # Assume state contains velocities (we'll infer them)\n    # For now treat previous action as proxy for velocity if needed\n    # Here we assume velocities are implicitly part of the state\n    \n    # Apply force as action, integrate with mass\n    acc_x = action[0] / p[\"mass\"]\n    acc_y = action[1] / p[\"mass\"]\n    \n    # First order integration with damping\n    # v_new = (v_old + a*dt) * exp(-damping*dt)\n    # This is approximate form combining integration and damping\n    \n    # We don't have explicit vx/vy, so we simulate their effect on position\n    # Using simplified model where change in position is damped version of action\n    damp_factor = math.exp(-p[\"damping\"] * p[\"dt\"])\n    \n    dx = action[0] * p[\"dt\"] * p[\"dt\"] * 0.5  # Simplified acceleration integration\n    dy = action[1] * p[\"dt\"] * p[\"dt\"] * 0.5\n    \n    new_arm_x = state[\"arm.x\"] + dx\n    new_arm_y = state[\"arm.y\"] + dy\n    \n    # Recompute finger using FK (assuming fixed link lengths)\n    # Placeholder values since they're not given\n    import math\n    l1, l2 = 1.0, 1.0\n    angle1, angle2 = new_arm_x, new_arm_y\n    finger_x = l1 * math.cos(angle1) + l2 * math.cos(angle1 + angle2)\n    finger_y = l1 * math.sin(angle1) + l2 * math.sin(angle1 + angle2)\n    \n    return {\n        \"arm.x\": new_arm_x,\n        \"arm.y\": new_arm_y,\n        \"finger.x\": finger_x,\n        \"finger.y\": finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "mass": 1.0,
        "damping": 0.1,
        "dt": 0.01
      },
      "repaired": false
    },
    {
      "name": "direct_end_effector_control",
      "mechanism": "Actions directly control finger/end-effector position through integration; arm state is ignored.",
      "code": "# HYPOTHESIS: direct_end_effector_control\n# MECHANISM: Actions directly control finger/end-effector position through integration; arm state is ignored.\nPARAMS = {\"speed_gain\": 1.0, \"dt\": 0.01}\n\ndef step(state, action, p, meta):\n    # Direct velocity control of finger\n    dx = action[0] * p[\"speed_gain\"] * p[\"dt\"]\n    dy = action[1] * p[\"speed_gain\"] * p[\"dt\"]\n    \n    new_finger_x = state[\"finger.x\"] + dx\n    new_finger_y = state[\"finger.y\"] + dy\n    \n    # Arm state is not changed meaningfully - just carried forward\n    # This models a system where the controller directly commands the end effector\n    \n    return {\n        \"arm.x\": state[\"arm.x\"],\n        \"arm.y\": state[\"arm.y\"],\n        \"finger.x\": new_finger_x,\n        \"finger.y\": new_finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "speed_gain": 1.0,
        "dt": 0.01
      },
      "repaired": false
    },
    {
      "name": "proportional_control_to_target",
      "mechanism": "System autonomously moves finger towards target with action providing modulation or additional drive.",
      "code": "# HYPOTHESIS: proportional_control_to_target\n# MECHANISM: System autonomously moves finger towards target with action providing modulation or additional drive.\nPARAMS = {\"kp\": 1.0, \"modulation_gain\": 0.1, \"dt\": 0.01}\n\ndef step(state, action, p, meta):\n    import math\n    \n    # Compute desired velocity toward target\n    dx_to_target = state[\"target.x\"] - state[\"finger.x\"]\n    dy_to_target = state[\"target.y\"] - state[\"finger.y\"]\n    \n    # Proportional control law\n    vx_desired = p[\"kp\"] * dx_to_target\n    vy_desired = p[\"kp\"] * dy_to_target\n    \n    # Action modulates this behavior\n    vx_final = vx_desired + action[0] * p[\"modulation_gain\"]\n    vy_final = vy_desired + action[1] * p[\"modulation_gain\"]\n    \n    # Integrate velocity to get new position\n    new_finger_x = state[\"finger.x\"] + vx_final * p[\"dt\"]\n    new_finger_y = state[\"finger.y\"] + vy_final * p[\"dt\"]\n    \n    # Arm state updated via inverse kinematics or ignored\n    # Here we ignore it for simplicity\n    new_arm_x = state[\"arm.x\"]\n    new_arm_y = state[\"arm.y\"]\n    \n    return {\n        \"arm.x\": new_arm_x,\n        \"arm.y\": new_arm_y,\n        \"finger.x\": new_finger_x,\n        \"finger.y\": new_finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "kp": 1.0,
        "modulation_gain": 0.1,
        "dt": 0.01
      },
      "repaired": false
    },
    {
      "name": "gated_action_effect",
      "mechanism": "Action only affects the system when arm/finger configuration allows it (gated).",
      "code": "# HYPOTHESIS: gated_action_effect\n# MECHANISM: Action only affects the system when arm/finger configuration allows it (gated).\nPARAMS = {\"gate_threshold\": 0.5, \"effect_scale\": 1.0, \"dt\": 0.01}\n\ndef step(state, action, p, meta):\n    import math\n    \n    # Gate opens when arm is near some configuration\n    # E.g., when angle magnitude is below threshold\n    arm_mag = math.sqrt(state[\"arm.x\"]**2 + state[\"arm.y\"]**2)\n    \n    dx, dy = 0.0, 0.0\n    if arm_mag < p[\"gate_threshold\"]:\n        dx = action[0] * p[\"effect_scale\"] * p[\"dt\"]\n        dy = action[1] * p[\"effect_scale\"] * p[\"dt\"]\n    \n    # Apply conditional change\n    new_arm_x = state[\"arm.x\"] + dx\n    new_arm_y = state[\"arm.y\"] + dy\n    \n    # Finger recomputed via FK\n    l1, l2 = 1.0, 1.0\n    angle1, angle2 = new_arm_x, new_arm_y\n    finger_x = l1 * math.cos(angle1) + l2 * math.cos(angle1 + angle2)\n    finger_y = l1 * math.sin(angle1) + l2 * math.sin(angle1 + angle2)\n    \n    return {\n        \"arm.x\": new_arm_x,\n        \"arm.y\": new_arm_y,\n        \"finger.x\": finger_x,\n        \"finger.y\": finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "gate_threshold": 0.5,
        "effect_scale": 1.0,
        "dt": 0.01
      },
      "repaired": false
    },
    {
      "name": "coupled_oscillator_dynamics",
      "mechanism": "Arm and finger exhibit coupled oscillatory behavior with action as driving force.",
      "code": "# HYPOTHESIS: coupled_oscillator_dynamics\n# MECHANISM: Arm and finger exhibit coupled oscillatory behavior with action as driving force.\nPARAMS = {\"omega_arm\": 1.0, \"coupling_strength\": 0.5, \"drive_gain\": 1.0, \"dt\": 0.01}\n\ndef step(state, action, p, meta):\n    import math\n    \n    # Simplified coupled oscillator model\n    # Representing joint angles as phases of oscillators\n    \n    # d\u00b2\u03b8\u2081/dt\u00b2 = -\u03c9\u2081\u00b2\u03b8\u2081 + k(\u03b8\u2082-\u03b8\u2081) + u\u2081\n    # d\u00b2\u03b8\u2082/dt\u00b2 = -\u03c9\u2082\u00b2\u03b8\u2082 + k(\u03b8\u2081-\u03b8\u2082) + u\u2082\n    \n    # Approximate with first-order difference equations\n    # \u03b8\u2081_new \u2248 \u03b8\u2081 + (-\u03c9\u2081\u00b2\u03b8\u2081 + k(\u03b8\u2082-\u03b8\u2081) + u\u2081)*dt\n    # But we simplify further assuming harmonic response\n    \n    # Effective frequencies modified by coupling\n    freq1 = p[\"omega_arm\"]\n    freq2 = p[\"omega_arm\"] + p[\"coupling_strength\"]\n    \n    # Phase advance\n    phase1 = state[\"arm.x\"] + freq1 * p[\"dt\"] + action[0] * p[\"drive_gain\"] * p[\"dt\"]\n    phase2 = state[\"arm.y\"] + freq2 * p[\"dt\"] + action[1] * p[\"drive_gain\"] * p[\"dt\"]\n    \n    # Forward kinematics to get finger\n    l1, l2 = 1.0, 1.0\n    finger_x = l1 * math.cos(phase1) + l2 * math.cos(phase1 + phase2)\n    finger_y = l1 * math.sin(phase1) + l2 * math.sin(phase1 + phase2)\n    \n    return {\n        \"arm.x\": phase1,\n        \"arm.y\": phase2,\n        \"finger.x\": finger_x,\n        \"finger.y\": finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "omega_arm": 1.0,
        "coupling_strength": 0.5,
        "drive_gain": 1.0,
        "dt": 0.01
      },
      "repaired": false
    }
