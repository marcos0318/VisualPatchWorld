      "name": "independent_linear_velocity",
      "mechanism": "Action directly adds to position/angle of all objects with independent linear gains.",
      "code": "# HYPOTHESIS: independent_linear_velocity\n# MECHANISM: Action directly adds to position/angle of all objects with independent linear gains.\nPARAMS = {\"arm_gain_x\": 0.1, \"arm_gain_y\": 0.1, \"finger_gain_x\": 0.01, \"finger_gain_y\": 0.01}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    \n    s[\"arm.x\"] = state[\"arm.x\"] + p[\"arm_gain_x\"] * ax\n    s[\"arm.y\"] = state[\"arm.y\"] + p[\"arm_gain_y\"] * ay\n    s[\"finger.x\"] = state[\"finger.x\"] + p[\"finger_gain_x\"] * ax\n    s[\"finger.y\"] = state[\"finger.y\"] + p[\"finger_gain_y\"] * ay\n    s[\"target.x\"] = state[\"target.x\"]\n    s[\"target.y\"] = state[\"target.y\"]\n    return s",
      "init_params": {
        "arm_gain_x": 0.1,
        "arm_gain_y": 0.1,
        "finger_gain_x": 0.01,
        "finger_gain_y": 0.01
      },
      "repaired": false
    },
    {
      "name": "kinematic_chain_fk",
      "mechanism": "Arm fields are joint angles; finger position is deterministically computed via forward kinematics.",
      "code": "# HYPOTHESIS: kinematic_chain_fk\n# MECHANISM: Arm fields are joint angles; finger position is deterministically computed via forward kinematics.\nPARAMS = {\"link_len_1\": 0.12, \"link_len_2\": 0.12, \"arm_gain_1\": 0.1, \"arm_gain_2\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    \n    a1 = state[\"arm.x\"] + p[\"arm_gain_1\"] * ax\n    a2 = state[\"arm.y\"] + p[\"arm_gain_2\"] * ay\n    \n    s[\"arm.x\"] = a1\n    s[\"arm.y\"] = a2\n    \n    l1 = p[\"link_len_1\"]\n    l2 = p[\"link_len_2\"]\n    s[\"finger.x\"] = l1 * math.cos(a1) + l2 * math.cos(a1 + a2)\n    s[\"finger.y\"] = l1 * math.sin(a1) + l2 * math.sin(a1 + a2)\n    \n    s[\"target.x\"] = state[\"target.x\"]\n    s[\"target.y\"] = state[\"target.y\"]\n    return s",
      "init_params": {
        "link_len_1": 0.12,
        "link_len_2": 0.12,
        "arm_gain_1": 0.1,
        "arm_gain_2": 0.1
      },
      "repaired": false
    },
    {
      "name": "saturating_tanh_response",
      "mechanism": "Action-to-velocity mapping saturates nonlinearly at high magnitudes.",
      "code": "# HYPOTHESIS: saturating_tanh_response\n# MECHANISM: Action-to-velocity mapping saturates nonlinearly at high magnitudes.\nPARAMS = {\"max_speed_arm\": 0.5, \"max_speed_finger\": 0.05, \"steepness\": 2.0}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    \n    def saturated_move(current, act, max_sp, steep):\n        vel = max_sp * math.tanh(steep * act)\n        return current + vel\n        \n    s[\"arm.x\"] = saturated_move(state[\"arm.x\"], ax, p[\"max_speed_arm\"], p[\"steepness\"])\n    s[\"arm.y\"] = saturated_move(state[\"arm.y\"], ay, p[\"max_speed_arm\"], p[\"steepness\"])\n    s[\"finger.x\"] = saturated_move(state[\"finger.x\"], ax, p[\"max_speed_finger\"], p[\"steepness\"])\n    s[\"finger.y\"] = saturated_move(state[\"finger.y\"], ay, p[\"max_speed_finger\"], p[\"steepness\"])\n    \n    s[\"target.x\"] = state[\"target.x\"]\n    s[\"target.y\"] = state[\"target.y\"]\n    return s",
      "init_params": {
        "max_speed_arm": 0.5,
        "max_speed_finger": 0.05,
        "steepness": 2.0
      },
      "repaired": false
    },
    {
      "name": "jacobian_modulated_gain",
      "mechanism": "Finger movement gain is modulated by arm configuration (simulating kinematic leverage).",
      "code": "# HYPOTHESIS: jacobian_modulated_gain\n# MECHANISM: Finger movement gain is modulated by arm configuration (simulating kinematic leverage).\nPARAMS = {\"arm_gain\": 0.1, \"finger_base_gain\": 0.01, \"finger_mod_gain\": 0.01}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    \n    s[\"arm.x\"] = state[\"arm.x\"] + p[\"arm_gain\"] * ax\n    s[\"arm.y\"] = state[\"arm.y\"] + p[\"arm_gain\"] * ay\n    \n    config_factor = 1.0 + 0.5 * math.cos(state[\"arm.x\"]) \n    eff_gain = p[\"finger_base_gain\"] + p[\"finger_mod_gain\"] * config_factor\n    \n    s[\"finger.x\"] = state[\"finger.x\"] + eff_gain * ax\n    s[\"finger.y\"] = state[\"finger.y\"] + eff_gain * ay\n    \n    s[\"target.x\"] = state[\"target.x\"]\n    s[\"target.y\"] = state[\"target.y\"]\n    return s",
      "init_params": {
        "arm_gain": 0.1,
        "finger_base_gain": 0.01,
        "finger_mod_gain": 0.01
      },
      "repaired": false
    },
    {
      "name": "hard_clamped_bounds",
      "mechanism": "State variables are hard-clamped to physical limits after every update.",
      "code": "# HYPOTHESIS: hard_clamped_bounds\n# MECHANISM: State variables are hard-clamped to physical limits after every update.\nPARAMS = {\"arm_min\": -5.0, \"arm_max\": 5.0, \"finger_min\": -0.25, \"finger_max\": 0.25, \"arm_gain\": 0.1, \"finger_ratio\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    \n    def clamp(val, lo, hi):\n        if val < lo: return lo\n        if val > hi: return hi\n        return val\n        \n    s[\"arm.x\"] = clamp(state[\"arm.x\"] + p[\"arm_gain\"] * ax, p[\"arm_min\"], p[\"arm_max\"])\n    s[\"arm.y\"] = clamp(state[\"arm.y\"] + p[\"arm_gain\"] * ay, p[\"arm_min\"], p[\"arm_max\"])\n    \n    f_gain = p[\"arm_gain\"] * p[\"finger_ratio\"]\n    s[\"finger.x\"] = clamp(state[\"finger.x\"] + f_gain * ax, p[\"finger_min\"], p[\"finger_max\"])\n    s[\"finger.y\"] = clamp(state[\"finger.y\"] + f_gain * ay, p[\"finger_min\"], p[\"finger_max\"])\n    \n    s[\"target.x\"] = state[\"target.x\"]\n    s[\"target.y\"] = state[\"target.y\"]\n    return s",
      "init_params": {
        "arm_min": -5.0,
        "arm_max": 5.0,
        "finger_min": -0.25,
        "finger_max": 0.25,
        "arm_gain": 0.1,
        "finger_ratio": 0.1
      },
      "repaired": false
    },
    {
      "name": "static_friction_deadzone",
      "mechanism": "Action must exceed a threshold to overcome static friction; otherwise no movement.",
      "code": "# HYPOTHESIS: static_friction_deadzone\n# MECHANISM: Action must exceed a threshold to overcome static friction; otherwise no movement.\nPARAMS = {\"deadzone\": 0.1, \"arm_gain\": 0.1, \"finger_gain\": 0.01}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    \n    def apply_deadzone(a, thresh):\n        if abs(a) < thresh:\n            return 0.0\n        return a\n        \n    dx_arm = apply_deadzone(ax, p[\"deadzone\"])\n    dy_arm = apply_deadzone(ay, p[\"deadzone\"])\n    \n    s[\"arm.x\"] = state[\"arm.x\"] + p[\"arm_gain\"] * dx_arm\n    s[\"arm.y\"] = state[\"arm.y\"] + p[\"arm_gain\"] * dy_arm\n    s[\"finger.x\"] = state[\"finger.x\"] + p[\"finger_gain\"] * dx_arm\n    s[\"finger.y\"] = state[\"finger.y\"] + p[\"finger_gain\"] * dy_arm\n    \n    s[\"target.x\"] = state[\"target.x\"]\n    s[\"target.y\"] = state[\"target.y\"]\n    return s",
      "init_params": {
        "deadzone": 0.1,
        "arm_gain": 0.1,
        "finger_gain": 0.01
      },
      "repaired": false
    }
