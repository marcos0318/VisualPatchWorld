      "name": "linear_direct_control",
      "mechanism": "Actions directly change agent position with linear response and no momentum",
      "code": "# HYPOTHESIS: linear_direct_control\n# MECHANISM: Actions directly change agent position with linear response and no momentum\nPARAMS = {\"gain_x\": 1.0, \"gain_y\": 1.0}\n\ndef step(state, action, p, meta):\n    next_state = {}\n    next_state[\"agent.x\"] = state[\"agent.x\"] + action[0] * p[\"gain_x\"]\n    next_state[\"agent.y\"] = state[\"agent.y\"] + action[1] * p[\"gain_y\"]\n    next_state[\"target.x\"] = state[\"target.x\"]  # Target is static\n    next_state[\"target.y\"] = state[\"target.y\"]\n    return next_state",
      "init_params": {
        "gain_x": 1.0,
        "gain_y": 1.0
      },
      "repaired": false
    },
    {
      "name": "first_order_dynamics",
      "mechanism": "Agent accelerates in response to action with velocity damping",
      "code": "# HYPOTHESIS: first_order_dynamics\n# MECHANISM: Agent accelerates in response to action with velocity damping\nPARAMS = {\"acc_gain\": 50.0, \"damping\": 0.8}\n\ndef step(state, action, p, meta):\n    new_state = {}\n    \n    # Compute acceleration from action\n    ax = action[0] * p[\"acc_gain\"]\n    ay = action[1] * p[\"acc_gain\"]\n    \n    # Update velocities with damping\n    new_vx = (state.get(\"agent.vx\", 0.0) + ax) * p[\"damping\"]\n    new_vy = (state.get(\"agent.vy\", 0.0) + ay) * p[\"damping\"]\n    \n    # Update positions\n    new_state[\"agent.x\"] = state[\"agent.x\"] + new_vx\n    new_state[\"agent.y\"] = state[\"agent.y\"] + new_vy\n    new_state[\"agent.vx\"] = new_vx\n    new_state[\"agent.vy\"] = new_vy\n    \n    # Target remains static\n    new_state[\"target.x\"] = state[\"target.x\"]\n    new_state[\"target.y\"] = state[\"target.y\"]\n    \n    return new_state",
      "init_params": {
        "acc_gain": 50.0,
        "damping": 0.8
      },
      "repaired": false
    },
    {
      "name": "second_order_momentum",
      "mechanism": "Agent has mass and inertia; actions apply forces with full momentum integration",
      "code": "# HYPOTHESIS: second_order_momentum\n# MECHANISM: Agent has mass and inertia; actions apply forces with full momentum integration\nPARAMS = {\"force_gain\": 100.0, \"mass\": 1.0, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    new_state = {}\n    \n    # Get current state (default to zero if missing)\n    vx = state.get(\"agent.vx\", 0.0)\n    vy = state.get(\"agent.vy\", 0.0)\n    \n    # Apply force from action\n    fx = action[0] * p[\"force_gain\"]\n    fy = action[1] * p[\"force_gain\"]\n    \n    # Newton's second law: F = ma => a = F/m\n    ax = fx / p[\"mass\"]\n    ay = fy / p[\"mass\"]\n    \n    # Integrate acceleration to get new velocity\n    new_vx = vx + ax * p[\"dt\"]\n    new_vy = vy + ay * p[\"dt\"]\n    \n    # Integrate velocity to get new position\n    new_state[\"agent.x\"] = state[\"agent.x\"] + new_vx * p[\"dt\"]\n    new_state[\"agent.y\"] = state[\"agent.y\"] + new_vy * p[\"dt\"]\n    new_state[\"agent.vx\"] = new_vx\n    new_state[\"agent.vy\"] = new_vy\n    \n    # Target remains static\n    new_state[\"target.x\"] = state[\"target.x\"]\n    new_state[\"target.y\"] = state[\"target.y\"]\n    \n    return new_state",
      "init_params": {
        "force_gain": 100.0,
        "mass": 1.0,
        "dt": 0.1
      },
      "repaired": false
    },
    {
      "name": "gated_door_passage",
      "mechanism": "Agent moves with first-order dynamics but is blocked by door unless passing through opening",
      "code": "# HYPOTHESIS: gated_door_passage\n# MECHANISM: Agent moves with first-order dynamics but is blocked by door unless passing through opening\nPARAMS = {\"acc_gain\": 50.0, \"damping\": 0.8, \"door_width\": 10.0}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = {}\n    \n    # Compute acceleration from action\n    ax = action[0] * p[\"acc_gain\"]\n    ay = action[1] * p[\"acc_gain\"]\n    \n    # Update velocities with damping\n    new_vx = (state.get(\"agent.vx\", 0.0) + ax) * p[\"damping\"]\n    new_vy = (state.get(\"agent.vy\", 0.0) + ay) * p[\"damping\"]\n    \n    # Tentative new position\n    tentative_x = state[\"agent.x\"] + new_vx\n    tentative_y = state[\"agent.y\"] + new_vy\n    \n    # Check for door constraint (assuming vertical door at x=112.0 from metadata)\n    door_x = meta.get(\"door_coords\", [112.0])[0]\n    door_passable = abs(tentative_y - 49.0) < p[\"door_width\"]/2 if len(meta.get(\"door_coords\", [])) > 1 else True\n    \n    # Allow movement only if not blocked by door\n    if abs(tentative_x - door_x) < 2.0 and not door_passable:\n        new_vx = 0.0\n        tentative_x = state[\"agent.x\"]\n    \n    # Update final state\n    new_state[\"agent.x\"] = tentative_x\n    new_state[\"agent.y\"] = tentative_y\n    new_state[\"agent.vx\"] = new_vx\n    new_state[\"agent.vy\"] = new_vy\n    \n    # Target remains static\n    new_state[\"target.x\"] = state[\"target.x\"]\n    new_state[\"target.y\"] = state[\"target.y\"]\n    \n    return new_state",
      "init_params": {
        "acc_gain": 50.0,
        "damping": 0.8,
        "door_width": 10.0
      },
      "repaired": false
    },
    {
      "name": "attractor_field_navigation",
      "mechanism": "Agent moves in response to a potential field attracting toward the target",
      "code": "# HYPOTHESIS: attractor_field_navigation\n# MECHANISM: Agent moves in response to a potential field attracting toward the target\nPARAMS = {\"field_strength\": 10.0, \"damping\": 0.8, \"agent_speed\": 5.0}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = {}\n    \n    # Vector from agent to target\n    dx = state[\"target.x\"] - state[\"agent.x\"]\n    dy = state[\"target.y\"] - state[\"agent.y\"]\n    distance = math.sqrt(dx*dx + dy*dy)\n    \n    # Normalize and scale by field strength (avoid division by zero)\n    if distance > 0.0:\n        unit_dx = dx / distance\n        unit_dy = dy / distance\n    else:\n        unit_dx, unit_dy = 0.0, 0.0\n    \n    # Compute desired velocity towards target\n    desired_vx = unit_dx * p[\"agent_speed\"]\n    desired_vy = unit_dy * p[\"agent_speed\"]\n    \n    # Apply damping to current velocity\n    current_vx = state.get(\"agent.vx\", 0.0) * p[\"damping\"]\n    current_vy = state.get(\"agent.vy\", 0.0) * p[\"damping\"]\n    \n    # Blend with desired velocity based on field influence\n    new_vx = current_vx + (desired_vx - current_vx) * p[\"field_strength\"] / (p[\"field_strength\"] + 1.0)\n    new_vy = current_vy + (desired_vy - current_vy) * p[\"field_strength\"] / (p[\"field_strength\"] + 1.0)\n    \n    # Update positions\n    new_state[\"agent.x\"] = state[\"agent.x\"] + new_vx\n    new_state[\"agent.y\"] = state[\"agent.y\"] + new_vy\n    new_state[\"agent.vx\"] = new_vx\n    new_state[\"agent.vy\"] = new_vy\n    \n    # Target remains static\n    new_state[\"target.x\"] = state[\"target.x\"]\n    new_state[\"target.y\"] = state[\"target.y\"]\n    \n    return new_state",
      "init_params": {
        "field_strength": 10.0,
        "damping": 0.8,
        "agent_speed": 5.0
      },
      "repaired": false
    },
    {
      "name": "proportional_control_navigation",
      "mechanism": "Agent uses proportional control to move toward the target with bounded speed",
      "code": "# HYPOTHESIS: proportional_control_navigation\n# MECHANISM: Agent uses proportional control to move toward the target with bounded speed\nPARAMS = {\"kp\": 0.5, \"max_speed\": 10.0}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = {}\n    \n    # Calculate error between agent and target\n    ex = state[\"target.x\"] - state[\"agent.x\"]\n    ey = state[\"target.y\"] - state[\"agent.y\"]\n    \n    # Proportional control law\n    vx = p[\"kp\"] * ex\n    vy = p[\"kp\"] * ey\n    \n    # Limit speed to maximum value\n    speed = math.sqrt(vx*vx + vy*vy)\n    if speed > p[\"max_speed\"] and speed > 0:\n        vx = vx * p[\"max_speed\"] / speed\n        vy = vy * p[\"max_speed\"] / speed\n    \n    # Update positions\n    new_state[\"agent.x\"] = state[\"agent.x\"] + vx\n    new_state[\"agent.y\"] = state[\"agent.y\"] + vy\n    \n    # Maintain simplified velocity tracking\n    new_state[\"agent.vx\"] = vx\n    new_state[\"agent.vy\"] = vy\n    \n    # Target remains static\n    new_state[\"target.x\"] = state[\"target.x\"]\n    new_state[\"target.y\"] = state[\"target.y\"]\n    \n    return new_state",
      "init_params": {
        "kp": 0.5,
        "max_speed": 10.0
      },
      "repaired": false
    }
