      "name": "kinematic_direct",
      "mechanism": "Action directly controls displacement (first-order kinematics); target is static.",
      "code": "# HYPOTHESIS: kinematic_direct\n# MECHANISM: Action directly controls displacement (first-order kinematics); target is static.\nPARAMS = {\"scale_x\": 25.0, \"scale_y\": 25.0}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    ax = action[0] * p[\"scale_x\"]\n    ay = action[1] * p[\"scale_y\"]\n    s[\"agent.x\"] = s[\"agent.x\"] + ax\n    s[\"agent.y\"] = s[\"agent.y\"] + ay\n    s[\"target.x\"] = s[\"target.x\"]\n    s[\"target.y\"] = s[\"target.y\"]\n    return s",
      "init_params": {
        "scale_x": 25.0,
        "scale_y": 25.0
      },
      "repaired": false
    },
    {
      "name": "velocity_momentum",
      "mechanism": "Action controls acceleration; agent has velocity state with momentum integration.",
      "code": "# HYPOTHESIS: velocity_momentum\n# MECHANISM: Action controls acceleration; agent has velocity state with momentum integration.\nPARAMS = {\"acc_scale\": 50.0, \"drag\": 0.1, \"dt\": 1.0}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    vx = s.get(\"agent.vx\", 0.0)\n    vy = s.get(\"agent.vy\", 0.0)\n    ax = action[0] * p[\"acc_scale\"]\n    ay = action[1] * p[\"acc_scale\"]\n    vx = vx + ax * p[\"dt\"]\n    vy = vy + ay * p[\"dt\"]\n    vx = vx * (1.0 - p[\"drag\"])\n    vy = vy * (1.0 - p[\"drag\"])\n    s[\"agent.x\"] = s[\"agent.x\"] + vx * p[\"dt\"]\n    s[\"agent.y\"] = s[\"agent.y\"] + vy * p[\"dt\"]\n    s[\"agent.vx\"] = vx\n    s[\"agent.vy\"] = vy\n    s[\"target.x\"] = s[\"target.x\"]\n    s[\"target.y\"] = s[\"target.y\"]\n    return s",
      "init_params": {
        "acc_scale": 50.0,
        "drag": 0.1,
        "dt": 1.0
      },
      "repaired": false
    },
    {
      "name": "door_barrier",
      "mechanism": "Agent movement is blocked or slowed when crossing door boundary from metadata.",
      "code": "# HYPOTHESIS: door_barrier\n# MECHANISM: Agent movement is blocked or slowed when crossing door boundary from metadata.\nPARAMS = {\"scale\": 25.0, \"barrier_strength\": 0.5, \"door_radius\": 30.0}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    door = meta.get(\"door_coords\", [112.0, 49.0, 0.0, 0.0, 0.0, 0.0])\n    door_x, door_y = door[0], door[1]\n    dx = action[0] * p[\"scale\"]\n    dy = action[1] * p[\"scale\"]\n    new_x = s[\"agent.x\"] + dx\n    new_y = s[\"agent.y\"] + dy\n    dist_to_door = math.hypot(new_x - door_x, new_y - door_y)\n    if dist_to_door < p[\"door_radius\"]:\n        scale_factor = dist_to_door / p[\"door_radius\"]\n        dx = dx * p[\"barrier_strength\"] * scale_factor\n        dy = dy * p[\"barrier_strength\"] * scale_factor\n    s[\"agent.x\"] = s[\"agent.x\"] + dx\n    s[\"agent.y\"] = s[\"agent.y\"] + dy\n    s[\"target.x\"] = s[\"target.x\"]\n    s[\"target.y\"] = s[\"target.y\"]\n    return s",
      "init_params": {
        "scale": 25.0,
        "barrier_strength": 0.5,
        "door_radius": 30.0
      },
      "repaired": false
    },
    {
      "name": "action_saturation",
      "mechanism": "Action effect saturates nonlinearly at high magnitudes (sigmoid-like response).",
      "code": "# HYPOTHESIS: action_saturation\n# MECHANISM: Action effect saturates nonlinearly at high magnitudes (sigmoid-like response).\nPARAMS = {\"max_speed\": 30.0, \"gain\": 1.5, \"threshold\": 0.5}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    ax_raw = action[0] * p[\"gain\"]\n    ay_raw = action[1] * p[\"gain\"]\n    mag = math.hypot(ax_raw, ay_raw)\n    if mag > 1e-6:\n        scale = math.tanh(mag / p[\"threshold\"]) / mag * p[\"max_speed\"]\n        ax = ax_raw * scale\n        ay = ay_raw * scale\n    else:\n        ax, ay = 0.0, 0.0\n    s[\"agent.x\"] = s[\"agent.x\"] + ax\n    s[\"agent.y\"] = s[\"agent.y\"] + ay\n    s[\"target.x\"] = s[\"target.x\"]\n    s[\"target.y\"] = s[\"target.y\"]\n    return s",
      "init_params": {
        "max_speed": 30.0,
        "gain": 1.5,
        "threshold": 0.5
      },
      "repaired": false
    },
    {
      "name": "target_attraction",
      "mechanism": "Agent experiences weak attraction toward target in addition to action control.",
      "code": "# HYPOTHESIS: target_attraction\n# MECHANISM: Agent experiences weak attraction toward target in addition to action control.\nPARAMS = {\"scale\": 25.0, \"attraction_strength\": 0.02, \"attraction_range\": 200.0}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    dx_action = action[0] * p[\"scale\"]\n    dy_action = action[1] * p[\"scale\"]\n    tx, ty = s[\"target.x\"], s[\"target.y\"]\n    ax, ay = s[\"agent.x\"], s[\"agent.y\"]\n    dist = math.hypot(tx - ax, ty - ay)\n    if dist > 1e-6 and dist < p[\"attraction_range\"]:\n        attract_scale = p[\"attraction_strength\"] * (1.0 - dist / p[\"attraction_range\"])\n        dx_attract = (tx - ax) * attract_scale\n        dy_attract = (ty - ay) * attract_scale\n    else:\n        dx_attract, dy_attract = 0.0, 0.0\n    s[\"agent.x\"] = ax + dx_action + dx_attract\n    s[\"agent.y\"] = ay + dy_action + dy_attract\n    s[\"target.x\"] = tx\n    s[\"target.y\"] = ty\n    return s",
      "init_params": {
        "scale": 25.0,
        "attraction_strength": 0.02,
        "attraction_range": 200.0
      },
      "repaired": false
    },
    {
      "name": "anisotropic_friction",
      "mechanism": "Movement cost differs by direction; diagonal motion is penalized relative to cardinal.",
      "code": "# HYPOTHESIS: anisotropic_friction\n# MECHANISM: Movement cost differs by direction; diagonal motion is penalized relative to cardinal.\nPARAMS = {\"scale_x\": 25.0, \"scale_y\": 25.0, \"diagonal_penalty\": 0.85}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    ax = action[0] * p[\"scale_x\"]\n    ay = action[1] * p[\"scale_y\"]\n    if abs(ax) > 1e-6 and abs(ay) > 1e-6:\n        penalty = p[\"diagonal_penalty\"]\n        ax = ax * penalty\n        ay = ay * penalty\n    s[\"agent.x\"] = s[\"agent.x\"] + ax\n    s[\"agent.y\"] = s[\"agent.y\"] + ay\n    s[\"target.x\"] = s[\"target.x\"]\n    s[\"target.y\"] = s[\"target.y\"]\n    return s",
      "init_params": {
        "scale_x": 25.0,
        "scale_y": 25.0,
        "diagonal_penalty": 0.85
      },
      "repaired": false
    }
