      "name": "baseline_random_walk",
      "mechanism": "Simple baseline - effector performs scaled random walk from action; block never moves (null hypothesis for block dynamics)",
      "code": "# HYPOTHESIS: baseline_random_walk\n# MECHANISM: Simple baseline - effector performs scaled random walk from action; block never moves (null hypothesis for block dynamics)\nPARAMS = {\"eff_scale\": 0.1, \"noise\": 0.01}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = dict(state)\n    \n    # Effector moves proportionally to action\n    ex = state[\"effector.x\"] + action[0] * p[\"eff_scale\"]\n    ey = state[\"effector.y\"] + action[1] * p[\"eff_scale\"]\n    ez = max(0.02, state[\"effector.z\"] + action[2] * p[\"eff_scale\"])\n    \n    new_state[\"effector.x\"] = ex\n    new_state[\"effector.y\"] = ey\n    new_state[\"effector.z\"] = ez\n    \n    # Block never moves (test if block dynamics are needed)\n    new_state[\"block.x\"] = state[\"block.x\"]\n    new_state[\"block.y\"] = state[\"block.y\"]\n    new_state[\"block.z\"] = state[\"block.z\"]\n    \n    # Goal static\n    new_state[\"goal.x\"] = state[\"goal.x\"]\n    new_state[\"goal.y\"] = state[\"goal.y\"]\n    new_state[\"goal.z\"] = state[\"goal.z\"]\n    \n    return new_state",
