    {
      "name": "velocity_momentum_friction",
      "mechanism": "Objects have hidden velocity; action applies acceleration; friction dissipates momentum; block slides when pushed",
      "code": "# HYPOTHESIS: velocity_momentum_friction\n# MECHANISM: Objects have hidden velocity; action applies acceleration; friction dissipates momentum; block slides when pushed\nPARAMS = {\"eff_mass\": 1.0, \"block_mass\": 2.0, \"friction\": 0.5, \"force_scale\": 0.2, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = dict(state)\n    \n    # Initialize velocities from meta or assume zero (hidden state approximation)\n    evx = meta.get(\"eff_vx\", 0.0)\n    evy = meta.get(\"eff_vy\", 0.0)\n    evz = meta.get(\"eff_vz\", 0.0)\n    bvx = meta.get(\"block_vx\", 0.0)\n    bvy = meta.get(\"block_vy\", 0.0)\n    bvz = meta.get(\"block_vz\", 0.0)\n    \n    # Action applies force to effector\n    evx += action[0] * p[\"force_scale\"] / p[\"eff_mass\"] * p[\"dt\"]\n    evy += action[1] * p[\"force_scale\"] / p[\"eff_mass\"] * p[\"dt\"]\n    evz += action[2] * p[\"force_scale\"] / p[\"eff_mass\"] * p[\"dt\"]\n    \n    # Friction\n    evx *= (1 - p[\"friction\"] * p[\"dt\"])\n    evy *= (1 - p[\"friction\"] * p[\"dt\"])\n    evz *= (1 - p[\"friction\"] * p[\"dt\"])\n    \n    # Update effector position\n    ex = state[\"effector.x\"] + evx * p[\"dt\"]\n    ey = state[\"effector.y\"] + evy * p[\"dt\"]\n    ez = max(0.02, state[\"effector.z\"] + evz * p[\"dt\"])\n    new_state[\"effector.x\"] = ex\n    new_state[\"effector.y\"] = ey\n    new_state[\"effector.z\"] = ez\n    \n    # Block moves only if effector pushes it (contact)\n    dx = ex - state[\"block.x\"]\n    dy = ey - state[\"block.y\"]\n    dz = ez - state[\"block.z\"]\n    dist = math.sqrt(dx*dx + dy*dy + dz*dz)\n    \n    if dist < 0.02 and action[4] > 0:\n        # Pushed by effector\n        bvx = evx * 0.5\n        bvy = evy * 0.5\n        bvz = evz * 0.5\n    else:\n        # Friction stops block\n        bvx *= (1 - p[\"friction\"] * p[\"dt\"] * 2)\n        bvy *= (1 - p[\"friction\"] * p[\"dt\"] * 2)\n        bvz *= (1 - p[\"friction\"] * p[\"dt\"] * 2)\n    \n    bx = state[\"block.x\"] + bvx * p[\"dt\"]\n    by = state[\"block.y\"] + bvy * p[\"dt\"]\n    bz = max(0.02, state[\"block.z\"] + bvz * p[\"dt\"])\n    new_state[\"block.x\"] = bx\n    new_state[\"block.y\"] = by\n    new_state[\"block.z\"] = bz\n    \n    # Store velocities in meta for next step (simulated hidden state)\n    new_state[\"_eff_vx\"] = evx\n    new_state[\"_eff_vy\"] = evy\n    new_state[\"_eff_vz\"] = evz\n    new_state[\"_block_vx\"] = bvx\n    new_state[\"_block_vy\"] = bvy\n    new_state[\"_block_vz\"] = bvz\n    \n    new_state[\"goal.x\"] = state[\"goal.x\"]\n    new_state[\"goal.y\"] = state[\"goal.y\"]\n    new_state[\"goal.z\"] = state[\"goal.z\"]\n    \n    return new_state",
      "init_params": {
        "eff_mass": 1.0,
        "block_mass": 2.0,
        "friction": 0.5,
        "force_scale": 0.2,
        "dt": 0.1
      },
      "repaired": false
