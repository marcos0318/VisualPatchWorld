      "name": "binary_grip_attachment",
      "mechanism": "Effector moves kinematically by action; block rigidly attaches when gripper closed (action[4]>0) and within distance threshold",
      "code": "# HYPOTHESIS: binary_grip_attachment\n# MECHANISM: Effector moves kinematically by action; block rigidly attaches when gripper closed (action[4]>0) and within distance threshold\nPARAMS = {\"move_scale\": 0.1, \"attach_dist\": 0.03, \"grip_thresh\": 0.0}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = dict(state)\n    \n    # Effector moves by action (velocity-like)\n    ex = state[\"effector.x\"] + action[0] * p[\"move_scale\"]\n    ey = state[\"effector.y\"] + action[1] * p[\"move_scale\"]\n    ez = max(0.02, state[\"effector.z\"] + action[2] * p[\"move_scale\"])\n    new_state[\"effector.x\"] = ex\n    new_state[\"effector.y\"] = ey\n    new_state[\"effector.z\"] = ez\n    \n    # Check attachment: gripper closed AND close enough\n    dx = state[\"block.x\"] - state[\"effector.x\"]\n    dy = state[\"block.y\"] - state[\"effector.y\"]\n    dz = state[\"block.z\"] - state[\"effector.z\"]\n    dist = math.sqrt(dx*dx + dy*dy + dz*dz)\n    \n    gripper_closed = action[4] > p[\"grip_thresh\"]\n    attached = gripper_closed and (dist < p[\"attach_dist\"])\n    \n    if attached:\n        # Block moves with effector\n        new_state[\"block.x\"] = ex\n        new_state[\"block.y\"] = ey\n        new_state[\"block.z\"] = max(0.02, ez + (state[\"block.z\"] - state[\"effector.z\"]))\n    else:\n        # Block stays still (on ground if z low)\n        new_state[\"block.x\"] = state[\"block.x\"]\n        new_state[\"block.y\"] = state[\"block.y\"]\n        new_state[\"block.z\"] = state[\"block.z\"]\n    \n    # Goal is static\n    new_state[\"goal.x\"] = state[\"goal.x\"]\n    new_state[\"goal.y\"] = state[\"goal.y\"]\n    new_state[\"goal.z\"] = state[\"goal.z\"]\n    \n    return new_state",
      "init_params": {
        "move_scale": 0.1,
        "attach_dist": 0.03,
        "grip_thresh": 0.0
      },
      "repaired": false
    },
    {
      "name": "spring_coupled_dynamics",
      "mechanism": "Block is connected to effector via spring-damper; action[4] controls spring stiffness (grip strength)",
      "code": "# HYPOTHESIS: spring_coupled_dynamics\n# MECHANISM: Block is connected to effector via spring-damper; action[4] controls spring stiffness (grip strength)\nPARAMS = {\"move_scale\": 0.1, \"k_grip\": 50.0, \"k_loose\": 0.5, \"damping\": 5.0, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = dict(state)\n    \n    # Effector moves kinematically\n    ex = state[\"effector.x\"] + action[0] * p[\"move_scale\"]\n    ey = state[\"effector.y\"] + action[1] * p[\"move_scale\"]\n    ez = max(0.02, state[\"effector.z\"] + action[2] * p[\"move_scale\"])\n    new_state[\"effector.x\"] = ex\n    new_state[\"effector.y\"] = ey\n    new_state[\"effector.z\"] = ez\n    \n    # Spring stiffness depends on grip action\n    k = p[\"k_grip\"] if action[4] > 0 else p[\"k_loose\"]\n    \n    # Spring force on block toward effector\n    dx = ex - state[\"block.x\"]\n    dy = ey - state[\"block.y\"]\n    dz = ez - state[\"block.z\"]\n    \n    fx = k * dx * p[\"dt\"]\n    fy = k * dy * p[\"dt\"]\n    fz = k * dz * p[\"dt\"]\n    \n    # Update block position (first-order, no momentum)\n    bx = state[\"block.x\"] + fx\n    by = state[\"block.y\"] + fy\n    bz = max(0.02, state[\"block.z\"] + fz)\n    \n    new_state[\"block.x\"] = bx\n    new_state[\"block.y\"] = by\n    new_state[\"block.z\"] = bz\n    \n    # Goal static\n    new_state[\"goal.x\"] = state[\"goal.x\"]\n    new_state[\"goal.y\"] = state[\"goal.y\"]\n    new_state[\"goal.z\"] = state[\"goal.z\"]\n    \n    return new_state",
      "init_params": {
        "move_scale": 0.1,
        "k_grip": 50.0,
        "k_loose": 0.5,
        "damping": 5.0,
        "dt": 0.1
      },
      "repaired": false
