      "name": "hybrid_contact_modes",
      "mechanism": "Two distinct dynamic modes: free-flight (effector only moves) vs contact (both move together); mode switches on distance+grip",
      "code": "# HYPOTHESIS: hybrid_contact_modes\n# MECHANISM: Two distinct dynamic modes: free-flight (effector only moves) vs contact (both move together); mode switches on distance+grip\nPARAMS = {\"free_speed\": 0.12, \"contact_speed\": 0.08, \"contact_dist\": 0.025, \"grip_thresh\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = dict(state)\n    \n    # Determine mode\n    dx = state[\"block.x\"] - state[\"effector.x\"]\n    dy = state[\"block.y\"] - state[\"effector.y\"]\n    dz = state[\"block.z\"] - state[\"effector.z\"]\n    dist = math.sqrt(dx*dx + dy*dy + dz*dz)\n    \n    in_contact = (dist < p[\"contact_dist\"]) and (action[4] > p[\"grip_thresh\"])\n    \n    if in_contact:\n        # Contact mode: both move together at reduced speed\n        speed = p[\"contact_speed\"]\n        ex = state[\"effector.x\"] + action[0] * speed\n        ey = state[\"effector.y\"] + action[1] * speed\n        ez = max(0.02, state[\"effector.z\"] + action[2] * speed)\n        \n        new_state[\"effector.x\"] = ex\n        new_state[\"effector.y\"] = ey\n        new_state[\"effector.z\"] = ez\n        \n        # Block moves same delta\n        new_state[\"block.x\"] = state[\"block.x\"] + (ex - state[\"effector.x\"])\n        new_state[\"block.y\"] = state[\"block.y\"] + (ey - state[\"effector.y\"])\n        new_state[\"block.z\"] = max(0.02, state[\"block.z\"] + (ez - state[\"effector.z\"]))\n    else:\n        # Free mode: only effector moves\n        speed = p[\"free_speed\"]\n        ex = state[\"effector.x\"] + action[0] * speed\n        ey = state[\"effector.y\"] + action[1] * speed\n        ez = max(0.02, state[\"effector.z\"] + action[2] * speed)\n        \n        new_state[\"effector.x\"] = ex\n        new_state[\"effector.y\"] = ey\n        new_state[\"effector.z\"] = ez\n        \n        # Block stationary\n        new_state[\"block.x\"] = state[\"block.x\"]\n        new_state[\"block.y\"] = state[\"block.y\"]\n        new_state[\"block.z\"] = state[\"block.z\"]\n    \n    new_state[\"goal.x\"] = state[\"goal.x\"]\n    new_state[\"goal.y\"] = state[\"goal.y\"]\n    new_state[\"goal.z\"] = state[\"goal.z\"]\n    \n    return new_state",
