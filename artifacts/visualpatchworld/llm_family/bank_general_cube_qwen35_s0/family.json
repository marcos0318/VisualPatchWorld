    {
      "name": "action_target_position",
      "mechanism": "Action specifies target position offset; effector moves toward target with first-order lag; block follows when gripped",
      "code": "# HYPOTHESIS: action_target_position\n# MECHANISM: Action specifies target position offset; effector moves toward target with first-order lag; block follows when gripped\nPARAMS = {\"lag\": 0.3, \"move_scale\": 0.15, \"grip_thresh\": 0.0, \"attach_dist\": 0.03}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = dict(state)\n    \n    # Action[0:3] is target offset from current position\n    target_x = state[\"effector.x\"] + action[0] * p[\"move_scale\"]\n    target_y = state[\"effector.y\"] + action[1] * p[\"move_scale\"]\n    target_z = max(0.02, state[\"effector.z\"] + action[2] * p[\"move_scale\"])\n    \n    # First-order lag toward target\n    ex = state[\"effector.x\"] + p[\"lag\"] * (target_x - state[\"effector.x\"])\n    ey = state[\"effector.y\"] + p[\"lag\"] * (target_y - state[\"effector.y\"])\n    ez = state[\"effector.z\"] + p[\"lag\"] * (target_z - state[\"effector.z\"])\n    ez = max(0.02, ez)\n    \n    new_state[\"effector.x\"] = ex\n    new_state[\"effector.y\"] = ey\n    new_state[\"effector.z\"] = ez\n    \n    # Check grip and attachment\n    dx = state[\"block.x\"] - state[\"effector.x\"]\n    dy = state[\"block.y\"] - state[\"effector.y\"]\n    dz = state[\"block.z\"] - state[\"effector.z\"]\n    dist = math.sqrt(dx*dx + dy*dy + dz*dz)\n    \n    if action[4] > p[\"grip_thresh\"] and dist < p[\"attach_dist\"]:\n        # Block follows with same lag\n        new_state[\"block.x\"] = state[\"block.x\"] + p[\"lag\"] * (ex - state[\"effector.x\"])\n        new_state[\"block.y\"] = state[\"block.y\"] + p[\"lag\"] * (ey - state[\"effector.y\"])\n        new_state[\"block.z\"] = max(0.02, state[\"block.z\"] + p[\"lag\"] * (ez - state[\"effector.z\"]))\n    else:\n        new_state[\"block.x\"] = state[\"block.x\"]\n        new_state[\"block.y\"] = state[\"block.y\"]\n        new_state[\"block.z\"] = state[\"block.z\"]\n    \n    new_state[\"goal.x\"] = state[\"goal.x\"]\n    new_state[\"goal.y\"] = state[\"goal.y\"]\n    new_state[\"goal.z\"] = state[\"goal.z\"]\n    \n    return new_state",
