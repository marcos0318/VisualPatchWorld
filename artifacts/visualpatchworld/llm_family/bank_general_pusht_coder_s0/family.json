      "name": "point_mass_no_coupling",
      "mechanism": "Agent moves as point mass under action force; block is static",
      "code": "# HYPOTHESIS: point_mass_no_coupling\n# MECHANISM: Agent moves as point mass under action force; block is static\nPARAMS = {\"agent_mass\": 1.0, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    agent_vx = state[\"agent.vx\"] + action[0] / p[\"agent_mass\"] * p[\"dt\"]\n    agent_vy = state[\"agent.vy\"] + action[1] / p[\"agent_mass\"] * p[\"dt\"]\n    agent_x = state[\"agent.x\"] + agent_vx * p[\"dt\"]\n    agent_y = state[\"agent.y\"] + agent_vy * p[\"dt\"]\n    \n    return {\n        \"agent.vx\": agent_vx,\n        \"agent.vy\": agent_vy,\n        \"agent.x\": agent_x,\n        \"agent.y\": agent_y,\n        \"block.angle\": state[\"block.angle\"],\n        \"block.x\": state[\"block.x\"],\n        \"block.y\": state[\"block.y\"]\n    }",
      "init_params": {
        "agent_mass": 1.0,
        "dt": 0.1
      },
      "repaired": false
    },
    {
      "name": "damped_agent_block_contact",
      "mechanism": "Agent accelerates under action but with damping; contacts block when nearby to move it",
      "code": "# HYPOTHESIS: damped_agent_block_contact\n# MECHANISM: Agent accelerates under action but with damping; contacts block when nearby to move it\nPARAMS = {\n    \"agent_mass\": 1.0,\n    \"agent_damping\": 0.5,\n    \"contact_threshold\": 20.0,\n    \"block_mass\": 2.0,\n    \"dt\": 0.1\n}\n\ndef step(state, action, p, meta):\n    # Agent dynamics with damping\n    agent_ax = (action[0] - p[\"agent_damping\"] * state[\"agent.vx\"]) / p[\"agent_mass\"]\n    agent_ay = (action[1] - p[\"agent_damping\"] * state[\"agent.vy\"]) / p[\"agent_mass\"]\n    \n    agent_vx = state[\"agent.vx\"] + agent_ax * p[\"dt\"]\n    agent_vy = state[\"agent.vy\"] + agent_ay * p[\"dt\"]\n    agent_x = state[\"agent.x\"] + agent_vx * p[\"dt\"]\n    agent_y = state[\"agent.y\"] + agent_vy * p[\"dt\"]\n    \n    # Compute distance between agent and block\n    dx = agent_x - state[\"block.x\"]\n    dy = agent_y - state[\"block.y\"]\n    dist = math.sqrt(dx*dx + dy*dy)\n    \n    # Block dynamics\n    block_x, block_y, block_angle = state[\"block.x\"], state[\"block.y\"], state[\"block.angle\"]\n    \n    if dist < p[\"contact_threshold\"]:\n        # Simple transfer of agent velocity to block (inelastic contact-like)\n        block_x += agent_vx * p[\"dt\"] * (p[\"agent_mass\"] / (p[\"agent_mass\"] + p[\"block_mass\"]))\n        block_y += agent_vy * p[\"dt\"] * (p[\"agent_mass\"] / (p[\"agent_mass\"] + p[\"block_mass\"]))\n    \n    return {\n        \"agent.vx\": agent_vx,\n        \"agent.vy\": agent_vy,\n        \"agent.x\": agent_x,\n        \"agent.y\": agent_y,\n        \"block.angle\": block_angle,\n        \"block.x\": block_x,\n        \"block.y\": block_y\n    }",
      "init_params": {
        "agent_mass": 1.0,
        "agent_damping": 0.5,
        "contact_threshold": 20.0,
        "block_mass": 2.0,
        "dt": 0.1
      },
      "repaired": false
    },
    {
      "name": "viscous_push_with_angle",
      "mechanism": "Agent pushes block directly with force dependent on action and relative position; block rotates based on torque",
      "code": "# HYPOTHESIS: viscous_push_with_angle\n# MECHANISM: Agent pushes block directly with force dependent on action and relative position; block rotates based on torque\nPARAMS = {\n    \"push_force_scale\": 1.0,\n    \"block_mass\": 1.0,\n    \"block_inertia\": 0.1,\n    \"dt\": 0.1\n}\n\ndef step(state, action, p, meta):\n    # Agent moves instantaneously to new position (like a robotic arm endpoint)\n    agent_x = state[\"agent.x\"] + action[0] * p[\"dt\"]\n    agent_y = state[\"agent.y\"] + action[1] * p[\"dt\"]\n    agent_vx = (agent_x - state[\"agent.x\"]) / p[\"dt\"] if p[\"dt\"] != 0 else 0\n    agent_vy = (agent_y - state[\"agent.y\"]) / p[\"dt\"] if p[\"dt\"] != 0 else 0\n\n    # Calculate push force direction\n    dx = agent_x - state[\"block.x\"]\n    dy = agent_y - state[\"block.y\"]\n    dist_sq = dx*dx + dy*dy\n    if dist_sq > 0:\n        inv_dist = 1.0 / math.sqrt(dist_sq)\n        fx = -dx * inv_dist * p[\"push_force_scale\"]\n        fy = -dy * inv_dist * p[\"push_force_scale\"]\n        \n        # Apply force to block\n        block_ax = fx / p[\"block_mass\"]\n        block_ay = fy / p[\"block_mass\"]\n        \n        block_vx = (agent_x - state[\"block.x\"]) / p[\"dt\"] if p[\"dt\"] != 0 else 0\n        block_vy = (agent_y - state[\"block.y\"]) / p[\"dt\"] if p[\"dt\"] != 0 else 0\n        \n        block_x = state[\"block.x\"] + block_vx * p[\"dt\"]\n        block_y = state[\"block.y\"] + block_vy * p[\"dt\"]\n        \n        # Torque = r x F (simplified)\n        torque = dx * fy - dy * fx\n        ang_acc = torque / p[\"block_inertia\"]\n        block_angle = state[\"block.angle\"] + ang_acc * p[\"dt\"]\n    else:\n        block_x, block_y, block_angle = state[\"block.x\"], state[\"block.y\"], state[\"block.angle\"]\n\n    return {\n        \"agent.vx\": agent_vx,\n        \"agent.vy\": agent_vy,\n        \"agent.x\": agent_x,\n        \"agent.y\": agent_y,\n        \"block.angle\": block_angle,\n        \"block.x\": block_x,\n        \"block.y\": block_y\n    }",
      "init_params": {
        "push_force_scale": 1.0,
        "block_mass": 1.0,
        "block_inertia": 0.1,
        "dt": 0.1
      },
      "repaired": false
    },
    {
      "name": "momentum_conservation_collision",
      "mechanism": "Agent has momentum; transfers it to block during elastic collision",
      "code": "# HYPOTHESIS: momentum_conservation_collision\n# MECHANISM: Agent has momentum; transfers it to block during elastic collision\nPARAMS = {\n    \"agent_mass\": 1.0,\n    \"block_mass\": 2.0,\n    \"restitution\": 0.8,\n    \"contact_distance\": 15.0,\n    \"dt\": 0.1\n}\n\ndef step(state, action, p, meta):\n    # Update agent velocity based on action (force)\n    agent_vx = state[\"agent.vx\"] + action[0] / p[\"agent_mass\"] * p[\"dt\"]\n    agent_vy = state[\"agent.vy\"] + action[1] / p[\"agent_mass\"] * p[\"dt\"]\n    \n    # Predict positions\n    agent_x = state[\"agent.x\"] + agent_vx * p[\"dt\"]\n    agent_y = state[\"agent.y\"] + agent_vy * p[\"dt\"]\n    \n    block_x = state[\"block.x\"]\n    block_y = state[\"block.y\"]\n    block_vx = 0.0\n    block_vy = 0.0\n    \n    # Check for collision\n    dx = agent_x - block_x\n    dy = agent_y - block_y\n    dist = math.sqrt(dx*dx + dy*dy)\n    \n    if dist < p[\"contact_distance\"] and dist > 0:\n        # Collision detected - elastic collision in 1D along line of impact\n        nx = dx / dist\n        ny = dy / dist\n        \n        # Project velocities onto normal\n        v1n = agent_vx * nx + agent_vy * ny\n        v2n = block_vx * nx + block_vy * ny\n        \n        # Elastic collision formulas\n        m1 = p[\"agent_mass\"]\n        m2 = p[\"block_mass\"]\n        e = p[\"restitution\"]\n        \n        v1n_new = ((m1 - e*m2)*v1n + (1+e)*m2*v2n) / (m1 + m2)\n        v2n_new = ((1+e)*m1*v1n + (m2 - e*m1)*v2n) / (m1 + m2)\n        \n        # Tangential components unchanged\n        v1t = agent_vx*ny - agent_vy*nx\n        v2t = block_vx*ny - block_vy*nx\n        \n        # Reconstruct velocities\n        agent_vx = v1n_new*nx - v1t*ny\n        agent_vy = v1n_new*ny + v1t*nx\n        block_vx = v2n_new*nx - v2t*ny\n        block_vy = v2n_new*ny + v2t*nx\n        \n        # Update positions after impulse\n        agent_x = state[\"agent.x\"] + agent_vx * p[\"dt\"]\n        agent_y = state[\"agent.y\"] + agent_vy * p[\"dt\"]\n        block_x = state[\"block.x\"] + block_vx * p[\"dt\"]\n        block_y = state[\"block.y\"] + block_vy * p[\"dt\"]\n    \n    return {\n        \"agent.vx\": agent_vx,\n        \"agent.vy\": agent_vy,\n        \"agent.x\": agent_x,\n        \"agent.y\": agent_y,\n        \"block.angle\": state[\"block.angle\"],\n        \"block.x\": block_x,\n        \"block.y\": block_y\n    }",
      "init_params": {
        "agent_mass": 1.0,
        "block_mass": 2.0,
        "restitution": 0.8,
        "contact_distance": 15.0,
        "dt": 0.1
      },
      "repaired": false
    },
    {
      "name": "independent_object_dynamics",
      "mechanism": "Both agent and block follow independent second-order dynamics with action affecting only agent",
      "code": "# HYPOTHESIS: independent_object_dynamics\n# MECHANISM: Both agent and block follow independent second-order dynamics with action affecting only agent\nPARAMS = {\n    \"agent_mass\": 1.0,\n    \"block_mass\": 1.0,\n    \"agent_damping\": 0.3,\n    \"block_damping\": 0.1,\n    \"dt\": 0.1\n}\n\ndef step(state, action, p, meta):\n    # Agent dynamics: F = ma with damping\n    agent_ax = (action[0] - p[\"agent_damping\"] * state[\"agent.vx\"]) / p[\"agent_mass\"]\n    agent_ay = (action[1] - p[\"agent_damping\"] * state[\"agent.vy\"]) / p[\"agent_mass\"]\n    \n    agent_vx = state[\"agent.vx\"] + agent_ax * p[\"dt\"]\n    agent_vy = state[\"agent.vy\"] + agent_ay * p[\"dt\"]\n    agent_x = state[\"agent.x\"] + agent_vx * p[\"dt\"]\n    agent_y = state[\"agent.y\"] + agent_vy * p[\"dt\"]\n    \n    # Block has its own internal dynamics (e.g., sliding with friction)\n    block_ax = -p[\"block_damping\"] * (state[\"block.x\"] - state[\"block.x\"]) / p[\"block_mass\"]  # Placeholder\n    block_ay = -p[\"block_damping\"] * (state[\"block.y\"] - state[\"block.y\"]) / p[\"block_mass\"]  # Placeholder\n    \n    # For now assume block can also have some autonomous movement or response\n    block_vx = 0.0  # Will be determined by fitting\n    block_vy = 0.0\n    \n    block_x = state[\"block.x\"] + block_vx * p[\"dt\"]\n    block_y = state[\"block.y\"] + block_vy * p[\"dt\"]\n    \n    # Assume angle changes independently or remains constant\n    block_angle = state[\"block.angle\"]  # Could add rotation model here\n    \n    return {\n        \"agent.vx\": agent_vx,\n        \"agent.vy\": agent_vy,\n        \"agent.x\": agent_x,\n        \"agent.y\": agent_y,\n        \"block.angle\": block_angle,\n        \"block.x\": block_x,\n        \"block.y\": block_y\n    }",
      "init_params": {
        "agent_mass": 1.0,
        "block_mass": 1.0,
        "agent_damping": 0.3,
        "block_damping": 0.1,
        "dt": 0.1
      },
      "repaired": false
    },
    {
      "name": "proportional_position_control",
      "mechanism": "Agent moves toward commanded position using proportional control; no explicit physics",
      "code": "# HYPOTHESIS: proportional_position_control\n# MECHANISM: Agent moves toward commanded position using proportional control; no explicit physics\nPARAMS = {\n    \"kp\": 2.0,\n    \"dt\": 0.1\n}\n\ndef step(state, action, p, meta):\n    # Action interpreted as desired position change\n    cmd_x = state[\"agent.x\"] + action[0]\n    cmd_y = state[\"agent.y\"] + action[1]\n    \n    # Proportional controller drives agent towards command\n    error_x = cmd_x - state[\"agent.x\"]\n    error_y = cmd_y - state[\"agent.y\"]\n    \n    agent_vx = p[\"kp\"] * error_x\n    agent_vy = p[\"kp\"] * error_y\n    \n    agent_x = state[\"agent.x\"] + agent_vx * p[\"dt\"]\n    agent_y = state[\"agent.y\"] + agent_vy * p[\"dt\"]\n    \n    # Block assumed to stay put unless pushed hard enough\n    block_x = state[\"block.x\"]\n    block_y = state[\"block.y\"]\n    block_angle = state[\"block.angle\"]\n    \n    return {\n        \"agent.vx\": agent_vx,\n        \"agent.vy\": agent_vy,\n        \"agent.x\": agent_x,\n        \"agent.y\": agent_y,\n        \"block.angle\": block_angle,\n        \"block.x\": block_x,\n        \"block.y\": block_y\n    }",
      "init_params": {
        "kp": 2.0,
        "dt": 0.1
      },
      "repaired": false
    }
