    {
      "name": "simple_point_mass_control",
      "mechanism": "Agent velocity is driven toward a commanded velocity (action) with a first\u2011order filter; block stays static.",
      "code": "# HYPOTHESIS: simple_point_mass_control\n# MECHANISM: Agent velocity is driven toward a commanded velocity (action) with a first\u2011order filter; block stays static.\nPARAMS = {\"k_vel\": 5.0, \"v_max\": 250.0, \"dt\": 0.05}\n\ndef step(state, action, p, meta):\n    # unpack params\n    k = p[\"k_vel\"]; vmax = p[\"v_max\"]; dt = p[\"dt\"]\n    # agent dynamics (velocity control)\n    cmd_vx, cmd_vy = action[0], action[1]\n    ax = k * (cmd_vx - state[\"agent.vx\"])\n    ay = k * (cmd_vy - state[\"agent.vy\"])\n    vx = state[\"agent.vx\"] + ax * dt\n    vy = state[\"agent.vy\"] + ay * dt\n    # clamp speed\n    if vx > vmax:   vx = vmax\n    if vx < -vmax:  vx = -vmax\n    if vy > vmax:   vy = vmax\n    if vy < -vmax:  vy = -vmax\n    # position integration\n    x = state[\"agent.x\"] + vx * dt\n    y = state[\"agent.y\"] + vy * dt\n    # block unchanged\n    return {\n        \"agent.vx\": vx, \"agent.vy\": vy,\n        \"agent.x\": x,  \"agent.y\": y,\n        \"block.angle\": state[\"block.angle\"],\n        \"block.x\": state[\"block.x\"],\n        \"block.y\": state[\"block.y\"]\n    }",
      "init_params": {
        "k_vel": 5.0,
        "v_max": 250.0,
        "dt": 0.05
      },
      "repaired": false
    },
    {
      "name": "mass_damper_force",
      "mechanism": "Action is a force applied to a point\u2011mass agent with linear viscous damping; block remains immobile.",
      "code": "# HYPOTHESIS: mass_damper_force\n# MECHANISM: Action is a force applied to a point\u2011mass agent with linear viscous damping; block remains immobile.\nPARAMS = {\"mass\": 1.0, \"damping\": 2.0, \"dt\": 0.05}\n\ndef step(state, action, p, meta):\n    m = p[\"mass\"]; b = p[\"damping\"]; dt = p[\"dt\"]\n    fx, fy = action[0], action[1]\n    # acceleration from Newton's law with viscous drag\n    ax = (fx - b * state[\"agent.vx\"]) / m\n    ay = (fy - b * state[\"agent.vy\"]) / m\n    vx = state[\"agent.vx\"] + ax * dt\n    vy = state[\"agent.vy\"] + ay * dt\n    x = state[\"agent.x\"] + vx * dt\n    y = state[\"agent.y\"] + vy * dt\n    return {\n        \"agent.vx\": vx, \"agent.vy\": vy,\n        \"agent.x\": x,  \"agent.y\": y,\n        \"block.angle\": state[\"block.angle\"],\n        \"block.x\": state[\"block.x\"],\n        \"block.y\": state[\"block.y\"]\n    }",
      "init_params": {
        "mass": 1.0,
        "damping": 2.0,
        "dt": 0.05
      },
      "repaired": false
    },
    {
      "name": "elastic_coupling_contact",
      "mechanism": "When the agent is within a contact radius a linear spring couples the agent and block; both follow mass\u2011damper dynamics.",
      "code": "# HYPOTHESIS: elastic_coupling_contact\n# MECHANISM: When the agent is within a contact radius a linear spring couples the agent and block; both follow mass\u2011damper dynamics.\nPARAMS = {\"mass_a\": 1.0, \"mass_b\": 2.0,\n          \"damping_a\": 2.0, \"damping_b\": 4.0,\n          \"k_spring\": 0.8, \"contact_radius\": 30.0,\n          \"dt\": 0.05}\n\ndef step(state, action, p, meta):\n    import math\n    dt = p[\"dt\"]\n    # unpack parameters\n    ma, mb = p[\"mass_a\"], p[\"mass_b\"]\n    ba, bb = p[\"damping_a\"], p[\"damping_b\"]\n    k = p[\"k_spring\"]; r_thr = p[\"contact_radius\"]\n    # positions\n    ax, ay = state[\"agent.x\"], state[\"agent.y\"]\n    bx, by = state[\"block.x\"], state[\"block.y\"]\n    # distance\n    dx = bx - ax\n    dy = by - ay\n    dist = math.hypot(dx, dy)\n    # spring force (zero if out of range)\n    if dist < r_thr and dist > 1e-6:\n        fx = k * dx\n        fy = k * dy\n    else:\n        fx = fy = 0.0\n    # agent dynamics (mass\u2011damper with external force = action + spring)\n    fx_a = action[0] - fx\n    fy_a = action[1] - fy\n    ax_acc = (fx_a - ba * state[\"agent.vx\"]) / ma\n    ay_acc = (fy_a - ba * state[\"agent.vy\"]) / ma\n    avx = state[\"agent.vx\"] + ax_acc * dt\n    avy = state[\"agent.vy\"] + ay_acc * dt\n    ax_new = ax + avx * dt\n    ay_new = ay + avy * dt\n    # block dynamics (mass\u2011damper, only spring force)\n    bx_acc = (fx - bb * 0.0) / mb   # block velocity not observed, assume zero for simplicity\n    by_acc = (fy - bb * 0.0) / mb\n    bvx = bx_acc * dt\n    bvy = by_acc * dt\n    bx_new = bx + bvx * dt\n    by_new = by + bvy * dt\n    return {\n        \"agent.vx\": avx, \"agent.vy\": avy,\n        \"agent.x\": ax_new, \"agent.y\": ay_new,\n        \"block.angle\": state[\"block.angle\"],\n        \"block.x\": bx_new, \"block.y\": by_new\n    }",
      "init_params": {
        "mass_a": 1.0,
        "mass_b": 2.0,
        "damping_a": 2.0,
        "damping_b": 4.0,
        "k_spring": 0.8,
        "contact_radius": 30.0,
        "dt": 0.05
      },
      "repaired": false
    },
    {
      "name": "contact_point_torque_with_friction",
      "mechanism": "When in contact the agent exerts a spring force on the block; the offset creates a torque that rotates the block; Coulomb friction limits translational motion.",
      "code": "# HYPOTHESIS: contact_point_torque_with_friction\n# MECHANISM: When in contact the agent exerts a spring force on the block; the offset creates a torque that rotates the block; Coulomb friction limits translational motion.\nPARAMS = {\"mass_a\": 1.0, \"mass_b\": 2.0,\n          \"damping_a\": 2.0, \"damping_b\": 4.0,\n          \"k_spring\": 1.2, \"contact_radius\": 30.0,\n          \"mu_fric\": 0.3, \"normal_force\": 10.0,\n          \"inertia_b\": 5.0, \"dt\": 0.05}\n\ndef step(state, action, p, meta):\n    import math\n    dt = p[\"dt\"]\n    ma, mb = p[\"mass_a\"], p[\"mass_b\"]\n    ba, bb = p[\"damping_a\"], p[\"damping_b\"]\n    k = p[\"k_spring\"]; r_thr = p[\"contact_radius\"]\n    mu = p[\"mu_fric\"]; N = p[\"normal_force\"]; I = p[\"inertia_b\"]\n    # positions\n    ax, ay = state[\"agent.x\"], state[\"agent.y\"]\n    bx, by = state[\"block.x\"], state[\"block.y\"]\n    # vector from block centre to agent\n    dx = ax - bx\n    dy = ay - by\n    dist = math.hypot(dx, dy)\n    # spring force (only if contact)\n    if dist < r_thr and dist > 1e-6:\n        fx = -k * dx\n        fy = -k * dy\n        # torque from offset\n        torque = dx * fy - dy * fx\n    else:\n        fx = fy = torque = 0.0\n    # Coulomb friction opposing block translation\n    # block velocity not observed; we approximate it as zero and apply static limit\n    f_fric_x = -mu * N * (1 if fx > 0 else -1) if abs(fx) > mu * N else -fx\n    f_fric_y = -mu * N * (1 if fy > 0 else -1) if abs(fy) > mu * N else -fy\n    # net force on block\n    fx_b = fx + f_fric_x\n    fy_b = fy + f_fric_y\n    # block translational update (simple Euler, assuming zero initial velocity)\n    bx_new = bx + (fx_b / mb) * dt * dt\n    by_new = by + (fy_b / mb) * dt * dt\n    # block rotation update\n    ang_vel = state.get(\"block.angular_vel\", 0.0)  # hidden state; start at 0\n    ang_vel = ang_vel + (torque / I) * dt\n    angle_new = state[\"block.angle\"] + ang_vel * dt\n    # agent dynamics (mass\u2011damper with external action + reaction force)\n    fx_a = action[0] + fx   # reaction = +spring force on agent\n    fy_a = action[1] + fy\n    ax_acc = (fx_a - ba * state[\"agent.vx\"]) / ma\n    ay_acc = (fy_a - ba * state[\"agent.vy\"]) / ma\n    avx = state[\"agent.vx\"] + ax_acc * dt\n    avy = state[\"agent.vy\"] + ay_acc * dt\n    ax_new = ax + avx * dt\n    ay_new = ay + avy * dt\n    # store hidden angular velocity back via meta (optional)\n    meta[\"block.angular_vel\"] = ang_vel\n    return {\n        \"agent.vx\": avx, \"agent.vy\": avy,\n        \"agent.x\": ax_new, \"agent.y\": ay_new,\n        \"block.angle\": angle_new,\n        \"block.x\": bx_new,\n        \"block.y\": by_new\n    }",
      "init_params": {
        "mass_a": 1.0,
        "mass_b": 2.0,
        "damping_a": 2.0,
        "damping_b": 4.0,
        "k_spring": 1.2,
        "contact_radius": 30.0,
        "mu_fric": 0.3,
        "normal_force": 10.0,
        "inertia_b": 5.0,
        "dt": 0.05
      },
      "repaired": false
    },
    {
      "name": "velocity_threshold_switch_static_friction",
      "mechanism": "Agent follows mass\u2011damper dynamics; the block moves only when the relative speed between agent and block exceeds a static\u2011friction threshold, otherwise it stays still.",
      "code": "# HYPOTHESIS: velocity_threshold_switch_static_friction\n# MECHANISM: Agent follows mass\u2011damper dynamics; the block moves only when the relative speed between agent and block exceeds a static\u2011friction threshold, otherwise it stays still.\nPARAMS = {\"mass_a\": 1.0, \"damping_a\": 2.0,\n          \"mass_b\": 2.0, \"damping_b\": 4.0,\n          \"v_thr\": 20.0, \"dt\": 0.05}\n\ndef step(state, action, p, meta):\n    import math\n    dt = p[\"dt\"]\n    ma, ba = p[\"mass_a\"], p[\"damping_a\"]\n    mb, bb = p[\"mass_b\"], p[\"damping_b\"]\n    v_thr = p[\"v_thr\"]\n    # agent dynamics (mass\u2011damper with external force = action)\n    fx_a = action[0]; fy_a = action[1]\n    ax_acc = (fx_a - ba * state[\"agent.vx\"]) / ma\n    ay_acc = (fy_a - ba * state[\"agent.vy\"]) / ma\n    avx = state[\"agent.vx\"] + ax_acc * dt\n    avy = state[\"agent.vy\"] + ay_acc * dt\n    ax_new = state[\"agent.x\"] + avx * dt\n    ay_new = state[\"agent.y\"] + avy * dt\n    # relative speed\n    rel_vx = avx - 0.0   # block velocity not observed, assume zero unless moving\n    rel_vy = avy - 0.0\n    rel_speed = math.hypot(rel_vx, rel_vy)\n    # block moves only if relative speed exceeds threshold\n    if rel_speed > v_thr:\n        # simple translation with same velocity as agent (sliding)\n        bx_new = state[\"block.x\"] + rel_vx * dt\n        by_new = state[\"block.y\"] + rel_vy * dt\n    else:\n        bx_new = state[\"block.x\"]\n        by_new = state[\"block.y\"]\n    # block angle unchanged\n    return {\n        \"agent.vx\": avx, \"agent.vy\": avy,\n        \"agent.x\": ax_new, \"agent.y\": ay_new,\n        \"block.angle\": state[\"block.angle\"],\n        \"block.x\": bx_new,\n        \"block.y\": by_new\n    }",
      "init_params": {
        "mass_a": 1.0,
        "damping_a": 2.0,
        "mass_b": 2.0,
        "damping_b": 4.0,
        "v_thr": 20.0,
        "dt": 0.05
      },
      "repaired": false
    },
    {
      "name": "grasp_attach_sticky_push",
      "mechanism": "If the agent gets within a small radius it creates a rigid attachment; the block then follows the agent\u2019s pose (with optional offset). Detachment occurs when the distance grows beyond a release radius.",
      "code": "# HYPOTHESIS: grasp_attach_sticky_push\n# MECHANISM: If the agent gets within a small radius it creates a rigid attachment; the block then follows the agent\u2019s pose (with optional offset). Detachment occurs when the distance grows beyond a release radius.\nPARAMS = {\"attach_radius\": 20.0, \"release_radius\": 30.0,\n          \"offset_x\": 0.0, \"offset_y\": 0.0,\n          \"mass_a\": 1.0, \"damping_a\": 2.0,\n          \"dt\": 0.05}\n\ndef step(state, action, p, meta):\n    import math\n    dt = p[\"dt\"]\n    # unpack params\n    r_attach = p[\"attach_radius\"]\n    r_release = p[\"release_radius\"]\n    offx = p[\"offset_x\"]; offy = p[\"offset_y\"]\n    # agent dynamics (mass\u2011damper with force = action)\n    ma, ba = p[\"mass_a\"], p[\"damping_a\"]\n    fx_a, fy_a = action[0], action[1]\n    ax_acc = (fx_a - ba * state[\"agent.vx\"]) / ma\n    ay_acc = (fy_a - ba * state[\"agent.vy\"]) / ma\n    avx = state[\"agent.vx\"] + ax_acc * dt\n    avy = state[\"agent.vy\"] + ay_acc * dt\n    ax_new = state[\"agent.x\"] + avx * dt\n    ay_new = state[\"agent.y\"] + avy * dt\n    # distance to block\n    dx = state[\"block.x\"] - state[\"agent.x\"]\n    dy = state[\"block.y\"] - state[\"agent.y\"]\n    dist = math.hypot(dx, dy)\n    # attachment flag stored in meta (persisted across steps)\n    attached = meta.get(\"attached\", False)\n    # update attachment state\n    if not attached and dist < r_attach:\n        attached = True\n    elif attached and dist > r_release:\n        attached = False\n    meta[\"attached\"] = attached\n    # block pose update\n    if attached:\n        # block follows agent with constant offset\n        bx_new = ax_new + offx\n        by_new = ay_new + offy\n    else:\n        # block stays where it was\n        bx_new = state[\"block.x\"]\n        by_new = state[\"block.y\"]\n    # block angle unchanged (no rotation in this hypothesis)\n    return {\n        \"agent.vx\": avx, \"agent.vy\": avy,\n        \"agent.x\": ax_new, \"agent.y\": ay_new,\n        \"block.angle\": state[\"block.angle\"],\n        \"block.x\": bx_new,\n        \"block.y\": by_new\n    }",
      "init_params": {
        "attach_radius": 20.0,
        "release_radius": 30.0,
        "offset_x": 0.0,
        "offset_y": 0.0,
        "mass_a": 1.0,
        "damping_a": 2.0,
        "dt": 0.05
      },
      "repaired": false
    }
