      "name": "second_order_drag_dynamics",
      "mechanism": "Agent has second-order dynamics with action as acceleration and linear velocity drag; block responds to contact force",
      "code": "# HYPOTHESIS: second_order_drag_dynamics\n# MECHANISM: Agent has second-order dynamics with action as acceleration and linear velocity drag; block responds to contact force\nPARAMS = {\"acc_scale\": 400.0, \"drag_coeff\": 0.8, \"contact_force_thresh\": 30.0, \"block_mass\": 5.0, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = {}\n    \n    # Agent: second-order dynamics - action is acceleration command\n    acc_x = action[0] * p[\"acc_scale\"]\n    acc_y = action[1] * p[\"acc_scale\"]\n    \n    # Apply linear drag to velocity\n    drag_vx = -p[\"drag_coeff\"] * state[\"agent.vx\"]\n    drag_vy = -p[\"drag_coeff\"] * state[\"agent.vy\"]\n    \n    # Update agent velocity\n    new_vx = state[\"agent.vx\"] + (acc_x + drag_vx) * p[\"dt\"]\n    new_vy = state[\"agent.vy\"] + (acc_y + drag_vy) * p[\"dt\"]\n    \n    # Update agent position\n    new_x = state[\"agent.x\"] + new_vx * p[\"dt\"]\n    new_y = state[\"agent.y\"] + new_vy * p[\"dt\"]\n    \n    # Contact force estimate based on relative velocity\n    dx = state[\"block.x\"] - state[\"agent.x\"]\n    dy = state[\"block.y\"] - state[\"agent.y\"]\n    dist = math.sqrt(dx*dx + dy*dy)\n    \n    if dist < 50.0:\n        contact_force = math.sqrt(new_vx*new_vx + new_vy*new_vy)\n        if contact_force > p[\"contact_force_thresh\"]:\n            force_ratio = (contact_force - p[\"contact_force_thresh\"]) / p[\"contact_force_thresh\"]\n            new_block_x = state[\"block.x\"] + (new_vx / p[\"block_mass\"]) * force_ratio * p[\"dt\"]\n            new_block_y = state[\"block.y\"] + (new_vy / p[\"block_mass\"]) * force_ratio * p[\"dt\"]\n            new_angle = state[\"block.angle\"] + (action[0] * 0.01) * force_ratio\n        else:\n            new_block_x = state[\"block.x\"]\n            new_block_y = state[\"block.y\"]\n            new_angle = state[\"block.angle\"]\n    else:\n        new_block_x = state[\"block.x\"]\n        new_block_y = state[\"block.y\"]\n        new_angle = state[\"block.angle\"]\n    \n    new_state[\"agent.vx\"] = new_vx\n    new_state[\"agent.vy\"] = new_vy\n    new_state[\"agent.x\"] = new_x\n    new_state[\"agent.y\"] = new_y\n    new_state[\"block.x\"] = new_block_x\n    new_state[\"block.y\"] = new_block_y\n    new_state[\"block.angle\"] = new_angle\n    \n    return new_state",
      "init_params": {
        "acc_scale": 400.0,
        "drag_coeff": 0.8,
        "contact_force_thresh": 30.0,
        "block_mass": 5.0,
        "dt": 0.1
