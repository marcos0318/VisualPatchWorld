      "name": "kinematic_agent_contact_gate",
      "mechanism": "Agent velocity directly commanded by action; block moves only when distance threshold is exceeded (contact gating)",
      "code": "# HYPOTHESIS: kinematic_agent_contact_gate\n# MECHANISM: Agent velocity directly commanded by action; block moves only when distance threshold is exceeded (contact gating)\nPARAMS = {\"vel_scale\": 350.0, \"contact_dist\": 45.0, \"push_gain\": 0.15, \"angle_gain\": 0.02, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = {}\n    \n    # Agent: kinematic control - action directly sets velocity\n    new_vx = action[0] * p[\"vel_scale\"]\n    new_vy = action[1] * p[\"vel_scale\"]\n    \n    # Update agent position via euler integration\n    new_x = state[\"agent.x\"] + new_vx * p[\"dt\"]\n    new_y = state[\"agent.y\"] + new_vy * p[\"dt\"]\n    \n    # Check contact with block\n    dx = state[\"block.x\"] - state[\"agent.x\"]\n    dy = state[\"block.y\"] - state[\"agent.y\"]\n    dist = math.sqrt(dx*dx + dy*dy)\n    \n    # Block only moves if agent is within contact distance\n    if dist < p[\"contact_dist\"]:\n        contact_factor = 1.0 - (dist / p[\"contact_dist\"])\n        new_block_x = state[\"block.x\"] + new_vx * p[\"push_gain\"] * contact_factor * p[\"dt\"]\n        new_block_y = state[\"block.y\"] + new_vy * p[\"push_gain\"] * contact_factor * p[\"dt\"]\n        new_angle = state[\"block.angle\"] + (action[0] * p[\"angle_gain\"]) * contact_factor\n    else:\n        new_block_x = state[\"block.x\"]\n        new_block_y = state[\"block.y\"]\n        new_angle = state[\"block.angle\"]\n    \n    new_state[\"agent.vx\"] = new_vx\n    new_state[\"agent.vy\"] = new_vy\n    new_state[\"agent.x\"] = new_x\n    new_state[\"agent.y\"] = new_y\n    new_state[\"block.x\"] = new_block_x\n    new_state[\"block.y\"] = new_block_y\n    new_state[\"block.angle\"] = new_angle\n    \n    return new_state",
      "init_params": {
        "vel_scale": 350.0,
        "contact_dist": 45.0,
        "push_gain": 0.15,
        "angle_gain": 0.02,
        "dt": 0.1
      },
      "repaired": false
