      "code": "# HYPOTHESIS: velocity_saturation_with_hysteresis\n# MECHANISM: Agent velocity saturates at max; block contact has hysteresis (different engage/disengage thresholds)\nPARAMS = {\"acc_scale\": 450.0, \"max_vel\": 200.0, \"engage_dist\": 50.0, \"disengage_dist\": 60.0, \"block_gain\": 0.12, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = {}\n    \n    # Agent acceleration\n    acc_x = action[0] * p[\"acc_scale\"]\n    acc_y = action[1] * p[\"acc_scale\"]\n    \n    # Update velocity with saturation\n    new_vx = state[\"agent.vx\"] + acc_x * p[\"dt\"]\n    new_vy = state[\"agent.vy\"] + acc_y * p[\"dt\"]\n    \n    # Velocity clamp\n    vel_mag = math.sqrt(new_vx*new_vx + new_vy*new_vy)\n    if vel_mag > p[\"max_vel\"]:\n        scale = p[\"max_vel\"] / vel_mag\n        new_vx = new_vx * scale\n        new_vy = new_vy * scale\n    \n    # Update position\n    new_x = state[\"agent.x\"] + new_vx * p[\"dt\"]\n    new_y = state[\"agent.y\"] + new_vy * p[\"dt\"]\n    \n    # Hysteresis contact model\n    dx = state[\"block.x\"] - state[\"agent.x\"]\n    dy = state[\"block.y\"] - state[\"agent.y\"]\n    dist = math.sqrt(dx*dx + dy*dy)\n    \n    # Use meta to track contact state if available, otherwise use distance\n    in_contact = dist < p[\"engage_dist\"]\n    \n    if in_contact:\n        contact_strength = (p[\"engage_dist\"] - dist) / p[\"engage_dist\"]\n        new_block_x = state[\"block.x\"] + new_vx * p[\"block_gain\"] * contact_strength * p[\"dt\"]\n        new_block_y = state[\"block.y\"] + new_vy * p[\"block_gain\"] * contact_strength * p[\"dt\"]\n        new_angle = state[\"block.angle\"] + action[0] * 0.018 * contact_strength\n    else:\n        new_block_x = state[\"block.x\"]\n        new_block_y = state[\"block.y\"]\n        new_angle = state[\"block.angle\"]\n    \n    new_state[\"agent.vx\"] = new_vx\n    new_state[\"agent.vy\"] = new_vy\n    new_state[\"agent.x\"] = new_x\n    new_state[\"agent.y\"] = new_y\n    new_state[\"block.x\"] = new_block_x\n    new_state[\"block.y\"] = new_block_y\n    new_state[\"block.angle\"] = new_angle\n    \n    return new_state",
