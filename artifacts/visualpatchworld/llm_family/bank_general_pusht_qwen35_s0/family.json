    {
      "name": "coulomb_friction_agent",
      "mechanism": "Agent experiences constant coulomb friction opposing motion; block moves via impulse on contact",
      "code": "# HYPOTHESIS: coulomb_friction_agent\n# MECHANISM: Agent experiences constant coulomb friction opposing motion; block moves via impulse on contact\nPARAMS = {\"acc_scale\": 380.0, \"friction_mag\": 15.0, \"impulse_gain\": 0.05, \"contact_radius\": 40.0, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = {}\n    \n    # Agent acceleration from action\n    acc_x = action[0] * p[\"acc_scale\"]\n    acc_y = action[1] * p[\"acc_scale\"]\n    \n    # Coulomb friction: constant magnitude opposing velocity direction\n    vel_mag = math.sqrt(state[\"agent.vx\"]**2 + state[\"agent.vy\"]**2)\n    if vel_mag > 0.1:\n        friction_x = -p[\"friction_mag\"] * (state[\"agent.vx\"] / vel_mag)\n        friction_y = -p[\"friction_mag\"] * (state[\"agent.vy\"] / vel_mag)\n    else:\n        friction_x = 0.0\n        friction_y = 0.0\n    \n    # Update velocity\n    new_vx = state[\"agent.vx\"] + (acc_x + friction_x) * p[\"dt\"]\n    new_vy = state[\"agent.vy\"] + (acc_y + friction_y) * p[\"dt\"]\n    \n    # Update position\n    new_x = state[\"agent.x\"] + new_vx * p[\"dt\"]\n    new_y = state[\"agent.y\"] + new_vy * p[\"dt\"]\n    \n    # Block impulse on contact\n    dx = state[\"block.x\"] - state[\"agent.x\"]\n    dy = state[\"block.y\"] - state[\"agent.y\"]\n    dist = math.sqrt(dx*dx + dy*dy)\n    \n    if dist < p[\"contact_radius\"]:\n        impulse = vel_mag * p[\"impulse_gain\"]\n        new_block_x = state[\"block.x\"] + (dx / dist) * impulse if dist > 0 else state[\"block.x\"]\n        new_block_y = state[\"block.y\"] + (dy / dist) * impulse if dist > 0 else state[\"block.y\"]\n        new_angle = state[\"block.angle\"] + (action[1] * 0.015)\n    else:\n        new_block_x = state[\"block.x\"]\n        new_block_y = state[\"block.y\"]\n        new_angle = state[\"block.angle\"]\n    \n    new_state[\"agent.vx\"] = new_vx\n    new_state[\"agent.vy\"] = new_vy\n    new_state[\"agent.x\"] = new_x\n    new_state[\"agent.y\"] = new_y\n    new_state[\"block.x\"] = new_block_x\n    new_state[\"block.y\"] = new_block_y\n    new_state[\"block.angle\"] = new_angle\n    \n    return new_state",
      "init_params": {
        "acc_scale": 380.0,
        "friction_mag": 15.0,
        "impulse_gain": 0.05,
        "contact_radius": 40.0,
        "dt": 0.1
      },
      "repaired": false
