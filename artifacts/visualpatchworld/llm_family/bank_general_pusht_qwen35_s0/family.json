    {
      "name": "soft_spring_contact_model",
      "mechanism": "Contact modeled as soft spring when agent penetrates block boundary; spring force moves block",
      "code": "# HYPOTHESIS: soft_spring_contact_model\n# MECHANISM: Contact modeled as soft spring when agent penetrates block boundary; spring force moves block\nPARAMS = {\"vel_scale\": 320.0, \"spring_k\": 0.8, \"rest_distance\": 35.0, \"block_damping\": 0.5, \"angle_spring\": 0.03, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = {}\n    \n    # Agent velocity from action with some inertia\n    target_vx = action[0] * p[\"vel_scale\"]\n    target_vy = action[1] * p[\"vel_scale\"]\n    new_vx = state[\"agent.vx\"] * 0.7 + target_vx * 0.3\n    new_vy = state[\"agent.vy\"] * 0.7 + target_vy * 0.3\n    \n    # Update agent position\n    new_x = state[\"agent.x\"] + new_vx * p[\"dt\"]\n    new_y = state[\"agent.y\"] + new_vy * p[\"dt\"]\n    \n    # Soft spring contact model\n    dx = state[\"block.x\"] - state[\"agent.x\"]\n    dy = state[\"block.y\"] - state[\"agent.y\"]\n    dist = math.sqrt(dx*dx + dy*dy)\n    \n    if dist < p[\"rest_distance\"]:\n        penetration = p[\"rest_distance\"] - dist\n        spring_force = p[\"spring_k\"] * penetration\n        \n        # Block moves proportional to spring force\n        new_block_x = state[\"block.x\"] + (dx / dist) * spring_force * p[\"dt\"] if dist > 0 else state[\"block.x\"]\n        new_block_y = state[\"block.y\"] + (dy / dist) * spring_force * p[\"dt\"] if dist > 0 else state[\"block.y\"]\n        \n        # Angle changes based on tangential component\n        tan_component = (-dy * new_vx + dx * new_vy) / dist if dist > 0 else 0.0\n        new_angle = state[\"block.angle\"] + tan_component * p[\"angle_spring\"] * p[\"dt\"]\n    else:\n        # Block damping when not in contact\n        new_block_x = state[\"block.x\"]\n        new_block_y = state[\"block.y\"]\n        new_angle = state[\"block.angle\"]\n    \n    new_state[\"agent.vx\"] = new_vx\n    new_state[\"agent.vy\"] = new_vy\n    new_state[\"agent.x\"] = new_x\n    new_state[\"agent.y\"] = new_y\n    new_state[\"block.x\"] = new_block_x\n    new_state[\"block.y\"] = new_block_y\n    new_state[\"block.angle\"] = new_angle\n    \n    return new_state",
      "init_params": {
