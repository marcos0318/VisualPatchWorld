      "name": "decoupled_momentum_transfer",
      "mechanism": "Agent and block are fully decoupled except for discrete momentum transfer events at contact boundary",
      "code": "# HYPOTHESIS: decoupled_momentum_transfer\n# MECHANISM: Agent and block are fully decoupled except for discrete momentum transfer events at contact boundary\nPARAMS = {\"acc_scale\": 420.0, \"drag\": 0.6, \"momentum_transfer\": 0.25, \"contact_boundary\": 42.0, \"angular_momentum\": 0.04, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = {}\n    \n    # Agent dynamics with drag\n    acc_x = action[0] * p[\"acc_scale\"]\n    acc_y = action[1] * p[\"acc_scale\"]\n    \n    drag_vx = -p[\"drag\"] * state[\"agent.vx\"]\n    drag_vy = -p[\"drag\"] * state[\"agent.vy\"]\n    \n    new_vx = state[\"agent.vx\"] + (acc_x + drag_vx) * p[\"dt\"]\n    new_vy = state[\"agent.vy\"] + (acc_y + drag_vy) * p[\"dt\"]\n    \n    new_x = state[\"agent.x\"] + new_vx * p[\"dt\"]\n    new_y = state[\"agent.y\"] + new_vy * p[\"dt\"]\n    \n    # Discrete momentum transfer at contact boundary\n    dx = state[\"block.x\"] - state[\"agent.x\"]\n    dy = state[\"block.y\"] - state[\"agent.y\"]\n    dist = math.sqrt(dx*dx + dy*dy)\n    \n    # Check if crossing contact boundary\n    prev_dx = dx - new_vx * p[\"dt\"]\n    prev_dy = dy - new_vy * p[\"dt\"]\n    prev_dist = math.sqrt(prev_dx*prev_dx + prev_dy*prev_dy)\n    \n    if prev_dist > p[\"contact_boundary\"] and dist <= p[\"contact_boundary\"]:\n        # Momentum transfer event\n        agent_momentum = math.sqrt(new_vx*new_vx + new_vy*new_vy)\n        transfer = agent_momentum * p[\"momentum_transfer\"]\n        \n        # Direction of transfer\n        dir_x = dx / dist if dist > 0 else 1.0\n        dir_y = dy / dist if dist > 0 else 0.0\n        \n        new_block_x = state[\"block.x\"] + dir_x * transfer * p[\"dt\"]\n        new_block_y = state[\"block.y\"] + dir_y * transfer * p[\"dt\"]\n        \n        # Angular momentum from tangential velocity\n        tangential = (-dy * new_vx + dx * new_vy) / dist if dist > 0 else 0.0\n        new_angle = state[\"block.angle\"] + tangential * p[\"angular_momentum\"] * p[\"dt\"]\n    else:\n        new_block_x = state[\"block.x\"]\n        new_block_y = state[\"block.y\"]\n        new_angle = state[\"block.angle\"]\n    \n    new_state[\"agent.vx\"] = new_vx\n    new_state[\"agent.vy\"] = new_vy\n    new_state[\"agent.x\"] = new_x\n    new_state[\"agent.y\"] = new_y\n    new_state[\"block.x\"] = new_block_x\n    new_state[\"block.y\"] = new_block_y\n    new_state[\"block.angle\"] = new_angle\n    \n    return new_state",
