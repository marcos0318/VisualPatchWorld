  "candidates": [
    {
      "name": "direct_linear_control",
      "mechanism": "Actions directly change arm position with linear mapping; finger follows arm deterministically.",
      "code": "# HYPOTHESIS: direct_linear_control\n# MECHANISM: Actions directly change arm position with linear mapping; finger follows arm deterministically.\nPARAMS = {\"kp_arm\": 1.0, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    arm_x = state[\"arm.x\"] + action[0] * p[\"dt\"]\n    arm_y = state[\"arm.y\"] + action[1] * p[\"dt\"]\n    # Assume finger is a fixed offset from arm (e.g., unit length)\n    finger_x = arm_x + 1.0\n    finger_y = arm_y\n    return {\n        \"arm.x\": arm_x,\n        \"arm.y\": arm_y,\n        \"finger.x\": finger_x,\n        \"finger.y\": finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "kp_arm": 1.0,
        "dt": 0.1
      },
      "repaired": false
    },
    {
      "name": "second_order_arm_with_kinematics",
      "mechanism": "Arm behaves as a second-order system under action force; finger position derived via forward kinematics.",
      "code": "# HYPOTHESIS: second_order_arm_with_kinematics\n# MECHANISM: Arm behaves as a second-order system under action force; finger position derived via forward kinematics.\nPARAMS = {\"mass\": 1.0, \"dt\": 0.1, \"link_length\": 1.0}\n\ndef step(state, action, p, p_meta):\n    import math\n    # Update arm using second order inertia (force = action)\n    ax = action[0] / p[\"mass\"]\n    ay = action[1] / p[\"mass\"]\n    vx = (state[\"arm.x\"] - state.get(\"prev_arm_x\", state[\"arm.x\"])) / p[\"dt\"] + ax * p[\"dt\"]\n    vy = (state[\"arm.y\"] - state.get(\"prev_arm_y\", state[\"arm.y\"])) / p[\"dt\"] + ay * p[\"dt\"]\n    arm_x = state[\"arm.x\"] + vx * p[\"dt\"]\n    arm_y = state[\"arm.y\"] + vy * p[\"dt\"]\n\n    # Forward kinematics: finger at unit distance from arm\n    angle = math.atan2(arm_y, arm_x)\n    finger_x = arm_x + p[\"link_length\"] * math.cos(angle)\n    finger_y = arm_y + p[\"link_length\"] * math.sin(angle)\n\n    return {\n        \"arm.x\": arm_x,\n        \"arm.y\": arm_y,\n        \"finger.x\": finger_x,\n        \"finger.y\": finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "mass": 1.0,
        "dt": 0.1,
        "link_length": 1.0
      },
      "repaired": false
    },
    {
      "name": "proportional_end_effector_control",
      "mechanism": "Action drives finger position directly via proportional control towards a commanded target.",
      "code": "# HYPOTHESIS: proportional_end_effector_control\n# MECHANISM: Action drives finger position directly via proportional control towards a commanded target.\nPARAMS = {\"kp_finger\": 2.0, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    # Desired finger position based on action\n    des_fx = state[\"finger.x\"] + action[0]\n    des_fy = state[\"finger.y\"] + action[1]\n\n    # Move finger proportionally toward desired\n    new_fx = state[\"finger.x\"] + p[\"kp_finger\"] * (des_fx - state[\"finger.x\"]) * p[\"dt\"]\n    new_fy = state[\"finger.y\"] + p[\"kp_finger\"] * (des_fy - state[\"finger.y\"]) * p[\"dt\"]\n\n    # Arm updated heuristically or kept constant\n    arm_x = state[\"arm.x\"]\n    arm_y = state[\"arm.y\"]\n\n    return {\n        \"arm.x\": arm_x,\n        \"arm.y\": arm_y,\n        \"finger.x\": new_fx,\n        \"finger.y\": new_fy,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "kp_finger": 2.0,
        "dt": 0.1
      },
      "repaired": false
    },
    {
      "name": "joint_space_dynamics_with_jacobian",
      "mechanism": "Actions affect joint velocities which are mapped through Jacobian to move end effector.",
      "code": "# HYPOTHESIS: joint_space_dynamics_with_jacobian\n# MECHANISM: Actions affect joint velocities which are mapped through Jacobian to move end effector.\nPARAMS = {\"kp\": 1.5, \"link1\": 1.0, \"link2\": 1.0, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    # Treat action as joint torques or accelerations\n    theta1 = state[\"arm.x\"]\n    theta2 = state[\"arm.y\"]\n    \n    dtheta1 = action[0] * p[\"dt\"]\n    dtheta2 = action[1] * p[\"dt\"]\n\n    theta1_new = theta1 + dtheta1\n    theta2_new = theta2 + dtheta2\n\n    # Forward kinematics for two-link arm\n    l1, l2 = p[\"link1\"], p[\"link2\"]\n    finger_x = l1 * math.cos(theta1_new) + l2 * math.cos(theta1_new + theta2_new)\n    finger_y = l1 * math.sin(theta1_new) + l2 * math.sin(theta1_new + theta2_new)\n\n    return {\n        \"arm.x\": theta1_new,\n        \"arm.y\": theta2_new,\n        \"finger.x\": finger_x,\n        \"finger.y\": finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "kp": 1.5,
        "link1": 1.0,
        "link2": 1.0,
        "dt": 0.1
      },
      "repaired": false
    },
    {
      "name": "damped_pendulum_arm",
      "mechanism": "Arm behaves like a damped pendulum where actions apply torque; finger position determined by angle.",
      "code": "# HYPOTHESIS: damped_pendulum_arm\n# MECHANISM: Arm behaves like a damped pendulum where actions apply torque; finger position determined by angle.\nPARAMS = {\"inertia\": 1.0, \"damping\": 0.5, \"length\": 1.0, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    # State interpretation: arm.x and arm.y are angular position and velocity?\n    angle = state[\"arm.x\"]\n    ang_vel = state[\"arm.y\"]\n\n    torque = action[0]  # Only use first action component for simplicity\n\n    ang_acc = (torque - p[\"damping\"] * ang_vel) / p[\"inertia\"]\n    ang_vel_new = ang_vel + ang_acc * p[\"dt\"]\n    angle_new = angle + ang_vel_new * p[\"dt\"]\n\n    finger_x = p[\"length\"] * math.cos(angle_new)\n    finger_y = p[\"length\"] * math.sin(angle_new)\n\n    return {\n        \"arm.x\": angle_new,\n        \"arm.y\": ang_vel_new,\n        \"finger.x\": finger_x,\n        \"finger.y\": finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "inertia": 1.0,
        "damping": 0.5,
        "length": 1.0,
        "dt": 0.1
      },
      "repaired": false
    },
    {
      "name": "independent_finger_target_attraction",
      "mechanism": "Finger moves independently with attraction towards target modulated by action.",
      "code": "# HYPOTHESIS: independent_finger_target_attraction\n# MECHANISM: Finger moves independently with attraction towards target modulated by action.\nPARAMS = {\"attraction_gain\": 1.0, \"action_scale\": 0.5, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    tx = state[\"target.x\"]\n    ty = state[\"target.y\"]\n    fx = state[\"finger.x\"]\n    fy = state[\"finger.y\"]\n\n    # Attraction vector scaled by action\n    ax = (tx - fx) * p[\"attraction_gain\"] + action[0] * p[\"action_scale\"]\n    ay = (ty - fy) * p[\"attraction_gain\"] + action[1] * p[\"action_scale\"]\n\n    new_fx = fx + ax * p[\"dt\"]\n    new_fy = fy + ay * p[\"dt\"]\n\n    # Arm remains unchanged or inferred\n    arm_x = state[\"arm.x\"]\n    arm_y = state[\"arm.y\"]\n\n    return {\n        \"arm.x\": arm_x,\n        \"arm.y\": arm_y,\n        \"finger.x\": new_fx,\n        \"finger.y\": new_fy,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "attraction_gain": 1.0,
        "action_scale": 0.5,
        "dt": 0.1
      },
      "repaired": false
    }
  ],
