    {
      "name": "joint_vel_control",
      "mechanism": "First\u2011order velocity command directly integrates joint angles with saturation.",
      "code": "# HYPOTHESIS: joint_vel_control\n# MECHANISM: First\u2011order velocity command directly integrates joint angles with saturation.\nPARAMS = {\"v_max\": 2.0, \"dt\": 0.05}\n\ndef step(state, action, p, meta):\n    # clamp velocity command\n    def sat(v):\n        if v > p[\"v_max\"]: return p[\"v_max\"]\n        if v < -p[\"v_max\"]: return -p[\"v_max\"]\n        return v\n    v0 = sat(action[0])\n    v1 = sat(action[1])\n    new_state = {\n        \"arm.x\": state[\"arm.x\"] + v0 * p[\"dt\"],\n        \"arm.y\": state[\"arm.y\"] + v1 * p[\"dt\"],\n        \"finger.x\": state[\"finger.x\"],\n        \"finger.y\": state[\"finger.y\"],\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }\n    return new_state",
      "init_params": {
        "v_max": 2.0,
        "dt": 0.05
      },
      "repaired": false
    },
    {
      "name": "torque_control",
      "mechanism": "Action is a torque\u2011like command that changes joint angles proportionally (no velocity state).",
      "code": "# HYPOTHESIS: torque_control\n# MECHANISM: Action is a torque\u2011like command that changes joint angles proportionally (no velocity state).\nPARAMS = {\"k\": 0.8, \"dt\": 0.05}\n\ndef step(state, action, p, meta):\n    delta0 = p[\"k\"] * action[0] * p[\"dt\"]\n    delta1 = p[\"k\"] * action[1] * p[\"dt\"]\n    new_state = {\n        \"arm.x\": state[\"arm.x\"] + delta0,\n        \"arm.y\": state[\"arm.y\"] + delta1,\n        \"finger.x\": state[\"finger.x\"],\n        \"finger.y\": state[\"finger.y\"],\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }\n    return new_state",
      "init_params": {
        "k": 0.8,
        "dt": 0.05
      },
      "repaired": false
    },
    {
      "name": "fk_joint_to_finger",
      "mechanism": "Joint angles evolve by saturated velocity commands; finger position is obtained by planar 2\u2011link forward kinematics.",
      "code": "# HYPOTHESIS: fk_joint_to_finger\n# MECHANISM: Joint angles evolve by saturated velocity commands; finger position is obtained by planar 2\u2011link forward kinematics.\nPARAMS = {\"v_max\": 2.0, \"dt\": 0.05, \"L1\": 0.15, \"L2\": 0.15}\n\ndef step(state, action, p, meta):\n    # saturated joint velocity integration\n    def sat(v):\n        if v > p[\"v_max\"]: return p[\"v_max\"]\n        if v < -p[\"v_max\"]: return -p[\"v_max\"]\n        return v\n    v0 = sat(action[0])\n    v1 = sat(action[1])\n    th0 = state[\"arm.x\"] + v0 * p[\"dt\"]\n    th1 = state[\"arm.y\"] + v1 * p[\"dt\"]\n    # forward kinematics for fingertip\n    x = p[\"L1\"] * math.cos(th0) + p[\"L2\"] * math.cos(th0 + th1)\n    y = p[\"L1\"] * math.sin(th0) + p[\"L2\"] * math.sin(th0 + th1)\n    new_state = {\n        \"arm.x\": th0,\n        \"arm.y\": th1,\n        \"finger.x\": x,\n        \"finger.y\": y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }\n    return new_state",
      "init_params": {
        "v_max": 2.0,
        "dt": 0.05,
        "L1": 0.15,
        "L2": 0.15
      },
      "repaired": false
    },
    {
      "name": "ik_task_pd",
      "mechanism": "Task\u2011space error (finger vs target) is turned into joint velocities via Jacobian pseudo\u2011inverse and a proportional gain; joints are integrated.",
      "code": "# HYPOTHESIS: ik_task_pd\n# MECHANISM: Task\u2011space error (finger vs target) is turned into joint velocities via Jacobian pseudo\u2011inverse and a proportional gain; joints are integrated.\nPARAMS = {\"k_p\": 1.2, \"dt\": 0.05, \"L1\": 0.15, \"L2\": 0.15}\n\ndef step(state, action, p, meta):\n    # ignore raw action, use PD on task error\n    # current fingertip from current joints\n    th0 = state[\"arm.x\"]\n    th1 = state[\"arm.y\"]\n    fx = p[\"L1\"] * math.cos(th0) + p[\"L2\"] * math.cos(th0 + th1)\n    fy = p[\"L1\"] * math.sin(th0) + p[\"L2\"] * math.sin(th0 + th1)\n    # error to target\n    ex = state[\"target.x\"] - fx\n    ey = state[\"target.y\"] - fy\n    # Jacobian\n    j11 = -p[\"L1\"] * math.sin(th0) - p[\"L2\"] * math.sin(th0 + th1)\n    j12 = -p[\"L2\"] * math.sin(th0 + th1)\n    j21 =  p[\"L1\"] * math.cos(th0) + p[\"L2\"] * math.cos(th0 + th1)\n    j22 =  p[\"L2\"] * math.cos(th0 + th1)\n    # determinant\n    det = j11 * j22 - j12 * j21\n    # pseudo\u2011inverse (2x2)\n    if abs(det) < 1e-8:\n        inv11 = inv12 = inv21 = inv22 = 0.0\n    else:\n        inv11 =  j22 / det\n        inv12 = -j12 / det\n        inv21 = -j21 / det\n        inv22 =  j11 / det\n    # joint velocity = J\u207a * (k_p * error)\n    vx = p[\"k_p\"] * (inv11 * ex + inv12 * ey)\n    vy = p[\"k_p\"] * (inv21 * ex + inv22 * ey)\n    # integrate joints\n    new_th0 = th0 + vx * p[\"dt\"]\n    new_th1 = th1 + vy * p[\"dt\"]\n    # recompute fingertip\n    new_fx = p[\"L1\"] * math.cos(new_th0) + p[\"L2\"] * math.cos(new_th0 + new_th1)\n    new_fy = p[\"L1\"] * math.sin(new_th0) + p[\"L2\"] * math.sin(new_th0 + new_th1)\n    new_state = {\n        \"arm.x\": new_th0,\n        \"arm.y\": new_th1,\n        \"finger.x\": new_fx,\n        \"finger.y\": new_fy,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }\n    return new_state",
      "init_params": {
        "k_p": 1.2,
        "dt": 0.05,
        "L1": 0.15,
        "L2": 0.15
      },
      "repaired": false
    },
    {
      "name": "elastic_coupling_finger",
      "mechanism": "Arm joints move by saturated velocity commands; finger is a separate mass attracted toward the arm\u2019s end\u2011effector by a linear spring.",
      "code": "# HYPOTHESIS: elastic_coupling_finger\n# MECHANISM: Arm joints move by saturated velocity commands; finger is a separate mass attracted toward the arm\u2019s end\u2011effector by a linear spring.\nPARAMS = {\"v_max\": 2.0, \"dt\": 0.05, \"L1\": 0.15, \"L2\": 0.15, \"k_s\": 4.0}\n\ndef step(state, action, p, meta):\n    # joint velocity update (same as H1)\n    def sat(v):\n        if v > p[\"v_max\"]: return p[\"v_max\"]\n        if v < -p[\"v_max\"]: return -p[\"v_max\"]\n        return v\n    v0 = sat(action[0])\n    v1 = sat(action[1])\n    th0 = state[\"arm.x\"] + v0 * p[\"dt\"]\n    th1 = state[\"arm.y\"] + v1 * p[\"dt\"]\n    # arm end\u2011effector position (rest length = 0)\n    arm_x = p[\"L1\"] * math.cos(th0) + p[\"L2\"] * math.cos(th0 + th1)\n    arm_y = p[\"L1\"] * math.sin(th0) + p[\"L2\"] * math.sin(th0 + th1)\n    # spring pulling finger toward arm end\n    dx = arm_x - state[\"finger.x\"]\n    dy = arm_y - state[\"finger.y\"]\n    new_finger_x = state[\"finger.x\"] + p[\"k_s\"] * dx * p[\"dt\"]\n    new_finger_y = state[\"finger.y\"] + p[\"k_s\"] * dy * p[\"dt\"]\n    new_state = {\n        \"arm.x\": th0,\n        \"arm.y\": th1,\n        \"finger.x\": new_finger_x,\n        \"finger.y\": new_finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }\n    return new_state",
      "init_params": {
        "v_max": 2.0,
        "dt": 0.05,
        "L1": 0.15,
        "L2": 0.15,
        "k_s": 4.0
      },
      "repaired": false
    },
    {
      "name": "deadzone_finger_vel",
      "mechanism": "Action passes through a dead\u2011zone actuator and then directly integrates finger position; arm is static.",
      "code": "# HYPOTHESIS: deadzone_finger_vel\n# MECHANISM: Action passes through a dead\u2011zone actuator and then directly integrates finger position; arm is static.\nPARAMS = {\"dz\": 0.05, \"dt\": 0.05}\n\ndef step(state, action, p, meta):\n    # dead\u2011zone processing\n    def deadzone(cmd):\n        if abs(cmd) < p[\"dz\"]:\n            return 0.0\n        return (abs(cmd) - p[\"dz\"]) * (1 if cmd > 0 else -1)\n    v_fx = deadzone(action[0])\n    v_fy = deadzone(action[1])\n    new_state = {\n        \"arm.x\": state[\"arm.x\"],\n        \"arm.y\": state[\"arm.y\"],\n        \"finger.x\": state[\"finger.x\"] + v_fx * p[\"dt\"],\n        \"finger.y\": state[\"finger.y\"] + v_fy * p[\"dt\"],\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }\n    return new_state",
      "init_params": {
        "dz": 0.05,
        "dt": 0.05
      },
      "repaired": false
    }
  ],
