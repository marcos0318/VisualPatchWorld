  "candidates": [
    {
      "name": "rigid_kinematic_chain",
      "mechanism": "Arm joints integrate action as velocity; finger position is strictly determined by forward kinematics.",
      "code": "# HYPOTHESIS: rigid_kinematic_chain\n# MECHANISM: Arm joints integrate action as velocity; finger position is strictly determined by forward kinematics.\nPARAMS = {\"dt\": 0.1, \"link_1\": 0.1, \"link_2\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    # Unpack state\n    ax, ay = state[\"arm.x\"], state[\"arm.y\"]\n    # Unpack params\n    dt, l1, l2 = p[\"dt\"], p[\"link_1\"], p[\"link_2\"]\n    \n    # Update arm angles (action interpreted as angular velocity)\n    new_ax = ax + action[0] * dt\n    new_ay = ay + action[1] * dt\n    \n    # Forward Kinematics for finger\n    fx = l1 * math.cos(new_ax) + l2 * math.cos(new_ax + new_ay)\n    fy = l1 * math.sin(new_ax) + l2 * math.sin(new_ax + new_ay)\n    \n    # Target is static\n    tx, ty = state[\"target.x\"], state[\"target.y\"]\n    \n    return {\n        \"arm.x\": new_ax, \"arm.y\": new_ay,\n        \"finger.x\": fx, \"finger.y\": fy,\n        \"target.x\": tx, \"target.y\": ty\n    }",
      "init_params": {
        "dt": 0.1,
        "link_1": 0.1,
        "link_2": 0.1
      },
      "repaired": false
    },
    {
      "name": "decoupled_cartesian",
      "mechanism": "Arm and finger are independent point masses; action directly drives Cartesian velocity for both.",
      "code": "# HYPOTHESIS: decoupled_cartesian\n# MECHANISM: Arm and finger are independent point masses; action directly drives Cartesian velocity for both.\nPARAMS = {\"k_arm\": 0.1, \"k_finger\": 0.05}\n\ndef step(state, action, p, meta):\n    # Unpack state\n    ax, ay = state[\"arm.x\"], state[\"arm.y\"]\n    fx, fy = state[\"finger.x\"], state[\"finger.y\"]\n    tx, ty = state[\"target.x\"], state[\"target.y\"]\n    \n    # Unpack params\n    ka, kf = p[\"k_arm\"], p[\"k_finger\"]\n    \n    # Independent linear updates\n    new_ax = ax + action[0] * ka\n    new_ay = ay + action[1] * ka\n    new_fx = fx + action[0] * kf\n    new_fy = fy + action[1] * kf\n    \n    return {\n        \"arm.x\": new_ax, \"arm.y\": new_ay,\n        \"finger.x\": new_fx, \"finger.y\": new_fy,\n        \"target.x\": tx, \"target.y\": ty\n    }",
      "init_params": {
        "k_arm": 0.1,
        "k_finger": 0.05
      },
      "repaired": false
    },
    {
      "name": "spring_loaded_effector",
      "mechanism": "Arm moves kinematically, but finger is attached via a spring (lagging behind ideal FK position).",
      "code": "# HYPOTHESIS: spring_loaded_effector\n# MECHANISM: Arm moves kinematically, but finger is attached via a spring (lagging behind ideal FK position).\nPARAMS = {\"dt\": 0.1, \"link_1\": 0.1, \"link_2\": 0.1, \"stiffness\": 0.5}\n\ndef step(state, action, p, meta):\n    import math\n    ax, ay = state[\"arm.x\"], state[\"arm.y\"]\n    fx, fy = state[\"finger.x\"], state[\"finger.y\"]\n    tx, ty = state[\"target.x\"], state[\"target.y\"]\n    \n    dt, l1, l2, k = p[\"dt\"], p[\"link_1\"], p[\"link_2\"], p[\"stiffness\"]\n    \n    # Update arm\n    new_ax = ax + action[0] * dt\n    new_ay = ay + action[1] * dt\n    \n    # Ideal finger position\n    ideal_fx = l1 * math.cos(new_ax) + l2 * math.cos(new_ax + new_ay)\n    ideal_fy = l1 * math.sin(new_ax) + l2 * math.sin(new_ax + new_ay)\n    \n    # Spring dynamics towards ideal\n    new_fx = fx + (ideal_fx - fx) * k\n    new_fy = fy + (ideal_fy - fy) * k\n    \n    return {\n        \"arm.x\": new_ax, \"arm.y\": new_ay,\n        \"finger.x\": new_fx, \"finger.y\": new_fy,\n        \"target.x\": tx, \"target.y\": ty\n    }",
      "init_params": {
        "dt": 0.1,
        "link_1": 0.1,
        "link_2": 0.1,
        "stiffness": 0.5
      },
      "repaired": false
    },
    {
      "name": "static_friction_joints",
      "mechanism": "Joints do not move if action magnitude is below a static friction threshold (deadzone).",
      "code": "# HYPOTHESIS: static_friction_joints\n# MECHANISM: Joints do not move if action magnitude is below a static friction threshold (deadzone).\nPARAMS = {\"dt\": 0.1, \"link_1\": 0.1, \"link_2\": 0.1, \"friction_thresh\": 0.05}\n\ndef step(state, action, p, meta):\n    import math\n    ax, ay = state[\"arm.x\"], state[\"arm.y\"]\n    tx, ty = state[\"target.x\"], state[\"target.y\"]\n    \n    dt, l1, l2, thresh = p[\"dt\"], p[\"link_1\"], p[\"link_2\"], p[\"friction_thresh\"]\n    \n    # Apply static friction lock\n    dx = action[0] if abs(action[0]) > thresh else 0.0\n    dy = action[1] if abs(action[1]) > thresh else 0.0\n    \n    new_ax = ax + dx * dt\n    new_ay = ay + dy * dt\n    \n    # Rigid FK\n    fx = l1 * math.cos(new_ax) + l2 * math.cos(new_ax + new_ay)\n    fy = l1 * math.sin(new_ax) + l2 * math.sin(new_ax + new_ay)\n    \n    return {\n        \"arm.x\": new_ax, \"arm.y\": new_ay,\n        \"finger.x\": fx, \"finger.y\": fy,\n        \"target.x\": tx, \"target.y\": ty\n    }",
      "init_params": {
        "dt": 0.1,
        "link_1": 0.1,
        "link_2": 0.1,
        "friction_thresh": 0.05
      },
      "repaired": false
    },
    {
      "name": "configuration_gain",
      "mechanism": "Control effectiveness on arm.x is modulated by the current arm.x angle (simulating Jacobian effects).",
      "code": "# HYPOTHESIS: configuration_gain\n# MECHANISM: Control effectiveness on arm.x is modulated by the current arm.x angle (simulating Jacobian effects).\nPARAMS = {\"dt\": 0.1, \"link_1\": 0.1, \"link_2\": 0.1, \"gain_mod\": 0.5}\n\ndef step(state, action, p, meta):\n    import math\n    ax, ay = state[\"arm.x\"], state[\"arm.y\"]\n    tx, ty = state[\"target.x\"], state[\"target.y\"]\n    \n    dt, l1, l2, gm = p[\"dt\"], p[\"link_1\"], p[\"link_2\"], p[\"gain_mod\"]\n    \n    # Configuration dependent gain for x-joint\n    eff_gain_x = 1.0 + gm * math.cos(ax)\n    \n    new_ax = ax + action[0] * dt * eff_gain_x\n    new_ay = ay + action[1] * dt\n    \n    fx = l1 * math.cos(new_ax) + l2 * math.cos(new_ax + new_ay)\n    fy = l1 * math.sin(new_ax) + l2 * math.sin(new_ax + new_ay)\n    \n    return {\n        \"arm.x\": new_ax, \"arm.y\": new_ay,\n        \"finger.x\": fx, \"finger.y\": fy,\n        \"target.x\": tx, \"target.y\": ty\n    }",
      "init_params": {
        "dt": 0.1,
        "link_1": 0.1,
        "link_2": 0.1,
        "gain_mod": 0.5
      },
      "repaired": false
    },
    {
      "name": "goal_biased_dynamics",
      "mechanism": "Finger experiences an additional attraction force towards the target position independent of arm kinematics.",
      "code": "# HYPOTHESIS: goal_biased_dynamics\n# MECHANISM: Finger experiences an additional attraction force towards the target position independent of arm kinematics.\nPARAMS = {\"dt\": 0.1, \"link_1\": 0.1, \"link_2\": 0.1, \"target_gain\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    ax, ay = state[\"arm.x\"], state[\"arm.y\"]\n    fx, fy = state[\"finger.x\"], state[\"finger.y\"]\n    tx, ty = state[\"target.x\"], state[\"target.y\"]\n    \n    dt, l1, l2, tg = p[\"dt\"], p[\"link_1\"], p[\"link_2\"], p[\"target_gain\"]\n    \n    new_ax = ax + action[0] * dt\n    new_ay = ay + action[1] * dt\n    \n    # Kinematic target for finger\n    kin_fx = l1 * math.cos(new_ax) + l2 * math.cos(new_ax + new_ay)\n    kin_fy = l1 * math.sin(new_ax) + l2 * math.sin(new_ax + new_ay)\n    \n    # Blend kinematic position with target attraction\n    new_fx = kin_fx + (tx - fx) * tg * dt\n    new_fy = kin_fy + (ty - fy) * tg * dt\n    \n    return {\n        \"arm.x\": new_ax, \"arm.y\": new_ay,\n        \"finger.x\": new_fx, \"finger.y\": new_fy,\n        \"target.x\": tx, \"target.y\": ty\n    }",
      "init_params": {
        "dt": 0.1,
        "link_1": 0.1,
        "link_2": 0.1,
        "target_gain": 0.1
      },
      "repaired": false
    }
