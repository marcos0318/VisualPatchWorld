      "name": "point_mass_with_damping",
      "mechanism": "Agent moves as a damped point mass with linear control force and isotropic drag.",
      "code": "# HYPOTHESIS: point_mass_with_damping\n# MECHANISM: Agent moves as a damped point mass with linear control force and isotropic drag.\nPARAMS = {\"mass\": 1.0, \"damping\": 0.1, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    ax = action[0]\n    ay = action[1]\n    \n    # Damped acceleration: F = m*a => a = F/m, but damped\n    acc_x = ax / p[\"mass\"]\n    acc_y = ay / p[\"mass\"]\n    \n    # Apply damping to current velocity\n    damping_factor = math.exp(-p[\"damping\"] * p[\"dt\"] / p[\"mass\"])\n    vx = (state[\"agent.x\"] - state.get(\"agent.prev_x\", state[\"agent.x\"])) / p[\"dt\"]\n    vy = (state[\"agent.y\"] - state.get(\"agent.prev_y\", state[\"agent.y\"])) / p[\"dt\"]\n    vx *= damping_factor\n    vy *= damping_factor\n    \n    # Update velocity with new acceleration\n    vx += acc_x * p[\"dt\"]\n    vy += acc_y * p[\"dt\"]\n    \n    # Update position\n    next_x = state[\"agent.x\"] + vx * p[\"dt\"]\n    next_y = state[\"agent.y\"] + vy * p[\"dt\"]\n    \n    return {\n        \"agent.x\": next_x,\n        \"agent.y\": next_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "mass": 1.0,
        "damping": 0.1,
        "dt": 0.1
      },
      "repaired": false
    },
    {
      "name": "second_order_dynamics",
      "mechanism": "Agent follows full second-order Newtonian dynamics with inertia and direct force control.",
      "code": "# HYPOTHESIS: second_order_dynamics\n# MECHANISM: Agent follows full second-order Newtonian dynamics with inertia and direct force control.\nPARAMS = {\"mass\": 1.0, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    ax = action[0]\n    ay = action[1]\n    \n    # Get previous velocity or assume zero\n    prev_vx = state.get(\"agent.vx\", 0.0)\n    prev_vy = state.get(\"agent.vy\", 0.0)\n    \n    # Acceleration from force (F=ma => a=F/m)\n    acc_x = ax / p[\"mass\"]\n    acc_y = ay / p[\"mass\"]\n    \n    # Update velocity\n    vx = prev_vx + acc_x * p[\"dt\"]\n    vy = prev_vy + acc_y * p[\"dt\"]\n    \n    # Update position\n    next_x = state[\"agent.x\"] + vx * p[\"dt\"]\n    next_y = state[\"agent.y\"] + vy * p[\"dt\"]\n    \n    return {\n        \"agent.x\": next_x,\n        \"agent.y\": next_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "mass": 1.0,
        "dt": 0.1
      },
      "repaired": false
    },
    {
      "name": "proportional_navigation",
      "mechanism": "Agent steers toward target using proportional control on heading angle based on bearing error.",
      "code": "# HYPOTHESIS: proportional_navigation\n# MECHANISM: Agent steers toward target using proportional control on heading angle based on bearing error.\nPARAMS = {\"kp\": 1.0, \"speed\": 1.0, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    \n    dx = state[\"target.x\"] - state[\"agent.x\"]\n    dy = state[\"target.y\"] - state[\"agent.y\"]\n    target_angle = math.atan2(dy, dx)\n    \n    # Current heading estimate from velocity\n    current_vx = state.get(\"agent.vx\", 0.0)\n    current_vy = state.get(\"agent.vy\", 0.0)\n    if abs(current_vx) < 1e-6 and abs(current_vy) < 1e-6:\n        current_angle = 0.0\n    else:\n        current_angle = math.atan2(current_vy, current_vx)\n    \n    # Compute angle error (normalize to [-pi, pi])\n    angle_error = target_angle - current_angle\n    while angle_error > math.pi:\n        angle_error -= 2 * math.pi\n    while angle_error < -math.pi:\n        angle_error += 2 * math.pi\n        \n    # Proportional steering\n    steer = p[\"kp\"] * angle_error\n    \n    # Move in current direction with fixed speed\n    speed = p[\"speed\"]\n    new_vx = speed * math.cos(current_angle + steer * p[\"dt\"])\n    new_vy = speed * math.sin(current_angle + steer * p[\"dt\"])\n    \n    next_x = state[\"agent.x\"] + new_vx * p[\"dt\"]\n    next_y = state[\"agent.y\"] + new_vy * p[\"dt\"]\n    \n    return {\n        \"agent.x\": next_x,\n        \"agent.y\": next_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "kp": 1.0,
        "speed": 1.0,
        "dt": 0.1
      },
      "repaired": false
    },
    {
      "name": "obstacle_avoidance_barrier",
      "mechanism": "Agent is subject to barrier forces near scene boundaries in addition to control inputs.",
      "code": "# HYPOTHESIS: obstacle_avoidance_barrier\n# MECHANISM: Agent is subject to barrier forces near scene boundaries in addition to control inputs.\nPARAMS = {\"barrier_threshold\": 10.0, \"barrier_stiffness\": 1.0, \"mass\": 1.0, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    # Scene bounds inferred from data ranges\n    x_min, x_max = 14.0, 206.0\n    y_min, y_max = 19.8, 208.2\n    \n    # Barrier forces\n    fx = 0.0\n    fy = 0.0\n    \n    if state[\"agent.x\"] < x_min + p[\"barrier_threshold\"]:\n        fx += p[\"barrier_stiffness\"] * (x_min + p[\"barrier_threshold\"] - state[\"agent.x\"])\n    elif state[\"agent.x\"] > x_max - p[\"barrier_threshold\"]:\n        fx -= p[\"barrier_stiffness\"] * (state[\"agent.x\"] - (x_max - p[\"barrier_threshold\"]))\n        \n    if state[\"agent.y\"] < y_min + p[\"barrier_threshold\"]:\n        fy += p[\"barrier_stiffness\"] * (y_min + p[\"barrier_threshold\"] - state[\"agent.y\"])\n    elif state[\"agent.y\"] > y_max - p[\"barrier_threshold\"]:\n        fy -= p[\"barrier_stiffness\"] * (state[\"agent.y\"] - (y_max - p[\"barrier_threshold\"]))\n    \n    # Total force includes action input\n    total_fx = action[0] + fx\n    total_fy = action[1] + fy\n    \n    # Acceleration\n    acc_x = total_fx / p[\"mass\"]\n    acc_y = total_fy / p[\"mass\"]\n    \n    # Assume previous velocity is zero if not present\n    vx = state.get(\"agent.vx\", 0.0) + acc_x * p[\"dt\"]\n    vy = state.get(\"agent.vy\", 0.0) + acc_y * p[\"dt\"]\n    \n    next_x = state[\"agent.x\"] + vx * p[\"dt\"]\n    next_y = state[\"agent.y\"] + vy * p[\"dt\"]\n    \n    return {\n        \"agent.x\": next_x,\n        \"agent.y\": next_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "barrier_threshold": 10.0,
        "barrier_stiffness": 1.0,
        "mass": 1.0,
        "dt": 0.1
      },
      "repaired": false
    },
    {
      "name": "velocity_based_control",
      "mechanism": "Action directly sets instantaneous change in velocity with optional saturation.",
      "code": "# HYPOTHESIS: velocity_based_control\n# MECHANISM: Action directly sets instantaneous change in velocity with optional saturation.\nPARAMS = {\"max_vel_change\": 1.0, \"drag\": 0.05, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    # Get current velocity or approximate from last step\n    prev_x = state.get(\"agent.prev_x\", state[\"agent.x\"])\n    prev_y = state.get(\"agent.prev_y\", state[\"agent.y\"])\n    curr_vx = (state[\"agent.x\"] - prev_x) / p[\"dt\"]\n    curr_vy = (state[\"agent.y\"] - prev_y) / p[\"dt\"]\n    \n    # Apply drag (exponential decay)\n    curr_vx *= (1.0 - p[\"drag\"])\n    curr_vy *= (1.0 - p[\"drag\"])\n    \n    # Control input modifies velocity directly with clamping\n    dvx = max(-p[\"max_vel_change\"], min(p[\"max_vel_change\"], action[0]))\n    dvy = max(-p[\"max_vel_change\"], min(p[\"max_vel_change\"], action[1]))\n    \n    new_vx = curr_vx + dvx\n    new_vy = curr_vy + dvy\n    \n    next_x = state[\"agent.x\"] + new_vx * p[\"dt\"]\n    next_y = state[\"agent.y\"] + new_vy * p[\"dt\"]\n    \n    return {\n        \"agent.x\": next_x,\n        \"agent.y\": next_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "max_vel_change": 1.0,
        "drag": 0.05,
        "dt": 0.1
      },
      "repaired": false
    },
    {
      "name": "radial_field_navigation",
      "mechanism": "Agent moves under influence of radial potential field attracting to target, plus control input.",
      "code": "# HYPOTHESIS: radial_field_navigation\n# MECHANISM: Agent moves under influence of radial potential field attracting to target, plus control input.\nPARAMS = {\"attraction_amplitude\": 1.0, \"repulsion_threshold\": 20.0, \"mass\": 1.0, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    \n    dx = state[\"target.x\"] - state[\"agent.x\"]\n    dy = state[\"target.y\"] - state[\"agent.y\"]\n    distance = math.sqrt(dx*dx + dy*dy)\n    \n    # Avoid division by zero\n    if distance < 1e-6:\n        fx, fy = 0.0, 0.0\n    else:\n        # Attractive force towards target (inverse square law)\n        strength = p[\"attraction_amplitude\"] / (distance**2)\n        unit_dx = dx / distance\n        unit_dy = dy / distance\n        fx = strength * unit_dx\n        fy = strength * unit_dy\n        \n        # Repulsive force if too close to boundary (simplified)\n        margin = 10.0\n        x_min, x_max = 14.0, 206.0\n        y_min, y_max = 19.8, 208.2\n        \n        if state[\"agent.x\"] < x_min + margin:\n            repel_dist = state[\"agent.x\"] - x_min\n            fx += p[\"attraction_amplitude\"] / (repel_dist**2)\n        elif state[\"agent.x\"] > x_max - margin:\n            repel_dist = x_max - state[\"agent.x\"]\n            fx -= p[\"attraction_amplitude\"] / (repel_dist**2)\n            \n        if state[\"agent.y\"] < y_min + margin:\n            repel_dist = state[\"agent.y\"] - y_min\n            fy += p[\"attraction_amplitude\"] / (repel_dist**2)\n        elif state[\"agent.y\"] > y_max - margin:\n            repel_dist = y_max - state[\"agent.y\"]\n            fy -= p[\"attraction_amplitude\"] / (repel_dist**2)\n\n    # Add control input directly as force\n    fx += action[0]\n    fy += action[1]\n    \n    # Acceleration\n    acc_x = fx / p[\"mass\"]\n    acc_y = fy / p[\"mass\"]\n    \n    # Integrate like second order system\n    vx = state.get(\"agent.vx\", 0.0) + acc_x * p[\"dt\"]\n    vy = state.get(\"agent.vy\", 0.0) + acc_y * p[\"dt\"]\n    \n    next_x = state[\"agent.x\"] + vx * p[\"dt\"]\n    next_y = state[\"agent.y\"] + vy * p[\"dt\"]\n    \n    return {\n        \"agent.x\": next_x,\n        \"agent.y\": next_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "attraction_amplitude": 1.0,
        "repulsion_threshold": 20.0,
        "mass": 1.0,
        "dt": 0.1
