    {
      "name": "linear_independent_xyz",
      "mechanism": "Each spatial component responds linearly and independently to actions; no coupling, no momentum.",
      "code": "# HYPOTHESIS: linear_independent_xyz\n# MECHANISM: Each spatial component responds linearly and independently to actions; no coupling, no momentum.\nPARAMS = {\n    \"kx\": 0.1, \"ky\": 0.1, \"kz\": 0.1,\n    \"dt\": 0.05\n}\n\ndef step(state, action, p, meta):\n    ax, ay, az = action[0], action[1], action[2]\n    dt = p[\"dt\"]\n    \n    # Effector moves linearly with action\n    new_ex = state[\"effector.x\"] + p[\"kx\"] * ax * dt\n    new_ey = state[\"effector.y\"] + p[\"ky\"] * ay * dt\n    new_ez = state[\"effector.z\"] + p[\"kz\"] * az * dt\n\n    # Block remains static unless contacted (simplified)\n    new_bx, new_by, new_bz = state[\"block.x\"], state[\"block.y\"], state[\"block.z\"]\n\n    return {\n        \"block.x\": new_bx, \"block.y\": new_by, \"block.z\": new_bz,\n        \"effector.x\": new_ex, \"effector.y\": new_ey, \"effector.z\": new_ez,\n        \"goal.x\": state[\"goal.x\"], \"goal.y\": state[\"goal.y\"], \"goal.z\": state[\"goal.z\"]\n    }",
      "init_params": {
        "kx": 0.1,
        "ky": 0.1,
        "kz": 0.1,
        "dt": 0.05
      },
      "repaired": false
    },
    {
      "name": "momentum_based_coupled",
      "mechanism": "Effector has momentum; action applies force. Contact can move block.",
      "code": "# HYPOTHESIS: momentum_based_coupled\n# MECHANISM: Effector has momentum; action applies force. Contact can move block.\nPARAMS = {\n    \"eff_mass\": 1.0, \"block_mass\": 1.0, \"contact_thresh\": 0.05,\n    \"force_scale\": 0.1, \"damping\": 0.95, \"dt\": 0.05\n}\n\ndef step(state, action, p, meta):\n    import math\n    ax, ay, az = action[0], action[1], action[2]\n    dt = p[\"dt\"]\n\n    # Assume velocities from previous step are zero (no memory), so force directly changes position via acceleration\n    force_x = p[\"force_scale\"] * ax\n    force_y = p[\"force_scale\"] * ay\n    force_z = p[\"force_scale\"] * az\n\n    delta_ex = force_x / p[\"eff_mass\"] * dt**2\n    delta_ey = force_y / p[\"eff_mass\"] * dt**2\n    delta_ez = force_z / p[\"eff_mass\"] * dt**2\n\n    new_ex = state[\"effector.x\"] + delta_ex\n    new_ey = state[\"effector.y\"] + delta_ey\n    new_ez = state[\"effector.z\"] + delta_ez\n\n    # Check contact\n    dx = new_ex - state[\"block.x\"]\n    dy = new_ey - state[\"block.y\"]\n    dz = new_ez - state[\"block.z\"]\n    dist = math.sqrt(dx*dx + dy*dy + dz*dz)\n\n    new_bx, new_by, new_bz = state[\"block.x\"], state[\"block.y\"], state[\"block.z\"]\n    if dist < p[\"contact_thresh\"]:\n        new_bx += delta_ex * (p[\"eff_mass\"] / p[\"block_mass\"])\n        new_by += delta_ey * (p[\"eff_mass\"] / p[\"block_mass\"])\n        new_bz += delta_ez * (p[\"eff_mass\"] / p[\"block_mass\"])\n\n    return {\n        \"block.x\": new_bx, \"block.y\": new_by, \"block.z\": new_bz,\n        \"effector.x\": new_ex, \"effector.y\": new_ey, \"effector.z\": new_ez,\n        \"goal.x\": state[\"goal.x\"], \"goal.y\": state[\"goal.y\"], \"goal.z\": state[\"goal.z\"]\n    }",
      "init_params": {
        "eff_mass": 1.0,
        "block_mass": 1.0,
        "contact_thresh": 0.05,
        "force_scale": 0.1,
        "damping": 0.95,
        "dt": 0.05
      },
      "repaired": false
    },
    {
      "name": "saturating_nonlinear_response",
      "mechanism": "Action response is nonlinear (sigmoidal); saturation occurs at extremes.",
      "code": "# HYPOTHESIS: saturating_nonlinear_response\n# MECHANISM: Action response is nonlinear (sigmoidal); saturation occurs at extremes.\nPARAMS = {\n    \"scale\": 0.2, \"slope\": 2.0, \"dt\": 0.05\n}\n\ndef step(state, action, p, meta):\n    import math\n    def sigmoid(x):\n        return 1.0 / (1.0 + math.exp(-p[\"slope\"] * x))\n\n    ax, ay, az = action[0], action[1], action[2]\n\n    dx = p[\"scale\"] * (2 * sigmoid(ax) - 1) * p[\"dt\"]\n    dy = p[\"scale\"] * (2 * sigmoid(ay) - 1) * p[\"dt\"]\n    dz = p[\"scale\"] * (2 * sigmoid(az) - 1) * p[\"dt\"]\n\n    new_ex = state[\"effector.x\"] + dx\n    new_ey = state[\"effector.y\"] + dy\n    new_ez = state[\"effector.z\"] + dz\n\n    # No block movement for simplicity in this hypothesis\n    new_bx, new_by, new_bz = state[\"block.x\"], state[\"block.y\"], state[\"block.z\"]\n\n    return {\n        \"block.x\": new_bx, \"block.y\": new_by, \"block.z\": new_bz,\n        \"effector.x\": new_ex, \"effector.y\": new_ey, \"effector.z\": new_ez,\n        \"goal.x\": state[\"goal.x\"], \"goal.y\": state[\"goal.y\"], \"goal.z\": state[\"goal.z\"]\n    }",
      "init_params": {
        "scale": 0.2,
        "slope": 2.0,
        "dt": 0.05
      },
      "repaired": false
    },
    {
      "name": "z_gravity_constrained",
      "mechanism": "Z motion is gravity-constrained; object falls unless supported; action lifts but cannot push down.",
      "code": "# HYPOTHESIS: z_gravity_constrained\n# MECHANISM: Z motion is gravity-constrained; object falls unless supported; action lifts but cannot push down.\nPARAMS = {\n    \"lift_strength\": 0.1, \"gravity\": 0.05, \"ground_level\": 0.02, \"dt\": 0.05\n}\n\ndef step(state, action, p, meta):\n    ax, ay, az_action = action[0], action[1], action[2]\n    dt = p[\"dt\"]\n\n    # XY follow action directly\n    new_ex = state[\"effector.x\"] + ax * p[\"lift_strength\"] * dt\n    new_ey = state[\"effector.y\"] + ay * p[\"lift_strength\"] * dt\n\n    # Z has gravity and lift\n    lift = max(0, az_action)  # Only upward force allowed\n    new_ez_raw = state[\"effector.z\"] + (lift * p[\"lift_strength\"] - p[\"gravity\"]) * dt\n    new_ez = max(p[\"ground_level\"], new_ez_raw)  # Can't go below ground\n\n    # Block not moved for simplicity here\n    new_bx, new_by, new_bz = state[\"block.x\"], state[\"block.y\"], state[\"block.z\"]\n\n    return {\n        \"block.x\": new_bx, \"block.y\": new_by, \"block.z\": new_bz,\n        \"effector.x\": new_ex, \"effector.y\": new_ey, \"effector.z\": new_ez,\n        \"goal.x\": state[\"goal.x\"], \"goal.y\": state[\"goal.y\"], \"goal.z\": state[\"goal.z\"]\n    }",
      "init_params": {
        "lift_strength": 0.1,
        "gravity": 0.05,
        "ground_level": 0.02,
        "dt": 0.05
      },
      "repaired": false
    },
    {
      "name": "gated_contact_transfer",
      "mechanism": "Effector can transfer motion to block only when aligned and within threshold distance; gating mechanism.",
      "code": "# HYPOTHESIS: gated_contact_transfer\n# MECHANISM: Effector can transfer motion to block only when aligned and within threshold distance; gating mechanism.\nPARAMS = {\n    \"align_tol\": 0.03, \"move_factor\": 0.8, \"dt\": 0.05\n}\n\ndef step(state, action, p, meta):\n    ax, ay, az = action[0], action[1], action[2]\n    dt = p[\"dt\"]\n\n    new_ex = state[\"effector.x\"] + ax * dt\n    new_ey = state[\"effector.y\"] + ay * dt\n    new_ez = state[\"effector.z\"] + az * dt\n\n    # Gate: Move block only if effector was close enough before moving\n    dx_before = state[\"effector.x\"] - state[\"block.x\"]\n    dy_before = state[\"effector.y\"] - state[\"block.y\"]\n    dz_before = state[\"effector.z\"] - state[\"block.z\"]\n\n    gate_condition = (abs(dx_before) < p[\"align_tol\"] and\n                      abs(dy_before) < p[\"align_tol\"] and\n                      abs(dz_before) < p[\"align_tol\"])\n\n    new_bx, new_by, new_bz = state[\"block.x\"], state[\"block.y\"], state[\"block.z\"]\n    if gate_condition:\n        new_bx = state[\"block.x\"] + ax * p[\"move_factor\"] * dt\n        new_by = state[\"block.y\"] + ay * p[\"move_factor\"] * dt\n        new_bz = state[\"block.z\"] + az * p[\"move_factor\"] * dt\n\n    return {\n        \"block.x\": new_bx, \"block.y\": new_by, \"block.z\": new_bz,\n        \"effector.x\": new_ex, \"effector.y\": new_ey, \"effector.z\": new_ez,\n        \"goal.x\": state[\"goal.x\"], \"goal.y\": state[\"goal.y\"], \"goal.z\": state[\"goal.z\"]\n    }",
      "init_params": {
        "align_tol": 0.03,
        "move_factor": 0.8,
        "dt": 0.05
      },
      "repaired": false
    },
    {
      "name": "fixed_baseline_random_walk",
      "mechanism": "Baseline hypothesis where effector performs random walk independent of action.",
      "code": "# HYPOTHESIS: fixed_baseline_random_walk\n# MECHANISM: Baseline hypothesis where effector performs random walk independent of action.\nPARAMS = {\n    \"step_size\": 0.01, \"random_seed\": 42\n}\n\ndef step(state, action, p, meta):\n    import math\n    # Deterministic pseudo-random walk based on hash of inputs\n    def pseudo_rand(seed_val):\n        s = hash(str(seed_val)) % 1000000\n        return (s / 500000.0) - 1.0  # approx [-1,1]\n\n    seed_base = (state[\"effector.x\"], state[\"effector.y\"], state[\"effector.z\"], tuple(action))\n    dx = pseudo_rand((\"dx\",) + seed_base) * p[\"step_size\"]\n    dy = pseudo_rand((\"dy\",) + seed_base) * p[\"step_size\"]\n    dz = pseudo_rand((\"dz\",) + seed_base) * p[\"step_size\"]\n\n    new_ex = state[\"effector.x\"] + dx\n    new_ey = state[\"effector.y\"] + dy\n    new_ez = state[\"effector.z\"] + dz\n\n    # Block stays put\n    new_bx, new_by, new_bz = state[\"block.x\"], state[\"block.y\"], state[\"block.z\"]\n\n    return {\n        \"block.x\": new_bx, \"block.y\": new_by, \"block.z\": new_bz,\n        \"effector.x\": new_ex, \"effector.y\": new_ey, \"effector.z\": new_ez,\n        \"goal.x\": state[\"goal.x\"], \"goal.y\": state[\"goal.y\"], \"goal.z\": state[\"goal.z\"]\n    }",
      "init_params": {
        "step_size": 0.01,
        "random_seed": 42.0
      },
      "repaired": false
    }
