  "candidates": [
    {
      "name": "simple_linear",
      "mechanism": "Effector and block positions change linearly with action components; no contact detection.",
      "code": "# HYPOTHESIS: simple_linear\n# MECHANISM: Effector and block positions change linearly with action components; no contact detection.\nPARAMS = {\"effector_gain_xy\": 0.1, \"effector_gain_z\": 0.1, \"block_gain_xy\": 0.05, \"block_gain_z\": 0.05, \"action_scale\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    ns = dict(state)\n    ax, ay, az, aw, av = action[0], action[1], action[2], action[3], action[4]\n    scale = p[\"action_scale\"]\n    ns[\"effector.x\"] = state[\"effector.x\"] + scale * p[\"effector_gain_xy\"] * ax\n    ns[\"effector.y\"] = state[\"effector.y\"] + scale * p[\"effector_gain_xy\"] * ay\n    ns[\"effector.z\"] = state[\"effector.z\"] + scale * p[\"effector_gain_z\"] * az\n    ns[\"block.x\"] = state[\"block.x\"] + scale * p[\"block_gain_xy\"] * aw\n    ns[\"block.y\"] = state[\"block.y\"] + scale * p[\"block_gain_xy\"] * av\n    ns[\"block.z\"] = state[\"block.z\"] + scale * p[\"block_gain_z\"] * az\n    ns[\"goal.x\"] = state[\"goal.x\"]\n    ns[\"goal.y\"] = state[\"goal.y\"]\n    ns[\"goal.z\"] = state[\"goal.z\"]\n    return ns",
      "init_params": {
        "effector_gain_xy": 0.1,
        "effector_gain_z": 0.1,
        "block_gain_xy": 0.05,
        "block_gain_z": 0.05,
        "action_scale": 0.1
      },
      "repaired": false
    },
    {
      "name": "contact_gating",
      "mechanism": "Block only moves when effector is within contact distance; otherwise block is stationary.",
      "code": "# HYPOTHESIS: contact_gating\n# MECHANISM: Block only moves when effector is within contact distance; otherwise block is stationary.\nPARAMS = {\"effector_gain\": 0.1, \"contact_dist\": 0.05, \"block_coupling\": 0.8, \"z_contact_thresh\": 0.03}\n\ndef step(state, action, p, meta):\n    import math\n    ns = dict(state)\n    ax, ay, az, aw, av = action[0], action[1], action[2], action[3], action[4]\n    eg = p[\"effector_gain\"]\n    ns[\"effector.x\"] = state[\"effector.x\"] + eg * ax\n    ns[\"effector.y\"] = state[\"effector.y\"] + eg * ay\n    ns[\"effector.z\"] = state[\"effector.z\"] + eg * az\n    dx = abs(state[\"effector.x\"] - state[\"block.x\"])\n    dy = abs(state[\"effector.y\"] - state[\"block.y\"])\n    dz = abs(state[\"effector.z\"] - state[\"block.z\"])\n    dist = math.sqrt(dx*dx + dy*dy + dz*dz)\n    in_contact = dist < p[\"contact_dist\"] and dz < p[\"z_contact_thresh\"]\n    if in_contact:\n        ns[\"block.x\"] = state[\"block.x\"] + p[\"block_coupling\"] * eg * ax\n        ns[\"block.y\"] = state[\"block.y\"] + p[\"block_coupling\"] * eg * ay\n        ns[\"block.z\"] = state[\"block.z\"] + p[\"block_coupling\"] * eg * az\n    else:\n        ns[\"block.x\"] = state[\"block.x\"]\n        ns[\"block.y\"] = state[\"block.y\"]\n        ns[\"block.z\"] = state[\"block.z\"]\n    ns[\"goal.x\"] = state[\"goal.x\"]\n    ns[\"goal.y\"] = state[\"goal.y\"]\n    ns[\"goal.z\"] = state[\"goal.z\"]\n    return ns",
      "init_params": {
        "effector_gain": 0.1,
        "contact_dist": 0.05,
        "block_coupling": 0.8,
        "z_contact_thresh": 0.03
      },
      "repaired": false
    },
    {
      "name": "velocity_momentum",
      "mechanism": "Actions control velocity; position integrates velocity with momentum decay.",
      "code": "# HYPOTHESIS: velocity_momentum\n# MECHANISM: Actions control velocity; position integrates velocity with momentum decay.\nPARAMS = {\"vel_gain\": 0.15, \"momentum_decay\": 0.9, \"block_drag\": 0.7, \"contact_vel_transfer\": 0.5}\n\ndef step(state, action, p, meta):\n    import math\n    ns = dict(state)\n    ax, ay, az, aw, av = action[0], action[1], action[2], action[3], action[4]\n    vg = p[\"vel_gain\"]\n    md = p[\"momentum_decay\"]\n    eff_vx = vg * ax\n    eff_vy = vg * ay\n    eff_vz = vg * az\n    ns[\"effector.x\"] = state[\"effector.x\"] + eff_vx\n    ns[\"effector.y\"] = state[\"effector.y\"] + eff_vy\n    ns[\"effector.z\"] = state[\"effector.z\"] + eff_vz\n    dx = abs(state[\"effector.x\"] - state[\"block.x\"])\n    dy = abs(state[\"effector.y\"] - state[\"block.y\"])\n    dz = abs(state[\"effector.z\"] - state[\"block.z\"])\n    dist = math.sqrt(dx*dx + dy*dy + dz*dz)\n    if dist < 0.05:\n        ns[\"block.x\"] = state[\"block.x\"] + p[\"contact_vel_transfer\"] * eff_vx * p[\"block_drag\"]\n        ns[\"block.y\"] = state[\"block.y\"] + p[\"contact_vel_transfer\"] * eff_vy * p[\"block_drag\"]\n        ns[\"block.z\"] = state[\"block.z\"] + p[\"contact_vel_transfer\"] * eff_vz * p[\"block_drag\"]\n    else:\n        ns[\"block.x\"] = state[\"block.x\"] * md + state[\"block.x\"] * (1 - md)\n        ns[\"block.y\"] = state[\"block.y\"] * md + state[\"block.y\"] * (1 - md)\n        ns[\"block.z\"] = max(0.02, state[\"block.z\"] * md)\n    ns[\"goal.x\"] = state[\"goal.x\"]\n    ns[\"goal.y\"] = state[\"goal.y\"]\n    ns[\"goal.z\"] = state[\"goal.z\"]\n    return ns",
      "init_params": {
        "vel_gain": 0.15,
        "momentum_decay": 0.9,
        "block_drag": 0.7,
        "contact_vel_transfer": 0.5
      },
      "repaired": false
    },
    {
      "name": "independent_channels",
      "mechanism": "First 3 action components control effector xyz; last 2 control block xy independently.",
      "code": "# HYPOTHESIS: independent_channels\n# MECHANISM: First 3 action components control effector xyz; last 2 control block xy independently.\nPARAMS = {\"effector_scale\": 0.12, \"block_scale\": 0.08, \"block_z_friction\": 0.95, \"min_z\": 0.02}\n\ndef step(state, action, p, meta):\n    import math\n    ns = dict(state)\n    ax, ay, az, aw, av = action[0], action[1], action[2], action[3], action[4]\n    es = p[\"effector_scale\"]\n    bs = p[\"block_scale\"]\n    ns[\"effector.x\"] = state[\"effector.x\"] + es * ax\n    ns[\"effector.y\"] = state[\"effector.y\"] + es * ay\n    ns[\"effector.z\"] = max(p[\"min_z\"], state[\"effector.z\"] + es * az)\n    ns[\"block.x\"] = state[\"block.x\"] + bs * aw\n    ns[\"block.y\"] = state[\"block.y\"] + bs * av\n    if state[\"block.z\"] > p[\"min_z\"] + 0.01:\n        ns[\"block.z\"] = state[\"block.z\"] * p[\"block_z_friction\"]\n    else:\n        ns[\"block.z\"] = p[\"min_z\"]\n    ns[\"goal.x\"] = state[\"goal.x\"]\n    ns[\"goal.y\"] = state[\"goal.y\"]\n    ns[\"goal.z\"] = state[\"goal.z\"]\n    return ns",
      "init_params": {
        "effector_scale": 0.12,
        "block_scale": 0.08,
        "block_z_friction": 0.95,
        "min_z": 0.02
      },
      "repaired": false
    },
    {
      "name": "nonlinear_saturation",
      "mechanism": "Action effects saturate via tanh nonlinearity; coupling strength depends on proximity.",
      "code": "# HYPOTHESIS: nonlinear_saturation\n# MECHANISM: Action effects saturate via tanh nonlinearity; coupling strength depends on proximity.\nPARAMS = {\"max_speed\": 0.15, \"saturation_k\": 2.0, \"coupling_strength\": 0.7, \"proximity_scale\": 10.0}\n\ndef step(state, action, p, meta):\n    import math\n    ns = dict(state)\n    ax, ay, az, aw, av = action[0], action[1], action[2], action[3], action[4]\n    ms = p[\"max_speed\"]\n    sk = p[\"saturation_k\"]\n    def sat(v):\n        return ms * math.tanh(sk * v)\n    ns[\"effector.x\"] = state[\"effector.x\"] + sat(ax)\n    ns[\"effector.y\"] = state[\"effector.y\"] + sat(ay)\n    ns[\"effector.z\"] = state[\"effector.z\"] + sat(az)\n    dx = abs(state[\"effector.x\"] - state[\"block.x\"])\n    dy = abs(state[\"effector.y\"] - state[\"block.y\"])\n    dz = abs(state[\"effector.z\"] - state[\"block.z\"])\n    dist = math.sqrt(dx*dx + dy*dy + dz*dz)\n    coupling = p[\"coupling_strength\"] * math.exp(-p[\"proximity_scale\"] * dist)\n    ns[\"block.x\"] = state[\"block.x\"] + coupling * sat(aw)\n    ns[\"block.y\"] = state[\"block.y\"] + coupling * sat(av)\n    ns[\"block.z\"] = state[\"block.z\"] + coupling * sat(az) * 0.5\n    ns[\"goal.x\"] = state[\"goal.x\"]\n    ns[\"goal.y\"] = state[\"goal.y\"]\n    ns[\"goal.z\"] = state[\"goal.z\"]\n    return ns",
      "init_params": {
        "max_speed": 0.15,
        "saturation_k": 2.0,
        "coupling_strength": 0.7,
        "proximity_scale": 10.0
      },
      "repaired": false
    },
    {
      "name": "gravity_surface",
      "mechanism": "Z-axis has gravity pulling down to surface; block slides on surface when effector pushes.",
      "code": "# HYPOTHESIS: gravity_surface\n# MECHANISM: Z-axis has gravity pulling down to surface; block slides on surface when effector pushes.\nPARAMS = {\"xy_gain\": 0.1, \"z_lift_gain\": 0.08, \"gravity\": 0.02, \"surface_z\": 0.02, \"friction\": 0.3}\n\ndef step(state, action, p, meta):\n    import math\n    ns = dict(state)\n    ax, ay, az, aw, av = action[0], action[1], action[2], action[3], action[4]\n    xyg = p[\"xy_gain\"]\n    zlg = p[\"z_lift_gain\"]\n    ns[\"effector.x\"] = state[\"effector.x\"] + xyg * ax\n    ns[\"effector.y\"] = state[\"effector.y\"] + xyg * ay\n    eff_z_new = state[\"effector.z\"] + zlg * az - p[\"gravity\"]\n    ns[\"effector.z\"] = max(p[\"surface_z\"], eff_z_new)\n    on_surface = state[\"block.z\"] <= p[\"surface_z\"] + 0.01\n    dx = abs(state[\"effector.x\"] - state[\"block.x\"])\n    dy = abs(state[\"effector.y\"] - state[\"block.y\"])\n    dz = abs(state[\"effector.z\"] - state[\"block.z\"])\n    pushing = dx < 0.05 and dy < 0.05 and dz < 0.05\n    if pushing and on_surface:\n        ns[\"block.x\"] = state[\"block.x\"] + xyg * ax * p[\"friction\"]\n        ns[\"block.y\"] = state[\"block.y\"] + xyg * ay * p[\"friction\"]\n        ns[\"block.z\"] = p[\"surface_z\"]\n    elif state[\"block.z\"] > p[\"surface_z\"]:\n        ns[\"block.x\"] = state[\"block.x\"]\n        ns[\"block.y\"] = state[\"block.y\"]\n        ns[\"block.z\"] = max(p[\"surface_z\"], state[\"block.z\"] - p[\"gravity\"])\n    else:\n        ns[\"block.x\"] = state[\"block.x\"]\n        ns[\"block.y\"] = state[\"block.y\"]\n        ns[\"block.z\"] = p[\"surface_z\"]\n    ns[\"goal.x\"] = state[\"goal.x\"]\n    ns[\"goal.y\"] = state[\"goal.y\"]\n    ns[\"goal.z\"] = state[\"goal.z\"]\n    return ns",
      "init_params": {
        "xy_gain": 0.1,
        "z_lift_gain": 0.08,
        "gravity": 0.02,
        "surface_z": 0.02,
        "friction": 0.3
      },
      "repaired": false
    }
