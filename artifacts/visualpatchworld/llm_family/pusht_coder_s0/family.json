    {
      "name": "linear_no_coupling",
      "mechanism": "Agent responds linearly to actions with damping; block is static.",
      "code": "# HYPOTHESIS: linear_no_coupling\n# MECHANISM: Agent responds linearly to actions with damping; block is static.\nPARAMS = {\n    \"agent_vx_factor\": 1.0,\n    \"agent_vy_factor\": 1.0,\n    \"agent_damping\": 0.95,\n    \"dt\": 1.0\n}\n\ndef step(state, action, p, meta):\n    ax, ay = action\n    dt = p[\"dt\"]\n    \n    # Update velocities based on action\n    new_vx = state[\"agent.vx\"] * p[\"agent_damping\"] + ax * p[\"agent_vx_factor\"]\n    new_vy = state[\"agent.vy\"] * p[\"agent_damping\"] + ay * p[\"agent_vy_factor\"]\n    \n    # Update positions based on new velocities\n    new_x = state[\"agent.x\"] + new_vx * dt\n    new_y = state[\"agent.y\"] + new_vy * dt\n    \n    return {\n        \"agent.vx\": new_vx,\n        \"agent.vy\": new_vy,\n        \"agent.x\": new_x,\n        \"agent.y\": new_y,\n        \"block.angle\": state[\"block.angle\"],\n        \"block.x\": state[\"block.x\"],\n        \"block.y\": state[\"block.y\"]\n    }",
      "init_params": {
        "agent_vx_factor": 1.0,
        "agent_vy_factor": 1.0,
        "agent_damping": 0.95,
        "dt": 1.0
      },
      "repaired": false
    },
    {
      "name": "momentum_based_agent",
      "mechanism": "Agent accelerates based on action; block remains static.",
      "code": "# HYPOTHESIS: momentum_based_agent\n# MECHANISM: Agent accelerates based on action; block remains static.\nPARAMS = {\n    \"agent_acc_factor\": 1.0,\n    \"agent_damping\": 0.1,\n    \"dt\": 1.0\n}\n\ndef step(state, action, p, meta):\n    ax, ay = action\n    dt = p[\"dt\"]\n    \n    # Acceleration applied to velocity\n    dvx = ax * p[\"agent_acc_factor\"] - state[\"agent.vx\"] * p[\"agent_damping\"]\n    dvy = ay * p[\"agent_acc_factor\"] - state[\"agent.vy\"] * p[\"agent_damping\"]\n    \n    new_vx = state[\"agent.vx\"] + dvx\n    new_vy = state[\"agent.vy\"] + dvy\n    \n    new_x = state[\"agent.x\"] + new_vx * dt\n    new_y = state[\"agent.y\"] + new_vy * dt\n    \n    return {\n        \"agent.vx\": new_vx,\n        \"agent.vy\": new_vy,\n        \"agent.x\": new_x,\n        \"agent.y\": new_y,\n        \"block.angle\": state[\"block.angle\"],\n        \"block.x\": state[\"block.x\"],\n        \"block.y\": state[\"block.y\"]\n    }",
      "init_params": {
        "agent_acc_factor": 1.0,
        "agent_damping": 0.1,
        "dt": 1.0
      },
      "repaired": false
    },
    {
      "name": "angular_action_coupling",
      "mechanism": "Action rotates agent's movement vector; block unaffected.",
      "code": "# HYPOTHESIS: angular_action_coupling\n# MECHANISM: Action rotates agent's movement vector; block unaffected.\nPARAMS = {\n    \"force_magnitude\": 1.0,\n    \"agent_damping\": 0.9,\n    \"dt\": 1.0\n}\n\nimport math\n\ndef step(state, action, p, meta):\n    ax, ay = action\n    angle = math.atan2(ay, ax)\n    magnitude = math.sqrt(ax*ax + ay*ay) * p[\"force_magnitude\"]\n    \n    fx = magnitude * math.cos(angle)\n    fy = magnitude * math.sin(angle)\n    \n    dt = p[\"dt\"]\n    \n    # Apply force with damping\n    new_vx = state[\"agent.vx\"] * p[\"agent_damping\"] + fx\n    new_vy = state[\"agent.vy\"] * p[\"agent_damping\"] + fy\n    \n    new_x = state[\"agent.x\"] + new_vx * dt\n    new_y = state[\"agent.y\"] + new_vy * dt\n    \n    return {\n        \"agent.vx\": new_vx,\n        \"agent.vy\": new_vy,\n        \"agent.x\": new_x,\n        \"agent.y\": new_y,\n        \"block.angle\": state[\"block.angle\"],\n        \"block.x\": state[\"block.x\"],\n        \"block.y\": state[\"block.y\"]\n    }",
      "init_params": {
        "force_magnitude": 1.0,
        "agent_damping": 0.9,
        "dt": 1.0
      },
      "repaired": false
    },
    {
      "name": "contact_interaction",
      "mechanism": "Agent interacts with block through contact when close enough; otherwise free.",
      "code": "# HYPOTHESIS: contact_interaction\n# MECHANISM: Agent interacts with block through contact when close enough; otherwise free.\nPARAMS = {\n    \"agent_acc_factor\": 1.0,\n    \"contact_distance\": 30.0,\n    \"contact_force\": 0.5,\n    \"dt\": 1.0\n}\n\nimport math\n\ndef step(state, action, p, meta):\n    ax, ay = action\n    dt = p[\"dt\"]\n    \n    # Compute agent acceleration from action\n    dvx = ax * p[\"agent_acc_factor\"]\n    dvy = ay * p[\"agent_acc_factor\"]\n    \n    new_vx = state[\"agent.vx\"] + dvx\n    new_vy = state[\"agent.vy\"] + dvy\n    \n    new_x = state[\"agent.x\"] + new_vx * dt\n    new_y = state[\"agent.y\"] + new_vy * dt\n    \n    # Check distance to block center\n    dx = new_x - state[\"block.x\"]\n    dy = new_y - state[\"block.y\"]\n    dist = math.sqrt(dx*dx + dy*dy)\n    \n    # If within contact distance, apply influence on block\n    if dist < p[\"contact_distance\"]:\n        scale = (p[\"contact_distance\"] - dist) / p[\"contact_distance\"]\n        # Block moves slightly towards agent\n        block_dx = -dx * scale * p[\"contact_force\"] * dt\n        block_dy = -dy * scale * p[\"contact_force\"] * dt\n        \n        new_block_x = state[\"block.x\"] + block_dx\n        new_block_y = state[\"block.y\"] + block_dy\n    else:\n        new_block_x = state[\"block.x\"]\n        new_block_y = state[\"block.y\"]\n    \n    return {\n        \"agent.vx\": new_vx,\n        \"agent.vy\": new_vy,\n        \"agent.x\": new_x,\n        \"agent.y\": new_y,\n        \"block.angle\": state[\"block.angle\"],\n        \"block.x\": new_block_x,\n        \"block.y\": new_block_y\n    }",
      "init_params": {
        "agent_acc_factor": 1.0,
        "contact_distance": 30.0,
        "contact_force": 0.5,
        "dt": 1.0
      },
      "repaired": false
    },
    {
      "name": "fixed_point_attraction",
      "mechanism": "Agent is attracted toward block position with action providing perturbation.",
      "code": "# HYPOTHESIS: fixed_point_attraction\n# MECHANISM: Agent is attracted toward block position with action providing perturbation.\nPARAMS = {\n    \"attraction_strength\": 0.1,\n    \"action_scale\": 1.0,\n    \"damping\": 0.9,\n    \"dt\": 1.0\n}\n\ndef step(state, action, p, meta):\n    ax, ay = action\n    dt = p[\"dt\"]\n    \n    # Compute attraction vector to block\n    dx = state[\"block.x\"] - state[\"agent.x\"]\n    dy = state[\"block.y\"] - state[\"agent.y\"]\n    \n    # Acceleration from attraction plus action\n    acc_x = dx * p[\"attraction_strength\"] + ax * p[\"action_scale\"]\n    acc_y = dy * p[\"attraction_strength\"] + ay * p[\"action_scale\"]\n    \n    # Update velocities with damping\n    new_vx = (state[\"agent.vx\"] + acc_x) * p[\"damping\"]\n    new_vy = (state[\"agent.vy\"] + acc_y) * p[\"damping\"]\n    \n    # Update positions\n    new_x = state[\"agent.x\"] + new_vx * dt\n    new_y = state[\"agent.y\"] + new_vy * dt\n    \n    return {\n        \"agent.vx\": new_vx,\n        \"agent.vy\": new_vy,\n        \"agent.x\": new_x,\n        \"agent.y\": new_y,\n        \"block.angle\": state[\"block.angle\"],\n        \"block.x\": state[\"block.x\"],\n        \"block.y\": state[\"block.y\"]\n    }",
      "init_params": {
        "attraction_strength": 0.1,
        "action_scale": 1.0,
        "damping": 0.9,
        "dt": 1.0
      },
      "repaired": false
    },
    {
      "name": "saturated_control_response",
      "mechanism": "Agent responds with capped acceleration; block can rotate but not translate.",
      "code": "# HYPOTHESIS: saturated_control_response\n# MECHANISM: Agent responds with capped acceleration; block can rotate but not translate.\nPARAMS = {\n    \"max_acc\": 100.0,\n    \"torque_factor\": 0.5,\n    \"mass\": 1.0,\n    \"dt\": 1.0\n}\n\nimport math\n\ndef step(state, action, p, meta):\n    ax, ay = action\n    dt = p[\"dt\"]\n    \n    # Cap the control inputs\n    mag = math.sqrt(ax*ax + ay*ay)\n    if mag > 1e-6:\n        scale = min(p[\"max_acc\"], mag) / mag\n        ax *= scale\n        ay *= scale\n    \n    # Apply forces directly as accelerations (assuming unit mass)\n    new_vx = state[\"agent.vx\"] + ax * dt\n    new_vy = state[\"agent.vy\"] + ay * dt\n    \n    new_x = state[\"agent.x\"] + new_vx * dt\n    new_y = state[\"agent.y\"] + new_vy * dt\n    \n    # Torque affects rotation if agent gets near block\n    dx = state[\"agent.x\"] - state[\"block.x\"]\n    dy = state[\"agent.y\"] - state[\"block.y\"]\n    distance = max(1e-3, math.sqrt(dx*dx + dy*dy))\n    \n    torque = (ax * (-dy) + ay * dx) / (distance + 1) * p[\"torque_factor\"] * dt\n    new_angle = state[\"block.angle\"] + torque\n    \n    # Clamp angle to valid range\n    new_angle = new_angle % (2 * math.pi)\n    \n    return {\n        \"agent.vx\": new_vx,\n        \"agent.vy\": new_vy,\n        \"agent.x\": new_x,\n        \"agent.y\": new_y,\n        \"block.angle\": new_angle,\n        \"block.x\": state[\"block.x\"],\n        \"block.y\": state[\"block.y\"]\n    }",
      "init_params": {
        "max_acc": 100.0,
        "torque_factor": 0.5,
        "mass": 1.0,
        "dt": 1.0
      },
      "repaired": false
    }
