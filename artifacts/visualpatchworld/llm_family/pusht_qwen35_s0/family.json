      "name": "linear_kinematic_baseline",
      "mechanism": "Agent follows simple linear kinematics with action directly setting velocity change; block is static.",
      "code": "# HYPOTHESIS: linear_kinematic_baseline\n# MECHANISM: Agent follows simple linear kinematics with action directly setting velocity change; block is static.\nPARAMS = {\"action_gain\": 350.0, \"friction\": 0.02, \"dt\": 0.08}\n\ndef step(state, action, p, meta):\n    import math\n    s = state.copy()\n    ax, ay = action[0], action[1]\n    vx_old, vy_old = s[\"agent.vx\"], s[\"agent.vy\"]\n    dvx = p[\"action_gain\"] * ax - p[\"friction\"] * vx_old\n    dvy = p[\"action_gain\"] * ay - p[\"friction\"] * vy_old\n    s[\"agent.vx\"] = vx_old + dvx\n    s[\"agent.vy\"] = vy_old + dvy\n    s[\"agent.x\"] = s[\"agent.x\"] + s[\"agent.vx\"] * p[\"dt\"]\n    s[\"agent.y\"] = s[\"agent.y\"] + s[\"agent.vy\"] * p[\"dt\"]\n    s[\"block.angle\"] = state[\"block.angle\"]\n    s[\"block.x\"] = state[\"block.x\"]\n    s[\"block.y\"] = state[\"block.y\"]\n    return s",
      "init_params": {
        "action_gain": 350.0,
        "friction": 0.02,
        "dt": 0.08
      },
      "repaired": false
    },
    {
      "name": "acceleration_with_drag",
      "mechanism": "Action produces acceleration; velocity experiences quadratic drag; block remains static.",
      "code": "# HYPOTHESIS: acceleration_with_drag\n# MECHANISM: Action produces acceleration; velocity experiences quadratic drag; block remains static.\nPARAMS = {\"action_accel\": 4000.0, \"drag_linear\": 0.1, \"drag_quad\": 0.001, \"dt\": 0.08}\n\ndef step(state, action, p, meta):\n    import math\n    s = state.copy()\n    ax, ay = action[0], action[1]\n    vx, vy = s[\"agent.vx\"], s[\"agent.vy\"]\n    speed = math.sqrt(vx*vx + vy*vy + 1e-9)\n    dvx = p[\"action_accel\"] * ax - p[\"drag_linear\"] * vx - p[\"drag_quad\"] * vx * speed\n    dvy = p[\"action_accel\"] * ay - p[\"drag_linear\"] * vy - p[\"drag_quad\"] * vy * speed\n    s[\"agent.vx\"] = vx + dvx * p[\"dt\"]\n    s[\"agent.vy\"] = vy + dvy * p[\"dt\"]\n    s[\"agent.x\"] = s[\"agent.x\"] + s[\"agent.vx\"] * p[\"dt\"]\n    s[\"agent.y\"] = s[\"agent.y\"] + s[\"agent.vy\"] * p[\"dt\"]\n    s[\"block.angle\"] = state[\"block.angle\"]\n    s[\"block.x\"] = state[\"block.x\"]\n    s[\"block.y\"] = state[\"block.y\"]\n    return s",
      "init_params": {
        "action_accel": 4000.0,
        "drag_linear": 0.1,
        "drag_quad": 0.001,
        "dt": 0.08
      },
      "repaired": false
    },
    {
      "name": "contact_driven_block",
      "mechanism": "Block moves only when agent is within contact distance; otherwise block is static.",
      "code": "# HYPOTHESIS: contact_driven_block\n# MECHANISM: Block moves only when agent is within contact distance; otherwise block is static.\nPARAMS = {\"action_gain\": 350.0, \"friction\": 0.02, \"contact_dist\": 50.0, \"block_response\": 0.1, \"dt\": 0.08}\n\ndef step(state, action, p, meta):\n    import math\n    s = state.copy()\n    ax, ay = action[0], action[1]\n    vx_old, vy_old = s[\"agent.vx\"], s[\"agent.vy\"]\n    dvx = p[\"action_gain\"] * ax - p[\"friction\"] * vx_old\n    dvy = p[\"action_gain\"] * ay - p[\"friction\"] * vy_old\n    s[\"agent.vx\"] = vx_old + dvx\n    s[\"agent.vy\"] = vy_old + dvy\n    s[\"agent.x\"] = s[\"agent.x\"] + s[\"agent.vx\"] * p[\"dt\"]\n    s[\"agent.y\"] = s[\"agent.y\"] + s[\"agent.vy\"] * p[\"dt\"]\n    dist = math.sqrt((s[\"agent.x\"] - state[\"block.x\"])**2 + (s[\"agent.y\"] - state[\"block.y\"])**2)\n    if dist < p[\"contact_dist\"]:\n        s[\"block.x\"] = state[\"block.x\"] + p[\"block_response\"] * (s[\"agent.x\"] - state[\"block.x\"])\n        s[\"block.y\"] = state[\"block.y\"] + p[\"block_response\"] * (s[\"agent.y\"] - state[\"block.y\"])\n        s[\"block.angle\"] = state[\"block.angle\"] + p[\"block_response\"] * 0.01\n    else:\n        s[\"block.x\"] = state[\"block.x\"]\n        s[\"block.y\"] = state[\"block.y\"]\n        s[\"block.angle\"] = state[\"block.angle\"]\n    return s",
      "init_params": {
        "action_gain": 350.0,
        "friction": 0.02,
        "contact_dist": 50.0,
        "block_response": 0.1,
        "dt": 0.08
      },
      "repaired": false
    },
    {
      "name": "velocity_saturation",
      "mechanism": "Action affects velocity but velocity is clamped to maximum speed; block is static.",
      "code": "# HYPOTHESIS: velocity_saturation\n# MECHANISM: Action affects velocity but velocity is clamped to maximum speed; block is static.\nPARAMS = {\"action_gain\": 350.0, \"friction\": 0.02, \"max_speed\": 200.0, \"dt\": 0.08}\n\ndef step(state, action, p, meta):\n    import math\n    s = state.copy()\n    ax, ay = action[0], action[1]\n    vx_old, vy_old = s[\"agent.vx\"], s[\"agent.vy\"]\n    dvx = p[\"action_gain\"] * ax - p[\"friction\"] * vx_old\n    dvy = p[\"action_gain\"] * ay - p[\"friction\"] * vy_old\n    vx_new = vx_old + dvx\n    vy_new = vy_old + dvy\n    speed = math.sqrt(vx_new*vx_new + vy_new*vy_new)\n    if speed > p[\"max_speed\"]:\n        scale = p[\"max_speed\"] / (speed + 1e-9)\n        vx_new *= scale\n        vy_new *= scale\n    s[\"agent.vx\"] = vx_new\n    s[\"agent.vy\"] = vy_new\n    s[\"agent.x\"] = s[\"agent.x\"] + s[\"agent.vx\"] * p[\"dt\"]\n    s[\"agent.y\"] = s[\"agent.y\"] + s[\"agent.vy\"] * p[\"dt\"]\n    s[\"block.angle\"] = state[\"block.angle\"]\n    s[\"block.x\"] = state[\"block.x\"]\n    s[\"block.y\"] = state[\"block.y\"]\n    return s",
      "init_params": {
        "action_gain": 350.0,
        "friction": 0.02,
        "max_speed": 200.0,
        "dt": 0.08
      },
      "repaired": false
    },
    {
      "name": "momentum_coupling",
      "mechanism": "Agent and block exchange momentum when close; action affects agent momentum directly.",
      "code": "# HYPOTHESIS: momentum_coupling\n# MECHANISM: Agent and block exchange momentum when close; action affects agent momentum directly.\nPARAMS = {\"action_force\": 300.0, \"friction\": 0.02, \"coupling_strength\": 0.05, \"coupling_dist\": 60.0, \"dt\": 0.08}\n\ndef step(state, action, p, meta):\n    import math\n    s = state.copy()\n    ax, ay = action[0], action[1]\n    vx, vy = s[\"agent.vx\"], s[\"agent.vy\"]\n    dvx = p[\"action_force\"] * ax - p[\"friction\"] * vx\n    dvy = p[\"action_force\"] * ay - p[\"friction\"] * vy\n    dist = math.sqrt((s[\"agent.x\"] - state[\"block.x\"])**2 + (s[\"agent.y\"] - state[\"block.y\"])**2)\n    if dist < p[\"coupling_dist\"] and dist > 1e-6:\n        nx = (s[\"agent.x\"] - state[\"block.x\"]) / dist\n        ny = (s[\"agent.y\"] - state[\"block.y\"]) / dist\n        dvx -= p[\"coupling_strength\"] * vx * nx\n        dvy -= p[\"coupling_strength\"] * vy * ny\n    s[\"agent.vx\"] = vx + dvx\n    s[\"agent.vy\"] = vy + dvy\n    s[\"agent.x\"] = s[\"agent.x\"] + s[\"agent.vx\"] * p[\"dt\"]\n    s[\"agent.y\"] = s[\"agent.y\"] + s[\"agent.vy\"] * p[\"dt\"]\n    s[\"block.x\"] = state[\"block.x\"]\n    s[\"block.y\"] = state[\"block.y\"]\n    s[\"block.angle\"] = state[\"block.angle\"]\n    return s",
      "init_params": {
        "action_force": 300.0,
        "friction": 0.02,
        "coupling_strength": 0.05,
        "coupling_dist": 60.0,
        "dt": 0.08
      },
      "repaired": false
    },
    {
      "name": "action_nonlinearity",
      "mechanism": "Action effect is nonlinear (sigmoidal saturation); velocity decay is exponential; block static.",
      "code": "# HYPOTHESIS: action_nonlinearity\n# MECHANISM: Action effect is nonlinear (sigmoidal saturation); velocity decay is exponential; block static.\nPARAMS = {\"action_scale\": 400.0, \"action_knee\": 0.3, \"decay_rate\": 0.05, \"dt\": 0.08}\n\ndef step(state, action, p, meta):\n    import math\n    s = state.copy()\n    ax, ay = action[0], action[1]\n    def saturate(a, k, scale):\n        return scale * math.tanh(a / (k + 1e-9))\n    vx, vy = s[\"agent.vx\"], s[\"agent.vy\"]\n    dvx = saturate(ax, p[\"action_knee\"], p[\"action_scale\"]) - p[\"decay_rate\"] * vx\n    dvy = saturate(ay, p[\"action_knee\"], p[\"action_scale\"]) - p[\"decay_rate\"] * vy\n    s[\"agent.vx\"] = vx + dvx\n    s[\"agent.vy\"] = vy + dvy\n    s[\"agent.x\"] = s[\"agent.x\"] + s[\"agent.vx\"] * p[\"dt\"]\n    s[\"agent.y\"] = s[\"agent.y\"] + s[\"agent.vy\"] * p[\"dt\"]\n    s[\"block.angle\"] = state[\"block.angle\"]\n    s[\"block.x\"] = state[\"block.x\"]\n    s[\"block.y\"] = state[\"block.y\"]\n    return s",
      "init_params": {
        "action_scale": 400.0,
        "action_knee": 0.3,
        "decay_rate": 0.05,
        "dt": 0.08
      },
