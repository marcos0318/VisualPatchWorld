  "candidates": [
    {
      "name": "linear_no_coupling",
      "mechanism": "Arm moves linearly with action, finger follows arm rigidly, no coupling between objects",
      "code": "# HYPOTHESIS: linear_no_coupling\n# MECHANISM: Arm moves linearly with action, finger follows arm rigidly, no coupling between objects\nPARAMS = {\"arm_gain_x\": 0.5, \"arm_gain_y\": 0.5, \"dt\": 1.0}\n\ndef step(state, action, p, meta):\n    arm_x = state[\"arm.x\"] + action[0] * p[\"arm_gain_x\"] * p[\"dt\"]\n    arm_y = state[\"arm.y\"] + action[1] * p[\"arm_gain_y\"] * p[\"dt\"]\n    \n    # Finger position relative to arm remains constant\n    finger_dx = state[\"finger.x\"] - state[\"arm.x\"]\n    finger_dy = state[\"finger.y\"] - state[\"arm.y\"]\n    \n    finger_x = arm_x + finger_dx\n    finger_y = arm_y + finger_dy\n    \n    return {\n        \"arm.x\": arm_x,\n        \"arm.y\": arm_y,\n        \"finger.x\": finger_x,\n        \"finger.y\": finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "arm_gain_x": 0.5,
        "arm_gain_y": 0.5,
        "dt": 1.0
      },
      "repaired": false
    },
    {
      "name": "momentum_arm",
      "mechanism": "Arm has momentum/inertia, finger follows arm with slight elasticity",
      "code": "# HYPOTHESIS: momentum_arm\n# MECHANISM: Arm has momentum/inertia, finger follows arm with slight elasticity\nPARAMS = {\"arm_mass\": 1.0, \"arm_damping\": 0.1, \"spring_constant\": 2.0, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    # Assume hidden velocity states for arm\n    # For simulation, approximate velocities from position changes\n    # Since we don't have previous state, use action as impulse\n    \n    # Apply force to arm (action is like impulse)\n    acc_x = action[0] - p[\"arm_damping\"] * (state[\"arm.x\"] - 0) / p[\"arm_mass\"]\n    acc_y = action[1] - p[\"arm_damping\"] * (state[\"arm.y\"] - 0) / p[\"arm_mass\"]\n    \n    # Update positions with Euler integration\n    new_arm_x = state[\"arm.x\"] + acc_x * p[\"dt\"]**2 / 2\n    new_arm_y = state[\"arm.y\"] + acc_y * p[\"dt\"]**2 / 2\n    \n    # Finger follows arm with spring-like behavior\n    finger_offset_x = state[\"finger.x\"] - state[\"arm.x\"]\n    finger_offset_y = state[\"finger.y\"] - state[\"arm.y\"]\n    \n    spring_force_x = -p[\"spring_constant\"] * finger_offset_x\n    spring_force_y = -p[\"spring_constant\"] * finger_offset_y\n    \n    new_finger_x = state[\"finger.x\"] + finger_offset_x * p[\"dt\"] + spring_force_x * p[\"dt\"]**2\n    new_finger_y = state[\"finger.y\"] + finger_offset_y * p[\"dt\"] + spring_force_y * p[\"dt\"]**2\n    \n    return {\n        \"arm.x\": new_arm_x,\n        \"arm.y\": new_arm_y,\n        \"finger.x\": new_finger_x,\n        \"finger.y\": new_finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "arm_mass": 1.0,
        "arm_damping": 0.1,
        "spring_constant": 2.0,
        "dt": 0.1
      },
      "repaired": false
    },
    {
      "name": "bounded_control_saturation",
      "mechanism": "Actions are subject to magnitude limits before affecting motion, with linear response otherwise",
      "code": "# HYPOTHESIS: bounded_control_saturation\n# MECHANISM: Actions are subject to magnitude limits before affecting motion, with linear response otherwise\nPARAMS = {\"max_action_mag\": 1.0, \"arm_gain_x\": 0.5, \"arm_gain_y\": 0.5, \"dt\": 1.0}\n\ndef step(state, action, p, meta):\n    # Saturate action magnitude\n    act_mag = math.sqrt(action[0]**2 + action[1]**2)\n    if act_mag > p[\"max_action_mag\"]:\n        scale = p[\"max_action_mag\"] / act_mag\n        act_x = action[0] * scale\n        act_y = action[1] * scale\n    else:\n        act_x = action[0]\n        act_y = action[1]\n        \n    arm_x = state[\"arm.x\"] + act_x * p[\"arm_gain_x\"] * p[\"dt\"]\n    arm_y = state[\"arm.y\"] + act_y * p[\"arm_gain_y\"] * p[\"dt\"]\n    \n    # Finger position relative to arm remains constant\n    finger_dx = state[\"finger.x\"] - state[\"arm.x\"]\n    finger_dy = state[\"finger.y\"] - state[\"arm.y\"]\n    \n    finger_x = arm_x + finger_dx\n    finger_y = arm_y + finger_dy\n    \n    return {\n        \"arm.x\": arm_x,\n        \"arm.y\": arm_y,\n        \"finger.x\": finger_x,\n        \"finger.y\": finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "max_action_mag": 1.0,
        "arm_gain_x": 0.5,
        "arm_gain_y": 0.5,
        "dt": 1.0
      },
      "repaired": false
    },
    {
      "name": "finger_actuation",
      "mechanism": "Finger can move independently of arm through its own control channel",
      "code": "# HYPOTHESIS: finger_actuation\n# MECHANISM: Finger can move independently of arm through its own control channel\nPARAMS = {\"arm_gain_x\": 0.5, \"arm_gain_y\": 0.5, \"finger_gain_x\": 0.3, \"finger_gain_y\": 0.3, \"dt\": 1.0}\n\ndef step(state, action, p, meta):\n    arm_x = state[\"arm.x\"] + action[0] * p[\"arm_gain_x\"] * p[\"dt\"]\n    arm_y = state[\"arm.y\"] + action[1] * p[\"arm_gain_y\"] * p[\"dt\"]\n    \n    # Finger has independent movement based on action\n    finger_x = state[\"finger.x\"] + action[0] * p[\"finger_gain_x\"] * p[\"dt\"]\n    finger_y = state[\"finger.y\"] + action[1] * p[\"finger_gain_y\"] * p[\"dt\"]\n    \n    return {\n        \"arm.x\": arm_x,\n        \"arm.y\": arm_y,\n        \"finger.x\": finger_x,\n        \"finger.y\": finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "arm_gain_x": 0.5,
        "arm_gain_y": 0.5,
        "finger_gain_x": 0.3,
        "finger_gain_y": 0.3,
        "dt": 1.0
      },
      "repaired": false
    },
    {
      "name": "workspace_limits",
      "mechanism": "Motion is clamped to rectangular workspace boundaries",
      "code": "# HYPOTHESIS: workspace_limits\n# MECHANISM: Motion is clamped to rectangular workspace boundaries\nPARAMS = {\"arm_gain_x\": 0.5, \"arm_gain_y\": 0.5, \"workspace_min_x\": -5.0, \"workspace_max_x\": 5.0, \n          \"workspace_min_y\": -3.0, \"workspace_max_y\": 3.0, \"dt\": 1.0}\n\ndef step(state, action, p, meta):\n    proposed_arm_x = state[\"arm.x\"] + action[0] * p[\"arm_gain_x\"] * p[\"dt\"]\n    proposed_arm_y = state[\"arm.y\"] + action[1] * p[\"arm_gain_y\"] * p[\"dt\"]\n    \n    # Clamp to workspace boundaries\n    arm_x = max(p[\"workspace_min_x\"], min(p[\"workspace_max_x\"], proposed_arm_x))\n    arm_y = max(p[\"workspace_min_y\"], min(p[\"workspace_max_y\"], proposed_arm_y))\n    \n    # Finger position relative to arm remains constant\n    finger_dx = state[\"finger.x\"] - state[\"arm.x\"]\n    finger_dy = state[\"finger.y\"] - state[\"arm.y\"]\n    \n    finger_x = arm_x + finger_dx\n    finger_y = arm_y + finger_dy\n    \n    return {\n        \"arm.x\": arm_x,\n        \"arm.y\": arm_y,\n        \"finger.x\": finger_x,\n        \"finger.y\": finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "arm_gain_x": 0.5,
        "arm_gain_y": 0.5,
        "workspace_min_x": -5.0,
        "workspace_max_x": 5.0,
        "workspace_min_y": -3.0,
        "workspace_max_y": 3.0,
        "dt": 1.0
      },
      "repaired": false
    },
    {
      "name": "coupled_nonlinear_dynamics",
      "mechanism": "Arm and finger positions affect each other through nonlinear coupling terms",
      "code": "# HYPOTHESIS: coupled_nonlinear_dynamics\n# MECHANISM: Arm and finger positions affect each other through nonlinear coupling terms\nPARAMS = {\"base_gain_x\": 0.5, \"base_gain_y\": 0.5, \"coupling_strength\": 0.1, \"nonlinearity_power\": 2.0, \"dt\": 1.0}\n\ndef step(state, action, p, meta):\n    # Nonlinear coupling based on distance between arm and finger\n    dx = state[\"finger.x\"] - state[\"arm.x\"]\n    dy = state[\"finger.y\"] - state[\"arm.y\"]\n    dist = math.sqrt(dx*dx + dy*dy + 1e-8)  # Small epsilon to avoid division by zero\n    \n    coupling_x = p[\"coupling_strength\"] * dx / (dist**(p[\"nonlinearity_power\"]-1) + 1e-8)\n    coupling_y = p[\"coupling_strength\"] * dy / (dist**(p[\"nonlinearity_power\"]-1) + 1e-8)\n    \n    arm_x = state[\"arm.x\"] + (action[0] * p[\"base_gain_x\"] + coupling_x) * p[\"dt\"]\n    arm_y = state[\"arm.y\"] + (action[1] * p[\"base_gain_y\"] + coupling_y) * p[\"dt\"]\n    \n    finger_x = state[\"finger.x\"] + (action[0] * p[\"base_gain_x\"] - coupling_x) * p[\"dt\"]\n    finger_y = state[\"finger.y\"] + (action[1] * p[\"base_gain_y\"] - coupling_y) * p[\"dt\"]\n    \n    return {\n        \"arm.x\": arm_x,\n        \"arm.y\": arm_y,\n        \"finger.x\": finger_x,\n        \"finger.y\": finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "base_gain_x": 0.5,
        "base_gain_y": 0.5,
        "coupling_strength": 0.1,
        "nonlinearity_power": 2.0,
        "dt": 1.0
      },
      "repaired": false
    }
