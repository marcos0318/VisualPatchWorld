    {
      "name": "direct_position_control",
      "mechanism": "Action directly commands position displacement with independent diagonal gains per variable.",
      "code": "# HYPOTHESIS: direct_position_control\n# MECHANISM: Action directly commands position displacement with independent diagonal gains per variable.\nPARAMS = {\"arm_gain_x\": 0.1, \"arm_gain_y\": 0.1, \"finger_gain_x\": 0.05, \"finger_gain_y\": 0.05}\n\ndef step(state, action, p, meta):\n    ns = dict(state)\n    ns[\"arm.x\"] = state[\"arm.x\"] + p[\"arm_gain_x\"] * action[0]\n    ns[\"arm.y\"] = state[\"arm.y\"] + p[\"arm_gain_y\"] * action[1]\n    ns[\"finger.x\"] = state[\"finger.x\"] + p[\"finger_gain_x\"] * action[0]\n    ns[\"finger.y\"] = state[\"finger.y\"] + p[\"finger_gain_y\"] * action[1]\n    return ns",
      "init_params": {
        "arm_gain_x": 0.1,
        "arm_gain_y": 0.1,
        "finger_gain_x": 0.05,
        "finger_gain_y": 0.05
      },
      "repaired": false
    },
    {
      "name": "velocity_integration",
      "mechanism": "Action commands velocity; position integrates velocity with first-order lag dynamics.",
      "code": "# HYPOTHESIS: velocity_integration\n# MECHANISM: Action commands velocity; position integrates velocity with first-order lag dynamics.\nPARAMS = {\"arm_vel_scale\": 0.3, \"finger_vel_scale\": 0.08, \"arm_friction\": 0.05, \"finger_friction\": 0.1}\n\ndef step(state, action, p, meta):\n    ns = dict(state)\n    v_arm_x = p[\"arm_vel_scale\"] * action[0]\n    v_arm_y = p[\"arm_vel_scale\"] * action[1]\n    v_finger_x = p[\"finger_vel_scale\"] * action[0]\n    v_finger_y = p[\"finger_vel_scale\"] * action[1]\n    ns[\"arm.x\"] = state[\"arm.x\"] + v_arm_x - p[\"arm_friction\"] * state[\"arm.x\"]\n    ns[\"arm.y\"] = state[\"arm.y\"] + v_arm_y - p[\"arm_friction\"] * state[\"arm.y\"]\n    ns[\"finger.x\"] = state[\"finger.x\"] + v_finger_x - p[\"finger_friction\"] * state[\"finger.x\"]\n    ns[\"finger.y\"] = state[\"finger.y\"] + v_finger_y - p[\"finger_friction\"] * state[\"finger.y\"]\n    return ns",
      "init_params": {
        "arm_vel_scale": 0.3,
        "finger_vel_scale": 0.08,
        "arm_friction": 0.05,
        "finger_friction": 0.1
      },
      "repaired": false
    },
    {
      "name": "kinematic_chain",
      "mechanism": "Finger is end-effector mounted on arm; finger position partially follows arm movement.",
      "code": "# HYPOTHESIS: kinematic_chain\n# MECHANISM: Finger is end-effector mounted on arm; finger position partially follows arm movement.\nPARAMS = {\"arm_gain_x\": 0.1, \"arm_gain_y\": 0.1, \"finger_independent_gain\": 0.03, \"finger_couple_ratio\": 0.5}\n\ndef step(state, action, p, meta):\n    ns = dict(state)\n    new_arm_x = state[\"arm.x\"] + p[\"arm_gain_x\"] * action[0]\n    new_arm_y = state[\"arm.y\"] + p[\"arm_gain_y\"] * action[1]\n    arm_dx = new_arm_x - state[\"arm.x\"]\n    arm_dy = new_arm_y - state[\"arm.y\"]\n    ns[\"arm.x\"] = new_arm_x\n    ns[\"arm.y\"] = new_arm_y\n    ns[\"finger.x\"] = state[\"finger.x\"] + p[\"finger_couple_ratio\"] * arm_dx + p[\"finger_independent_gain\"] * action[0]\n    ns[\"finger.y\"] = state[\"finger.y\"] + p[\"finger_couple_ratio\"] * arm_dy + p[\"finger_independent_gain\"] * action[1]\n    return ns",
      "init_params": {
        "arm_gain_x": 0.1,
        "arm_gain_y": 0.1,
        "finger_independent_gain": 0.03,
        "finger_couple_ratio": 0.5
      },
      "repaired": false
    },
    {
      "name": "boundary_saturation",
      "mechanism": "Control gain saturates smoothly near workspace boundaries via sigmoid gain scheduling.",
      "code": "# HYPOTHESIS: boundary_saturation\n# MECHANISM: Control gain saturates smoothly near workspace boundaries via sigmoid gain scheduling.\nPARAMS = {\"base_gain_arm\": 0.1, \"base_gain_finger\": 0.05, \"boundary_arm\": 4.5, \"boundary_finger\": 0.2, \"saturation_steepness\": 1.0}\n\ndef step(state, action, p, meta):\n    import math\n    ns = dict(state)\n    def sat_factor(pos, bound, steep):\n        dist = abs(pos)\n        margin = bound - dist\n        return 1.0 / (1.0 + math.exp(-steep * margin))\n    arm_sat = sat_factor((state[\"arm.x\"]**2 + state[\"arm.y\"]**2)**0.5, p[\"boundary_arm\"], p[\"saturation_steepness\"])\n    finger_sat = sat_factor((state[\"finger.x\"]**2 + state[\"finger.y\"]**2)**0.5, p[\"boundary_finger\"], p[\"saturation_steepness\"])\n    ns[\"arm.x\"] = state[\"arm.x\"] + p[\"base_gain_arm\"] * action[0] * arm_sat\n    ns[\"arm.y\"] = state[\"arm.y\"] + p[\"base_gain_arm\"] * action[1] * arm_sat\n    ns[\"finger.x\"] = state[\"finger.x\"] + p[\"base_gain_finger\"] * action[0] * finger_sat\n    ns[\"finger.y\"] = state[\"finger.y\"] + p[\"base_gain_finger\"] * action[1] * finger_sat\n    return ns",
      "init_params": {
        "base_gain_arm": 0.1,
        "base_gain_finger": 0.05,
        "boundary_arm": 4.5,
        "boundary_finger": 0.2,
        "saturation_steepness": 1.0
      },
      "repaired": false
    },
    {
      "name": "cross_coupled_control",
      "mechanism": "Each action component affects both x and y axes through full 2x2 gain matrices.",
      "code": "# HYPOTHESIS: cross_coupled_control\n# MECHANISM: Each action component affects both x and y axes through full 2x2 gain matrices.\nPARAMS = {\"arm_g_xx\": 0.1, \"arm_g_xy\": 0.02, \"arm_g_yx\": 0.02, \"arm_g_yy\": 0.1, \"finger_g_xx\": 0.05, \"finger_g_xy\": 0.01, \"finger_g_yx\": 0.01, \"finger_g_yy\": 0.05}\n\ndef step(state, action, p, meta):\n    ns = dict(state)\n    ns[\"arm.x\"] = state[\"arm.x\"] + p[\"arm_g_xx\"] * action[0] + p[\"arm_g_xy\"] * action[1]\n    ns[\"arm.y\"] = state[\"arm.y\"] + p[\"arm_g_yx\"] * action[0] + p[\"arm_g_yy\"] * action[1]\n    ns[\"finger.x\"] = state[\"finger.x\"] + p[\"finger_g_xx\"] * action[0] + p[\"finger_g_xy\"] * action[1]\n    ns[\"finger.y\"] = state[\"finger.y\"] + p[\"finger_g_yx\"] * action[0] + p[\"finger_g_yy\"] * action[1]\n    return ns",
      "init_params": {
        "arm_g_xx": 0.1,
        "arm_g_xy": 0.02,
        "arm_g_yx": 0.02,
        "arm_g_yy": 0.1,
        "finger_g_xx": 0.05,
        "finger_g_xy": 0.01,
        "finger_g_yx": 0.01,
        "finger_g_yy": 0.05
      },
      "repaired": false
    },
    {
      "name": "target_attractor",
      "mechanism": "Motion combines action response with spring-like attraction toward target position.",
      "code": "# HYPOTHESIS: target_attractor\n# MECHANISM: Motion combines action response with spring-like attraction toward target position.\nPARAMS = {\"arm_action_gain\": 0.1, \"finger_action_gain\": 0.05, \"arm_spring_k\": 0.01, \"finger_spring_k\": 0.02}\n\ndef step(state, action, p, meta):\n    ns = dict(state)\n    arm_dx = p[\"arm_action_gain\"] * action[0] + p[\"arm_spring_k\"] * (state[\"target.x\"] - state[\"arm.x\"])\n    arm_dy = p[\"arm_action_gain\"] * action[1] + p[\"arm_spring_k\"] * (state[\"target.y\"] - state[\"arm.y\"])\n    finger_dx = p[\"finger_action_gain\"] * action[0] + p[\"finger_spring_k\"] * (state[\"target.x\"] - state[\"finger.x\"])\n    finger_dy = p[\"finger_action_gain\"] * action[1] + p[\"finger_spring_k\"] * (state[\"target.y\"] - state[\"finger.y\"])\n    ns[\"arm.x\"] = state[\"arm.x\"] + arm_dx\n    ns[\"arm.y\"] = state[\"arm.y\"] + arm_dy\n    ns[\"finger.x\"] = state[\"finger.x\"] + finger_dx\n    ns[\"finger.y\"] = state[\"finger.y\"] + finger_dy\n    return ns",
      "init_params": {
        "arm_action_gain": 0.1,
        "finger_action_gain": 0.05,
        "arm_spring_k": 0.01,
        "finger_spring_k": 0.02
      },
      "repaired": false
    }
