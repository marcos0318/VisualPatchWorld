    {
      "name": "linear_no_momentum",
      "mechanism": "Agent moves with linear response to action, no momentum, no obstacles.",
      "code": "# HYPOTHESIS: linear_no_momentum\n# MECHANISM: Agent moves with linear response to action, no momentum, no obstacles.\nPARAMS = {\"speed\": 25.0}\n\ndef step(state, action, p, meta):\n    dx = action[0] * p[\"speed\"]\n    dy = action[1] * p[\"speed\"]\n    return {\n        \"agent.x\": state[\"agent.x\"] + dx,\n        \"agent.y\": state[\"agent.y\"] + dy,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }",
      "init_params": {
        "speed": 25.0
      },
      "repaired": false
    },
    {
      "name": "momentum_xy",
      "mechanism": "Agent has velocity that changes gradually based on action; first-order momentum.",
      "code": "# HYPOTHESIS: momentum_xy\n# MECHANISM: Agent has velocity that changes gradually based on action; first-order momentum.\nPARAMS = {\"acceleration\": 20.0, \"drag\": 0.8}\n\ndef step(state, action, p, meta):\n    vx = state.get(\"agent.vx\", 0.0)\n    vy = state.get(\"agent.vy\", 0.0)\n    dvx = action[0] * p[\"acceleration\"]\n    dvy = action[1] * p[\"acceleration\"]\n    vx_new = (vx + dvx) * p[\"drag\"]\n    vy_new = (vy + dvy) * p[\"drag\"]\n    return {\n        \"agent.x\": state[\"agent.x\"] + vx_new,\n        \"agent.y\": state[\"agent.y\"] + vy_new,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n        \"agent.vx\": vx_new,\n        \"agent.vy\": vy_new,\n    }",
      "init_params": {
        "acceleration": 20.0,
        "drag": 0.8
      },
      "repaired": false
    },
    {
      "name": "velocity_clamp",
      "mechanism": "Agent accelerates with momentum but velocity magnitude is capped.",
      "code": "# HYPOTHESIS: velocity_clamp\n# MECHANISM: Agent accelerates with momentum but velocity magnitude is capped.\nPARAMS = {\"acceleration\": 15.0, \"drag\": 0.7, \"max_speed\": 10.0}\n\ndef step(state, action, p, meta):\n    vx = state.get(\"agent.vx\", 0.0)\n    vy = state.get(\"agent.vy\", 0.0)\n    dvx = action[0] * p[\"acceleration\"]\n    dvy = action[1] * p[\"acceleration\"]\n    vx_new = (vx + dvx) * p[\"drag\"]\n    vy_new = (vy + dvy) * p[\"drag\"]\n    speed = math.sqrt(vx_new**2 + vy_new**2)\n    if speed > p[\"max_speed\"] > 0:\n        scale = p[\"max_speed\"] / speed\n        vx_new *= scale\n        vy_new *= scale\n    return {\n        \"agent.x\": state[\"agent.x\"] + vx_new,\n        \"agent.y\": state[\"agent.y\"] + vy_new,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n        \"agent.vx\": vx_new,\n        \"agent.vy\": vy_new,\n    }",
      "init_params": {
        "acceleration": 15.0,
        "drag": 0.7,
        "max_speed": 10.0
      },
      "repaired": false
    },
    {
      "name": "directional_friction",
      "mechanism": "Motion is resisted differently along x vs y axes (anisotropic friction).",
      "code": "# HYPOTHESIS: directional_friction\n# MECHANISM: Motion is resisted differently along x vs y axes (anisotropic friction).\nPARAMS = {\"acc_x\": 20.0, \"acc_y\": 20.0, \"drag_x\": 0.8, \"drag_y\": 0.9}\n\ndef step(state, action, p, meta):\n    vx = state.get(\"agent.vx\", 0.0)\n    vy = state.get(\"agent.vy\", 0.0)\n    dvx = action[0] * p[\"acc_x\"]\n    dvy = action[1] * p[\"acc_y\"]\n    vx_new = (vx + dvx) * p[\"drag_x\"]\n    vy_new = (vy + dvy) * p[\"drag_y\"]\n    return {\n        \"agent.x\": state[\"agent.x\"] + vx_new,\n        \"agent.y\": state[\"agent.y\"] + vy_new,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n        \"agent.vx\": vx_new,\n        \"agent.vy\": vy_new,\n    }",
      "init_params": {
        "acc_x": 20.0,
        "acc_y": 20.0,
        "drag_x": 0.8,
        "drag_y": 0.9
      },
      "repaired": false
    },
    {
      "name": "attract_to_target",
      "mechanism": "Agent is attracted toward the target position with controllable strength.",
      "code": "# HYPOTHESIS: attract_to_target\n# MECHANISM: Agent is attracted toward the target position with controllable strength.\nPARAMS = {\"control_gain\": 15.0, \"attraction_strength\": 0.05, \"drag\": 0.85}\n\ndef step(state, action, p, meta):\n    ax = action[0] * p[\"control_gain\"]\n    ay = action[1] * p[\"control_gain\"]\n    tx = state[\"target.x\"]\n    ty = state[\"target.y\"]\n    px = state[\"agent.x\"]\n    py = state[\"agent.y\"]\n    attract_x = (tx - px) * p[\"attraction_strength\"]\n    attract_y = (ty - py) * p[\"attraction_strength\"]\n    vx = state.get(\"agent.vx\", 0.0)\n    vy = state.get(\"agent.vy\", 0.0)\n    dvx = ax + attract_x\n    dvy = ay + attract_y\n    vx_new = (vx + dvx) * p[\"drag\"]\n    vy_new = (vy + dvy) * p[\"drag\"]\n    return {\n        \"agent.x\": state[\"agent.x\"] + vx_new,\n        \"agent.y\": state[\"agent.y\"] + vy_new,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n        \"agent.vx\": vx_new,\n        \"agent.vy\": vy_new,\n    }",
      "init_params": {
        "control_gain": 15.0,
        "attraction_strength": 0.05,
        "drag": 0.85
      },
      "repaired": false
    },
    {
      "name": "bounded_action_response",
      "mechanism": "Action components are non-linearly mapped through a tanh saturation function.",
      "code": "# HYPOTHESIS: bounded_action_response\n# MECHANISM: Action components are non-linearly mapped through a tanh saturation function.\nPARAMS = {\"scale\": 30.0, \"drag\": 0.8}\n\ndef step(state, action, p, meta):\n    ax = math.tanh(action[0]) * p[\"scale\"]\n    ay = math.tanh(action[1]) * p[\"scale\"]\n    vx = state.get(\"agent.vx\", 0.0)\n    vy = state.get(\"agent.vy\", 0.0)\n    vx_new = (vx + ax) * p[\"drag\"]\n    vy_new = (vy + ay) * p[\"drag\"]\n    return {\n        \"agent.x\": state[\"agent.x\"] + vx_new,\n        \"agent.y\": state[\"agent.y\"] + vy_new,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n        \"agent.vx\": vx_new,\n        \"agent.vy\": vy_new,\n    }",
      "init_params": {
        "scale": 30.0,
        "drag": 0.8
      },
