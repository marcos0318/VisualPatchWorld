  "candidates": [
    {
      "name": "baseline_linear",
      "mechanism": "Agent position changes linearly with action; target and environment are passive.",
      "code": "# HYPOTHESIS: baseline_linear\n# MECHANISM: Agent position changes linearly with action; target and environment are passive.\nPARAMS = {\"gain\": 25.0}\n\ndef step(state, action, p, meta):\n    \"\"\"state: dict mapping \"object.field\" -> float (do not mutate).\n    action: list of floats. p: dict of fitted constants (same keys as PARAMS).\n    meta: dict of static scene metadata (may be empty).\n    Return a NEW dict with exactly the same keys as `state`.\"\"\"\n    ax, ay = action\n    dx = p[\"gain\"] * ax\n    dy = p[\"gain\"] * ay\n    return {\n        \"agent.x\": state[\"agent.x\"] + dx,\n        \"agent.y\": state[\"agent.y\"] + dy,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "gain": 25.0
      },
      "repaired": false
    },
    {
      "name": "saturated_kinematics",
      "mechanism": "Control authority saturates at high action magnitudes (nonlinear tanh response).",
      "code": "# HYPOTHESIS: saturated_kinematics\n# MECHANISM: Control authority saturates at high action magnitudes (nonlinear tanh response).\nPARAMS = {\"gain\": 25.0, \"limit\": 20.0}\n\ndef step(state, action, p, meta):\n    \"\"\"state: dict mapping \"object.field\" -> float (do not mutate).\n    action: list of floats. p: dict of fitted constants (same keys as PARAMS).\n    meta: dict of static scene metadata (may be empty).\n    Return a NEW dict with exactly the same keys as `state`.\"\"\"\n    import math\n    ax, ay = action\n    dx = p[\"limit\"] * math.tanh(p[\"gain\"] * ax / p[\"limit\"])\n    dy = p[\"limit\"] * math.tanh(p[\"gain\"] * ay / p[\"limit\"])\n    return {\n        \"agent.x\": state[\"agent.x\"] + dx,\n        \"agent.y\": state[\"agent.y\"] + dy,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "gain": 25.0,
        "limit": 20.0
      },
      "repaired": false
    },
    {
      "name": "target_attraction",
      "mechanism": "Agent is passively pulled towards the target coordinates (magnetic coupling).",
      "code": "# HYPOTHESIS: target_attraction\n# MECHANISM: Agent is passively pulled towards the target coordinates (magnetic coupling).\nPARAMS = {\"gain\": 25.0, \"coupling\": 0.1}\n\ndef step(state, action, p, meta):\n    \"\"\"state: dict mapping \"object.field\" -> float (do not mutate).\n    action: list of floats. p: dict of fitted constants (same keys as PARAMS).\n    meta: dict of static scene metadata (may be empty).\n    Return a NEW dict with exactly the same keys as `state`.\"\"\"\n    ax, ay = action\n    dx = p[\"gain\"] * ax + p[\"coupling\"] * (state[\"target.x\"] - state[\"agent.x\"])\n    dy = p[\"gain\"] * ay + p[\"coupling\"] * (state[\"target.y\"] - state[\"agent.y\"])\n    return {\n        \"agent.x\": state[\"agent.x\"] + dx,\n        \"agent.y\": state[\"agent.y\"] + dy,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "gain": 25.0,
        "coupling": 0.1
      },
      "repaired": false
    },
    {
      "name": "door_repulsion",
      "mechanism": "Static obstacle (door) exerts a repulsive force inversely proportional to distance.",
      "code": "# HYPOTHESIS: door_repulsion\n# MECHANISM: Static obstacle (door) exerts a repulsive force inversely proportional to distance.\nPARAMS = {\"gain\": 25.0, \"repel_strength\": 50.0, \"softening\": 1.0}\n\ndef step(state, action, p, meta):\n    \"\"\"state: dict mapping \"object.field\" -> float (do not mutate).\n    action: list of floats. p: dict of fitted constants (same keys as PARAMS).\n    meta: dict of static scene metadata (may be empty).\n    Return a NEW dict with exactly the same keys as `state`.\"\"\"\n    import math\n    ax, ay = action\n    dx = p[\"gain\"] * ax\n    dy = p[\"gain\"] * ay\n    \n    door = meta.get(\"door_coords\")\n    if door and len(door) >= 2:\n        dx_door, dy_door = door[0], door[1]\n        dist_sq = (state[\"agent.x\"] - dx_door)**2 + (state[\"agent.y\"] - dy_door)**2 + p[\"softening\"]\n        dist = math.sqrt(dist_sq)\n        fx = (state[\"agent.x\"] - dx_door) / dist\n        fy = (state[\"agent.y\"] - dy_door) / dist\n        force = p[\"repel_strength\"] / dist\n        dx += force * fx\n        dy += force * fy\n        \n    return {\n        \"agent.x\": state[\"agent.x\"] + dx,\n        \"agent.y\": state[\"agent.y\"] + dy,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "gain": 25.0,
        "repel_strength": 50.0,
        "softening": 1.0
      },
      "repaired": false
    },
    {
      "name": "boundary_damping",
      "mechanism": "Control gain reduces when approaching scene boundaries (friction zones).",
      "code": "# HYPOTHESIS: boundary_damping\n# MECHANISM: Control gain reduces when approaching scene boundaries (friction zones).\nPARAMS = {\"gain\": 25.0, \"x_min\": 14.0, \"x_max\": 199.0, \"y_min\": 21.0, \"y_max\": 208.0, \"friction\": 0.5, \"zone_width\": 20.0}\n\ndef step(state, action, p, meta):\n    \"\"\"state: dict mapping \"object.field\" -> float (do not mutate).\n    action: list of floats. p: dict of fitted constants (same keys as PARAMS).\n    meta: dict of static scene metadata (may be empty).\n    Return a NEW dict with exactly the same keys as `state`.\"\"\"\n    ax, ay = action\n    base_dx = p[\"gain\"] * ax\n    base_dy = p[\"gain\"] * ay\n    \n    def damp(pos, min_v, max_v, zone):\n        d_min = max(0.0, zone - (pos - min_v))\n        d_max = max(0.0, zone - (max_v - pos))\n        penalty = max(d_min, d_max) / zone if zone > 0 else 0.0\n        return max(0.1, 1.0 - p[\"friction\"] * penalty)\n        \n    dx = base_dx * damp(state[\"agent.x\"], p[\"x_min\"], p[\"x_max\"], p[\"zone_width\"])\n    dy = base_dy * damp(state[\"agent.y\"], p[\"y_min\"], p[\"y_max\"], p[\"zone_width\"])\n    \n    return {\n        \"agent.x\": state[\"agent.x\"] + dx,\n        \"agent.y\": state[\"agent.y\"] + dy,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "gain": 25.0,
        "x_min": 14.0,
        "x_max": 199.0,
        "y_min": 21.0,
        "y_max": 208.0,
        "friction": 0.5,
        "zone_width": 20.0
      },
      "repaired": false
    },
    {
      "name": "cross_coupling",
      "mechanism": "Action axes are coupled; X action affects Y velocity and vice versa (rotation/misalignment).",
      "code": "# HYPOTHESIS: cross_coupling\n# MECHANISM: Action axes are coupled; X action affects Y velocity and vice versa (rotation/misalignment).\nPARAMS = {\"gain_x\": 25.0, \"gain_y\": 25.0, \"coupling_xy\": 0.1, \"coupling_yx\": 0.1}\n\ndef step(state, action, p, meta):\n    \"\"\"state: dict mapping \"object.field\" -> float (do not mutate).\n    action: list of floats. p: dict of fitted constants (same keys as PARAMS).\n    meta: dict of static scene metadata (may be empty).\n    Return a NEW dict with exactly the same keys as `state`.\"\"\"\n    ax, ay = action\n    dx = p[\"gain_x\"] * ax + p[\"coupling_xy\"] * ay\n    dy = p[\"gain_y\"] * ay + p[\"coupling_yx\"] * ax\n    return {\n        \"agent.x\": state[\"agent.x\"] + dx,\n        \"agent.y\": state[\"agent.y\"] + dy,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"]\n    }",
      "init_params": {
        "gain_x": 25.0,
        "gain_y": 25.0,
        "coupling_xy": 0.1,
        "coupling_yx": 0.1
      },
      "repaired": false
    }
  ],
