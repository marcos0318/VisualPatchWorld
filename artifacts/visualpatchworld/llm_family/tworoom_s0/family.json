      "name": "linear_velocity",
      "mechanism": "Agent position changes proportionally to action with constant velocity scale (simple baseline).",
      "code": "# HYPOTHESIS: linear_velocity\n# MECHANISM: Agent position changes proportionally to action with constant velocity scale (simple baseline).\nPARAMS = {\"velocity_scale\": 25.0}\n\ndef step(state, action, p, meta):\n    \"\"\"state: dict mapping \"object.field\" -> float (do not mutate).\n    action: list of floats. p: dict of fitted constants (same keys as PARAMS).\n    meta: dict of static scene metadata (may be empty).\n    Return a NEW dict with exactly the same keys as `state`.\"\"\"\n    import math\n    new_state = {}\n    for k in state:\n        new_state[k] = state[k]\n    new_state[\"agent.x\"] = state[\"agent.x\"] + p[\"velocity_scale\"] * action[0]\n    new_state[\"agent.y\"] = state[\"agent.y\"] + p[\"velocity_scale\"] * action[1]\n    return new_state",
      "init_params": {
        "velocity_scale": 25.0
      },
      "repaired": false
    },
    {
      "name": "action_nonlinearity",
      "mechanism": "Large actions experience diminishing returns through tanh saturation.",
      "code": "# HYPOTHESIS: action_nonlinearity\n# MECHANISM: Large actions experience diminishing returns through tanh saturation.\nPARAMS = {\"velocity_scale\": 25.0, \"saturation_k\": 0.5}\n\ndef step(state, action, p, meta):\n    \"\"\"state: dict mapping \"object.field\" -> float (do not mutate).\n    action: list of floats. p: dict of fitted constants (same keys as PARAMS).\n    meta: dict of static scene metadata (may be empty).\n    Return a NEW dict with exactly the same keys as `state`.\"\"\"\n    import math\n    new_state = {}\n    for k in state:\n        new_state[k] = state[k]\n    k = p[\"saturation_k\"]\n    if abs(k) < 1e-8:\n        eff_ax, eff_ay = action[0], action[1]\n    else:\n        eff_ax = math.tanh(k * action[0]) / k\n        eff_ay = math.tanh(k * action[1]) / k\n    new_state[\"agent.x\"] = state[\"agent.x\"] + p[\"velocity_scale\"] * eff_ax\n    new_state[\"agent.y\"] = state[\"agent.y\"] + p[\"velocity_scale\"] * eff_ay\n    return new_state",
      "init_params": {
        "velocity_scale": 25.0,
        "saturation_k": 0.5
      },
      "repaired": false
    },
    {
      "name": "position_dependent_gain",
      "mechanism": "Movement efficiency varies linearly with agent position in the arena.",
      "code": "# HYPOTHESIS: position_dependent_gain\n# MECHANISM: Movement efficiency varies linearly with agent position in the arena.\nPARAMS = {\"base_scale\": 25.0, \"x_gradient\": 0.0, \"y_gradient\": 0.0}\n\ndef step(state, action, p, meta):\n    \"\"\"state: dict mapping \"object.field\" -> float (do not mutate).\n    action: list of floats. p: dict of fitted constants (same keys as PARAMS).\n    meta: dict of static scene metadata (may be empty).\n    Return a NEW dict with exactly the same keys as `state`.\"\"\"\n    import math\n    new_state = {}\n    for k in state:\n        new_state[k] = state[k]\n    scale_x = p[\"base_scale\"] + p[\"x_gradient\"] * state[\"agent.x\"]\n    scale_y = p[\"base_scale\"] + p[\"y_gradient\"] * state[\"agent.y\"]\n    new_state[\"agent.x\"] = state[\"agent.x\"] + scale_x * action[0]\n    new_state[\"agent.y\"] = state[\"agent.y\"] + scale_y * action[1]\n    return new_state",
      "init_params": {
        "base_scale": 25.0,
        "x_gradient": 0.0,
        "y_gradient": 0.0
      },
      "repaired": false
    },
    {
      "name": "boundary_constraints",
      "mechanism": "Movement is damped near arena boundaries, creating soft wall effects.",
      "code": "# HYPOTHESIS: boundary_constraints\n# MECHANISM: Movement is damped near arena boundaries, creating soft wall effects.\nPARAMS = {\"base_scale\": 25.0, \"boundary_margin\": 30.0, \"boundary_strength\": 0.3}\n\ndef step(state, action, p, meta):\n    \"\"\"state: dict mapping \"object.field\" -> float (do not mutate).\n    action: list of floats. p: dict of fitted constants (same keys as PARAMS).\n    meta: dict of static scene metadata (may be empty).\n    Return a NEW dict with exactly the same keys as `state`.\"\"\"\n    import math\n    new_state = {}\n    for k in state:\n        new_state[k] = state[k]\n    x_min, x_max = 10.0, 210.0\n    y_min, y_max = 10.0, 210.0\n    margin = p[\"boundary_margin\"]\n    strength = p[\"boundary_strength\"]\n    \n    damp_x = 1.0\n    if state[\"agent.x\"] < x_min + margin:\n        damp_x *= strength + (1 - strength) * (state[\"agent.x\"] - x_min) / margin\n    if state[\"agent.x\"] > x_max - margin:\n        damp_x *= strength + (1 - strength) * (x_max - state[\"agent.x\"]) / margin\n    \n    damp_y = 1.0\n    if state[\"agent.y\"] < y_min + margin:\n        damp_y *= strength + (1 - strength) * (state[\"agent.y\"] - y_min) / margin\n    if state[\"agent.y\"] > y_max - margin:\n        damp_y *= strength + (1 - strength) * (y_max - state[\"agent.y\"]) / margin\n    \n    damp_x = max(0.0, min(1.0, damp_x))\n    damp_y = max(0.0, min(1.0, damp_y))\n    \n    new_state[\"agent.x\"] = state[\"agent.x\"] + p[\"base_scale\"] * action[0] * damp_x\n    new_state[\"agent.y\"] = state[\"agent.y\"] + p[\"base_scale\"] * action[1] * damp_y\n    return new_state",
      "init_params": {
        "base_scale": 25.0,
        "boundary_margin": 30.0,
        "boundary_strength": 0.3
      },
      "repaired": false
    },
    {
      "name": "target_coupling",
      "mechanism": "Agent movement is biased toward or away from target position.",
      "code": "# HYPOTHESIS: target_coupling\n# MECHANISM: Agent movement is biased toward or away from target position.\nPARAMS = {\"base_scale\": 20.0, \"target_coupling\": 0.5}\n\ndef step(state, action, p, meta):\n    \"\"\"state: dict mapping \"object.field\" -> float (do not mutate).\n    action: list of floats. p: dict of fitted constants (same keys as PARAMS).\n    meta: dict of static scene metadata (may be empty).\n    Return a NEW dict with exactly the same keys as `state`.\"\"\"\n    import math\n    new_state = {}\n    for k in state:\n        new_state[k] = state[k]\n    dx = state[\"target.x\"] - state[\"agent.x\"]\n    dy = state[\"target.y\"] - state[\"agent.y\"]\n    dist = math.sqrt(dx*dx + dy*dy)\n    if dist < 0.001:\n        dist = 0.001\n    ux, uy = dx / dist, dy / dist\n    mod_ax = action[0] + p[\"target_coupling\"] * ux\n    mod_ay = action[1] + p[\"target_coupling\"] * uy\n    new_state[\"agent.x\"] = state[\"agent.x\"] + p[\"base_scale\"] * mod_ax\n    new_state[\"agent.y\"] = state[\"agent.y\"] + p[\"base_scale\"] * mod_ay\n    return new_state",
      "init_params": {
        "base_scale": 20.0,
        "target_coupling": 0.5
      },
      "repaired": false
    },
    {
      "name": "action_cross_coupling",
      "mechanism": "X and Y action components affect each other through rotational coupling.",
      "code": "# HYPOTHESIS: action_cross_coupling\n# MECHANISM: X and Y action components affect each other through rotational coupling.\nPARAMS = {\"velocity_scale\": 25.0, \"cross_coupling\": 0.0}\n\ndef step(state, action, p, meta):\n    \"\"\"state: dict mapping \"object.field\" -> float (do not mutate).\n    action: list of floats. p: dict of fitted constants (same keys as PARAMS).\n    meta: dict of static scene metadata (may be empty).\n    Return a NEW dict with exactly the same keys as `state`.\"\"\"\n    import math\n    new_state = {}\n    for k in state:\n        new_state[k] = state[k]\n    cc = p[\"cross_coupling\"]\n    eff_ax = action[0] + cc * action[1]\n    eff_ay = action[1] + cc * action[0]\n    new_state[\"agent.x\"] = state[\"agent.x\"] + p[\"velocity_scale\"] * eff_ax\n    new_state[\"agent.y\"] = state[\"agent.y\"] + p[\"velocity_scale\"] * eff_ay\n    return new_state",
      "init_params": {
        "velocity_scale": 25.0,
        "cross_coupling": 0.0
      },
