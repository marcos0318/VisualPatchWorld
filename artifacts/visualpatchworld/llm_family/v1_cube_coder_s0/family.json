      "name": "linear_independent",
      "mechanism": "Each object moves independently in response to its own action components with linear velocity control and no coupling.",
      "code": "# HYPOTHESIS: linear_independent\n# MECHANISM: Each object moves independently in response to its own action components with linear velocity control and no coupling.\nPARAMS = {\"k_block\": 0.1, \"k_effector\": 0.2, \"dt\": 0.05}\n\ndef step(state, action, p, meta):\n    next_state = {}\n    # Effector moves based on first 3 action components\n    next_state[\"effector.x\"] = state[\"effector.x\"] + p[\"k_effector\"] * action[0] * p[\"dt\"]\n    next_state[\"effector.y\"] = state[\"effector.y\"] + p[\"k_effector\"] * action[1] * p[\"dt\"]\n    next_state[\"effector.z\"] = state[\"effector.z\"] + p[\"k_effector\"] * action[2] * p[\"dt\"]\n    \n    # Block is moved if effector is close enough (coupling condition)\n    dx = state[\"effector.x\"] - state[\"block.x\"]\n    dy = state[\"effector.y\"] - state[\"block.y\"]\n    dz = state[\"effector.z\"] - state[\"block.z\"]\n    dist = (dx**2 + dy**2 + dz**2)**0.5\n    \n    if dist < 0.05: # Gripper grasp range\n        next_state[\"block.x\"] = state[\"block.x\"] + p[\"k_block\"] * action[0] * p[\"dt\"]\n        next_state[\"block.y\"] = state[\"block.y\"] + p[\"k_block\"] * action[1] * p[\"dt\"]\n        next_state[\"block.z\"] = state[\"block.z\"] + p[\"k_block\"] * action[2] * p[\"dt\"]\n    else:\n        next_state[\"block.x\"] = state[\"block.x\"]\n        next_state[\"block.y\"] = state[\"block.y\"]\n        next_state[\"block.z\"] = state[\"block.z\"]\n\n    # Goal position is fixed\n    next_state[\"goal.x\"] = state[\"goal.x\"]\n    next_state[\"goal.y\"] = state[\"goal.y\"]\n    next_state[\"goal.z\"] = state[\"goal.z\"]\n    \n    return next_state",
      "init_params": {
        "k_block": 0.1,
        "k_effector": 0.2,
        "dt": 0.05
      },
      "repaired": false
    },
    {
      "name": "momentum_coupled",
      "mechanism": "Objects have momentum; actions apply forces that change velocities, with instantaneous position-based coupling when in contact.",
      "code": "# HYPOTHESIS: momentum_coupled\n# MECHANISM: Objects have momentum; actions apply forces that change velocities, with instantaneous position-based coupling when in contact.\nPARAMS = {\"mass_effector\": 1.0, \"mass_block\": 0.5, \"force_scale\": 1.0, \"friction\": 0.8, \"dt\": 0.05}\n\ndef step(state, action, p, meta):\n    next_state = {}\n    \n    # Effector force integration (F = ma -> dv = F/m * dt)\n    dvx_e = action[0] * p[\"force_scale\"] / p[\"mass_effector\"] * p[\"dt\"]\n    dvy_e = action[1] * p[\"force_scale\"] / p[\"mass_effector\"] * p[\"dt\"]\n    dvz_e = action[2] * p[\"force_scale\"] / p[\"mass_effector\"] * p[\"dt\"]\n    \n    vx_e = state.get(\"effector.vx\", 0) + dvx_e\n    vy_e = state.get(\"effector.vy\", 0) + dvy_e\n    vz_e = state.get(\"effector.vz\", 0) + dvz_e\n\n    # Apply friction to effector\n    vx_e *= p[\"friction\"]\n    vy_e *= p[\"friction\"]\n    vz_e *= p[\"friction\"]\n\n    # Update effector position\n    next_state[\"effector.x\"] = state[\"effector.x\"] + vx_e * p[\"dt\"]\n    next_state[\"effector.y\"] = state[\"effector.y\"] + vy_e * p[\"dt\"]\n    next_state[\"effector.z\"] = state[\"effector.z\"] + vz_e * p[\"dt\"]\n    next_state[\"effector.vx\"] = vx_e\n    next_state[\"effector.vy\"] = vy_e\n    next_state[\"effector.vz\"] = vz_e\n    \n    # Block dynamics\n    dx = state[\"effector.x\"] - state[\"block.x\"]\n    dy = state[\"effector.y\"] - state[\"block.y\"]\n    dz = state[\"effector.z\"] - state[\"block.z\"]\n    dist = (dx**2 + dy**2 + dz**2)**0.5\n\n    # If in contact, transfer some velocity\n    if dist < 0.05:\n        # Assume perfect transfer for simplicity\n        block_vx = vx_e\n        block_vy = vy_e\n        block_vz = vz_e\n    else:\n        block_vx = state.get(\"block.vx\", 0)\n        block_vy = state.get(\"block.vy\", 0)\n        block_vz = state.get(\"block.vz\", 0)\n\n    # Apply friction to block\n    block_vx *= p[\"friction\"]\n    block_vy *= p[\"friction\"]\n    block_vz *= p[\"friction\"]\n\n    next_state[\"block.x\"] = state[\"block.x\"] + block_vx * p[\"dt\"]\n    next_state[\"block.y\"] = state[\"block.y\"] + block_vy * p[\"dt\"]\n    next_state[\"block.z\"] = state[\"block.z\"] + block_vz * p[\"dt\"]\n    next_state[\"block.vx\"] = block_vx\n    next_state[\"block.vy\"] = block_vy\n    next_state[\"block.vz\"] = block_vz\n\n    # Goal remains fixed\n    next_state[\"goal.x\"] = state[\"goal.x\"]\n    next_state[\"goal.y\"] = state[\"goal.y\"]\n    next_state[\"goal.z\"] = state[\"goal.z\"]\n\n    return next_state",
      "init_params": {
        "mass_effector": 1.0,
        "mass_block": 0.5,
        "force_scale": 1.0,
        "friction": 0.8,
        "dt": 0.05
      },
      "repaired": false
