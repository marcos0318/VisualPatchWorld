    {
      "name": "proportional_feedback_baseline",
      "mechanism": "Actions represent desired offsets from current state; system tries to achieve these through proportional feedback control.",
      "code": "# HYPOTHESIS: proportional_feedback_baseline\n# MECHANISM: Actions represent desired offsets from current state; system tries to achieve these through proportional feedback control.\nPARAMS = {\"kp\": 0.5, \"kd\": 0.1, \"dt\": 0.05, \"effector_speed_limit\": 0.2}\n\ndef step(state, action, p, meta):\n    next_state = {}\n    \n    # Desired target positions from action\n    target_ex = state[\"effector.x\"] + action[0]\n    target_ey = state[\"effector.y\"] + action[1]\n    target_ez = state[\"effector.z\"] + action[2]\n    \n    # Current velocities from previous step (assume zero if not present)\n    vx_curr = state.get(\"effector.vx\", 0)\n    vy_curr = state.get(\"effector.vy\", 0)\n    vz_curr = state.get(\"effector.vz\", 0)\n    \n    # Desired velocities based on error\n    err_x = target_ex - state[\"effector.x\"]\n    err_y = target_ey - state[\"effector.y\"]\n    err_z = target_ez - state[\"effector.z\"]\n    \n    vx_desired = err_x * p[\"kp\"]\n    vy_desired = err_y * p[\"kp\"]\n    vz_desired = err_z * p[\"kp\"]\n    \n    # Limit speed\n    speed = (vx_desired**2 + vy_desired**2 + vz_desired**2)**0.5\n    if speed > p[\"effector_speed_limit\"]:\n        scale = p[\"effector_speed_limit\"] / speed\n        vx_desired *= scale\n        vy_desired *= scale\n        vz_desired *= scale\n    \n    # Update effector\n    next_state[\"effector.x\"] = state[\"effector.x\"] + vx_desired * p[\"dt\"]\n    next_state[\"effector.y\"] = state[\"effector.y\"] + vy_desired * p[\"dt\"]\n    next_state[\"effector.z\"] = state[\"effector.z\"] + vz_desired * p[\"dt\"]\n    next_state[\"effector.vx\"] = vx_desired\n    next_state[\"effector.vy\"] = vy_desired\n    next_state[\"effector.vz\"] = vz_desired\n    \n    # Simple coupling: if effector touches block, drag it along\n    dx = next_state[\"effector.x\"] - state[\"block.x\"]\n    dy = next_state[\"effector.y\"] - state[\"block.y\"]\n    dz = next_state[\"effector.z\"] - state[\"block.z\"]\n    dist = (dx**2 + dy**2 + dz**2)**0.5\n    \n    if dist < 0.03:\n        next_state[\"block.x\"] = next_state[\"effector.x\"]\n        next_state[\"block.y\"] = next_state[\"effector.y\"]\n        next_state[\"block.z\"] = next_state[\"effector.z\"]\n    else:\n        next_state[\"block.x\"] = state[\"block.x\"]\n        next_state[\"block.y\"] = state[\"block.y\"]\n        next_state[\"block.z\"] = state[\"block.z\"]\n\n    # Goal fixed\n    next_state[\"goal.x\"] = state[\"goal.x\"]\n    next_state[\"goal.y\"] = state[\"goal.y\"]\n    next_state[\"goal.z\"] = state[\"goal.z\"]\n    \n    return next_state",
      "init_params": {
