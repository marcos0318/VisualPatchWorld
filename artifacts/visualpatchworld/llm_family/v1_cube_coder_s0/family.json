    {
      "name": "gated_impact",
      "mechanism": "Action directly changes positions, but only affects the block if the effector is sufficiently close and aligned along z-axis (gated).",
      "code": "# HYPOTHESIS: gated_impact\n# MECHANISM: Action directly changes positions, but only affects the block if the effector is sufficiently close and aligned along z-axis (gated).\nPARAMS = {\"sensitivity\": 1.0, \"max_move\": 0.05, \"tolerance_xy\": 0.03, \"tolerance_z\": 0.02}\n\ndef step(state, action, p, meta):\n    next_state = {}\n    \n    # Effector always follows action in X/Y/Z\n    next_state[\"effector.x\"] = state[\"effector.x\"] + action[0] * p[\"sensitivity\"] * p[\"max_move\"]\n    next_state[\"effector.y\"] = state[\"effector.y\"] + action[1] * p[\"sensitivity\"] * p[\"max_move\"]\n    next_state[\"effector.z\"] = state[\"effector.z\"] + action[2] * p[\"sensitivity\"] * p[\"max_move\"]\n    \n    # Check alignment for block movement\n    dx = abs(state[\"effector.x\"] - state[\"block.x\"])\n    dy = abs(state[\"effector.y\"] - state[\"block.y\"])\n    dz = abs(state[\"effector.z\"] - state[\"block.z\"])\n\n    # Only move block if effector is above it and close enough\n    if dx < p[\"tolerance_xy\"] and dy < p[\"tolerance_xy\"] and dz < p[\"tolerance_z\"]:\n        # Move block with effector\n        next_state[\"block.x\"] = state[\"block.x\"] + action[0] * p[\"sensitivity\"] * p[\"max_move\"]\n        next_state[\"block.y\"] = state[\"block.y\"] + action[1] * p[\"sensitivity\"] * p[\"max_move\"]\n        next_state[\"block.z\"] = state[\"block.z\"] + action[2] * p[\"sensitivity\"] * p[\"max_move\"]\n    else:\n        next_state[\"block.x\"] = state[\"block.x\"]\n        next_state[\"block.y\"] = state[\"block.y\"]\n        next_state[\"block.z\"] = state[\"block.z\"]\n\n    # Goal stays fixed\n    next_state[\"goal.x\"] = state[\"goal.x\"]\n    next_state[\"goal.y\"] = state[\"goal.y\"]\n    next_state[\"goal.z\"] = state[\"goal.z\"]\n    \n    return next_state",
      "init_params": {
        "sensitivity": 1.0,
        "max_move": 0.05,
        "tolerance_xy": 0.03,
        "tolerance_z": 0.02
      },
      "repaired": false
    },
    {
      "name": "saturating_control",
      "mechanism": "Control inputs are subject to non-linear saturation effects before influencing motion; large actions have diminishing returns.",
      "code": "# HYPOTHESIS: saturating_control\n# MECHANISM: Control inputs are subject to non-linear saturation effects before influencing motion; large actions have diminishing returns.\nPARAMS = {\"gain_x\": 0.1, \"gain_y\": 0.1, \"gain_z\": 0.1, \"sat_limit\": 0.8, \"power\": 1.5}\n\ndef step(state, action, p, meta):\n    import math\n    \n    def soft_saturate(x, limit, power):\n        sign = 1 if x >= 0 else -1\n        magnitude = min(abs(x), limit) / limit\n        return sign * (magnitude ** power) * limit\n        \n    # Saturate each action component\n    ax_sat = soft_saturate(action[0], p[\"sat_limit\"], p[\"power\"])\n    ay_sat = soft_saturate(action[1], p[\"sat_limit\"], p[\"power\"])\n    az_sat = soft_saturate(action[2], p[\"sat_limit\"], p[\"power\"])\n\n    next_state = {}\n    \n    # Effector update with saturated controls\n    next_state[\"effector.x\"] = state[\"effector.x\"] + ax_sat * p[\"gain_x\"]\n    next_state[\"effector.y\"] = state[\"effector.y\"] + ay_sat * p[\"gain_y\"]\n    next_state[\"effector.z\"] = state[\"effector.z\"] + az_sat * p[\"gain_z\"]\n\n    # Simple kinematic coupling\n    dx = state[\"effector.x\"] - state[\"block.x\"]\n    dy = state[\"effector.y\"] - state[\"block.y\"]\n    dz = state[\"effector.z\"] - state[\"block.z\"]\n    dist = math.sqrt(dx*dx + dy*dy + dz*dz)\n    \n    if dist < 0.05:\n        next_state[\"block.x\"] = state[\"block.x\"] + ax_sat * p[\"gain_x\"] * 0.5\n        next_state[\"block.y\"] = state[\"block.y\"] + ay_sat * p[\"gain_y\"] * 0.5\n        next_state[\"block.z\"] = state[\"block.z\"] + az_sat * p[\"gain_z\"] * 0.5\n    else:\n        next_state[\"block.x\"] = state[\"block.x\"]\n        next_state[\"block.y\"] = state[\"block.y\"]\n        next_state[\"block.z\"] = state[\"block.z\"]\n\n    # Fixed goal\n    next_state[\"goal.x\"] = state[\"goal.x\"]\n    next_state[\"goal.y\"] = state[\"goal.y\"]\n    next_state[\"goal.z\"] = state[\"goal.z\"]\n    \n    return next_state",
      "init_params": {
        "gain_x": 0.1,
        "gain_y": 0.1,
        "gain_z": 0.1,
        "sat_limit": 0.8,
        "power": 1.5
      },
      "repaired": false
    },
    {
      "name": "height_field_interaction",
      "mechanism": "Z-motion has special constraints; objects can't fall below ground plane (z=0.02) and vertical motion requires specific action conditions.",
      "code": "# HYPOTHESIS: height_field_interaction\n# MECHANISM: Z-motion has special constraints; objects can't fall below ground plane (z=0.02) and vertical motion requires specific action conditions.\nPARAMS = {\"k_xy\": 0.1, \"k_up\": 0.15, \"k_down\": 0.1, \"ground_level\": 0.02, \"lift_threshold\": 0.3}\n\ndef step(state, action, p, meta):\n    next_state = {}\n    \n    # XY motion independent of Z\n    next_state[\"effector.x\"] = state[\"effector.x\"] + action[0] * p[\"k_xy\"]\n    next_state[\"effector.y\"] = state[\"effector.y\"] + action[1] * p[\"k_xy\"]\n    \n    # Z-motion depends on action[4] (fifth component)\n    if action[4] > p[\"lift_threshold\"]:  # Lift up\n        next_state[\"effector.z\"] = max(p[\"ground_level\"], state[\"effector.z\"] + action[4] * p[\"k_up\"])\n    elif action[4] < -p[\"lift_threshold\"]:  # Push down\n        next_state[\"effector.z\"] = max(p[\"ground_level\"], state[\"effector.z\"] - abs(action[4]) * p[\"k_down\"])\n    else:\n        next_state[\"effector.z\"] = state[\"effector.z\"]\n\n    # Block interaction: lifted if close and effector moving up significantly\n    dx = abs(state[\"effector.x\"] - state[\"block.x\"])\n    dy = abs(state[\"effector.y\"] - state[\"block.y\"])\n    dz = abs(state[\"effector.z\"] - state[\"block.z\"])\n    \n    if dx < 0.03 and dy < 0.03 and dz < 0.02 and action[4] > p[\"lift_threshold\"]:\n        next_state[\"block.x\"] = next_state[\"effector.x\"]\n        next_state[\"block.y\"] = next_state[\"effector.y\"]\n        next_state[\"block.z\"] = next_state[\"effector.z\"]\n    else:\n        next_state[\"block.x\"] = state[\"block.x\"]\n        next_state[\"block.y\"] = state[\"block.y\"]\n        next_state[\"block.z\"] = max(p[\"ground_level\"], state[\"block.z\"])\n\n    # Goal is fixed\n    next_state[\"goal.x\"] = state[\"goal.x\"]\n    next_state[\"goal.y\"] = state[\"goal.y\"]\n    next_state[\"goal.z\"] = state[\"goal.z\"]\n    \n    return next_state",
      "init_params": {
        "k_xy": 0.1,
        "k_up": 0.15,
        "k_down": 0.1,
        "ground_level": 0.02,
        "lift_threshold": 0.3
      },
      "repaired": false
