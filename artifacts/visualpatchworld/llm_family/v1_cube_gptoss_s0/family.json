  "candidates": [
    {
      "name": "baseline_linear_action",
      "mechanism": "block position is directly incremented by scaled action components, ignoring effector and grip",
      "code": "# HYPOTHESIS: baseline_linear_action\n# MECHANISM: block position is directly incremented by scaled action components, ignoring effector and grip\nPARAMS = {\"scale_x\": 0.01, \"scale_y\": 0.01, \"scale_z\": 0.01}\n\ndef step(state, action, p, meta):\n    \"\"\"Simple open\u2011loop controller: block moves proportionally to the first three action values.\"\"\"\n    nx = state[\"block.x\"] + p[\"scale_x\"] * action[0]\n    ny = state[\"block.y\"] + p[\"scale_y\"] * action[1]\n    nz = state[\"block.z\"] + p[\"scale_z\"] * action[2]\n    return {\n        \"block.x\": nx, \"block.y\": ny, \"block.z\": nz,\n        \"effector.x\": state[\"effector.x\"], \"effector.y\": state[\"effector.y\"], \"effector.z\": state[\"effector.z\"],\n        \"goal.x\": state[\"goal.x\"], \"goal.y\": state[\"goal.y\"], \"goal.z\": state[\"goal.z\"]\n    }",
      "init_params": {
        "scale_x": 0.01,
        "scale_y": 0.01,
        "scale_z": 0.01
      },
      "repaired": false
    },
    {
      "name": "effector_and_grip_follow",
      "mechanism": "effector follows scaled action velocities; block is pulled toward the effector when a positive grip command is present",
      "code": "# HYPOTHESIS: effector_and_grip_follow\n# MECHANISM: effector follows scaled action velocities; block is pulled toward the effector when a positive grip command is present\nPARAMS = {\"eff_scale\": 0.02, \"pull_gain\": 0.05, \"grip_thresh\": 0.2}\n\ndef step(state, action, p, meta):\n    \"\"\"Effector moves like a velocity command; block is attracted to it if grip>threshold.\"\"\"\n    # update effector\n    ex = state[\"effector.x\"] + p[\"eff_scale\"] * action[0]\n    ey = state[\"effector.y\"] + p[\"eff_scale\"] * action[1]\n    ez = state[\"effector.z\"] + p[\"eff_scale\"] * action[2]\n\n    # grip signal (positive means closed)\n    grip = 1.0 if action[3] > p[\"grip_thresh\"] else 0.0\n\n    # block pulled toward effector\n    bx = state[\"block.x\"] + p[\"pull_gain\"] * (ex - state[\"block.x\"]) * grip\n    by = state[\"block.y\"] + p[\"pull_gain\"] * (ey - state[\"block.y\"]) * grip\n    bz = state[\"block.z\"] + p[\"pull_gain\"] * (ez - state[\"block.z\"]) * grip\n\n    return {\n        \"block.x\": bx, \"block.y\": by, \"block.z\": bz,\n        \"effector.x\": ex, \"effector.y\": ey, \"effector.z\": ez,\n        \"goal.x\": state[\"goal.x\"], \"goal.y\": state[\"goal.y\"], \"goal.z\": state[\"goal.z\"]\n    }",
      "init_params": {
        "eff_scale": 0.02,
        "pull_gain": 0.05,
        "grip_thresh": 0.2
      },
      "repaired": false
    },
    {
      "name": "contact_grip_gate",
      "mechanism": "block moves only when the effector is within a distance threshold and the grip command is positive; movement follows the action velocities",
      "code": "# HYPOTHESIS: contact_grip_gate\n# MECHANISM: block moves only when the effector is within a distance threshold and the grip command is positive; movement follows the action velocities\nPARAMS = {\"eff_scale\": 0.02, \"dist_thresh\": 0.05, \"grip_thresh\": 0.0, \"move_gain\": 0.04}\n\ndef step(state, action, p, meta):\n    \"\"\"Effector moves; block translates only if close enough and grip is active.\"\"\"\n    import math\n    # update effector\n    ex = state[\"effector.x\"] + p[\"eff_scale\"] * action[0]\n    ey = state[\"effector.y\"] + p[\"eff_scale\"] * action[1]\n    ez = state[\"effector.z\"] + p[\"eff_scale\"] * action[2]\n\n    # distance after effector move\n    dx = ex - state[\"block.x\"]\n    dy = ey - state[\"block.y\"]\n    dz = ez - state[\"block.z\"]\n    dist = math.sqrt(dx*dx + dy*dy + dz*dz)\n\n    grip = action[3] > p[\"grip_thresh\"]\n    if grip and dist < p[\"dist_thresh\"]:\n        bx = state[\"block.x\"] + p[\"move_gain\"] * action[0]\n        by = state[\"block.y\"] + p[\"move_gain\"] * action[1]\n        bz = state[\"block.z\"] + p[\"move_gain\"] * action[2]\n    else:\n        bx, by, bz = state[\"block.x\"], state[\"block.y\"], state[\"block.z\"]\n\n    return {\n        \"block.x\": bx, \"block.y\": by, \"block.z\": bz,\n        \"effector.x\": ex, \"effector.y\": ey, \"effector.z\": ez,\n        \"goal.x\": state[\"goal.x\"], \"goal.y\": state[\"goal.y\"], \"goal.z\": state[\"goal.z\"]\n    }",
      "init_params": {
        "eff_scale": 0.02,
        "dist_thresh": 0.05,
        "grip_thresh": 0.0,
        "move_gain": 0.04
      },
      "repaired": false
    },
    {
      "name": "tanh_coupling",
      "mechanism": "block displacement is a saturated tanh function of the vector difference to the effector, scaled by grip strength",
      "code": "# HYPOTHESIS: tanh_coupling\n# MECHANISM: block displacement is a saturated tanh function of the vector difference to the effector, scaled by grip strength\nPARAMS = {\"gain\": 10.0, \"scale\": 0.03, \"grip_thresh\": 0.0}\n\ndef step(state, action, p, meta):\n    \"\"\"Non\u2011linear, saturating pull toward the effector when grip is active.\"\"\"\n    import math\n    ex, ey, ez = state[\"effector.x\"], state[\"effector.y\"], state[\"effector.z\"]\n    grip = max(0.0, action[3])                     # only positive grip contributes\n    dx = ex - state[\"block.x\"]\n    dy = ey - state[\"block.y\"]\n    dz = ez - state[\"block.z\"]\n    bx = state[\"block.x\"] + p[\"scale\"] * math.tanh(p[\"gain\"] * dx) * grip\n    by = state[\"block.y\"] + p[\"scale\"] * math.tanh(p[\"gain\"] * dy) * grip\n    bz = state[\"block.z\"] + p[\"scale\"] * math.tanh(p[\"gain\"] * dz) * grip\n    return {\n        \"block.x\": bx, \"block.y\": by, \"block.z\": bz,\n        \"effector.x\": ex, \"effector.y\": ey, \"effector.z\": ez,\n        \"goal.x\": state[\"goal.x\"], \"goal.y\": state[\"goal.y\"], \"goal.z\": state[\"goal.z\"]\n    }",
      "init_params": {
        "gain": 10.0,
        "scale": 0.03,
        "grip_thresh": 0.0
      },
      "repaired": false
    },
    {
      "name": "goal_stop_gate",
      "mechanism": "like contact_grip_gate but block stops moving once it is within a small radius of the goal",
      "code": "# HYPOTHESIS: goal_stop_gate\n# MECHANISM: like contact_grip_gate but block stops moving once it is within a small radius of the goal\nPARAMS = {\n    \"eff_scale\": 0.02, \"dist_thresh\": 0.05, \"grip_thresh\": 0.0,\n    \"move_gain\": 0.04, \"goal_thresh\": 0.02\n}\n\ndef step(state, action, p, meta):\n    \"\"\"Effector moves; block moves only if (a) close to effector, (b) grip active, and (c) not already at the goal.\"\"\"\n    import math\n    # update effector\n    ex = state[\"effector.x\"] + p[\"eff_scale\"] * action[0]\n    ey = state[\"effector.y\"] + p[\"eff_scale\"] * action[1]\n    ez = state[\"effector.z\"] + p[\"eff_scale\"] * action[2]\n\n    # distances\n    d_eff = math.sqrt((ex - state[\"block.x\"])**2 +\n                      (ey - state[\"block.y\"])**2 +\n                      (ez - state[\"block.z\"])**2)\n    d_goal = math.sqrt((state[\"block.x\"] - state[\"goal.x\"])**2 +\n                       (state[\"block.y\"] - state[\"goal.y\"])**2 +\n                       (state[\"block.z\"] - state[\"goal.z\"])**2)\n\n    grip = action[3] > p[\"grip_thresh\"]\n    if grip and d_eff < p[\"dist_thresh\"] and d_goal > p[\"goal_thresh\"]:\n        bx = state[\"block.x\"] + p[\"move_gain\"] * action[0]\n        by = state[\"block.y\"] + p[\"move_gain\"] * action[1]\n        bz = state[\"block.z\"] + p[\"move_gain\"] * action[2]\n    else:\n        bx, by, bz = state[\"block.x\"], state[\"block.y\"], state[\"block.z\"]\n\n    return {\n        \"block.x\": bx, \"block.y\": by, \"block.z\": bz,\n        \"effector.x\": ex, \"effector.y\": ey, \"effector.z\": ez,\n        \"goal.x\": state[\"goal.x\"], \"goal.y\": state[\"goal.y\"], \"goal.z\": state[\"goal.z\"]\n    }",
      "init_params": {
        "eff_scale": 0.02,
        "dist_thresh": 0.05,
        "grip_thresh": 0.0,
        "move_gain": 0.04,
        "goal_thresh": 0.02
      },
      "repaired": false
    },
    {
      "name": "exponential_pull",
      "mechanism": "block approaches the effector with an exponential smoothing factor when grip is active (first\u2011order dynamics)",
      "code": "# HYPOTHESIS: exponential_pull\n# MECHANISM: block approaches the effector with an exponential smoothing factor when grip is active (first\u2011order dynamics)\nPARAMS = {\"alpha\": 0.5, \"grip_thresh\": 0.0}\n\ndef step(state, action, p, meta):\n    \"\"\"Effector remains static; block moves toward it with a rate set by alpha, gated by grip.\"\"\"\n    import math\n    ex, ey, ez = state[\"effector.x\"], state[\"effector.y\"], state[\"effector.z\"]\n    grip = action[3] > p[\"grip_thresh\"]\n    factor = 1 - math.exp(-p[\"alpha\"])\n    if grip:\n        bx = state[\"block.x\"] + factor * (ex - state[\"block.x\"])\n        by = state[\"block.y\"] + factor * (ey - state[\"block.y\"])\n        bz = state[\"block.z\"] + factor * (ez - state[\"block.z\"])\n    else:\n        bx, by, bz = state[\"block.x\"], state[\"block.y\"], state[\"block.z\"]\n    return {\n        \"block.x\": bx, \"block.y\": by, \"block.z\": bz,\n        \"effector.x\": ex, \"effector.y\": ey, \"effector.z\": ez,\n        \"goal.x\": state[\"goal.x\"], \"goal.y\": state[\"goal.y\"], \"goal.z\": state[\"goal.z\"]\n    }",
      "init_params": {
        "alpha": 0.5,
        "grip_thresh": 0.0
      },
      "repaired": false
    }
  ],
