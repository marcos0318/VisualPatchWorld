      "name": "simple_kinematic_grasp",
      "mechanism": "Effector follows action directly; block moves with effector only when within grasp threshold distance (binary contact).",
      "code": "# HYPOTHESIS: simple_kinematic_grasp\n# MECHANISM: Effector follows action directly; block moves with effector only when within grasp threshold distance (binary contact).\nPARAMS = {\"grasp_threshold\": 0.05, \"effector_gain\": 0.5, \"block_follow_ratio\": 0.9}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    \n    ex, ey, ez = s[\"effector.x\"], s[\"effector.y\"], s[\"effector.z\"]\n    bx, by, bz = s[\"block.x\"], s[\"block.y\"], s[\"block.z\"]\n    gx, gy, gz = s[\"goal.x\"], s[\"goal.y\"], s[\"goal.z\"]\n    \n    ex_new = ex + p[\"effector_gain\"] * action[0]\n    ey_new = ey + p[\"effector_gain\"] * action[1]\n    ez_new = max(0.015, min(0.335, ez + p[\"effector_gain\"] * action[2]))\n    \n    dist = math.sqrt((ex-bx)**2 + (ey-by)**2 + (ez-bz)**2)\n    \n    if dist < p[\"grasp_threshold\"]:\n        bx_new = bx + p[\"block_follow_ratio\"] * (ex_new - ex)\n        by_new = by + p[\"block_follow_ratio\"] * (ey_new - ey)\n        bz_new = bz + p[\"block_follow_ratio\"] * (ez_new - ez)\n    else:\n        bx_new, by_new, bz_new = bx, by, bz\n    \n    return {\n        \"block.x\": bx_new, \"block.y\": by_new, \"block.z\": bz_new,\n        \"effector.x\": ex_new, \"effector.y\": ey_new, \"effector.z\": ez_new,\n        \"goal.x\": gx, \"goal.y\": gy, \"goal.z\": gz\n    }",
      "init_params": {
        "grasp_threshold": 0.05,
        "effector_gain": 0.5,
        "block_follow_ratio": 0.9
      },
      "repaired": true
    },
    {
      "name": "gravity_friction_table",
      "mechanism": "Block experiences gravity when unsupported (z>table) and friction when on table; effector motion independent.",
      "code": "# HYPOTHESIS: gravity_friction_table\n# MECHANISM: Block experiences gravity when unsupported (z>table) and friction when on table; effector motion independent.\nPARAMS = {\"gravity\": 0.1, \"table_z\": 0.020, \"friction\": 0.8, \"effector_gain\": 0.5, \"grasp_threshold\": 0.03}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    \n    ex, ey, ez = s[\"effector.x\"], s[\"effector.y\"], s[\"effector.z\"]\n    bx, by, bz = s[\"block.x\"], s[\"block.y\"], s[\"block.z\"]\n    gx, gy, gz = s[\"goal.x\"], s[\"goal.y\"], s[\"goal.z\"]\n    \n    ex_new = ex + p[\"effector_gain\"] * action[0]\n    ey_new = ey + p[\"effector_gain\"] * action[1]\n    ez_new = max(0.015, min(0.335, ez + p[\"effector_gain\"] * action[2]))\n    \n    dist = math.sqrt((ex-bx)**2 + (ey-by)**2 + (ez-bz)**2)\n    \n    if dist < p[\"grasp_threshold\"]:\n        bx_new = bx + (ex_new - ex)\n        by_new = by + (ey_new - ey)\n        bz_new = bz + (ez_new - ez)\n    else:\n        bx_new, by_new = bx, by\n        if bz > p[\"table_z\"] + 0.005:\n            bz_new = max(p[\"table_z\"], bz - p[\"gravity\"])\n        else:\n            bz_new = p[\"table_z\"]\n            bx_new = bx * p[\"friction\"] + (1-p[\"friction\"]) * bx\n            by_new = by * p[\"friction\"] + (1-p[\"friction\"]) * by\n    \n    return {\n        \"block.x\": bx_new, \"block.y\": by_new, \"block.z\": bz_new,\n        \"effector.x\": ex_new, \"effector.y\": ey_new, \"effector.z\": ez_new,\n        \"goal.x\": gx, \"goal.y\": gy, \"goal.z\": gz\n    }",
      "init_params": {
        "gravity": 0.1,
        "table_z": 0.02,
        "friction": 0.8,
        "effector_gain": 0.5,
        "grasp_threshold": 0.03
      },
      "repaired": true
