    {
      "name": "action_grip_controlled",
      "mechanism": "Action[4] explicitly controls grip state; grip determines block-effector coupling strength continuously.",
      "code": "# HYPOTHESIS: action_grip_controlled\n# MECHANISM: Action[4] explicitly controls grip state; grip determines block-effector coupling strength continuously.\nPARAMS = {\"effector_gain\": 0.5, \"grip_threshold\": 0.0, \"max_coupling\": 1.0, \"min_coupling\": 0.0, \"dist_threshold\": 0.05}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    \n    ex, ey, ez = s[\"effector.x\"], s[\"effector.y\"], s[\"effector.z\"]\n    bx, by, bz = s[\"block.x\"], s[\"block.y\"], s[\"block.z\"]\n    gx, gy, gz = s[\"goal.x\"], s[\"goal.y\"], s[\"goal.z\"]\n    \n    ex_new = ex + p[\"effector_gain\"] * action[0]\n    ey_new = ey + p[\"effector_gain\"] * action[1]\n    ez_new = max(0.015, min(0.335, ez + p[\"effector_gain\"] * action[2]))\n    \n    dist = math.sqrt((ex-bx)**2 + (ey-by)**2 + (ez-bz)**2)\n    \n    grip_signal = (action[4] - p[\"grip_threshold\"]) / 1.0\n    grip_signal = max(0.0, min(1.0, grip_signal))\n    \n    dist_factor = max(0.0, 1.0 - dist / p[\"dist_threshold\"])\n    \n    coupling = p[\"min_coupling\"] + (p[\"max_coupling\"] - p[\"min_coupling\"]) * grip_signal * dist_factor\n    \n    bx_new = bx + coupling * (ex_new - ex)\n    by_new = by + coupling * (ey_new - ey)\n    bz_new = bz + coupling * (ez_new - ez)\n    \n    if bz_new < 0.020:\n        bz_new = 0.020\n    \n    return {\n        \"block.x\": bx_new, \"block.y\": by_new, \"block.z\": bz_new,\n        \"effector.x\": ex_new, \"effector.y\": ey_new, \"effector.z\": ez_new,\n        \"goal.x\": gx, \"goal.y\": gy, \"goal.z\": gz\n    }",
      "init_params": {
        "effector_gain": 0.5,
        "grip_threshold": 0.0,
        "max_coupling": 1.0,
        "min_coupling": 0.0,
        "dist_threshold": 0.05
      },
      "repaired": true
