    {
      "name": "nonlinear_saturation_drag",
      "mechanism": "Action effects saturate nonlinearly; block experiences velocity-dependent drag when moving through air.",
      "code": "# HYPOTHESIS: nonlinear_saturation_drag\n# MECHANISM: Action effects saturate nonlinearly; block experiences velocity-dependent drag when moving through air.\nPARAMS = {\"effector_gain\": 0.4, \"saturation\": 0.8, \"drag_coeff\": 0.1, \"grasp_threshold\": 0.04, \"table_z\": 0.020}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    \n    ex, ey, ez = s[\"effector.x\"], s[\"effector.y\"], s[\"effector.z\"]\n    bx, by, bz = s[\"block.x\"], s[\"block.y\"], s[\"block.z\"]\n    gx, gy, gz = s[\"goal.x\"], s[\"goal.y\"], s[\"goal.z\"]\n    \n    def saturate(x, sat):\n        return math.tanh(x * sat) / sat if sat > 0 else x\n    \n    dx_eff = p[\"effector_gain\"] * saturate(action[0], p[\"saturation\"])\n    dy_eff = p[\"effector_gain\"] * saturate(action[1], p[\"saturation\"])\n    dz_eff = p[\"effector_gain\"] * saturate(action[2], p[\"saturation\"])\n    \n    ex_new = ex + dx_eff\n    ey_new = ey + dy_eff\n    ez_new = max(0.015, min(0.335, ez + dz_eff))\n    \n    dist = math.sqrt((ex-bx)**2 + (ey-by)**2 + (ez-bz)**2)\n    \n    if dist < p[\"grasp_threshold\"]:\n        bx_new = bx + dx_eff * (1.0 - p[\"drag_coeff\"])\n        by_new = by + dy_eff * (1.0 - p[\"drag_coeff\"])\n        bz_new = bz + dz_eff * (1.0 - p[\"drag_coeff\"])\n    else:\n        bx_new, by_new = bx, by\n        if bz > p[\"table_z\"] + 0.005:\n            bz_new = bz - p[\"drag_coeff\"] * (bz - p[\"table_z\"])\n        else:\n            bz_new = p[\"table_z\"]\n    \n    return {\n        \"block.x\": bx_new, \"block.y\": by_new, \"block.z\": bz_new,\n        \"effector.x\": ex_new, \"effector.y\": ey_new, \"effector.z\": ez_new,\n        \"goal.x\": gx, \"goal.y\": gy, \"goal.z\": gz\n    }",
      "init_params": {
