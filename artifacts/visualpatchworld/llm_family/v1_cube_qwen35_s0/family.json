    {
      "name": "continuous_contact_spring",
      "mechanism": "Block and effector coupled via spring-damper force based on distance (no binary grasp state).",
      "code": "# HYPOTHESIS: continuous_contact_spring\n# MECHANISM: Block and effector coupled via spring-damper force based on distance (no binary grasp state).\nPARAMS = {\"spring_k\": 10.0, \"damper_c\": 2.0, \"effector_gain\": 0.5, \"block_mass\": 1.0, \"rest_length\": 0.01}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    \n    ex, ey, ez = s[\"effector.x\"], s[\"effector.y\"], s[\"effector.z\"]\n    bx, by, bz = s[\"block.x\"], s[\"block.y\"], s[\"block.z\"]\n    gx, gy, gz = s[\"goal.x\"], s[\"goal.y\"], s[\"goal.z\"]\n    \n    ex_new = ex + p[\"effector_gain\"] * action[0]\n    ey_new = ey + p[\"effector_gain\"] * action[1]\n    ez_new = max(0.015, min(0.335, ez + p[\"effector_gain\"] * action[2]))\n    \n    dx, dy, dz = ex - bx, ey - by, ez - bz\n    dist = math.sqrt(dx*dx + dy*dy + dz*dz) + 1e-6\n    \n    if dist < p[\"rest_length\"]:\n        force_scale = 0.0\n    else:\n        force_scale = p[\"spring_k\"] * (dist - p[\"rest_length\"]) / dist\n    \n    fx, fy, fz = dx * force_scale, dy * force_scale, dz * force_scale\n    \n    bx_new = bx + fx / p[\"block_mass\"]\n    by_new = by + fy / p[\"block_mass\"]\n    bz_new = max(0.020, bz + fz / p[\"block_mass\"])\n    \n    return {\n        \"block.x\": bx_new, \"block.y\": by_new, \"block.z\": bz_new,\n        \"effector.x\": ex_new, \"effector.y\": ey_new, \"effector.z\": ez_new,\n        \"goal.x\": gx, \"goal.y\": gy, \"goal.z\": gz\n    }",
      "init_params": {
        "spring_k": 10.0,
        "damper_c": 2.0,
        "effector_gain": 0.5,
        "block_mass": 1.0,
        "rest_length": 0.01
      },
      "repaired": false
    },
    {
      "name": "momentum_velocity_state",
      "mechanism": "Objects have velocity/momentum state; actions command accelerations not positions (second-order dynamics).",
      "code": "# HYPOTHESIS: momentum_velocity_state\n# MECHANISM: Objects have velocity/momentum state; actions command accelerations not positions (second-order dynamics).\nPARAMS = {\"effector_accel\": 0.3, \"block_accel\": 0.2, \"damping\": 0.9, \"grasp_threshold\": 0.04, \"dt\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    \n    ex, ey, ez = s[\"effector.x\"], s[\"effector.y\"], s[\"effector.z\"]\n    bx, by, bz = s[\"block.x\"], s[\"block.y\"], s[\"block.z\"]\n    gx, gy, gz = s[\"goal.x\"], s[\"goal.y\"], s[\"goal.z\"]\n    \n    dist = math.sqrt((ex-bx)**2 + (ey-by)**2 + (ez-bz)**2)\n    grasped = 1.0 if dist < p[\"grasp_threshold\"] else 0.0\n    \n    ax = p[\"effector_accel\"] * action[0]\n    ay = p[\"effector_accel\"] * action[1]\n    az = p[\"effector_accel\"] * action[2]\n    \n    ex_new = ex + ax * p[\"dt\"]\n    ey_new = ey + ay * p[\"dt\"]\n    ez_new = max(0.015, min(0.335, ez + az * p[\"dt\"]))\n    \n    bx_new = bx + grasped * p[\"block_accel\"] * action[0] * p[\"dt\"] * p[\"damping\"]\n    by_new = by + grasped * p[\"block_accel\"] * action[1] * p[\"dt\"] * p[\"damping\"]\n    bz_new = max(0.020, bz + grasped * p[\"block_accel\"] * action[2] * p[\"dt\"] * p[\"damping\"])\n    \n    if not grasped and bz > 0.025:\n        bz_new = bz - 0.01\n    \n    return {\n        \"block.x\": bx_new, \"block.y\": by_new, \"block.z\": bz_new,\n        \"effector.x\": ex_new, \"effector.y\": ey_new, \"effector.z\": ez_new,\n        \"goal.x\": gx, \"goal.y\": gy, \"goal.z\": gz\n    }",
      "init_params": {
        "effector_accel": 0.3,
        "block_accel": 0.2,
        "damping": 0.9,
        "grasp_threshold": 0.04,
        "dt": 0.1
      },
      "repaired": true
