      "name": "simple_linear",
      "mechanism": "agent velocity is a direct linear map of the two\u2011dimensional action, position integrates velocity, block never moves.",
      "code": "# HYPOTHESIS: simple_linear\n# MECHANISM: agent velocity is a direct linear map of the two\u2011dimensional action, position integrates velocity, block never moves.\nPARAMS = {\n    \"c0\": 0.0,   # bias on vx\n    \"c1\": 0.0,   # bias on vy\n    \"k0\": 150.0, # scaling for action[0] -> vx\n    \"k1\": 150.0, # scaling for action[1] -> vy\n}\n\ndef step(state, action, p, meta):\n    # linear velocity update\n    vx = p[\"k0\"] * action[0] + p[\"c0\"]\n    vy = p[\"k1\"] * action[1] + p[\"c1\"]\n    # position integration (dt = 1)\n    x = state[\"agent.x\"] + vx\n    y = state[\"agent.y\"] + vy\n    # block unchanged\n    out = {\n        \"agent.vx\": vx,\n        \"agent.vy\": vy,\n        \"agent.x\": x,\n        \"agent.y\": y,\n        \"block.angle\": state[\"block.angle\"],\n        \"block.x\": state[\"block.x\"],\n        \"block.y\": state[\"block.y\"],\n    }\n    return out",
      "init_params": {
        "c0": 0.0,
        "c1": 0.0,
        "k0": 150.0,
        "k1": 150.0
      },
      "repaired": false
    },
    {
      "name": "damped_first_order",
      "mechanism": "agent obeys first\u2011order dynamics with exponential damping; action acts as a force, velocities decay toward zero, positions integrate velocities.",
      "code": "# HYPOTHESIS: damped_first_order\n# MECHANISM: agent obeys first\u2011order dynamics with exponential damping; action acts as a force, velocities decay toward zero, positions integrate velocities.\nPARAMS = {\n    \"mass\": 1.0,          # mass scaling for acceleration\n    \"damp\": 0.9,          # velocity damping factor (0<damp<1)\n    \"gain0\": 100.0,       # force gain for action[0]\n    \"gain1\": 100.0,       # force gain for action[1]\n}\n\ndef step(state, action, p, meta):\n    # acceleration from action\n    ax = p[\"gain0\"] * action[0] / p[\"mass\"]\n    ay = p[\"gain1\"] * action[1] / p[\"mass\"]\n    # damped velocity update\n    vx = p[\"damp\"] * state[\"agent.vx\"] + ax\n    vy = p[\"damp\"] * state[\"agent.vy\"] + ay\n    # position integration (dt = 1)\n    x = state[\"agent.x\"] + vx\n    y = state[\"agent.y\"] + vy\n    # block unchanged (no contact model here)\n    out = {\n        \"agent.vx\": vx,\n        \"agent.vy\": vy,\n        \"agent.x\": x,\n        \"agent.y\": y,\n        \"block.angle\": state[\"block.angle\"],\n        \"block.x\": state[\"block.x\"],\n        \"block.y\": state[\"block.y\"],\n    }\n    return out",
      "init_params": {
        "mass": 1.0,
        "damp": 0.9,
        "gain0": 100.0,
        "gain1": 100.0
      },
      "repaired": false
    },
    {
      "name": "contact_push",
      "mechanism": "when the circular agent touches the rectangular block (distance < contact_radius) the block is instantaneously translated by the same delta as the agent; otherwise block stays still.",
      "code": "# HYPOTHESIS: contact_push\n# MECHANISM: when the circular agent touches the rectangular block (distance < contact_radius) the block is instantaneously translated by the same delta as the agent; otherwise block stays still.\nPARAMS = {\n    \"radius\": 15.0,   # contact radius of the circular pusher\n    \"k0\": 120.0,      # force scaling for vx\n    \"k1\": 120.0,      # force scaling for vy\n    \"damp\": 0.95,     # velocity damping\n}\n\ndef step(state, action, p, meta):\n    # agent dynamics (same as damped_first_order)\n    ax = p[\"k0\"] * action[0]\n    ay = p[\"k1\"] * action[1]\n    vx = p[\"damp\"] * state[\"agent.vx\"] + ax\n    vy = p[\"damp\"] * state[\"agent.vy\"] + ay\n    x = state[\"agent.x\"] + vx\n    y = state[\"agent.y\"] + vy\n\n    # contact test\n    dx = x - state[\"block.x\"]\n    dy = y - state[\"block.y\"]\n    dist = (dx*dx + dy*dy) ** 0.5\n    if dist < p[\"radius\"]:          # contact\n        bx = state[\"block.x\"] + vx\n        by = state[\"block.y\"] + vy\n        bang = state[\"block.angle\"]   # no rotation in this simple model\n    else:\n        bx = state[\"block.x\"]\n        by = state[\"block.y\"]\n        bang = state[\"block.angle\"]\n\n    out = {\n        \"agent.vx\": vx,\n        \"agent.vy\": vy,\n        \"agent.x\": x,\n        \"agent.y\": y,\n        \"block.angle\": bang,\n        \"block.x\": bx,\n        \"block.y\": by,\n    }\n    return out",
      "init_params": {
        "radius": 15.0,
        "k0": 120.0,
        "k1": 120.0,
        "damp": 0.95
      },
      "repaired": false
    },
    {
      "name": "torque_angle",
      "mechanism": "agent pushes the block when in contact; the block translates with the agent\u2019s delta and its orientation changes proportionally to the tangential component of the push (cross product of push direction and lever arm).",
      "code": "# HYPOTHESIS: torque_angle\n# MECHANISM: agent pushes the block when in contact; the block translates with the agent\u2019s delta and its orientation changes proportionally to the tangential component of the push (cross product of push direction and lever arm).\nPARAMS = {\n    \"radius\": 15.0,      # contact radius\n    \"k_lin\": 100.0,      # linear force gain\n    \"k_ang\": 0.02,       # angular gain (rad per unit torque)\n    \"damp\": 0.93,        # velocity damping\n}\n\ndef step(state, action, p, meta):\n    # linear agent dynamics\n    ax = p[\"k_lin\"] * action[0]\n    ay = p[\"k_lin\"] * action[1]\n    vx = p[\"damp\"] * state[\"agent.vx\"] + ax\n    vy = p[\"damp\"] * state[\"agent.vy\"] + ay\n    x = state[\"agent.x\"] + vx\n    y = state[\"agent.y\"] + vy\n\n    # contact test\n    dx = x - state[\"block.x\"]\n    dy = y - state[\"block.y\"]\n    dist = (dx*dx + dy*dy) ** 0.5\n    if dist < p[\"radius\"]:\n        # block translation follows agent\n        bx = state[\"block.x\"] + vx\n        by = state[\"block.y\"] + vy\n        # lever arm from block centre to contact point (approx agent centre)\n        lx = dx\n        ly = dy\n        # torque = r x F (2D cross product scalar)\n        torque = lx * ay - ly * ax\n        bang = state[\"block.angle\"] + p[\"k_ang\"] * torque\n    else:\n        bx = state[\"block.x\"]\n        by = state[\"block.y\"]\n        bang = state[\"block.angle\"]\n\n    out = {\n        \"agent.vx\": vx,\n        \"agent.vy\": vy,\n        \"agent.x\": x,\n        \"agent.y\": y,\n        \"block.angle\": bang,\n        \"block.x\": bx,\n        \"block.y\": by,\n    }\n    return out",
      "init_params": {
        "radius": 15.0,
        "k_lin": 100.0,
        "k_ang": 0.02,
        "damp": 0.93
      },
      "repaired": false
    },
    {
      "name": "saturated_action",
      "mechanism": "actions are passed through a tanh saturation before driving a first\u2011order velocity dynamics; this captures actuator limits and yields bounded velocities.",
      "code": "# HYPOTHESIS: saturated_action\n# MECHANISM: actions are passed through a tanh saturation before driving a first\u2011order velocity dynamics; this captures actuator limits and yields bounded velocities.\nPARAMS = {\n    \"sat_gain\": 200.0,   # scaling before tanh\n    \"damp\": 0.90,        # velocity damping\n    \"bias_vx\": 0.0,\n    \"bias_vy\": 0.0,\n}\n\ndef step(state, action, p, meta):\n    # saturated control\n    u0 = p[\"sat_gain\"] * action[0]\n    u1 = p[\"sat_gain\"] * action[1]\n    fu0 = math.tanh(u0)\n    fu1 = math.tanh(u1)\n\n    # first\u2011order velocity update\n    vx = p[\"damp\"] * state[\"agent.vx\"] + fu0 + p[\"bias_vx\"]\n    vy = p[\"damp\"] * state[\"agent.vy\"] + fu1 + p[\"bias_vy\"]\n    x = state[\"agent.x\"] + vx\n    y = state[\"agent.y\"] + vy\n\n    # block unchanged (no contact model)\n    out = {\n        \"agent.vx\": vx,\n        \"agent.vy\": vy,\n        \"agent.x\": x,\n        \"agent.y\": y,\n        \"block.angle\": state[\"block.angle\"],\n        \"block.x\": state[\"block.x\"],\n        \"block.y\": state[\"block.y\"],\n    }\n    return out",
      "init_params": {
        "sat_gain": 200.0,
        "damp": 0.9,
        "bias_vx": 0.0,
        "bias_vy": 0.0
      },
      "repaired": false
    },
    {
      "name": "coupled_momentum",
      "mechanism": "agent and block exchange momentum when in contact; the block receives a fraction of the agent\u2019s velocity (drag coefficient) and the agent\u2019s velocity is reduced by the same amount (action still provides external force).",
      "code": "# HYPOTHESIS: coupled_momentum\n# MECHANISM: agent and block exchange momentum when in contact; the block receives a fraction of the agent\u2019s velocity (drag coefficient) and the agent\u2019s velocity is reduced by the same amount (action still provides external force).\nPARAMS = {\n    \"mass_agent\": 1.0,\n    \"mass_block\": 5.0,\n    \"drag_coeff\": 0.3,    # fraction of agent velocity transferred to block on contact\n    \"force_gain\": 110.0,  # conversion from action to force\n    \"damp\": 0.92,         # damping on agent velocity\n    \"radius\": 15.0,      # contact radius\n}\n\ndef step(state, action, p, meta):\n    # external force on agent\n    fx = p[\"force_gain\"] * action[0]\n    fy = p[\"force_gain\"] * action[1]\n    # agent acceleration (mass normalized)\n    ax = fx / p[\"mass_agent\"]\n    ay = fy / p[\"mass_agent\"]\n    # damped velocity update\n    vx = p[\"damp\"] * state[\"agent.vx\"] + ax\n    vy = p[\"damp\"] * state[\"agent.vy\"] + ay\n    x = state[\"agent.x\"] + vx\n    y = state[\"agent.y\"] + vy\n\n    # contact test\n    dx = x - state[\"block.x\"]\n    dy = y - state[\"block.y\"]\n    dist = (dx*dx + dy*dy) ** 0.5\n    if dist < p[\"radius\"]:\n        # momentum exchange\n        # amount transferred proportional to drag_coeff and relative masses\n        transfer_x = p[\"drag_coeff\"] * vx * (p[\"mass_agent\"] / (p[\"mass_agent\"] + p[\"mass_block\"]))\n        transfer_y = p[\"drag_coeff\"] * vy * (p[\"mass_agent\"] / (p[\"mass_agent\"] + p[\"mass_block\"]))\n        # update agent velocity (reaction)\n        vx = vx - transfer_x\n        vy = vy - transfer_y\n        # block velocity (implicit) -> position update\n        bx = state[\"block.x\"] + transfer_x\n        by = state[\"block.y\"] + transfer_y\n        bang = state[\"block.angle\"]\n    else:\n        bx = state[\"block.x\"]\n        by = state[\"block.y\"]\n        bang = state[\"block.angle\"]\n\n    out = {\n        \"agent.vx\": vx,\n        \"agent.vy\": vy,\n        \"agent.x\": x,\n        \"agent.y\": y,\n        \"block.angle\": bang,\n        \"block.x\": bx,\n        \"block.y\": by,\n    }\n    return out",
      "init_params": {
        "mass_agent": 1.0,
        "mass_block": 5.0,
        "drag_coeff": 0.3,
        "force_gain": 110.0,
        "damp": 0.92,
        "radius": 15.0
      },
      "repaired": false
    }
