    {
      "name": "newtonian_agent_static_block",
      "mechanism": "Agent obeys Newtonian dynamics (action is acceleration); Block is completely immovable.",
      "code": "# HYPOTHESIS: newtonian_agent_static_block\n# MECHANISM: Agent obeys Newtonian dynamics (action is acceleration); Block is completely immovable.\nPARAMS = {\"agent_acc_scale\": 50.0, \"dt\": 1.0}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    ax = action[0] * p[\"agent_acc_scale\"]\n    ay = action[1] * p[\"agent_acc_scale\"]\n    \n    vx = s[\"agent.vx\"] + ax * p[\"dt\"]\n    vy = s[\"agent.vy\"] + ay * p[\"dt\"]\n    x = s[\"agent.x\"] + vx * p[\"dt\"]\n    y = s[\"agent.y\"] + vy * p[\"dt\"]\n    \n    s[\"agent.vx\"] = vx\n    s[\"agent.vy\"] = vy\n    s[\"agent.x\"] = x\n    s[\"agent.y\"] = y\n    # Block remains static\n    return s",
      "init_params": {
        "agent_acc_scale": 50.0,
        "dt": 1.0
      },
      "repaired": false
    },
    {
      "name": "kinematic_agent_static_block",
      "mechanism": "Agent velocity is directly set by action (no momentum); Block is completely immovable.",
      "code": "# HYPOTHESIS: kinematic_agent_static_block\n# MECHANISM: Agent velocity is directly set by action (no momentum); Block is completely immovable.\nPARAMS = {\"agent_vel_scale\": 100.0, \"dt\": 1.0}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    vx = action[0] * p[\"agent_vel_scale\"]\n    vy = action[1] * p[\"agent_vel_scale\"]\n    \n    x = s[\"agent.x\"] + vx * p[\"dt\"]\n    y = s[\"agent.y\"] + vy * p[\"dt\"]\n    \n    s[\"agent.vx\"] = vx\n    s[\"agent.vy\"] = vy\n    s[\"agent.x\"] = x\n    s[\"agent.y\"] = y\n    # Block remains static\n    return s",
      "init_params": {
        "agent_vel_scale": 100.0,
        "dt": 1.0
      },
      "repaired": false
    },
    {
      "name": "hard_contact_push",
      "mechanism": "Agent has momentum; Block moves kinematically with agent only if distance < radius.",
      "code": "# HYPOTHESIS: hard_contact_push\n# MECHANISM: Agent has momentum; Block moves kinematically with agent only if distance < radius.\nPARAMS = {\"agent_acc_scale\": 50.0, \"dt\": 1.0, \"contact_radius\": 50.0}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    ax = action[0] * p[\"agent_acc_scale\"]\n    ay = action[1] * p[\"agent_acc_scale\"]\n    \n    vx = s[\"agent.vx\"] + ax * p[\"dt\"]\n    vy = s[\"agent.vy\"] + ay * p[\"dt\"]\n    x = s[\"agent.x\"] + vx * p[\"dt\"]\n    y = s[\"agent.y\"] + vy * p[\"dt\"]\n    \n    s[\"agent.vx\"] = vx\n    s[\"agent.vy\"] = vy\n    s[\"agent.x\"] = x\n    s[\"agent.y\"] = y\n    \n    dx = x - s[\"block.x\"]\n    dy = y - s[\"block.y\"]\n    dist = math.hypot(dx, dy) + 1e-6\n    \n    if dist < p[\"contact_radius\"]:\n        # Push block with agent velocity\n        s[\"block.x\"] = s[\"block.x\"] + vx * p[\"dt\"]\n        s[\"block.y\"] = s[\"block.y\"] + vy * p[\"dt\"]\n        # Angle unchanged in this simple model\n        \n    return s",
      "init_params": {
        "agent_acc_scale": 50.0,
        "dt": 1.0,
        "contact_radius": 50.0
      },
      "repaired": false
    },
    {
      "name": "soft_contact_spring",
      "mechanism": "Agent and Block interact via a repulsive spring force when within a threshold distance.",
      "code": "# HYPOTHESIS: soft_contact_spring\n# MECHANISM: Agent and Block interact via a repulsive spring force when within a threshold distance.\nPARAMS = {\"agent_acc_scale\": 50.0, \"dt\": 1.0, \"contact_radius\": 60.0, \"stiffness\": 0.5, \"torque_scale\": 0.01}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    ax = action[0] * p[\"agent_acc_scale\"]\n    ay = action[1] * p[\"agent_acc_scale\"]\n    \n    vx = s[\"agent.vx\"] + ax * p[\"dt\"]\n    vy = s[\"agent.vy\"] + ay * p[\"dt\"]\n    x = s[\"agent.x\"] + vx * p[\"dt\"]\n    y = s[\"agent.y\"] + vy * p[\"dt\"]\n    \n    s[\"agent.vx\"] = vx\n    s[\"agent.vy\"] = vy\n    s[\"agent.x\"] = x\n    s[\"agent.y\"] = y\n    \n    dx = x - s[\"block.x\"]\n    dy = y - s[\"block.y\"]\n    dist = math.hypot(dx, dy) + 1e-6\n    \n    if dist < p[\"contact_radius\"]:\n        overlap = p[\"contact_radius\"] - dist\n        force = overlap * p[\"stiffness\"]\n        nx = dx / dist\n        ny = dy / dist\n        \n        s[\"block.x\"] += nx * force * p[\"dt\"]\n        s[\"block.y\"] += ny * force * p[\"dt\"]\n        # Simple torque approximation based on lateral offset\n        s[\"block.angle\"] += (nx * vy - ny * vx) * p[\"torque_scale\"] * p[\"dt\"]\n        \n    return s",
      "init_params": {
        "agent_acc_scale": 50.0,
        "dt": 1.0,
        "contact_radius": 60.0,
        "stiffness": 0.5,
        "torque_scale": 0.01
      },
      "repaired": false
    },
    {
      "name": "long_range_field",
      "mechanism": "Agent exerts a continuous force on Block proportional to inverse square of distance (no contact threshold).",
      "code": "# HYPOTHESIS: long_range_field\n# MECHANISM: Agent exerts a continuous force on Block proportional to inverse square of distance (no contact threshold).\nPARAMS = {\"agent_acc_scale\": 50.0, \"dt\": 1.0, \"field_strength\": 5000.0, \"rot_coupling\": 0.001}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    ax = action[0] * p[\"agent_acc_scale\"]\n    ay = action[1] * p[\"agent_acc_scale\"]\n    \n    vx = s[\"agent.vx\"] + ax * p[\"dt\"]\n    vy = s[\"agent.vy\"] + ay * p[\"dt\"]\n    x = s[\"agent.x\"] + vx * p[\"dt\"]\n    y = s[\"agent.y\"] + vy * p[\"dt\"]\n    \n    s[\"agent.vx\"] = vx\n    s[\"agent.vy\"] = vy\n    s[\"agent.x\"] = x\n    s[\"agent.y\"] = y\n    \n    dx = x - s[\"block.x\"]\n    dy = y - s[\"block.y\"]\n    dist_sq = dx*dx + dy*dy + 100.0 # Soften singularity\n    dist = math.sqrt(dist_sq)\n    \n    force = p[\"field_strength\"] / dist_sq\n    nx = dx / dist\n    ny = dy / dist\n    \n    s[\"block.x\"] += nx * force * p[\"dt\"]\n    s[\"block.y\"] += ny * force * p[\"dt\"]\n    s[\"block.angle\"] += (nx * vy - ny * vx) * p[\"rot_coupling\"] * p[\"dt\"]\n    \n    return s",
      "init_params": {
        "agent_acc_scale": 50.0,
        "dt": 1.0,
        "field_strength": 5000.0,
        "rot_coupling": 0.001
      },
      "repaired": false
    },
    {
      "name": "velocity_gated_push",
      "mechanism": "Block moves only if agent is close AND agent speed exceeds a threshold (static friction model).",
      "code": "# HYPOTHESIS: velocity_gated_push\n# MECHANISM: Block moves only if agent is close AND agent speed exceeds a threshold (static friction model).\nPARAMS = {\"agent_acc_scale\": 50.0, \"dt\": 1.0, \"contact_radius\": 50.0, \"speed_thresh\": 50.0, \"push_gain\": 0.5}\n\ndef step(state, action, p, meta):\n    import math\n    s = dict(state)\n    ax = action[0] * p[\"agent_acc_scale\"]\n    ay = action[1] * p[\"agent_acc_scale\"]\n    \n    vx = s[\"agent.vx\"] + ax * p[\"dt\"]\n    vy = s[\"agent.vy\"] + ay * p[\"dt\"]\n    x = s[\"agent.x\"] + vx * p[\"dt\"]\n    y = s[\"agent.y\"] + vy * p[\"dt\"]\n    \n    s[\"agent.vx\"] = vx\n    s[\"agent.vy\"] = vy\n    s[\"agent.x\"] = x\n    s[\"agent.y\"] = y\n    \n    dx = x - s[\"block.x\"]\n    dy = y - s[\"block.y\"]\n    dist = math.hypot(dx, dy) + 1e-6\n    speed = math.hypot(vx, vy)\n    \n    if dist < p[\"contact_radius\"] and speed > p[\"speed_thresh\"]:\n        s[\"block.x\"] += (dx / dist) * speed * p[\"push_gain\"] * p[\"dt\"]\n        s[\"block.y\"] += (dy / dist) * speed * p[\"push_gain\"] * p[\"dt\"]\n        # Rotation depends on tangential component\n        tangent = (vx * dy - vy * dx) / dist\n        s[\"block.angle\"] += tangent * p[\"push_gain\"] * 0.01 * p[\"dt\"]\n        \n    return s",
      "init_params": {
        "agent_acc_scale": 50.0,
        "dt": 1.0,
        "contact_radius": 50.0,
        "speed_thresh": 50.0,
        "push_gain": 0.5
      },
      "repaired": false
    }
