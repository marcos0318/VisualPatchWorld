    {
      "name": "linear_joint_control",
      "mechanism": "Actions directly change joint positions with linear response and no momentum",
      "code": "# HYPOTHESIS: linear_joint_control\n# MECHANISM: Actions directly change joint positions with linear response and no momentum\nPARAMS = {\"gain_x\": 1.0, \"gain_y\": 1.0}\n\ndef step(state, action, p, meta):\n    next_state = {}\n    next_state[\"arm.x\"] = state[\"arm.x\"] + action[0] * p[\"gain_x\"]\n    next_state[\"arm.y\"] = state[\"arm.y\"] + action[1] * p[\"gain_y\"]\n    next_state[\"finger.x\"] = state[\"finger.x\"]  # Finger position determined by arm kinematics\n    next_state[\"finger.y\"] = state[\"finger.y\"]\n    next_state[\"target.x\"] = state[\"target.x\"]  # Target is static\n    next_state[\"target.y\"] = state[\"target.y\"]\n    return next_state",
      "init_params": {
        "gain_x": 1.0,
        "gain_y": 1.0
      },
      "repaired": false
    },
    {
      "name": "momentum_joint_control",
      "mechanism": "Actions apply forces to joints with momentum-based integration",
      "code": "# HYPOTHESIS: momentum_joint_control\n# MECHANISM: Actions apply forces to joints with momentum-based integration\nPARAMS = {\"mass_arm_x\": 1.0, \"mass_arm_y\": 1.0, \"damping\": 0.1}\n\ndef step(state, action, p, meta):\n    next_state = {}\n    # Assume previous velocity is zero for simplicity, or derive from previous state if available\n    # Here we approximate using action as force and compute acceleration\n    acc_x = action[0] / p[\"mass_arm_x\"]\n    acc_y = action[1] / p[\"mass_arm_y\"]\n    \n    # Update velocities (assuming dt=1)\n    vel_x = acc_x - state.get(\"arm.vx\", 0) * p[\"damping\"]\n    vel_y = acc_y - state.get(\"arm.vy\", 0) * p[\"damping\"]\n    \n    # Update positions\n    next_state[\"arm.x\"] = state[\"arm.x\"] + vel_x\n    next_state[\"arm.y\"] = state[\"arm.y\"] + vel_y\n    \n    # Finger position follows arm (simplified)\n    next_state[\"finger.x\"] = state[\"finger.x\"] + (next_state[\"arm.x\"] - state[\"arm.x\"])\n    next_state[\"finger.y\"] = state[\"finger.y\"] + (next_state[\"arm.y\"] - state[\"arm.y\"])\n    \n    next_state[\"target.x\"] = state[\"target.x\"]\n    next_state[\"target.y\"] = state[\"target.y\"]\n    return next_state",
      "init_params": {
        "mass_arm_x": 1.0,
        "mass_arm_y": 1.0,
        "damping": 0.1
      },
      "repaired": false
    },
    {
      "name": "coupled_end_effector_control",
      "mechanism": "Actions control end-effector movement directly through inverse kinematics",
      "code": "# HYPOTHESIS: coupled_end_effector_control\n# MECHANISM: Actions control end-effector movement directly through inverse kinematics\nPARAMS = {\"effector_gain_x\": 1.0, \"effector_gain_y\": 1.0, \"link_length\": 1.0}\n\ndef step(state, action, p, meta):\n    next_state = {}\n    # Move finger directly according to action\n    next_state[\"finger.x\"] = state[\"finger.x\"] + action[0] * p[\"effector_gain_x\"]\n    next_state[\"finger.y\"] = state[\"finger.y\"] + action[1] * p[\"effector_gain_y\"]\n    \n    # Arm position updates based on finger movement (inverse kinematics)\n    # Simplified assumption: arm moves to maintain finger position\n    dx = next_state[\"finger.x\"] - state[\"finger.x\"]\n    dy = next_state[\"finger.y\"] - state[\"finger.y\"]\n    next_state[\"arm.x\"] = state[\"arm.x\"] + dx / p[\"link_length\"]\n    next_state[\"arm.y\"] = state[\"arm.y\"] + dy / p[\"link_length\"]\n    \n    next_state[\"target.x\"] = state[\"target.x\"]\n    next_state[\"target.y\"] = state[\"target.y\"]\n    return next_state",
      "init_params": {
        "effector_gain_x": 1.0,
        "effector_gain_y": 1.0,
        "link_length": 1.0
      },
      "repaired": false
    },
    {
      "name": "saturated_joint_control",
      "mechanism": "Joint movements are subject to physical limits causing saturation effects",
      "code": "# HYPOTHESIS: saturated_joint_control\n# MECHANISM: Joint movements are subject to physical limits causing saturation effects\nPARAMS = {\"max_rate\": 0.5, \"min_x\": -5.0, \"max_x\": 5.0, \"min_y\": -3.0, \"max_y\": 3.0}\n\ndef step(state, action, p, meta):\n    next_state = {}\n    # Apply rate limiting\n    delta_x = max(min(action[0], p[\"max_rate\"]), -p[\"max_rate\"])\n    delta_y = max(min(action[1], p[\"max_rate\"]), -p[\"max_rate\"])\n    \n    new_x = state[\"arm.x\"] + delta_x\n    new_y = state[\"arm.y\"] + delta_y\n    \n    # Apply position limits\n    next_state[\"arm.x\"] = max(min(new_x, p[\"max_x\"]), p[\"min_x\"])\n    next_state[\"arm.y\"] = max(min(new_y, p[\"max_y\"]), p[\"min_y\"])\n    \n    # Finger position derived from arm (placeholder)\n    next_state[\"finger.x\"] = state[\"finger.x\"] + delta_x\n    next_state[\"finger.y\"] = state[\"finger.y\"] + delta_y\n    \n    next_state[\"target.x\"] = state[\"target.x\"]\n    next_state[\"target.y\"] = state[\"target.y\"]\n    return next_state",
      "init_params": {
        "max_rate": 0.5,
        "min_x": -5.0,
        "max_x": 5.0,
        "min_y": -3.0,
        "max_y": 3.0
      },
      "repaired": false
    },
    {
      "name": "delayed_response_model",
      "mechanism": "System has internal states that cause delayed response to actions",
      "code": "# HYPOTHESIS: delayed_response_model\n# MECHANISM: System has internal states that cause delayed response to actions\nPARAMS = {\"delay_factor\": 0.7, \"response_rate\": 0.3}\n\ndef step(state, action, p, meta):\n    next_state = {}\n    # Introduce delay through internal state memory (approximated here)\n    # This simulates systems where current output depends on past inputs\n    \n    # Compute intended change\n    intent_x = action[0] * p[\"response_rate\"]\n    intent_y = action[1] * p[\"response_rate\"]\n    \n    # Mix with previous state to simulate delay\n    next_state[\"arm.x\"] = state[\"arm.x\"] * p[\"delay_factor\"] + intent_x * (1 - p[\"delay_factor\"])\n    next_state[\"arm.y\"] = state[\"arm.y\"] * p[\"delay_factor\"] + intent_y * (1 - p[\"delay_factor\"])\n    \n    # Finger position follows arm approximately\n    next_state[\"finger.x\"] = state[\"finger.x\"] + (next_state[\"arm.x\"] - state[\"arm.x\"])\n    next_state[\"finger.y\"] = state[\"finger.y\"] + (next_state[\"arm.y\"] - state[\"arm.y\"])\n    \n    next_state[\"target.x\"] = state[\"target.x\"]\n    next_state[\"target.y\"] = state[\"target.y\"]\n    return next_state",
      "init_params": {
        "delay_factor": 0.7,
        "response_rate": 0.3
      },
      "repaired": false
    },
    {
      "name": "obstacle_avoidance_dynamics",
      "mechanism": "Motion is influenced by repulsive forces from boundaries or other objects",
      "code": "# HYPOTHESIS: obstacle_avoidance_dynamics\n# MECHANISM: Motion is influenced by repulsive forces from boundaries or other objects\nPARAMS = {\"repulsion_strength\": 0.1, \"boundary_margin\": 0.5, \"max_speed\": 0.4}\n\ndef step(state, action, p, meta):\n    next_state = {}\n    \n    # Base movement from action\n    dx = action[0]\n    dy = action[1]\n    \n    # Limit speed\n    speed = math.sqrt(dx*dx + dy*dy)\n    if speed > p[\"max_speed\"]:\n        scale = p[\"max_speed\"] / speed\n        dx *= scale\n        dy *= scale\n    \n    # Add repulsion from boundaries\n    boundary_force_x = 0\n    boundary_force_y = 0\n    \n    # Repel from x boundaries\n    if state[\"arm.x\"] < p[\"boundary_margin\"]:\n        boundary_force_x += p[\"repulsion_strength\"] / (state[\"arm.x\"] - (-5))  # Assuming min x ~ -5\n    elif state[\"arm.x\"] > 5 - p[\"boundary_margin\"]:\n        boundary_force_x -= p[\"repulsion_strength\"] / (5 - state[\"arm.x\"])\n        \n    # Repel from y boundaries  \n    if state[\"arm.y\"] < p[\"boundary_margin\"]:\n        boundary_force_y += p[\"repulsion_strength\"] / (state[\"arm.y\"] - (-3))  # Assuming min y ~ -3\n    elif state[\"arm.y\"] > 3 - p[\"boundary_margin\"]:\n        boundary_force_y -= p[\"repulsion_strength\"] / (3 - state[\"arm.y\"])\n    \n    # Apply forces\n    next_state[\"arm.x\"] = state[\"arm.x\"] + dx + boundary_force_x\n    next_state[\"arm.y\"] = state[\"arm.y\"] + dy + boundary_force_y\n    \n    # Finger follows arm\n    next_state[\"finger.x\"] = state[\"finger.x\"] + dx\n    next_state[\"finger.y\"] = state[\"finger.y\"] + dy\n    \n    next_state[\"target.x\"] = state[\"target.x\"]\n    next_state[\"target.y\"] = state[\"target.y\"]\n    return next_state",
      "init_params": {
        "repulsion_strength": 0.1,
        "boundary_margin": 0.5,
        "max_speed": 0.4
      },
      "repaired": false
    }
  ],
