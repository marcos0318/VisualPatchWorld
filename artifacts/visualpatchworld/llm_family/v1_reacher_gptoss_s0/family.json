  "candidates": [
    {
      "name": "linear_first_order",
      "mechanism": "arm moves linearly with the raw action, finger follows arm with a fixed coupling gain.",
      "code": "# HYPOTHESIS: linear_first_order\n# MECHANISM: arm moves linearly with the raw action, finger follows arm with a fixed coupling gain.\nPARAMS = {\n    \"arm_gain_x\": 0.5,\n    \"arm_gain_y\": 0.5,\n    \"finger_coupling\": 0.2,\n}\n\ndef step(state, action, p, meta):\n    # arm updates directly from action\n    new_arm_x = state[\"arm.x\"] + p[\"arm_gain_x\"] * action[0]\n    new_arm_y = state[\"arm.y\"] + p[\"arm_gain_y\"] * action[1]\n\n    # finger moves a fraction towards the new arm position\n    dx = new_arm_x - state[\"finger.x\"]\n    dy = new_arm_y - state[\"finger.y\"]\n    new_finger_x = state[\"finger.x\"] + p[\"finger_coupling\"] * dx\n    new_finger_y = state[\"finger.y\"] + p[\"finger_coupling\"] * dy\n\n    # target is static\n    return {\n        \"arm.x\": new_arm_x,\n        \"arm.y\": new_arm_y,\n        \"finger.x\": new_finger_x,\n        \"finger.y\": new_finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }",
      "init_params": {
        "arm_gain_x": 0.5,
        "arm_gain_y": 0.5,
        "finger_coupling": 0.2
      },
      "repaired": false
    },
    {
      "name": "momentum_smoothing",
      "mechanism": "action is interpreted as a velocity command that is low\u2011pass filtered; finger lags with exponential smoothing.",
      "code": "# HYPOTHESIS: momentum_smoothing\n# MECHANISM: action is interpreted as a velocity command that is low\u2011pass filtered; finger lags with exponential smoothing.\nPARAMS = {\n    \"arm_vel_gain\": 0.8,      # scale from action to velocity\n    \"arm_alpha\": 0.7,        # smoothing factor for arm (0=no smoothing, 1=full inertia)\n    \"finger_alpha\": 0.4,      # smoothing factor for finger\n}\n\ndef step(state, action, p, meta):\n    # compute raw velocity from action\n    vel_x = p[\"arm_vel_gain\"] * action[0]\n    vel_y = p[\"arm_vel_gain\"] * action[1]\n\n    # low\u2011pass filter the arm position (momentum)\n    new_arm_x = state[\"arm.x\"] + (1.0 - p[\"arm_alpha\"]) * vel_x\n    new_arm_y = state[\"arm.y\"] + (1.0 - p[\"arm_alpha\"]) * vel_y\n\n    # finger follows the arm with its own smoothing\n    new_finger_x = state[\"finger.x\"] + p[\"finger_alpha\"] * (new_arm_x - state[\"finger.x\"])\n    new_finger_y = state[\"finger.y\"] + p[\"finger_alpha\"] * (new_arm_y - state[\"finger.y\"])\n\n    return {\n        \"arm.x\": new_arm_x,\n        \"arm.y\": new_arm_y,\n        \"finger.x\": new_finger_x,\n        \"finger.y\": new_finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }",
      "init_params": {
        "arm_vel_gain": 0.8,
        "arm_alpha": 0.7,
        "finger_alpha": 0.4
      },
      "repaired": false
    },
    {
      "name": "saturated_tanh",
      "mechanism": "arm response saturates non\u2011linearly via a tanh nonlinearity; finger follows arm linearly.",
      "code": "# HYPOTHESIS: saturated_tanh\n# MECHANISM: arm response saturates non\u2011linearly via a tanh nonlinearity; finger follows arm linearly.\nPARAMS = {\n    \"arm_gain_x\": 1.0,\n    \"arm_gain_y\": 1.0,\n    \"sat_scale\": 0.3,          # amplitude of saturated step\n    \"finger_coupling\": 0.15,\n}\n\ndef step(state, action, p, meta):\n    # saturated delta using tanh\n    delta_x = p[\"sat_scale\"] * math.tanh(p[\"arm_gain_x\"] * action[0])\n    delta_y = p[\"sat_scale\"] * math.tanh(p[\"arm_gain_y\"] * action[1])\n\n    new_arm_x = state[\"arm.x\"] + delta_x\n    new_arm_y = state[\"arm.y\"] + delta_y\n\n    # finger moves toward the new arm position\n    dx = new_arm_x - state[\"finger.x\"]\n    dy = new_arm_y - state[\"finger.y\"]\n    new_finger_x = state[\"finger.x\"] + p[\"finger_coupling\"] * dx\n    new_finger_y = state[\"finger.y\"] + p[\"finger_coupling\"] * dy\n\n    return {\n        \"arm.x\": new_arm_x,\n        \"arm.y\": new_arm_y,\n        \"finger.x\": new_finger_x,\n        \"finger.y\": new_finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }",
      "init_params": {
        "arm_gain_x": 1.0,
        "arm_gain_y": 1.0,
        "sat_scale": 0.3,
        "finger_coupling": 0.15
      },
      "repaired": false
    },
    {
      "name": "fixed_length_finger",
      "mechanism": "the finger is rigidly attached to the arm at a constant link length; action moves the arm, finger is recomputed to keep the distance L.",
      "code": "# HYPOTHESIS: fixed_length_finger\n# MECHANISM: the finger is rigidly attached to the arm at a constant link length; action moves the arm, finger is recomputed to keep the distance L.\nPARAMS = {\n    \"arm_gain_x\": 0.6,\n    \"arm_gain_y\": 0.6,\n    \"link_length\": 0.15,      # desired distance between arm and finger\n}\n\ndef step(state, action, p, meta):\n    # move the arm linearly\n    new_arm_x = state[\"arm.x\"] + p[\"arm_gain_x\"] * action[0]\n    new_arm_y = state[\"arm.y\"] + p[\"arm_gain_y\"] * action[1]\n\n    # vector from arm to current finger\n    vx = state[\"finger.x\"] - state[\"arm.x\"]\n    vy = state[\"finger.y\"] - state[\"arm.y\"]\n    # normalize\n    norm = math.hypot(vx, vy)\n    if norm == 0:\n        # arbitrary direction if collapsed\n        ux, uy = 1.0, 0.0\n    else:\n        ux, uy = vx / norm, vy / norm\n\n    # place finger at fixed distance along that direction from the new arm position\n    new_finger_x = new_arm_x + p[\"link_length\"] * ux\n    new_finger_y = new_arm_y + p[\"link_length\"] * uy\n\n    return {\n        \"arm.x\": new_arm_x,\n        \"arm.y\": new_arm_y,\n        \"finger.x\": new_finger_x,\n        \"finger.y\": new_finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }",
      "init_params": {
        "arm_gain_x": 0.6,
        "arm_gain_y": 0.6,
        "link_length": 0.15
      },
      "repaired": false
    },
    {
      "name": "proximity_gate",
      "mechanism": "finger moves toward the arm only while it is farther than a threshold from the target; once close enough it stops (contact/gating).",
      "code": "# HYPOTHESIS: proximity_gate\n# MECHANISM: finger moves toward the arm only while it is farther than a threshold from the target; once close enough it stops (contact/gating).\nPARAMS = {\n    \"arm_gain_x\": 0.55,\n    \"arm_gain_y\": 0.55,\n    \"finger_gain\": 0.2,\n    \"gate_thresh\": 0.05,      # distance to target below which finger freezes\n}\n\ndef step(state, action, p, meta):\n    # arm update\n    new_arm_x = state[\"arm.x\"] + p[\"arm_gain_x\"] * action[0]\n    new_arm_y = state[\"arm.y\"] + p[\"arm_gain_y\"] * action[1]\n\n    # distance from finger to target\n    dx_t = state[\"finger.x\"] - state[\"target.x\"]\n    dy_t = state[\"finger.y\"] - state[\"target.y\"]\n    dist_to_target = math.hypot(dx_t, dy_t)\n\n    if dist_to_target < p[\"gate_thresh\"]:\n        # finger is considered in contact; freeze its position\n        new_finger_x = state[\"finger.x\"]\n        new_finger_y = state[\"finger.y\"]\n    else:\n        # otherwise move toward the arm\n        dx = new_arm_x - state[\"finger.x\"]\n        dy = new_arm_y - state[\"finger.y\"]\n        new_finger_x = state[\"finger.x\"] + p[\"finger_gain\"] * dx\n        new_finger_y = state[\"finger.y\"] + p[\"finger_gain\"] * dy\n\n    return {\n        \"arm.x\": new_arm_x,\n        \"arm.y\": new_arm_y,\n        \"finger.x\": new_finger_x,\n        \"finger.y\": new_finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }",
      "init_params": {
        "arm_gain_x": 0.55,
        "arm_gain_y": 0.55,
        "finger_gain": 0.2,
        "gate_thresh": 0.05
      },
      "repaired": false
    },
    {
      "name": "two_link_arm",
      "mechanism": "arm.x/y represent the base joint; action is an angular velocity applied to a second joint of fixed length; finger is the end\u2011effector of a two\u2011link planar arm.",
      "code": "# HYPOTHESIS: two_link_arm\n# MECHANISM: arm.x/y represent the base joint; action is an angular velocity applied to a second joint of fixed length; finger is the end\u2011effector of a two\u2011link planar arm.\nPARAMS = {\n    \"base_gain_x\": 0.5,       # translation gain for the base joint\n    \"base_gain_y\": 0.5,\n    \"link_length\": 0.25,      # length of the second link\n    \"angle_gain\": 0.8,        # scale from action[0] (joint torque) to angle change\n    \"angle_offset_gain\": 0.8, # scale from action[1] to a small offset angle (optional)\n}\n# we treat action[0] as angular increment, action[1] as secondary small angle (e.g., wrist)\n\ndef step(state, action, p, meta):\n    # move the base (first joint) linearly\n    base_x = state[\"arm.x\"] + p[\"base_gain_x\"] * action[0]\n    base_y = state[\"arm.y\"] + p[\"base_gain_y\"] * action[1]\n\n    # compute current angle of the second link relative to the base\n    # we infer it from the current finger position\n    vx = state[\"finger.x\"] - state[\"arm.x\"]\n    vy = state[\"finger.y\"] - state[\"arm.y\"]\n    cur_angle = math.atan2(vy, vx)\n\n    # update the angle with the action (scaled)\n    new_angle = cur_angle + p[\"angle_gain\"] * action[0]\n\n    # place the finger at the end of the second link\n    new_finger_x = base_x + p[\"link_length\"] * math.cos(new_angle)\n    new_finger_y = base_y + p[\"link_length\"] * math.sin(new_angle)\n\n    return {\n        \"arm.x\": base_x,\n        \"arm.y\": base_y,\n        \"finger.x\": new_finger_x,\n        \"finger.y\": new_finger_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }",
      "init_params": {
        "base_gain_x": 0.5,
        "base_gain_y": 0.5,
        "link_length": 0.25,
        "angle_gain": 0.8,
        "angle_offset_gain": 0.8
      },
      "repaired": false
    }
  ],
