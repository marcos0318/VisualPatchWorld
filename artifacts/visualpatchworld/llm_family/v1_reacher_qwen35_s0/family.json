    {
      "name": "workspace_constraint",
      "mechanism": "Finger motion is constrained by arm workspace boundaries; hard limits on reachable positions.",
      "code": "# HYPOTHESIS: workspace_constraint\n# MECHANISM: Finger motion is constrained by arm workspace boundaries; hard limits on reachable positions.\nPARAMS = {\"arm_gain\": 0.1, \"finger_gain\": 0.05, \"max_finger_x\": 0.25, \"max_finger_y\": 0.25, \"a0_w\": 0.5, \"a1_w\": 0.5}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = {}\n    new_state[\"target.x\"] = state[\"target.x\"]\n    new_state[\"target.y\"] = state[\"target.y\"]\n    action_eff = p[\"a0_w\"] * action[0] + p[\"a1_w\"] * action[1]\n    new_state[\"arm.x\"] = state[\"arm.x\"] + p[\"arm_gain\"] * action_eff\n    new_state[\"arm.y\"] = state[\"arm.y\"] + p[\"arm_gain\"] * action_eff\n    finger_x_new = state[\"finger.x\"] + p[\"finger_gain\"] * action_eff\n    finger_y_new = state[\"finger.y\"] + p[\"finger_gain\"] * action_eff\n    new_state[\"finger.x\"] = max(-p[\"max_finger_x\"], min(p[\"max_finger_x\"], finger_x_new))\n    new_state[\"finger.y\"] = max(-p[\"max_finger_y\"], min(p[\"max_finger_y\"], finger_y_new))\n    return new_state",
      "init_params": {
        "arm_gain": 0.1,
