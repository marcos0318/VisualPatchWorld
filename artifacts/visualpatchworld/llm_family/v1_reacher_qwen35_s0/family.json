      "name": "independent_linear",
      "mechanism": "Each state variable changes linearly and independently with action; no coupling between arm and finger.",
      "code": "# HYPOTHESIS: independent_linear\n# MECHANISM: Each state variable changes linearly and independently with action; no coupling between arm and finger.\nPARAMS = {\"arm_x_gain\": 0.1, \"arm_y_gain\": 0.1, \"finger_x_gain\": 0.05, \"finger_y_gain\": 0.05, \"a0_arm\": 0.5, \"a1_arm\": 0.5, \"a0_finger\": 0.5, \"a1_finger\": 0.5}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = {}\n    new_state[\"target.x\"] = state[\"target.x\"]\n    new_state[\"target.y\"] = state[\"target.y\"]\n    arm_eff = p[\"a0_arm\"] * action[0] + p[\"a1_arm\"] * action[1]\n    finger_eff = p[\"a0_finger\"] * action[0] + p[\"a1_finger\"] * action[1]\n    new_state[\"arm.x\"] = state[\"arm.x\"] + p[\"arm_x_gain\"] * arm_eff\n    new_state[\"arm.y\"] = state[\"arm.y\"] + p[\"arm_y_gain\"] * arm_eff\n    new_state[\"finger.x\"] = state[\"finger.x\"] + p[\"finger_x_gain\"] * finger_eff\n    new_state[\"finger.y\"] = state[\"finger.y\"] + p[\"finger_y_gain\"] * finger_eff\n    return new_state",
      "init_params": {
        "arm_x_gain": 0.1,
        "arm_y_gain": 0.1,
        "finger_x_gain": 0.05,
        "finger_y_gain": 0.05,
        "a0_arm": 0.5,
        "a1_arm": 0.5,
        "a0_finger": 0.5,
        "a1_finger": 0.5
      },
      "repaired": false
    },
    {
      "name": "forward_kinematics",
      "mechanism": "Finger position is determined by arm joint angles through trigonometric forward kinematics; only arm angles are directly actuated.",
      "code": "# HYPOTHESIS: forward_kinematics\n# MECHANISM: Finger position is determined by arm joint angles through trigonometric forward kinematics; only arm angles are directly actuated.\nPARAMS = {\"link1_len\": 1.0, \"link2_len\": 1.0, \"joint0_gain\": 0.1, \"joint1_gain\": 0.1, \"base_x\": 0.0, \"base_y\": 0.0}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = {}\n    new_state[\"target.x\"] = state[\"target.x\"]\n    new_state[\"target.y\"] = state[\"target.y\"]\n    new_state[\"arm.x\"] = state[\"arm.x\"] + p[\"joint0_gain\"] * action[0]\n    new_state[\"arm.y\"] = state[\"arm.y\"] + p[\"joint1_gain\"] * action[1]\n    j0 = new_state[\"arm.x\"]\n    j1 = new_state[\"arm.y\"]\n    new_state[\"finger.x\"] = p[\"base_x\"] + p[\"link1_len\"] * math.cos(j0) + p[\"link2_len\"] * math.cos(j0 + j1)\n    new_state[\"finger.y\"] = p[\"base_y\"] + p[\"link1_len\"] * math.sin(j0) + p[\"link2_len\"] * math.sin(j0 + j1)\n    return new_state",
      "init_params": {
        "link1_len": 1.0,
        "link2_len": 1.0,
        "joint0_gain": 0.1,
        "joint1_gain": 0.1,
        "base_x": 0.0,
        "base_y": 0.0
      },
      "repaired": false
    },
    {
      "name": "momentum_second_order",
      "mechanism": "Action affects velocity which integrates to position; includes state-dependent damping for energy dissipation.",
      "code": "# HYPOTHESIS: momentum_second_order\n# MECHANISM: Action affects velocity which integrates to position; includes state-dependent damping for energy dissipation.\nPARAMS = {\"arm_mass\": 1.0, \"finger_mass\": 1.0, \"damping\": 0.1, \"force_scale\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = {}\n    new_state[\"target.x\"] = state[\"target.x\"]\n    new_state[\"target.y\"] = state[\"target.y\"]\n    arm_resistance = 1.0 + p[\"damping\"] * abs(state[\"arm.x\"] + state[\"arm.y\"])\n    finger_resistance = 1.0 + p[\"damping\"] * abs(state[\"finger.x\"] + state[\"finger.y\"])\n    new_state[\"arm.x\"] = state[\"arm.x\"] + p[\"force_scale\"] * action[0] / (p[\"arm_mass\"] * arm_resistance)\n    new_state[\"arm.y\"] = state[\"arm.y\"] + p[\"force_scale\"] * action[1] / (p[\"arm_mass\"] * arm_resistance)\n    new_state[\"finger.x\"] = state[\"finger.x\"] + p[\"force_scale\"] * action[0] / (p[\"finger_mass\"] * finger_resistance)\n    new_state[\"finger.y\"] = state[\"finger.y\"] + p[\"force_scale\"] * action[1] / (p[\"finger_mass\"] * finger_resistance)\n    return new_state",
      "init_params": {
        "arm_mass": 1.0,
        "finger_mass": 1.0,
        "damping": 0.1,
        "force_scale": 0.1
      },
      "repaired": false
    },
    {
      "name": "saturated_response",
      "mechanism": "Action effect saturates at extremes via tanh nonlinearity; prevents unbounded state growth.",
      "code": "# HYPOTHESIS: saturated_response\n# MECHANISM: Action effect saturates at extremes via tanh nonlinearity; prevents unbounded state growth.\nPARAMS = {\"arm_gain\": 0.5, \"finger_gain\": 0.1, \"saturation_scale\": 2.0, \"a0_weight\": 0.5, \"a1_weight\": 0.5}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = {}\n    new_state[\"target.x\"] = state[\"target.x\"]\n    new_state[\"target.y\"] = state[\"target.y\"]\n    action_eff = p[\"a0_weight\"] * action[0] + p[\"a1_weight\"] * action[1]\n    saturated = math.tanh(action_eff / p[\"saturation_scale\"])\n    new_state[\"arm.x\"] = state[\"arm.x\"] + p[\"arm_gain\"] * saturated\n    new_state[\"arm.y\"] = state[\"arm.y\"] + p[\"arm_gain\"] * saturated\n    new_state[\"finger.x\"] = state[\"finger.x\"] + p[\"finger_gain\"] * saturated\n    new_state[\"finger.y\"] = state[\"finger.y\"] + p[\"finger_gain\"] * saturated\n    return new_state",
      "init_params": {
