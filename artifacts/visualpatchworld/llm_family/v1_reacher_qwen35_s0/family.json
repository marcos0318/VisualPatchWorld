        "max_finger_x": 0.25,
        "max_finger_y": 0.25,
        "a0_w": 0.5,
        "a1_w": 0.5
      },
      "repaired": false
    },
    {
      "name": "coupled_drag",
      "mechanism": "Arm motion creates drag force on finger; finger velocity depends on arm velocity.",
      "code": "# HYPOTHESIS: coupled_drag\n# MECHANISM: Arm motion creates drag force on finger; finger velocity depends on arm velocity.\nPARAMS = {\"arm_gain\": 0.1, \"finger_base_gain\": 0.05, \"coupling_strength\": 0.5, \"a0_w\": 0.5, \"a1_w\": 0.5}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = {}\n    new_state[\"target.x\"] = state[\"target.x\"]\n    new_state[\"target.y\"] = state[\"target.y\"]\n    action_eff = p[\"a0_w\"] * action[0] + p[\"a1_w\"] * action[1]\n    new_state[\"arm.x\"] = state[\"arm.x\"] + p[\"arm_gain\"] * action_eff\n    new_state[\"arm.y\"] = state[\"arm.y\"] + p[\"arm_gain\"] * action_eff\n    arm_delta_x = p[\"arm_gain\"] * action_eff\n    arm_delta_y = p[\"arm_gain\"] * action_eff\n    finger_delta_x = p[\"finger_base_gain\"] * action_eff + p[\"coupling_strength\"] * arm_delta_x\n    finger_delta_y = p[\"finger_base_gain\"] * action_eff + p[\"coupling_strength\"] * arm_delta_y\n    new_state[\"finger.x\"] = state[\"finger.x\"] + finger_delta_x\n    new_state[\"finger.y\"] = state[\"finger.y\"] + finger_delta_y\n    return new_state",
      "init_params": {
