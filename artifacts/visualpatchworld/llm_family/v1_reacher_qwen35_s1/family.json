    {
      "name": "independent_linear",
      "mechanism": "Action directly controls velocity of arm and finger independently; target is static.",
      "code": "# HYPOTHESIS: independent_linear\n# MECHANISM: Action directly controls velocity of arm and finger independently; target is static.\nPARAMS = {\"gain_ax\": 1.0, \"gain_ay\": 1.0, \"gain_fx\": 1.0, \"gain_fy\": 1.0}\n\ndef step(state, action, p, meta):\n    import math\n    s = state.copy()\n    # Arm updates\n    s[\"arm.x\"] = state[\"arm.x\"] + p[\"gain_ax\"] * action[0]\n    s[\"arm.y\"] = state[\"arm.y\"] + p[\"gain_ay\"] * action[1]\n    # Finger updates independently\n    s[\"finger.x\"] = state[\"finger.x\"] + p[\"gain_fx\"] * action[0]\n    s[\"finger.y\"] = state[\"finger.y\"] + p[\"gain_fy\"] * action[1]\n    # Target static\n    s[\"target.x\"] = state[\"target.x\"]\n    s[\"target.y\"] = state[\"target.y\"]\n    return s",
      "init_params": {
        "gain_ax": 1.0,
        "gain_ay": 1.0,
        "gain_fx": 1.0,
        "gain_fy": 1.0
      },
      "repaired": false
    },
    {
      "name": "arm_driven_linear",
      "mechanism": "Action controls arm velocity; finger moves linearly coupled to arm displacement.",
      "code": "# HYPOTHESIS: arm_driven_linear\n# MECHANISM: Action controls arm velocity; finger moves linearly coupled to arm displacement.\nPARAMS = {\"gain_ax\": 1.0, \"gain_ay\": 1.0, \"couple_fx\": 0.1, \"couple_fy\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    s = state.copy()\n    # Arm updates\n    new_arm_x = state[\"arm.x\"] + p[\"gain_ax\"] * action[0]\n    new_arm_y = state[\"arm.y\"] + p[\"gain_ay\"] * action[1]\n    delta_ax = new_arm_x - state[\"arm.x\"]\n    delta_ay = new_arm_y - state[\"arm.y\"]\n    \n    s[\"arm.x\"] = new_arm_x\n    s[\"arm.y\"] = new_arm_y\n    \n    # Finger follows arm delta\n    s[\"finger.x\"] = state[\"finger.x\"] + p[\"couple_fx\"] * delta_ax\n    s[\"finger.y\"] = state[\"finger.y\"] + p[\"couple_fy\"] * delta_ay\n    \n    # Target static\n    s[\"target.x\"] = state[\"target.x\"]\n    s[\"target.y\"] = state[\"target.y\"]\n    return s",
      "init_params": {
        "gain_ax": 1.0,
        "gain_ay": 1.0,
        "couple_fx": 0.1,
        "couple_fy": 0.1
      },
      "repaired": false
    },
    {
      "name": "arm_driven_fk",
      "mechanism": "Arm represents joint angles; finger position is determined by forward kinematics (trigonometric).",
      "code": "# HYPOTHESIS: arm_driven_fk\n# MECHANISM: Arm represents joint angles; finger position is determined by forward kinematics (trigonometric).\nPARAMS = {\"gain_ax\": 1.0, \"gain_ay\": 1.0, \"link1\": 0.15, \"link2\": 0.15, \"off_x\": 0.0, \"off_y\": 0.0}\n\ndef step(state, action, p, meta):\n    import math\n    s = state.copy()\n    # Arm updates (angles)\n    new_arm_x = state[\"arm.x\"] + p[\"gain_ax\"] * action[0]\n    new_arm_y = state[\"arm.y\"] + p[\"gain_ay\"] * action[1]\n    \n    s[\"arm.x\"] = new_arm_x\n    s[\"arm.y\"] = new_arm_y\n    \n    # Finger computed via FK\n    # Assuming arm.x is shoulder, arm.y is elbow relative\n    c1 = math.cos(new_arm_x)\n    s1 = math.sin(new_arm_x)\n    c2 = math.cos(new_arm_x + new_arm_y)\n    s2 = math.sin(new_arm_x + new_arm_y)\n    \n    s[\"finger.x\"] = p[\"link1\"] * c1 + p[\"link2\"] * c2 + p[\"off_x\"]\n    s[\"finger.y\"] = p[\"link1\"] * s1 + p[\"link2\"] * s2 + p[\"off_y\"]\n    \n    # Target static\n    s[\"target.x\"] = state[\"target.x\"]\n    s[\"target.y\"] = state[\"target.y\"]\n    return s",
      "init_params": {
        "gain_ax": 1.0,
        "gain_ay": 1.0,
        "link1": 0.15,
        "link2": 0.15,
        "off_x": 0.0,
        "off_y": 0.0
      },
      "repaired": false
    },
    {
      "name": "nonlinear_actuation",
      "mechanism": "Action effect is saturated via tanh nonlinearity before affecting positions.",
      "code": "# HYPOTHESIS: nonlinear_actuation\n# MECHANISM: Action effect is saturated via tanh nonlinearity before affecting positions.\nPARAMS = {\"gain_ax\": 1.0, \"gain_ay\": 1.0, \"gain_fx\": 1.0, \"gain_fy\": 1.0, \"saturation\": 1.0}\n\ndef step(state, action, p, meta):\n    import math\n    s = state.copy()\n    \n    # Saturated action\n    eff_a0 = math.tanh(action[0] / p[\"saturation\"])\n    eff_a1 = math.tanh(action[1] / p[\"saturation\"])\n    \n    s[\"arm.x\"] = state[\"arm.x\"] + p[\"gain_ax\"] * eff_a0\n    s[\"arm.y\"] = state[\"arm.y\"] + p[\"gain_ay\"] * eff_a1\n    s[\"finger.x\"] = state[\"finger.x\"] + p[\"gain_fx\"] * eff_a0\n    s[\"finger.y\"] = state[\"finger.y\"] + p[\"gain_fy\"] * eff_a1\n    \n    s[\"target.x\"] = state[\"target.x\"]\n    s[\"target.y\"] = state[\"target.y\"]\n    return s",
      "init_params": {
        "gain_ax": 1.0,
        "gain_ay": 1.0,
        "gain_fx": 1.0,
        "gain_fy": 1.0,
        "saturation": 1.0
      },
      "repaired": false
    },
    {
      "name": "position_damping",
      "mechanism": "Motion is resisted by a damping force proportional to current position (spring-like return to origin).",
      "code": "# HYPOTHESIS: position_damping\n# MECHANISM: Motion is resisted by a damping force proportional to current position (spring-like return to origin).\nPARAMS = {\"gain_ax\": 1.0, \"gain_ay\": 1.0, \"damp_ax\": 0.1, \"damp_ay\": 0.1, \"gain_fx\": 1.0, \"gain_fy\": 1.0}\n\ndef step(state, action, p, meta):\n    import math\n    s = state.copy()\n    \n    # Arm with damping\n    dx = p[\"gain_ax\"] * action[0] - p[\"damp_ax\"] * state[\"arm.x\"]\n    dy = p[\"gain_ay\"] * action[1] - p[\"damp_ay\"] * state[\"arm.y\"]\n    \n    s[\"arm.x\"] = state[\"arm.x\"] + dx\n    s[\"arm.y\"] = state[\"arm.y\"] + dy\n    \n    # Finger linear\n    s[\"finger.x\"] = state[\"finger.x\"] + p[\"gain_fx\"] * action[0]\n    s[\"finger.y\"] = state[\"finger.y\"] + p[\"gain_fy\"] * action[1]\n    \n    s[\"target.x\"] = state[\"target.x\"]\n    s[\"target.y\"] = state[\"target.y\"]\n    return s",
      "init_params": {
        "gain_ax": 1.0,
        "gain_ay": 1.0,
        "damp_ax": 0.1,
        "damp_ay": 0.1,
        "gain_fx": 1.0,
        "gain_fy": 1.0
      },
      "repaired": false
    },
    {
      "name": "target_attraction",
      "mechanism": "Finger experiences a passive attractive force towards the target in addition to action control.",
      "code": "# HYPOTHESIS: target_attraction\n# MECHANISM: Finger experiences a passive attractive force towards the target in addition to action control.\nPARAMS = {\"gain_ax\": 1.0, \"gain_ay\": 1.0, \"gain_fx\": 1.0, \"gain_fy\": 1.0, \"magnet_x\": 0.1, \"magnet_y\": 0.1}\n\ndef step(state, action, p, meta):\n    import math\n    s = state.copy()\n    \n    # Arm linear\n    s[\"arm.x\"] = state[\"arm.x\"] + p[\"gain_ax\"] * action[0]\n    s[\"arm.y\"] = state[\"arm.y\"] + p[\"gain_ay\"] * action[1]\n    \n    # Finger with target attraction\n    dist_x = state[\"target.x\"] - state[\"finger.x\"]\n    dist_y = state[\"target.y\"] - state[\"finger.y\"]\n    \n    s[\"finger.x\"] = state[\"finger.x\"] + p[\"gain_fx\"] * action[0] + p[\"magnet_x\"] * dist_x\n    s[\"finger.y\"] = state[\"finger.y\"] + p[\"gain_fy\"] * action[1] + p[\"magnet_y\"] * dist_y\n    \n    s[\"target.x\"] = state[\"target.x\"]\n    s[\"target.y\"] = state[\"target.y\"]\n    return s",
      "init_params": {
        "gain_ax": 1.0,
        "gain_ay": 1.0,
        "gain_fx": 1.0,
        "gain_fy": 1.0,
        "magnet_x": 0.1,
        "magnet_y": 0.1
      },
      "repaired": false
    }
