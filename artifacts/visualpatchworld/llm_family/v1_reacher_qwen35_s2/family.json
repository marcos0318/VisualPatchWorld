    {
      "name": "saturated_joint_limits",
      "mechanism": "Linear joint dynamics with hard saturation at learned joint limits; finger from forward kinematics.",
      "code": "# HYPOTHESIS: saturated_joint_limits\n# MECHANISM: Linear joint dynamics with hard saturation at learned joint limits; finger from forward kinematics.\nPARAMS = {\"joint_gain_0\": 0.12, \"joint_gain_1\": 0.12, \"joint_min_0\": -4.0, \"joint_max_0\": 4.0, \"joint_min_1\": -2.5, \"joint_max_1\": 2.5, \"fk_l1\": 0.13, \"fk_l2\": 0.10}\n\ndef step(state, action, p, meta):\n    import math\n    ns = dict(state)\n    # Linear dynamics with saturation\n    raw_x = state[\"arm.x\"] + p[\"joint_gain_0\"] * action[0]\n    raw_y = state[\"arm.y\"] + p[\"joint_gain_1\"] * action[1]\n    ns[\"arm.x\"] = max(p[\"joint_min_0\"], min(p[\"joint_max_0\"], raw_x))\n    ns[\"arm.y\"] = max(p[\"joint_min_1\"], min(p[\"joint_max_1\"], raw_y))\n    # Forward kinematics\n    j0 = ns[\"arm.x\"]\n    j1 = ns[\"arm.y\"]\n    ns[\"finger.x\"] = p[\"fk_l1\"] * math.cos(j0) + p[\"fk_l2\"] * math.cos(j0 + j1)\n    ns[\"finger.y\"] = p[\"fk_l1\"] * math.sin(j0) + p[\"fk_l2\"] * math.sin(j0 + j1)\n    ns[\"target.x\"] = state[\"target.x\"]\n    ns[\"target.y\"] = state[\"target.y\"]\n    return ns",
      "init_params": {
        "joint_gain_0": 0.12,
        "joint_gain_1": 0.12,
        "joint_min_0": -4.0,
        "joint_max_0": 4.0,
        "joint_min_1": -2.5,
