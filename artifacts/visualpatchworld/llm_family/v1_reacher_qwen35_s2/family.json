    {
      "name": "action_dependent_kinematics",
      "mechanism": "Joint dynamics are linear, but the finger kinematics change based on current action (gearing/elasticity effect).",
      "code": "# HYPOTHESIS: action_dependent_kinematics\n# MECHANISM: Joint dynamics are linear, but the finger kinematics change based on current action (gearing/elasticity effect).\nPARAMS = {\"joint_gain_0\": 0.13, \"joint_gain_1\": 0.13, \"fk_base_l1\": 0.14, \"fk_base_l2\": 0.11, \"fk_action_scale_1\": 0.01, \"fk_action_scale_2\": 0.01}\n\ndef step(state, action, p, meta):\n    import math\n    ns = dict(state)\n    # Linear joint dynamics\n    ns[\"arm.x\"] = state[\"arm.x\"] + p[\"joint_gain_0\"] * action[0]\n    ns[\"arm.y\"] = state[\"arm.y\"] + p[\"joint_gain_1\"] * action[1]\n    # Action-dependent link lengths (simulates compliance or variable gearing)\n    eff_l1 = p[\"fk_base_l1\"] + p[\"fk_action_scale_1\"] * abs(action[0])\n    eff_l2 = p[\"fk_base_l2\"] + p[\"fk_action_scale_2\"] * abs(action[1])\n    j0 = ns[\"arm.x\"]\n    j1 = ns[\"arm.y\"]\n    ns[\"finger.x\"] = eff_l1 * math.cos(j0) + eff_l2 * math.cos(j0 + j1)\n    ns[\"finger.y\"] = eff_l1 * math.sin(j0) + eff_l2 * math.sin(j0 + j1)\n    ns[\"target.x\"] = state[\"target.x\"]\n    ns[\"target.y\"] = state[\"target.y\"]\n    return ns",
