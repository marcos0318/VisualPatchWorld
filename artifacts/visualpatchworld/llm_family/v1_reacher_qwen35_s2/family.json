      "name": "linear_joint_linear_finger",
      "mechanism": "Action directly changes arm joints linearly; finger position is linear function of arm joints.",
      "code": "# HYPOTHESIS: linear_joint_linear_finger\n# MECHANISM: Action directly changes arm joints linearly; finger position is linear function of arm joints.\nPARAMS = {\"arm_gain_0\": 0.1, \"arm_gain_1\": 0.1, \"finger_scale_x\": 0.05, \"finger_scale_y\": 0.05, \"finger_offset_x\": 0.0, \"finger_offset_y\": 0.0}\n\ndef step(state, action, p, meta):\n    import math\n    ns = dict(state)\n    # Arm joints change linearly with action\n    ns[\"arm.x\"] = state[\"arm.x\"] + p[\"arm_gain_0\"] * action[0]\n    ns[\"arm.y\"] = state[\"arm.y\"] + p[\"arm_gain_1\"] * action[1]\n    # Finger is linear function of arm joints\n    ns[\"finger.x\"] = p[\"finger_scale_x\"] * state[\"arm.x\"] + p[\"finger_offset_x\"]\n    ns[\"finger.y\"] = p[\"finger_scale_y\"] * state[\"arm.y\"] + p[\"finger_offset_y\"]\n    # Target never changes\n    ns[\"target.x\"] = state[\"target.x\"]\n    ns[\"target.y\"] = state[\"target.y\"]\n    return ns",
      "init_params": {
        "arm_gain_0": 0.1,
        "arm_gain_1": 0.1,
        "finger_scale_x": 0.05,
        "finger_scale_y": 0.05,
        "finger_offset_x": 0.0,
        "finger_offset_y": 0.0
      },
      "repaired": false
    },
    {
      "name": "forward_kinematics_2link",
      "mechanism": "Action controls joint velocities; finger computed via 2-link forward kinematics (trigonometric).",
      "code": "# HYPOTHESIS: forward_kinematics_2link\n# MECHANISM: Action controls joint velocities; finger computed via 2-link forward kinematics (trigonometric).\nPARAMS = {\"joint_gain_0\": 0.15, \"joint_gain_1\": 0.15, \"link_length_1\": 0.15, \"link_length_2\": 0.12, \"base_offset_x\": 0.0, \"base_offset_y\": 0.0}\n\ndef step(state, action, p, meta):\n    import math\n    ns = dict(state)\n    # Joints evolve with velocity proportional to action\n    ns[\"arm.x\"] = state[\"arm.x\"] + p[\"joint_gain_0\"] * action[0]\n    ns[\"arm.y\"] = state[\"arm.y\"] + p[\"joint_gain_1\"] * action[1]\n    # Forward kinematics: finger = base + link1*cos/sin(joint0) + link2*cos/sin(joint0+joint1)\n    j0 = state[\"arm.x\"]\n    j1 = state[\"arm.y\"]\n    ns[\"finger.x\"] = p[\"base_offset_x\"] + p[\"link_length_1\"] * math.cos(j0) + p[\"link_length_2\"] * math.cos(j0 + j1)\n    ns[\"finger.y\"] = p[\"base_offset_y\"] + p[\"link_length_1\"] * math.sin(j0) + p[\"link_length_2\"] * math.sin(j0 + j1)\n    ns[\"target.x\"] = state[\"target.x\"]\n    ns[\"target.y\"] = state[\"target.y\"]\n    return ns",
      "init_params": {
        "joint_gain_0": 0.15,
        "joint_gain_1": 0.15,
        "link_length_1": 0.15,
        "link_length_2": 0.12,
        "base_offset_x": 0.0,
        "base_offset_y": 0.0
      },
      "repaired": false
    },
    {
      "name": "momentum_joint_dynamics",
      "mechanism": "Action controls joint acceleration; joints have implicit velocity (momentum) that carries over between steps.",
      "code": "# HYPOTHESIS: momentum_joint_dynamics\n# MECHANISM: Action controls joint acceleration; joints have implicit velocity (momentum) that carries over between steps.\nPARAMS = {\"accel_gain_0\": 0.02, \"accel_gain_1\": 0.02, \"damping_0\": 0.9, \"damping_1\": 0.9, \"fk_scale_x\": 0.05, \"fk_scale_y\": 0.05}\n\ndef step(state, action, p, meta):\n    import math\n    ns = dict(state)\n    # Use meta to store velocity between calls (simulated momentum)\n    vel_key = meta.get(\"episode_index\", 0)\n    if \"_vel\" not in meta:\n        meta[\"_vel\"] = [0.0, 0.0]\n    # Acceleration from action\n    acc0 = p[\"accel_gain_0\"] * action[0]\n    acc1 = p[\"accel_gain_1\"] * action[1]\n    # Update velocity with damping\n    meta[\"_vel\"][0] = p[\"damping_0\"] * meta[\"_vel\"][0] + acc0\n    meta[\"_vel\"][1] = p[\"damping_1\"] * meta[\"_vel\"][1] + acc1\n    # Update position from velocity\n    ns[\"arm.x\"] = state[\"arm.x\"] + meta[\"_vel\"][0]\n    ns[\"arm.y\"] = state[\"arm.y\"] + meta[\"_vel\"][1]\n    # Simple FK for finger\n    ns[\"finger.x\"] = p[\"fk_scale_x\"] * math.sin(state[\"arm.x\"])\n    ns[\"finger.y\"] = p[\"fk_scale_y\"] * math.cos(state[\"arm.y\"])\n    ns[\"target.x\"] = state[\"target.x\"]\n    ns[\"target.y\"] = state[\"target.y\"]\n    return ns",
      "init_params": {
        "accel_gain_0": 0.02,
        "accel_gain_1": 0.02,
        "damping_0": 0.9,
        "damping_1": 0.9,
        "fk_scale_x": 0.05,
        "fk_scale_y": 0.05
      },
      "repaired": false
    },
    {
      "name": "coupled_joint_dynamics",
      "mechanism": "Joints are coupled; action on one joint affects both joint positions (non-diagonal dynamics matrix).",
      "code": "# HYPOTHESIS: coupled_joint_dynamics\n# MECHANISM: Joints are coupled; action on one joint affects both joint positions (non-diagonal dynamics matrix).\nPARAMS = {\"couple_00\": 0.1, \"couple_01\": 0.02, \"couple_10\": 0.02, \"couple_11\": 0.1, \"fk_l1\": 0.14, \"fk_l2\": 0.11}\n\ndef step(state, action, p, meta):\n    import math\n    ns = dict(state)\n    # Coupled linear dynamics: delta_joint = M @ action\n    d0 = p[\"couple_00\"] * action[0] + p[\"couple_01\"] * action[1]\n    d1 = p[\"couple_10\"] * action[0] + p[\"couple_11\"] * action[1]\n    ns[\"arm.x\"] = state[\"arm.x\"] + d0\n    ns[\"arm.y\"] = state[\"arm.y\"] + d1\n    # Forward kinematics\n    j0 = ns[\"arm.x\"]\n    j1 = ns[\"arm.y\"]\n    ns[\"finger.x\"] = p[\"fk_l1\"] * math.cos(j0) + p[\"fk_l2\"] * math.cos(j0 + j1)\n    ns[\"finger.y\"] = p[\"fk_l1\"] * math.sin(j0) + p[\"fk_l2\"] * math.sin(j0 + j1)\n    ns[\"target.x\"] = state[\"target.x\"]\n    ns[\"target.y\"] = state[\"target.y\"]\n    return ns",
      "init_params": {
        "couple_00": 0.1,
