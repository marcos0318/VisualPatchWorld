    {
      "name": "linear_no_momentum",
      "mechanism": "Agent moves with constant velocity directly proportional to action, no inertia.",
      "code": "# HYPOTHESIS: linear_no_momentum\n# MECHANISM: Agent moves with constant velocity directly proportional to action, no inertia.\nPARAMS = {\"speed\": 10.0}\n\ndef step(state, action, p, meta):\n    ax, ay = action\n    speed = p[\"speed\"]\n    return {\n        \"agent.x\": state[\"agent.x\"] + ax * speed,\n        \"agent.y\": state[\"agent.y\"] + ay * speed,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }",
      "init_params": {
        "speed": 10.0
      },
      "repaired": false
    },
    {
      "name": "momentum_based",
      "mechanism": "Agent has velocity that changes based on action (acceleration), with position integrated from velocity.",
      "code": "# HYPOTHESIS: momentum_based\n# MECHANISM: Agent has velocity that changes based on action (acceleration), with position integrated from velocity.\nPARAMS = {\"acc_gain\": 5.0, \"dt\": 1.0}\n\ndef step(state, action, p, meta):\n    ax, ay = action\n    acc_gain = p[\"acc_gain\"]\n    dt = p[\"dt\"]\n\n    # Assume hidden velocity states are part of the model but not observed\n    # We simulate them implicitly using prior state if needed\n    # For simplicity here we assume velocities can be approximated from previous positions\n    # But since we don't have access to past velocities, use dummy zero-init or derive from action\n\n    # Approximate new velocity change due to action\n    dvx = ax * acc_gain\n    dvy = ay * acc_gain\n\n    # Assume starting vx=0, vy=0 for simplicity in absence of history\n    vx_new = dvx\n    vy_new = dvy\n\n    return {\n        \"agent.x\": state[\"agent.x\"] + vx_new * dt,\n        \"agent.y\": state[\"agent.y\"] + vy_new * dt,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }",
      "init_params": {
        "acc_gain": 5.0,
        "dt": 1.0
      },
      "repaired": false
    },
    {
      "name": "nonlinear_action_response",
      "mechanism": "Action affects agent motion through a nonlinear function (e.g., quadratic gain).",
      "code": "# HYPOTHESIS: nonlinear_action_response\n# MECHANISM: Action affects agent motion through a nonlinear function (e.g., quadratic gain).\nPARAMS = {\"gain\": 3.0, \"exp\": 2.0}\n\ndef step(state, action, p, meta):\n    ax, ay = action\n    gain = p[\"gain\"]\n    exp = p[\"exp\"]\n    dx = gain * (abs(ax)**exp) * (1 if ax >= 0 else -1)\n    dy = gain * (abs(ay)**exp) * (1 if ay >= 0 else -1)\n    return {\n        \"agent.x\": state[\"agent.x\"] + dx,\n        \"agent.y\": state[\"agent.y\"] + dy,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }",
      "init_params": {
        "gain": 3.0,
        "exp": 2.0
      },
      "repaired": false
    },
    {
      "name": "bounded_speed_saturation",
      "mechanism": "Agent's movement is capped at maximum speed regardless of action magnitude.",
      "code": "# HYPOTHESIS: bounded_speed_saturation\n# MECHANISM: Agent's movement is capped at maximum speed regardless of action magnitude.\nPARAMS = {\"max_speed\": 15.0}\n\ndef step(state, action, p, meta):\n    ax, ay = action\n    max_speed = p[\"max_speed\"]\n    norm = math.sqrt(ax**2 + ay**2)\n    if norm > 1e-8:\n        scale = min(norm, 1.0) / norm\n        dx = ax * scale * max_speed\n        dy = ay * scale * max_speed\n    else:\n        dx, dy = 0.0, 0.0\n    return {\n        \"agent.x\": state[\"agent.x\"] + dx,\n        \"agent.y\": state[\"agent.y\"] + dy,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }",
      "init_params": {
        "max_speed": 15.0
      },
      "repaired": false
    },
    {
      "name": "door_obstacle_avoidance",
      "mechanism": "Movement blocked when crossing a static door obstacle unless aligned properly.",
      "code": "# HYPOTHESIS: door_obstacle_avoidance\n# MECHANISM: Movement blocked when crossing a static door obstacle unless aligned properly.\nPARAMS = {\"speed\": 8.0}\n\ndef step(state, action, p, meta):\n    ax, ay = action\n    speed = p[\"speed\"]\n    dx = ax * speed\n    dy = ay * speed\n    new_x = state[\"agent.x\"] + dx\n    new_y = state[\"agent.y\"] + dy\n\n    door = meta.get(\"door_coords\", [])\n    if len(door) >= 2:\n        door_x, door_y = door[0], door[1]\n        threshold = 5.0\n        if abs(new_x - door_x) < threshold and abs(new_y - door_y) < threshold:\n            new_x = state[\"agent.x\"]\n            new_y = state[\"agent.y\"]\n\n    return {\n        \"agent.x\": new_x,\n        \"agent.y\": new_y,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }",
      "init_params": {
        "speed": 8.0
      },
      "repaired": false
    },
    {
      "name": "target_attraction_coupling",
      "mechanism": "Action influences motion towards target via coupling between agent and target positions.",
      "code": "# HYPOTHESIS: target_attraction_coupling\n# MECHANISM: Action influences motion towards target via coupling between agent and target positions.\nPARAMS = {\"k_att\": 0.1, \"speed_factor\": 5.0}\n\ndef step(state, action, p, meta):\n    ax, ay = action\n    k_att = p[\"k_att\"]\n    speed_factor = p[\"speed_factor\"]\n\n    tx = state[\"target.x\"]\n    ty = state[\"target.y\"]\n    px = state[\"agent.x\"]\n    py = state[\"agent.y\"]\n\n    dx_total = ax * speed_factor + k_att * (tx - px)\n    dy_total = ay * speed_factor + k_att * (ty - py)\n\n    return {\n        \"agent.x\": px + dx_total,\n        \"agent.y\": py + dy_total,\n        \"target.x\": tx,\n        \"target.y\": ty,\n    }",
      "init_params": {
        "k_att": 0.1,
        "speed_factor": 5.0
      },
      "repaired": false
    }
  ],
