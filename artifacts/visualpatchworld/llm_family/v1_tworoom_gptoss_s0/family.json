      "name": "baseline_static",
      "mechanism": "the world is assumed to be completely inert; the agent never moves regardless of the action.",
      "code": "# HYPOTHESIS: baseline_static\n# MECHANISM: the world is assumed to be completely inert; the agent never moves regardless of the action.\nPARAMS = {}\n\ndef step(state, action, p, meta):\n    \"\"\"Return a copy of the input state (no change).\"\"\"\n    return dict(state)",
      "init_params": {},
      "repaired": false
    },
    {
      "name": "linear_velocity",
      "mechanism": "the agent translates each step by a constant gain applied directly to the two action components.",
      "code": "# HYPOTHESIS: linear_velocity\n# MECHANISM: the agent translates each step by a constant gain applied directly to the two action components.\nPARAMS = {\"gain_x\": 5.0, \"gain_y\": 5.0}\n\ndef step(state, action, p, meta):\n    \"\"\"Simple first\u2011order linear mapping from action to position change.\"\"\"\n    nx = state[\"agent.x\"] + p[\"gain_x\"] * action[0]\n    ny = state[\"agent.y\"] + p[\"gain_y\"] * action[1]\n    return {\n        \"agent.x\": nx,\n        \"agent.y\": ny,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }",
      "init_params": {
        "gain_x": 5.0,
        "gain_y": 5.0
      },
      "repaired": false
    },
    {
      "name": "saturated_tanh",
      "mechanism": "action is passed through a tanh nonlinearity to model saturation of speed.",
      "code": "# HYPOTHESIS: saturated_tanh\n# MECHANISM: action is passed through a tanh nonlinearity to model saturation of speed.\nPARAMS = {\"gain\": 2.0, \"max_speed\": 10.0}\n\ndef step(state, action, p, meta):\n    \"\"\"Action is scaled, saturated by tanh, then multiplied by a maximum speed.\"\"\"\n    import math\n    vx = p[\"max_speed\"] * math.tanh(p[\"gain\"] * action[0])\n    vy = p[\"max_speed\"] * math.tanh(p[\"gain\"] * action[1])\n    nx = state[\"agent.x\"] + vx\n    ny = state[\"agent.y\"] + vy\n    return {\n        \"agent.x\": nx,\n        \"agent.y\": ny,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }",
      "init_params": {
        "gain": 2.0,
        "max_speed": 10.0
      },
      "repaired": false
    },
    {
      "name": "momentum",
      "mechanism": "the agent has hidden velocity that integrates the action as acceleration and decays with damping.",
      "code": "# HYPOTHESIS: momentum\n# MECHANISM: the agent has hidden velocity that integrates the action as acceleration and decays with damping.\nPARAMS = {\"accel_gain\": 0.8, \"damping\": 0.1}\n    \ndef step(state, action, p, meta):\n    \"\"\"First\u2011order dynamics with hidden velocity (stored in state if present).\"\"\"\n    vx = state.get(\"agent.vx\", 0.0) + p[\"accel_gain\"] * action[0]\n    vy = state.get(\"agent.vy\", 0.0) + p[\"accel_gain\"] * action[1]\n    # apply damping\n    vx *= (1.0 - p[\"damping\"])\n    vy *= (1.0 - p[\"damping\"])\n    nx = state[\"agent.x\"] + vx\n    ny = state[\"agent.y\"] + vy\n    return {\n        \"agent.x\": nx,\n        \"agent.y\": ny,\n        \"agent.vx\": vx,\n        \"agent.vy\": vy,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }",
      "init_params": {
        "accel_gain": 0.8,
        "damping": 0.1
      },
      "repaired": false
    },
    {
      "name": "obstacle_gate",
      "mechanism": "movement is slowed when the agent is inside a circular region around the door coordinates.",
      "code": "# HYPOTHESIS: obstacle_gate\n# MECHANISM: movement is slowed when the agent is inside a circular region around the door coordinates.\nPARAMS = {\"radius\": 15.0, \"slow_factor\": 0.3, \"gain_x\": 5.0, \"gain_y\": 5.0}\n    \ndef step(state, action, p, meta):\n    \"\"\"If the agent is within `radius` of the door, scale down the motion.\"\"\"\n    door = meta.get(\"door_coords\", [0.0, 0.0])\n    door_x, door_y = door[0], door[1]\n    dx = state[\"agent.x\"] - door_x\n    dy = state[\"agent.y\"] - door_y\n    dist2 = dx * dx + dy * dy\n    factor = p[\"slow_factor\"] if dist2 < p[\"radius\"] ** 2 else 1.0\n    nx = state[\"agent.x\"] + factor * p[\"gain_x\"] * action[0]\n    ny = state[\"agent.y\"] + factor * p[\"gain_y\"] * action[1]\n    return {\n        \"agent.x\": nx,\n        \"agent.y\": ny,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }",
      "init_params": {
        "radius": 15.0,
        "slow_factor": 0.3,
        "gain_x": 5.0,
        "gain_y": 5.0
      },
      "repaired": false
    },
    {
      "name": "goal_directed",
      "mechanism": "the agent moves toward the target; the speed is proportional to the action magnitude and modulated by alignment with the goal direction.",
      "code": "# HYPOTHESIS: goal_directed\n# MECHANISM: the agent moves toward the target; the speed is proportional to the action magnitude and modulated by alignment with the goal direction.\nPARAMS = {\"gain\": 8.0}\n    \ndef step(state, action, p, meta):\n    \"\"\"Action magnitude sets speed; only the component aligned with the target vector produces motion.\"\"\"\n    import math\n    # vector to target\n    tx = state[\"target.x\"] - state[\"agent.x\"]\n    ty = state[\"target.y\"] - state[\"agent.y\"]\n    angle_to_target = math.atan2(ty, tx)\n    # action direction (fallback to target direction if zero)\n    act_norm = math.hypot(action[0], action[1])\n    if act_norm < 1e-6:\n        action_angle = angle_to_target\n    else:\n        action_angle = math.atan2(action[1], action[0])\n    # alignment factor (cosine of angle difference, clipped at 0)\n    align = max(0.0, math.cos(angle_to_target - action_angle))\n    speed = p[\"gain\"] * act_norm * align\n    nx = state[\"agent.x\"] + speed * math.cos(angle_to_target)\n    ny = state[\"agent.y\"] + speed * math.sin(angle_to_target)\n    return {\n        \"agent.x\": nx,\n        \"agent.y\": ny,\n        \"target.x\": state[\"target.x\"],\n        \"target.y\": state[\"target.y\"],\n    }",
      "init_params": {
        "gain": 8.0
      },
      "repaired": false
    }
