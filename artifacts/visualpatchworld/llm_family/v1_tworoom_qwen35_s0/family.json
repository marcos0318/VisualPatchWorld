      "name": "simple_linear_velocity",
      "mechanism": "Agent moves with velocity directly proportional to action (first-order kinematics, no momentum).",
      "code": "# HYPOTHESIS: simple_linear_velocity\n# MECHANISM: Agent moves with velocity directly proportional to action (first-order kinematics, no momentum).\nPARAMS = {\"scale_x\": 25.0, \"scale_y\": 25.0}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = dict(state)\n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    new_state[\"agent.x\"] = state[\"agent.x\"] + p[\"scale_x\"] * ax\n    new_state[\"agent.y\"] = state[\"agent.y\"] + p[\"scale_y\"] * ay\n    new_state[\"target.x\"] = state[\"target.x\"]\n    new_state[\"target.y\"] = state[\"target.y\"]\n    return new_state",
      "init_params": {
        "scale_x": 25.0,
        "scale_y": 25.0
      },
      "repaired": false
    },
    {
      "name": "momentum_with_damping",
      "mechanism": "Agent has velocity state that accumulates from action with exponential decay (second-order dynamics).",
      "code": "# HYPOTHESIS: momentum_with_damping\n# MECHANISM: Agent has velocity state that accumulates from action with exponential decay (second-order dynamics).\nPARAMS = {\"accel_scale\": 20.0, \"damping\": 0.85, \"vel_x\": 0.0, \"vel_y\": 0.0}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = dict(state)\n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    vx = p.get(\"vel_x\", 0.0) * p[\"damping\"] + p[\"accel_scale\"] * ax\n    vy = p.get(\"vel_y\", 0.0) * p[\"damping\"] + p[\"accel_scale\"] * ay\n    new_state[\"agent.x\"] = state[\"agent.x\"] + vx\n    new_state[\"agent.y\"] = state[\"agent.y\"] + vy\n    new_state[\"target.x\"] = state[\"target.x\"]\n    new_state[\"target.y\"] = state[\"target.y\"]\n    return new_state",
      "init_params": {
        "accel_scale": 20.0,
        "damping": 0.85,
        "vel_x": 0.0,
        "vel_y": 0.0
      },
      "repaired": false
    },
    {
      "name": "saturating_nonlinear_response",
      "mechanism": "Action-to-velocity mapping has sigmoidal saturation at high action magnitudes.",
      "code": "# HYPOTHESIS: saturating_nonlinear_response\n# MECHANISM: Action-to-velocity mapping has sigmoidal saturation at high action magnitudes.\nPARAMS = {\"max_speed\": 15.0, \"steepness\": 3.0, \"threshold\": 0.3}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = dict(state)\n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    def saturate(a):\n        mag = math.sqrt(ax*ax + ay*ay)\n        if mag < 1e-6:\n            return 0.0\n        scale = p[\"max_speed\"] * math.tanh(p[\"steepness\"] * mag) / mag\n        return a * scale\n    new_state[\"agent.x\"] = state[\"agent.x\"] + saturate(ax)\n    new_state[\"agent.y\"] = state[\"agent.y\"] + saturate(ay)\n    new_state[\"target.x\"] = state[\"target.x\"]\n    new_state[\"target.y\"] = state[\"target.y\"]\n    return new_state",
      "init_params": {
        "max_speed": 15.0,
        "steepness": 3.0,
        "threshold": 0.3
      },
      "repaired": false
    },
    {
      "name": "obstacle_collision_blocking",
      "mechanism": "Movement is blocked when agent crosses door boundary coordinates (hard constraint from metadata).",
      "code": "# HYPOTHESIS: obstacle_collision_blocking\n# MECHANISM: Movement is blocked when agent crosses door boundary coordinates (hard constraint from metadata).\nPARAMS = {\"scale_x\": 25.0, \"scale_y\": 25.0, \"door_x\": 112.0, \"door_y\": 49.0, \"door_radius\": 15.0}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = dict(state)\n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    nx = state[\"agent.x\"] + p[\"scale_x\"] * ax\n    ny = state[\"agent.y\"] + p[\"scale_y\"] * ay\n    door_x = meta.get(\"door_coords\", [p[\"door_x\"], p[\"door_y\"]])[0]\n    door_y = meta.get(\"door_coords\", [p[\"door_x\"], p[\"door_y\"]])[1]\n    dist_to_door = math.sqrt((nx - door_x)**2 + (ny - door_y)**2)\n    if dist_to_door < p[\"door_radius\"] and dist_to_door > 1e-6:\n        nx = state[\"agent.x\"]\n        ny = state[\"agent.y\"]\n    new_state[\"agent.x\"] = nx\n    new_state[\"agent.y\"] = ny\n    new_state[\"target.x\"] = state[\"target.x\"]\n    new_state[\"target.y\"] = state[\"target.y\"]\n    return new_state",
      "init_params": {
        "scale_x": 25.0,
        "scale_y": 25.0,
        "door_x": 112.0,
        "door_y": 49.0,
        "door_radius": 15.0
      },
      "repaired": false
    },
    {
      "name": "action_coupling_cross_terms",
      "mechanism": "X and Y actions couple to produce diagonal motion (cross-terms in transition function).",
      "code": "# HYPOTHESIS: action_coupling_cross_terms\n# MECHANISM: X and Y actions couple to produce diagonal motion (cross-terms in transition function).\nPARAMS = {\"scale_main\": 20.0, \"scale_cross\": 5.0, \"bias_x\": 0.0, \"bias_y\": 0.0}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = dict(state)\n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    dx = p[\"scale_main\"] * ax + p[\"scale_cross\"] * ay + p[\"bias_x\"]\n    dy = p[\"scale_main\"] * ay + p[\"scale_cross\"] * ax + p[\"bias_y\"]\n    new_state[\"agent.x\"] = state[\"agent.x\"] + dx\n    new_state[\"agent.y\"] = state[\"agent.y\"] + dy\n    new_state[\"target.x\"] = state[\"target.x\"]\n    new_state[\"target.y\"] = state[\"target.y\"]\n    return new_state",
      "init_params": {
        "scale_main": 20.0,
        "scale_cross": 5.0,
        "bias_x": 0.0,
        "bias_y": 0.0
      },
      "repaired": false
    },
    {
      "name": "velocity_dependent_friction",
      "mechanism": "Effective action scale decreases with current speed (drag-like velocity-dependent friction).",
      "code": "# HYPOTHESIS: velocity_dependent_friction\n# MECHANISM: Effective action scale decreases with current speed (drag-like velocity-dependent friction).\nPARAMS = {\"base_scale\": 30.0, \"friction_coef\": 0.02, \"min_scale\": 5.0}\n\ndef step(state, action, p, meta):\n    import math\n    new_state = dict(state)\n    ax = action[0] if len(action) > 0 else 0.0\n    ay = action[1] if len(action) > 1 else 0.0\n    vx_prev = state.get(\"agent.vx\", 0.0)\n    vy_prev = state.get(\"agent.vy\", 0.0)\n    speed = math.sqrt(vx_prev*vx_prev + vy_prev*vy_prev)\n    effective_scale = max(p[\"min_scale\"], p[\"base_scale\"] * (1.0 - p[\"friction_coef\"] * speed))\n    new_state[\"agent.x\"] = state[\"agent.x\"] + effective_scale * ax\n    new_state[\"agent.y\"] = state[\"agent.y\"] + effective_scale * ay\n    new_state[\"target.x\"] = state[\"target.x\"]\n    new_state[\"target.y\"] = state[\"target.y\"]\n    return new_state",
      "init_params": {
        "base_scale": 30.0,
        "friction_coef": 0.02,
        "min_scale": 5.0
      },
      "repaired": false
    }
